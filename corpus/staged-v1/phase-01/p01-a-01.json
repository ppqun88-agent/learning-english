{
  "id": "p01-a-01",
  "title_zh": "约好机场接人地点",
  "topic_id": "travel",
  "scenario": {
    "id": "airport-pickup-location",
    "label_zh": "协调机场接人",
    "goal_zh": "确认机场接人地点、到达时间及联络方式。"
  },
  "participants": [
    "Leah",
    "Ravi"
  ],
  "context_zh": "拉维即将飞来探望莉娅，两人通电话确认接机地点，避免在航站楼外找不到对方。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-01-s01",
      "speaker": "Leah",
      "text": "What time will you arrive at the airport?"
    },
    {
      "id": "p01-a-01-s02",
      "speaker": "Ravi",
      "text": "Just after three. Is there a bus to your street?"
    },
    {
      "id": "p01-a-01-s03",
      "speaker": "Leah",
      "text": "There is, but I'll pick you up in my car."
    },
    {
      "id": "p01-a-01-s04",
      "speaker": "Ravi",
      "text": "Thanks. Shall I wait by the main entrance?"
    },
    {
      "id": "p01-a-01-s05",
      "speaker": "Leah",
      "text": "Use the short-stay parking area instead. I'll text you its address."
    },
    {
      "id": "p01-a-01-s06",
      "speaker": "Ravi",
      "text": "Okay. I'll call when I've collected my suitcase."
    },
    {
      "id": "p01-a-01-s07",
      "speaker": "Leah",
      "text": "Perfect. Have a good flight."
    },
    {
      "id": "p01-a-01-s08",
      "speaker": "Ravi",
      "text": "Thanks, and bye for now!"
    }
  ],
