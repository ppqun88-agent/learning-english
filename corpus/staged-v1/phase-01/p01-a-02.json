{
  "id": "p01-a-02",
  "title_zh": "看房时问清布局",
  "topic_id": "home",
  "scenario": {
    "id": "apartment-viewing-layout",
    "label_zh": "了解公寓布局",
    "goal_zh": "看房时询问房间位置及卫浴设施。"
  },
  "participants": [
    "Maya",
    "Landlord"
  ],
  "context_zh": "租客查看一套楼上的公寓，想知道房间的位置和洗浴设施，房东带她逐一查看。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-02-s01",
      "speaker": "Maya",
      "text": "Is this the apartment above the bakery?"
    },
    {
      "id": "p01-a-02-s02",
      "speaker": "Landlord",
      "text": "Yes. The bakery is directly below us, but it closes at five."
    },
    {
      "id": "p01-a-02-s03",
      "speaker": "Maya",
      "text": "That's good. Which door leads to the bedroom?"
    },
    {
      "id": "p01-a-02-s04",
      "speaker": "Landlord",
      "text": "The one between the kitchen and the bathroom."
    },
    {
      "id": "p01-a-02-s05",
      "speaker": "Maya",
      "text": "Is the bed included, or would I need my own?"
    },
    {
      "id": "p01-a-02-s06",
      "speaker": "Landlord",
      "text": "It's included. You can try it if you like."
    },
    {
      "id": "p01-a-02-s07",
      "speaker": "Maya",
      "text": "Thanks. One more thing: is there a bath, or only a shower?"
    },
    {
      "id": "p01-a-02-s08",
      "speaker": "Landlord",
      "text": "Both. Let me show you before we discuss the rent."
    }
  ],
