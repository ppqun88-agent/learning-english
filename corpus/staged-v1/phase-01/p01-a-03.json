{
  "id": "p01-a-03",
  "title_zh": "在失物招领处找背包",
  "topic_id": "services",
  "scenario": {
    "id": "lost-bag-identification",
    "label_zh": "描述并领取遗失物",
    "goal_zh": "向失物招领处描述背包并确认领取位置。"
  },
  "participants": [
    "Nora",
    "Station worker"
  ],
  "context_zh": "旅客在车站丢了包，工作人员先核对外观，再指引她去正确的服务柜台。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-03-s01",
      "speaker": "Nora",
      "text": "Could I ask about a bag I left here this morning?"
    },
    {
      "id": "p01-a-03-s02",
      "speaker": "Station worker",
      "text": "Of course. What does it look like?"
    },
    {
      "id": "p01-a-03-s03",
      "speaker": "Nora",
      "text": "It's black, with a blue pocket on the front."
    },
    {
      "id": "p01-a-03-s04",
      "speaker": "Station worker",
      "text": "Where did you last have it?"
    },
    {
      "id": "p01-a-03-s05",
      "speaker": "Nora",
      "text": "In the seating area, behind the ticket machines."
    },
    {
      "id": "p01-a-03-s06",
      "speaker": "Station worker",
      "text": "A cleaner found one there. The lost-property desk is across the hall."
    },
    {
      "id": "p01-a-03-s07",
      "speaker": "Nora",
      "text": "Do I need to show anything to collect it?"
    },
    {
      "id": "p01-a-03-s08",
      "speaker": "Station worker",
      "text": "Tell them what's inside and show your ID. They'll check that it belongs to you."
    },
    {
      "id": "p01-a-03-s09",
      "speaker": "Nora",
      "text": "Thank you. I'll go there now."
    }
  ],
