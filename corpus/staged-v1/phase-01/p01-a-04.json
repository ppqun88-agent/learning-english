{
  "id": "p01-a-04",
  "title_zh": "带宝宝去参加生日聚会",
  "topic_id": "relationships",
  "scenario": {
    "id": "family-newborn-visit",
    "label_zh": "安排家庭探访",
    "goal_zh": "安排带新生儿探望亲人的日期并核对生日。"
  },
  "participants": [
    "Ella",
    "Max"
  ],
  "context_zh": "兄妹商量何时带刚出生的孩子探望姨妈，并确认生日聚会的时间。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-04-s01",
      "speaker": "Ella",
      "text": "Are we visiting our aunt in April?"
    },
    {
      "id": "p01-a-04-s02",
      "speaker": "Max",
      "text": "No, her birthday is in August. That's when she's having the party."
    },
    {
      "id": "p01-a-04-s03",
      "speaker": "Ella",
      "text": "Right. I keep mixing up her birthday and Mum's."
    },
    {
      "id": "p01-a-04-s04",
      "speaker": "Max",
      "text": "Do you want to bring the baby?"
    },
    {
      "id": "p01-a-04-s05",
      "speaker": "Ella",
      "text": "Yes. He was born just two weeks ago, so we need a quiet place to stay."
    },
    {
      "id": "p01-a-04-s06",
      "speaker": "Max",
      "text": "By August, he'll be a little older. What age will he be then?"
    },
    {
      "id": "p01-a-04-s07",
      "speaker": "Ella",
      "text": "About four months. I'll ask if we can use the spare room."
    },
    {
      "id": "p01-a-04-s08",
      "speaker": "Max",
      "text": "Good idea. We can keep the visit short if he's tired."
    }
  ],
