{
  "id": "p01-a-05",
  "title_zh": "在咖啡馆挑一份点心",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-snack-order",
    "label_zh": "询问并点购点心",
    "goal_zh": "询问甜点口味和配料，完成简餐点单。"
  },
  "participants": [
    "Customer",
    "Server"
  ],
  "context_zh": "顾客第一次来到一家咖啡馆，想选水果、饮料和一份蛋糕，并询问配料。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-05-s01",
      "speaker": "Customer",
      "text": "Is this the cafe that makes its own cake?"
    },
    {
      "id": "p01-a-05-s02",
      "speaker": "Server",
      "text": "It is. Today we have chocolate or carrot cake."
    },
    {
      "id": "p01-a-05-s03",
      "speaker": "Customer",
      "text": "Does the carrot one contain any butter?"
    },
    {
      "id": "p01-a-05-s04",
      "speaker": "Server",
      "text": "Yes. The chocolate one is made with oil instead."
    },
    {
      "id": "p01-a-05-s05",
      "speaker": "Customer",
      "text": "I'll have a slice of that and an apple, please."
    },
    {
      "id": "p01-a-05-s06",
      "speaker": "Server",
      "text": "Certainly. Would you like a drink?"
    },
    {
      "id": "p01-a-05-s07",
      "speaker": "Customer",
      "text": "A small coffee. Could you add some milk?"
    },
    {
      "id": "p01-a-05-s08",
      "speaker": "Server",
      "text": "Of course. And would you prefer a banana? The apples are quite sharp today."
    },
    {
      "id": "p01-a-05-s09",
      "speaker": "Customer",
      "text": "No, I like sharp apples. I'll keep the apple, thanks."
    },
    {
      "id": "p01-a-05-s10",
      "speaker": "Server",
      "text": "All right. Take a seat and I'll bring everything over."
    }
  ],
