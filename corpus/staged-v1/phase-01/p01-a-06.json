{
  "id": "p01-a-06",
  "title_zh": "改正多收的咖啡钱",
  "topic_id": "services",
  "scenario": {
    "id": "cafe-bill-correction",
    "label_zh": "核对并更正餐饮账单",
    "goal_zh": "发现账单错误后核实费用与付款方式。"
  },
  "participants": [
    "Customer",
    "Server"
  ],
  "context_zh": "顾客发现账单上多算了一杯咖啡，服务员核对后更正金额，双方平静地完成付款。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-06-s01",
      "speaker": "Customer",
      "text": "Excuse me, I think there's a mistake on my bill."
    },
    {
      "id": "p01-a-06-s02",
      "speaker": "Server",
      "text": "Let me see. We charged you for two coffees, but you only had one."
    },
    {
      "id": "p01-a-06-s03",
      "speaker": "Customer",
      "text": "Could you change it? I know it is only a dollar, but every cent counts."
    },
    {
      "id": "p01-a-06-s04",
      "speaker": "Server",
      "text": "Of course. The correct total is seven dollars."
    },
    {
      "id": "p01-a-06-s05",
      "speaker": "Customer",
      "text": "Thanks. I wasn't angry with you; I just couldn't get anyone's attention."
    },
    {
      "id": "p01-a-06-s06",
      "speaker": "Server",
      "text": "You shouldn't have had to wait so long for an answer. I'm sorry."
    },
    {
      "id": "p01-a-06-s07",
      "speaker": "Customer",
      "text": "Can I pay by card?"
    },
    {
      "id": "p01-a-06-s08",
      "speaker": "Server",
      "text": "Yes. Tap it here."
    },
    {
      "id": "p01-a-06-s09",
      "speaker": "Customer",
      "text": "All done. Thank you."
    }
  ],
