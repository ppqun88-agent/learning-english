{
  "id": "p01-a-07",
  "title_zh": "挑一项运动体验课",
  "topic_id": "leisure",
  "scenario": {
    "id": "sports-taster-choice",
    "label_zh": "选择社区运动课程",
    "goal_zh": "选择适合初学者的社区运动体验课并确认用品。"
  },
  "participants": [
    "Jon",
    "Coordinator"
  ],
  "context_zh": "一位成年人在社区活动日询问初学者课程，工作人员帮助他比较两种球类活动。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-07-s01",
      "speaker": "Jon",
      "text": "I'm looking for an activity for an adult who has never played team sports."
    },
    {
      "id": "p01-a-07-s02",
      "speaker": "Coordinator",
      "text": "We have beginner sessions for baseball and basketball."
    },
    {
      "id": "p01-a-07-s03",
      "speaker": "Jon",
      "text": "Could I try both sessions?"
    },
    {
      "id": "p01-a-07-s04",
      "speaker": "Coordinator",
      "text": "Yes. Baseball is in the morning, and basketball is in the afternoon."
    },
    {
      "id": "p01-a-07-s05",
      "speaker": "Jon",
      "text": "Do I need to bring a ball?"
    },
    {
      "id": "p01-a-07-s06",
      "speaker": "Coordinator",
      "text": "No, we provide the equipment. Just bring comfortable shoes and a bottle of water."
    },
    {
      "id": "p01-a-07-s07",
      "speaker": "Jon",
      "text": "Great. I'll sign up for the morning first and see how I feel."
    },
    {
      "id": "p01-a-07-s08",
      "speaker": "Coordinator",
      "text": "That works. Please arrive ten minutes early so we can introduce you to the coach."
    }
  ],
