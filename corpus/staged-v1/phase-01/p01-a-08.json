{
  "id": "p01-a-08",
  "title_zh": "为受伤的小鸟求助",
  "topic_id": "nature",
  "scenario": {
    "id": "injured-bird-help",
    "label_zh": "联系动物救助人员",
    "goal_zh": "路人发现受伤小鸟，安全求助并与救助者协调。"
  },
  "participants": [
    "Lena",
    "Mo"
  ],
  "context_zh": "两名路人在路边发现似乎受伤的小鸟；其中一人联系救助人员，另一人让行人保持距离。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-08-s01",
      "speaker": "Lena",
      "text": "There's a bird beside the path. It keeps trying to fly, but it can't."
    },
    {
      "id": "p01-a-08-s02",
      "speaker": "Mo",
      "text": "I'll phone the animal rescue centre. Is anyone already helping it?"
    },
    {
      "id": "p01-a-08-s03",
      "speaker": "Lena",
      "text": "No. It looks afraid, so I'm keeping my distance."
    },
    {
      "id": "p01-a-08-s04",
      "speaker": "Mo",
      "text": "Good. Could you ask people to stay away while I call?"
    },
    {
      "id": "p01-a-08-s05",
      "speaker": "Lena",
      "text": "Yes. Should I put it in a box?"
    },
    {
      "id": "p01-a-08-s06",
      "speaker": "Mo",
      "text": "Let's ask first. I don't want us to hurt it."
    },
    {
      "id": "p01-a-08-s07",
      "speaker": "Lena",
      "text": "All right. What did they say?"
    },
    {
      "id": "p01-a-08-s08",
      "speaker": "Mo",
      "text": "A rescuer is coming. She's got a small carrier under her arm, so we'll recognize her."
    },
    {
      "id": "p01-a-08-s09",
      "speaker": "Lena",
      "text": "Do we need to carry the bird to the entrance?"
    },
    {
      "id": "p01-a-08-s10",
      "speaker": "Mo",
      "text": "No, she said to leave it where it is. I'll meet her and bring her here."
    }
  ],
