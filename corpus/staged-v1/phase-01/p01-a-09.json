{
  "id": "p01-a-09",
  "title_zh": "交代照看猫的安排",
  "topic_id": "nature",
  "scenario": {
    "id": "cat-sitting-handover",
    "label_zh": "向朋友交接宠物照护",
    "goal_zh": "向代为照看猫的朋友说明喂养安排。"
  },
  "participants": [
    "Priya",
    "Sam"
  ],
  "context_zh": "主人离家前告诉朋友猫的日常习惯，并给出需要帮助时的联系方式。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-09-s01",
      "speaker": "Priya",
      "text": "Thanks for looking after my cat. She always waits by the kitchen door at six."
    },
    {
      "id": "p01-a-09-s02",
      "speaker": "Sam",
      "text": "Is that when I should feed her?"
    },
    {
      "id": "p01-a-09-s03",
      "speaker": "Priya",
      "text": "Yes. One pouch is enough, even if she asks for another pouch."
    },
    {
      "id": "p01-a-09-s04",
      "speaker": "Sam",
      "text": "Any other advice?"
    },
    {
      "id": "p01-a-09-s05",
      "speaker": "Priya",
      "text": "Keep the bedroom window shut. She likes climbing onto the roof."
    },
    {
      "id": "p01-a-09-s06",
      "speaker": "Sam",
      "text": "Got it. Should I call if anything seems wrong?"
    },
    {
      "id": "p01-a-09-s07",
      "speaker": "Priya",
      "text": "Please do. My number and the vet's number are on the fridge."
    },
    {
      "id": "p01-a-09-s08",
      "speaker": "Sam",
      "text": "Okay. I'll send you a photo once she's settled."
    }
  ],
