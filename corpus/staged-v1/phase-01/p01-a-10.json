{
  "id": "p01-a-10",
  "title_zh": "决定怎样游览海边",
  "topic_id": "travel",
  "scenario": {
    "id": "seaside-boat-trip",
    "label_zh": "选择海边游览方式",
    "goal_zh": "比较海边游览方式并决定是否乘船。"
  },
  "participants": [
    "Ben",
    "Aisha"
  ],
  "context_zh": "两位朋友抵达海边后讨论要不要乘观光船，其中一位容易晕船，因此两人调整了计划。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-10-s01",
      "speaker": "Ben",
      "text": "This beach is beautiful. Shall we stay here for a while?"
    },
    {
      "id": "p01-a-10-s02",
      "speaker": "Aisha",
      "text": "Yes. I came for the fresh air, not a busy schedule."
    },
    {
      "id": "p01-a-10-s03",
      "speaker": "Ben",
      "text": "There is a boat that goes around the island, though."
    },
    {
      "id": "p01-a-10-s04",
      "speaker": "Aisha",
      "text": "I'd rather not go because I get seasick."
    },
    {
      "id": "p01-a-10-s05",
      "speaker": "Ben",
      "text": "No problem. We can walk along the shore instead."
    },
    {
      "id": "p01-a-10-s06",
      "speaker": "Aisha",
      "text": "That sounds lovely. Can we get lunch before the walk?"
    },
    {
      "id": "p01-a-10-s07",
      "speaker": "Ben",
      "text": "Definitely. Let's try that little place near the harbour."
    }
  ],
