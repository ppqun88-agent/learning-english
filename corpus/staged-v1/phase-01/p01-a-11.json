{
  "id": "p01-a-11",
  "title_zh": "确定社区短剧的演员",
  "topic_id": "leisure",
  "scenario": {
    "id": "community-play-casting",
    "label_zh": "确认角色分配和排练",
    "goal_zh": "剧团根据角色要求讨论试演人选及排练时间。"
  },
  "participants": [
    "Tess",
    "Omar"
  ],
  "context_zh": "两位社区剧团组织者回顾试演表现，借助外貌描述确认人选，并安排首次排练。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-11-s01",
      "speaker": "Tess",
      "text": "Did you find an actor to play the older brother?"
    },
    {
      "id": "p01-a-11-s02",
      "speaker": "Omar",
      "text": "Yes, Leo, the blond man who read first."
    },
    {
      "id": "p01-a-11-s03",
      "speaker": "Tess",
      "text": "I liked his audition. Who will play his sister?"
    },
    {
      "id": "p01-a-11-s04",
      "speaker": "Omar",
      "text": "Nina, the actress with the blonde hair. They worked well together."
    },
    {
      "id": "p01-a-11-s05",
      "speaker": "Tess",
      "text": "And the little boy in the final scene?"
    },
    {
      "id": "p01-a-11-s06",
      "speaker": "Omar",
      "text": "Sam has that part, and his father will stay for rehearsals."
    },
    {
      "id": "p01-a-11-s07",
      "speaker": "Tess",
      "text": "Good. When do we begin?"
    },
    {
      "id": "p01-a-11-s08",
      "speaker": "Omar",
      "text": "Monday at six. I'll send the cast the schedule."
    }
  ],
