{
  "id": "p01-a-12",
  "title_zh": "把短片开头剪得更紧凑",
  "topic_id": "work",
  "scenario": {
    "id": "short-film-feedback",
    "label_zh": "根据反馈调整影片开头",
    "goal_zh": "剪辑者根据试映反馈调整短片开头。"
  },
  "participants": [
    "Alex",
    "Drew"
  ],
  "context_zh": "剪辑者请同事试看短片，同事说明注意力下降的原因，两人确定下一版的修改方向。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-12-s01",
      "speaker": "Alex",
      "text": "Does the beginning feel too slow to you?"
    },
    {
      "id": "p01-a-12-s02",
      "speaker": "Drew",
      "text": "I was bored before anyone even spoke."
    },
    {
      "id": "p01-a-12-s03",
      "speaker": "Alex",
      "text": "I worried about that. I wanted to show where the story takes place."
    },
    {
      "id": "p01-a-12-s04",
      "speaker": "Drew",
      "text": "The street shots are lovely, but five in a row become boring."
    },
    {
      "id": "p01-a-12-s05",
      "speaker": "Alex",
      "text": "So should I start with the action, when the cyclist drops the bag?"
    },
    {
      "id": "p01-a-12-s06",
      "speaker": "Drew",
      "text": "Yes. We can learn about the place while we watch him."
    },
    {
      "id": "p01-a-12-s07",
      "speaker": "Alex",
      "text": "Okay. I'll cut the first minute, then we can watch it again."
    },
    {
      "id": "p01-a-12-s08",
      "speaker": "Drew",
      "text": "Sounds good. Keep the shot of the unattended bike at the end, though."
    }
  ],
