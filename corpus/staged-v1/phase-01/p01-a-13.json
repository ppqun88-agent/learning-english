{
  "id": "p01-a-13",
  "title_zh": "为社区博客约一场艺术访谈",
  "topic_id": "work",
  "scenario": {
    "id": "artist-interview-plan",
    "label_zh": "策划艺术家采访",
    "goal_zh": "为社区博客安排艺术家访谈和作品拍摄。"
  },
  "participants": [
    "Editor",
    "Writer"
  ],
  "context_zh": "社区博客的编辑和撰稿人想报道一幅新壁画，需要确定采访内容并先获得拍摄许可。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-13-s01",
      "speaker": "Editor",
      "text": "The new mural is amazing. Do you know who painted it?"
    },
    {
      "id": "p01-a-13-s02",
      "speaker": "Writer",
      "text": "A local artist called Rosa. She lives near the school."
    },
    {
      "id": "p01-a-13-s03",
      "speaker": "Editor",
      "text": "Could you interview her for our blog?"
    },
    {
      "id": "p01-a-13-s04",
      "speaker": "Writer",
      "text": "Yes. Should the article focus on the mural or her life?"
    },
    {
      "id": "p01-a-13-s05",
      "speaker": "Editor",
      "text": "Start with the mural. I want readers who know nothing about art to feel welcome."
    },
    {
      "id": "p01-a-13-s06",
      "speaker": "Writer",
      "text": "Can I take a camera, or does she prefer not to be photographed?"
    },
    {
      "id": "p01-a-13-s07",
      "speaker": "Editor",
      "text": "Ask her when you arrange the interview. We can use a photo of the wall if she doesn't want to appear."
    },
    {
      "id": "p01-a-13-s08",
      "speaker": "Writer",
      "text": "Good idea. I'll contact her today and send you an outline once she replies."
    }
  ],
