{
  "id": "p01-a-14",
  "title_zh": "先了解烘焙工作再转行",
  "topic_id": "work",
  "scenario": {
    "id": "career-change-discussion",
    "label_zh": "讨论职业方向",
    "goal_zh": "讨论转行念头并确定低风险了解行业的下一步。"
  },
  "participants": [
    "Jess",
    "Mina"
  ],
  "context_zh": "杰丝想从办公室工作转向烘焙，朋友帮她区分职业兴趣和经营店铺的责任。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-14-s01",
      "speaker": "Jess",
      "text": "I keep thinking about a career in baking."
    },
    {
      "id": "p01-a-14-s02",
      "speaker": "Mina",
      "text": "What attracts you to it?"
    },
    {
      "id": "p01-a-14-s03",
      "speaker": "Jess",
      "text": "I work as an office assistant, and I miss making things with my hands."
    },
    {
      "id": "p01-a-14-s04",
      "speaker": "Mina",
      "text": "Do you want to become a baker, or open your own business?"
    },
    {
      "id": "p01-a-14-s05",
      "speaker": "Jess",
      "text": "The first one, at least for now. I don't want to be a manager."
    },
    {
      "id": "p01-a-14-s06",
      "speaker": "Mina",
      "text": "Then perhaps talk to someone who does the job before you leave your current one."
    },
    {
      "id": "p01-a-14-s07",
      "speaker": "Jess",
      "text": "Do you really believe I could make the change?"
    },
    {
      "id": "p01-a-14-s08",
      "speaker": "Mina",
      "text": "I do, but let's find out what the training and working hours are like."
    },
    {
      "id": "p01-a-14-s09",
      "speaker": "Jess",
      "text": "Fair enough. I'll ask the bakery near my office if someone has time for a chat."
    }
  ],
