{
  "id": "p01-a-15",
  "title_zh": "约好一起听现场音乐",
  "topic_id": "leisure",
  "scenario": {
    "id": "live-music-evening",
    "label_zh": "安排现场音乐之夜",
    "goal_zh": "朋友相约听现场音乐并核对场地与购买专辑安排。"
  },
  "participants": [
    "Finn",
    "Ruby"
  ],
  "context_zh": "两位朋友商量去酒吧听一支喜欢的乐队，也确认同行的人、饮品和买唱片的安排。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-15-s01",
      "speaker": "Finn",
      "text": "Our favourite band is playing at the Lantern on Friday."
    },
    {
      "id": "p01-a-15-s02",
      "speaker": "Ruby",
      "text": "Is that the bar near the station?"
    },
    {
      "id": "p01-a-15-s03",
      "speaker": "Finn",
      "text": "Yes. I've heard the sound is awesome since they changed the speakers."
    },
    {
      "id": "p01-a-15-s04",
      "speaker": "Ruby",
      "text": "Can I bring my boyfriend? He likes their music too."
    },
    {
      "id": "p01-a-15-s05",
      "speaker": "Finn",
      "text": "Of course. Does he drink beer? They have a new local one."
    },
    {
      "id": "p01-a-15-s06",
      "speaker": "Ruby",
      "text": "He does, but I'm driving. I'll have something without alcohol."
    },
    {
      "id": "p01-a-15-s07",
      "speaker": "Finn",
      "text": "No problem. They also sell soft drinks."
    },
    {
      "id": "p01-a-15-s08",
      "speaker": "Ruby",
      "text": "Are they selling the new CD at the show?"
    },
    {
      "id": "p01-a-15-s09",
      "speaker": "Finn",
      "text": "I think so, but I'll check with the venue. Shall we meet outside at seven?"
    },
    {
      "id": "p01-a-15-s10",
      "speaker": "Ruby",
      "text": "Seven works. See you there."
    }
  ],
