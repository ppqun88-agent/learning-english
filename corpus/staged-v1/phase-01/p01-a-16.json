{
  "id": "p01-a-16",
  "title_zh": "修好异响的自行车",
  "topic_id": "services",
  "scenario": {
    "id": "bicycle-repair-estimate",
    "label_zh": "询问自行车维修安排",
    "goal_zh": "检查车况、讨论维修必要性并确认取车时间。"
  },
  "participants": [
    "Owner",
    "Mechanic"
  ],
  "context_zh": "车主担心前轮异响意味着昂贵维修，技师检查后说明处理办法，并与车主约好取车时间。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-16-s01",
      "speaker": "Owner",
      "text": "Can you look at my bicycle? The front wheel makes a strange noise."
    },
    {
      "id": "p01-a-16-s02",
      "speaker": "Mechanic",
      "text": "Sure. Bring the bike over here."
    },
    {
      "id": "p01-a-16-s03",
      "speaker": "Owner",
      "text": "Is it bad?"
    },
    {
      "id": "p01-a-16-s04",
      "speaker": "Mechanic",
      "text": "The wheel is loose. An adjustment is a better option than a new wheel."
    },
    {
      "id": "p01-a-16-s05",
      "speaker": "Owner",
      "text": "How long will it take?"
    },
    {
      "id": "p01-a-16-s06",
      "speaker": "Mechanic",
      "text": "About half an hour, but I'm about to take my lunch break."
    },
    {
      "id": "p01-a-16-s07",
      "speaker": "Owner",
      "text": "That's fine. Can I come back at two?"
    },
    {
      "id": "p01-a-16-s08",
      "speaker": "Mechanic",
      "text": "Yes. I'll check the brakes as well and have it ready then."
    }
  ],
