{
  "id": "p01-a-17",
  "title_zh": "给活动室留下足够空间",
  "topic_id": "community",
  "scenario": {
    "id": "community-room-furniture",
    "label_zh": "安排共享活动室的家具",
    "goal_zh": "讨论社区活动室家具尺寸和使用需要。"
  },
  "participants": [
    "Dev",
    "Ruth"
  ],
  "context_zh": "社区中心的两位志愿者讨论添置座椅，但必须兼顾舞蹈课的活动空间。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-17-s01",
      "speaker": "Dev",
      "text": "Can we build a bench along this wall?"
    },
    {
      "id": "p01-a-17-s02",
      "speaker": "Ruth",
      "text": "Maybe, but the dance class needs floor space."
    },
    {
      "id": "p01-a-17-s03",
      "speaker": "Dev",
      "text": "This building has three other rooms. Could they use one?"
    },
    {
      "id": "p01-a-17-s04",
      "speaker": "Ruth",
      "text": "All three rooms are booked in the evenings."
    },
    {
      "id": "p01-a-17-s05",
      "speaker": "Dev",
      "text": "Then let's use a folding chair for each person instead of a fixed bench."
    },
    {
      "id": "p01-a-17-s06",
      "speaker": "Ruth",
      "text": "Good. Leave the center of the room clear."
    },
    {
      "id": "p01-a-17-s07",
      "speaker": "Dev",
      "text": "How much space does each dancer need?"
    },
    {
      "id": "p01-a-17-s08",
      "speaker": "Ruth",
      "text": "Enough to turn their body without hitting anyone. Let's ask the teacher to test the layout."
    },
    {
      "id": "p01-a-17-s09",
      "speaker": "Dev",
      "text": "I agree. We shouldn't order furniture until she's checked it."
    }
  ],
