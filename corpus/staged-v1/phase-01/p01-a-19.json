{
  "id": "p01-a-19",
  "title_zh": "挑一个都能出门的周末",
  "topic_id": "travel",
  "scenario": {
    "id": "autumn-day-trip-date",
    "label_zh": "协调秋季一日游日期",
    "goal_zh": "在工作安排限制下确定秋季一日游的日期。"
  },
  "participants": [
    "Hugo",
    "Mei"
  ],
  "context_zh": "两位朋友计划秋天去山里走走，其中一人周末常要工作，因此先约定一个有空的星期日。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-19-s01",
      "speaker": "Hugo",
      "text": "What about a day in the hills this autumn?"
    },
    {
      "id": "p01-a-19-s02",
      "speaker": "Mei",
      "text": "I'd love that, but September is very busy at work."
    },
    {
      "id": "p01-a-19-s03",
      "speaker": "Hugo",
      "text": "Would October be better?"
    },
    {
      "id": "p01-a-19-s04",
      "speaker": "Mei",
      "text": "Yes. Any time after the tenth should work."
    },
    {
      "id": "p01-a-19-s05",
      "speaker": "Hugo",
      "text": "Saturday the seventeenth?"
    },
    {
      "id": "p01-a-19-s06",
      "speaker": "Mei",
      "text": "I cannot do Saturdays. Sunday is the best day for me."
    },
    {
      "id": "p01-a-19-s07",
      "speaker": "Hugo",
      "text": "Then let's keep the eighteenth free and check the weather nearer the time."
    },
    {
      "id": "p01-a-19-s08",
      "speaker": "Mei",
      "text": "Perfect. I'll put it in my calendar."
    }
  ],
