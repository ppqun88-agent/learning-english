{
  "id": "p01-a-20",
  "title_zh": "试穿一双徒步靴",
  "topic_id": "services",
  "scenario": {
    "id": "walking-boot-fitting",
    "label_zh": "判断鞋子尺寸并购买",
    "goal_zh": "试穿徒步靴并判断尺寸及是否购买。"
  },
  "participants": [
    "Customer",
    "Shop assistant"
  ],
  "context_zh": "顾客想买棕色徒步靴，但一只鞋的脚跟处偏松，店员让她比较小半码的鞋。",
  "author": "author-phase01-a",
  "sentences": [
    {
      "id": "p01-a-20-s01",
      "speaker": "Customer",
      "text": "Do you have a brown pair in this style?"
    },
    {
      "id": "p01-a-20-s02",
      "speaker": "Shop assistant",
      "text": "Yes. Try this pair."
    },
    {
      "id": "p01-a-20-s03",
      "speaker": "Customer",
      "text": "The left boot feels fine, but the right one is too big."
    },
    {
      "id": "p01-a-20-s04",
      "speaker": "Shop assistant",
      "text": "Is your heel moving when you walk?"
    },
    {
      "id": "p01-a-20-s05",
      "speaker": "Customer",
      "text": "Yes, quite a lot."
    },
    {
      "id": "p01-a-20-s06",
      "speaker": "Shop assistant",
      "text": "Let's try half a size smaller. Walk to the mirror and back so you can compare."
    },
    {
      "id": "p01-a-20-s07",
      "speaker": "Customer",
      "text": "These feel much more secure. I think I will buy them."
    },
    {
      "id": "p01-a-20-s08",
      "speaker": "Shop assistant",
      "text": "Great. I'll bring the box to the till."
    }
  ],
