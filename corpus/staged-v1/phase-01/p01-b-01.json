{
  "id": "p01-b-01",
  "title_zh": "一起准备六人晚餐",
  "topic_id": "food",
  "scenario": {
    "id": "shared-dinner-preparation",
    "label_zh": "分工准备晚饭",
    "goal_zh": "商定晚餐分工、菜品和份量"
  },
  "participants": [
    "Maya",
    "Jon"
  ],
  "context_zh": "两位室友在客人到来前准备晚餐，其中一位客人不吃肉。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-01-s01",
      "speaker": "Maya",
      "text": "There are six of us for dinner. I cannot do all the cooking on my own."
    },
    {
      "id": "p01-b-01-s02",
      "speaker": "Jon",
      "text": "I will help. Where should I start?"
    },
    {
      "id": "p01-b-01-s03",
      "speaker": "Maya",
      "text": "Please cut these tomatoes while I cook the chicken."
    },
    {
      "id": "p01-b-01-s04",
      "speaker": "Jon",
      "text": "Sure. Are we serving it with rice?"
    },
    {
      "id": "p01-b-01-s05",
      "speaker": "Maya",
      "text": "Yes, and this vegetable dish is for Sam. He does not eat meat."
    },
    {
      "id": "p01-b-01-s06",
      "speaker": "Jon",
      "text": "It smells delicious. Does it need anything on top?"
    },
    {
      "id": "p01-b-01-s07",
      "speaker": "Maya",
      "text": "A little cheese. There is some in the fridge."
    },
    {
      "id": "p01-b-01-s08",
      "speaker": "Jon",
      "text": "Do we have enough food for six people?"
    },
    {
      "id": "p01-b-01-s09",
      "speaker": "Maya",
      "text": "With the rice and salad, yes. Thanks for helping. I will put the plates out."
    }
  ],
