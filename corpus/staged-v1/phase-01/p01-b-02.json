{
  "id": "p01-b-02",
  "title_zh": "在咖啡馆换一个座位",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-drink-correction",
    "label_zh": "点餐并调整座位",
    "goal_zh": "选好餐点并找到不受冷风影响的座位"
  },
  "participants": [
    "Nora",
    "Eli"
  ],
  "context_zh": "客人想在咖啡馆坐一会儿，点餐时发现门边的座位太冷。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-02-s01",
      "speaker": "Nora",
      "text": "I would like a coffee and something small to eat."
    },
    {
      "id": "p01-b-02-s02",
      "speaker": "Eli",
      "text": "The chocolate cake is fresh. Would you like a slice?"
    },
    {
      "id": "p01-b-02-s03",
      "speaker": "Nora",
      "text": "Yes, without cream, please. And could I have a proper cup? I am staying here."
    },
    {
      "id": "p01-b-02-s04",
      "speaker": "Eli",
      "text": "Of course. Anything else?"
    },
    {
      "id": "p01-b-02-s05",
      "speaker": "Nora",
      "text": "Just a glass of water. It is rather cold by the door. May I move to that table?"
    },
    {
      "id": "p01-b-02-s06",
      "speaker": "Eli",
      "text": "Certainly. The customer who was sitting there has left. I will wipe it for you."
    },
    {
      "id": "p01-b-02-s07",
      "speaker": "Nora",
      "text": "Thanks. I was hoping to sit and read while I drink my coffee."
    },
    {
      "id": "p01-b-02-s08",
      "speaker": "Eli",
      "text": "That table is ready now. I will bring everything over."
    }
  ],
