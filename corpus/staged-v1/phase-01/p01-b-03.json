{
  "id": "p01-b-03",
  "title_zh": "选择晚间摄影课",
  "topic_id": "learning",
  "scenario": {
    "id": "evening-course-enrolment",
    "label_zh": "选择并报名晚间课程",
    "goal_zh": "核对开课时间和难度后提交报名表"
  },
  "participants": [
    "Priya",
    "Ben"
  ],
  "context_zh": "一位白天上班的人到学院咨询适合初学者的晚间摄影课程。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-03-s01",
      "speaker": "Priya",
      "text": "Does the college offer a photography course in the evening? I work until five."
    },
    {
      "id": "p01-b-03-s02",
      "speaker": "Ben",
      "text": "Yes. A new class starts in February, on Tuesday evenings."
    },
    {
      "id": "p01-b-03-s03",
      "speaker": "Priya",
      "text": "Would it be difficult for someone who only uses a phone camera?"
    },
    {
      "id": "p01-b-03-s04",
      "speaker": "Ben",
      "text": "No. You can use a phone for the first few weeks. The teacher starts with easy tasks, like taking a clear photo of a cup."
    },
    {
      "id": "p01-b-03-s05",
      "speaker": "Priya",
      "text": "That sounds right for me. How do I sign up?"
    },
    {
      "id": "p01-b-03-s06",
      "speaker": "Ben",
      "text": "Please complete this form. We will email you the room number before the first lesson."
    },
    {
      "id": "p01-b-03-s07",
      "speaker": "Priya",
      "text": "Great. I will fill it in now."
    }
  ],
