{
  "id": "p01-b-04",
  "title_zh": "先理解口语练习",
  "topic_id": "learning",
  "scenario": {
    "id": "classroom-speaking-practice",
    "label_zh": "澄清课堂练习要求",
    "goal_zh": "理解口语任务并开始一段有实际目的的练习"
  },
  "participants": [
    "Lina",
    "Omar"
  ],
  "context_zh": "社区英语课上，一名学生不清楚如何开始口语练习，老师示范任务而不要求背稿。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-04-s01",
      "speaker": "Lina",
      "text": "Before we start, please move your desk next to a partner. We need space in the middle of the classroom."
    },
    {
      "id": "p01-b-04-s02",
      "speaker": "Omar",
      "text": "What should we do with this picture?"
    },
    {
      "id": "p01-b-04-s03",
      "speaker": "Lina",
      "text": "Use it to start a conversation. One person has lost a bag, and the other works at the station."
    },
    {
      "id": "p01-b-04-s04",
      "speaker": "Omar",
      "text": "So we write a dialogue first?"
    },
    {
      "id": "p01-b-04-s05",
      "speaker": "Lina",
      "text": "No, try speaking first. You can describe the bag without knowing every word."
    },
    {
      "id": "p01-b-04-s06",
      "speaker": "Omar",
      "text": "Can you give us an example?"
    },
    {
      "id": "p01-b-04-s07",
      "speaker": "Lina",
      "text": "You could say, \"My bag is small and blue.\" Then explain where you last saw it."
    },
    {
      "id": "p01-b-04-s08",
      "speaker": "Omar",
      "text": "That helps. I will put my dictionary away and try asking my partner."
    }
  ],
