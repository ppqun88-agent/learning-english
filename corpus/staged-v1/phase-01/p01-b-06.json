{
  "id": "p01-b-06",
  "title_zh": "为冬季婚礼选外套",
  "topic_id": "services",
  "scenario": {
    "id": "winter-clothes-selection",
    "label_zh": "购买合适的冬装",
    "goal_zh": "在保暖、搭配和价格之间选定一件外套"
  },
  "participants": [
    "Hannah",
    "Grace"
  ],
  "context_zh": "顾客参加冬季婚礼，需要一件能穿在礼服外面的暖外套。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-06-s01",
      "speaker": "Hannah",
      "text": "I need some warm clothes for a winter wedding. This dress is lovely, but it is very thin."
    },
    {
      "id": "p01-b-06-s02",
      "speaker": "Grace",
      "text": "A long coat would work over it. What colour would you like?"
    },
    {
      "id": "p01-b-06-s03",
      "speaker": "Hannah",
      "text": "Something dark. I like this blue one, but it is too expensive for me."
    },
    {
      "id": "p01-b-06-s04",
      "speaker": "Grace",
      "text": "The grey one beside it is in the sale."
    },
    {
      "id": "p01-b-06-s05",
      "speaker": "Hannah",
      "text": "Why is it so cheap? Is there something wrong with it?"
    },
    {
      "id": "p01-b-06-s06",
      "speaker": "Grace",
      "text": "No, it is last winter's style. Try it on and see how it fits over your dress."
    },
    {
      "id": "p01-b-06-s07",
      "speaker": "Hannah",
      "text": "There is plenty of room, and it feels warm. I will choose this one."
    }
  ],
