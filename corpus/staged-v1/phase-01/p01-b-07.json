{
  "id": "p01-b-07",
  "title_zh": "把标志做得容易辨认",
  "topic_id": "work",
  "scenario": {
    "id": "small-company-logo-revision",
    "label_zh": "修改小公司标志",
    "goal_zh": "澄清图案和颜色需求并约定提供可比较的草图"
  },
  "participants": [
    "Alex",
    "Jules"
  ],
  "context_zh": "自行车维修公司的负责人查看设计师的标志草图，希望缩小后仍然清楚。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-07-s01",
      "speaker": "Alex",
      "text": "Can we look at the logo on your computer? It is hard to see on my phone."
    },
    {
      "id": "p01-b-07-s02",
      "speaker": "Jules",
      "text": "Sure. Here is the larger version."
    },
    {
      "id": "p01-b-07-s03",
      "speaker": "Alex",
      "text": "I like the shape, but there is too much detail inside the wheel."
    },
    {
      "id": "p01-b-07-s04",
      "speaker": "Jules",
      "text": "I can draw a simpler wheel. Do you want to keep the green?"
    },
    {
      "id": "p01-b-07-s05",
      "speaker": "Alex",
      "text": "Yes. That color is already on our vans. The company name needs to be easier to read, though."
    },
    {
      "id": "p01-b-07-s06",
      "speaker": "Jules",
      "text": "Your original description asked for the name inside the wheel. Would you be happy with it underneath?"
    },
    {
      "id": "p01-b-07-s07",
      "speaker": "Alex",
      "text": "Yes, if that makes it clearer on a small label."
    },
    {
      "id": "p01-b-07-s08",
      "speaker": "Jules",
      "text": "Then I will create two versions, with the name underneath in different sizes. You can compare them tomorrow."
    },
    {
      "id": "p01-b-07-s09",
      "speaker": "Alex",
      "text": "Perfect. Please show both at label size as well as full size."
    }
  ],
