{
  "id": "p01-b-08",
  "title_zh": "今晚在家看哪部电影",
  "topic_id": "leisure",
  "scenario": {
    "id": "home-film-choice",
    "label_zh": "商量在家看电影",
    "goal_zh": "在不出门的前提下选定双方都想看的影片"
  },
  "participants": [
    "Jamie",
    "Casey"
  ],
  "context_zh": "两位室友下班后都不想出门，打算从家里的影碟中选一部电影。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-08-s01",
      "speaker": "Jamie",
      "text": "Do you still want to go to the cinema this evening?"
    },
    {
      "id": "p01-b-08-s02",
      "speaker": "Casey",
      "text": "Honestly, I would rather stay home. I have been out all day."
    },
    {
      "id": "p01-b-08-s03",
      "speaker": "Jamie",
      "text": "Same here. We could watch a DVD. I still have that old comedy you like."
    },
    {
      "id": "p01-b-08-s04",
      "speaker": "Casey",
      "text": "My favorite! But you have seen it twice. Would you enjoy it again?"
    },
    {
      "id": "p01-b-08-s05",
      "speaker": "Jamie",
      "text": "Yes, especially the train scene. That is easy to decide, then. I will get the player ready."
    },
    {
      "id": "p01-b-08-s06",
      "speaker": "Casey",
      "text": "And I will make the popcorn."
    }
  ],
