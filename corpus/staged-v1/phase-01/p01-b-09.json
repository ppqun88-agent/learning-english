{
  "id": "p01-b-09",
  "title_zh": "为社区音乐会摆座位",
  "topic_id": "leisure",
  "scenario": {
    "id": "community-concert-seating",
    "label_zh": "安排音乐会座位和散场",
    "goal_zh": "核对座位布置、观众人数和活动后的收尾职责"
  },
  "participants": [
    "Tessa",
    "Mo"
  ],
  "context_zh": "两位志愿者在社区音乐会开始前检查座位安排。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-09-s01",
      "speaker": "Tessa",
      "text": "We have sold eighty tickets for the concert. Have we put out enough chairs?"
    },
    {
      "id": "p01-b-09-s02",
      "speaker": "Mo",
      "text": "Yes, but we cannot use this plan. It blocks the side exit."
    },
    {
      "id": "p01-b-09-s03",
      "speaker": "Tessa",
      "text": "Could we take one chair out of each row and add a row at the back?"
    },
    {
      "id": "p01-b-09-s04",
      "speaker": "Mo",
      "text": "That should leave the side clear. I will measure the space before we move anything."
    },
    {
      "id": "p01-b-09-s05",
      "speaker": "Tessa",
      "text": "Good. We need a clear path from every seat."
    },
    {
      "id": "p01-b-09-s06",
      "speaker": "Mo",
      "text": "Where will the volunteers sit?"
    },
    {
      "id": "p01-b-09-s07",
      "speaker": "Tessa",
      "text": "There are four extra chairs by the sound desk. Everybody helping tonight is on this list."
    },
    {
      "id": "p01-b-09-s08",
      "speaker": "Mo",
      "text": "All right. And when does the event end? We need time to stack the chairs."
    },
    {
      "id": "p01-b-09-s09",
      "speaker": "Tessa",
      "text": "The music finishes at nine. The hall is ours until ten, so we have an hour to clear up."
    },
    {
      "id": "p01-b-09-s10",
      "speaker": "Mo",
      "text": "That works. I will start by checking the back row."
    }
  ],
