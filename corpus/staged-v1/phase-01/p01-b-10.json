{
  "id": "p01-b-10",
  "title_zh": "没有经验也能来跳舞",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-dance-enrolment",
    "label_zh": "报名舞蹈社团体验课",
    "goal_zh": "确认零基础参加者可以独自参加并约好首次到场时间"
  },
  "participants": [
    "Sophie",
    "Luis"
  ],
  "context_zh": "初学者向舞蹈社团的联系人询问，担心自己没有搭档也没有经验。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-10-s01",
      "speaker": "Sophie",
      "text": "Is your club open to complete beginners?"
    },
    {
      "id": "p01-b-10-s02",
      "speaker": "Luis",
      "text": "Absolutely. Have you ever tried salsa?"
    },
    {
      "id": "p01-b-10-s03",
      "speaker": "Sophie",
      "text": "No. I like watching dancing, but I have never learned to dance myself."
    },
    {
      "id": "p01-b-10-s04",
      "speaker": "Luis",
      "text": "You do not need to be an experienced dancer. We start with a few steps, and you can join without a partner."
    },
    {
      "id": "p01-b-10-s05",
      "speaker": "Sophie",
      "text": "That sounds exciting. I was worried everyone would already know what to do."
    },
    {
      "id": "p01-b-10-s06",
      "speaker": "Luis",
      "text": "The first half hour is just for beginners. Come at seven and I will introduce you to the teacher."
    },
    {
      "id": "p01-b-10-s07",
      "speaker": "Sophie",
      "text": "Thanks. I am actually excited now. See you on Thursday."
    }
  ],
