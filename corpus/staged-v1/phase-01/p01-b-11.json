{
  "id": "p01-b-11",
  "title_zh": "准时到医院的路线",
  "topic_id": "travel",
  "scenario": {
    "id": "hospital-journey-route",
    "label_zh": "询问医院交通路线",
    "goal_zh": "比较开车与公交并确认下车位置"
  },
  "participants": [
    "Asha",
    "Rob"
  ],
  "context_zh": "酒店客人要去市医院探望亲属，向熟悉当地路线的工作人员问路。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-11-s01",
      "speaker": "Asha",
      "text": "How far is the hospital from here? I need to be there by nine."
    },
    {
      "id": "p01-b-11-s02",
      "speaker": "Rob",
      "text": "It is on the other side of the city. Were you planning to drive?"
    },
    {
      "id": "p01-b-11-s03",
      "speaker": "Asha",
      "text": "I could, but I would rather avoid the morning traffic."
    },
    {
      "id": "p01-b-11-s04",
      "speaker": "Rob",
      "text": "The number eleven bus has its own lane for most of the way. It is usually a fast trip."
    },
    {
      "id": "p01-b-11-s05",
      "speaker": "Asha",
      "text": "Where do I catch it?"
    },
    {
      "id": "p01-b-11-s06",
      "speaker": "Rob",
      "text": "Walk down this road to the library. The stop is just outside, on this side."
    },
    {
      "id": "p01-b-11-s07",
      "speaker": "Asha",
      "text": "Does it stop at the main hospital entrance?"
    },
    {
      "id": "p01-b-11-s08",
      "speaker": "Rob",
      "text": "No, at the east entrance. From there, follow the signs to reception."
    },
    {
      "id": "p01-b-11-s09",
      "speaker": "Asha",
      "text": "Thanks. I will leave early so I have time to find the right building."
    }
  ],
