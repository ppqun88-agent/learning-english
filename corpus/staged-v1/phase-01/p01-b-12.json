{
  "id": "p01-b-12",
  "title_zh": "带狗参观农场的规则",
  "topic_id": "nature",
  "scenario": {
    "id": "farm-visit-animal-rules",
    "label_zh": "核对农场参观规则",
    "goal_zh": "确认宠物限制并了解观赏牲畜的位置"
  },
  "participants": [
    "Nadia",
    "Gareth"
  ],
  "context_zh": "游客带着狗来到乡间农场的接待处，入场前询问规则。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-12-s01",
      "speaker": "Nadia",
      "text": "We are staying in the country this week. Is your farm open to visitors today?"
    },
    {
      "id": "p01-b-12-s02",
      "speaker": "Gareth",
      "text": "Yes. I am the farmer here. The marked path takes you past the animals and back to the shop."
    },
    {
      "id": "p01-b-12-s03",
      "speaker": "Nadia",
      "text": "Can our dog come with us? He is on a lead."
    },
    {
      "id": "p01-b-12-s04",
      "speaker": "Gareth",
      "text": "Not into the animal fields, please. You can take turns visiting while one of you stays with him by the shop."
    },
    {
      "id": "p01-b-12-s05",
      "speaker": "Nadia",
      "text": "Is it dangerous to walk near the cattle?"
    },
    {
      "id": "p01-b-12-s06",
      "speaker": "Gareth",
      "text": "Stay on the marked path and keep the gates shut. That cow by the fence has a young calf, so give her space."
    },
    {
      "id": "p01-b-12-s07",
      "speaker": "Nadia",
      "text": "Understood. I will stay here with the dog first, and my partner can follow the path."
    }
  ],
