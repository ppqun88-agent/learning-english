{
  "id": "p01-b-13",
  "title_zh": "把家庭聚餐安排早一点",
  "topic_id": "relationships",
  "scenario": {
    "id": "winter-family-meeting",
    "label_zh": "协调冬季家庭聚餐",
    "goal_zh": "商定聚餐日期、用餐时间及长辈接送"
  },
  "participants": [
    "Leah",
    "Tom"
  ],
  "context_zh": "一对伴侣为十二月的家庭聚餐协调一位亲属带孩子来访以及长辈的交通。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-13-s01",
      "speaker": "Leah",
      "text": "When should we get the family together for a meal in December?"
    },
    {
      "id": "p01-b-13-s02",
      "speaker": "Tom",
      "text": "My cousin Mia can come on the tenth, but she needs to leave by eight."
    },
    {
      "id": "p01-b-13-s03",
      "speaker": "Leah",
      "text": "Is she bringing her daughter?"
    },
    {
      "id": "p01-b-13-s04",
      "speaker": "Tom",
      "text": "Yes. She will be the only child here, so let us eat early and keep the meal short."
    },
    {
      "id": "p01-b-13-s05",
      "speaker": "Leah",
      "text": "What about your father? He does not like driving after dark."
    },
    {
      "id": "p01-b-13-s06",
      "speaker": "Tom",
      "text": "My dad can stay with us. I will collect him in the afternoon."
    },
    {
      "id": "p01-b-13-s07",
      "speaker": "Leah",
      "text": "Then I will tell Mia we are eating at five."
    },
    {
      "id": "p01-b-13-s08",
      "speaker": "Tom",
      "text": "Great. I will get the spare room ready that morning."
    }
  ],
