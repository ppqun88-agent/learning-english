{
  "id": "p01-b-14",
  "title_zh": "客人来之前收拾房间",
  "topic_id": "home",
  "scenario": {
    "id": "shared-house-cleanup",
    "label_zh": "分配合租房清洁工作",
    "goal_zh": "明确待清洁区域和离开房间前的操作"
  },
  "participants": [
    "Eva",
    "Noah"
  ],
  "context_zh": "室友准备招待来访者，需要在有限时间里清理共用空间。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-14-s01",
      "speaker": "Eva",
      "text": "I have been out all day. What still needs doing before the guests arrive?"
    },
    {
      "id": "p01-b-14-s02",
      "speaker": "Noah",
      "text": "The kitchen is ready, but the hall is dirty. I spilled some soil while moving the plants."
    },
    {
      "id": "p01-b-14-s03",
      "speaker": "Eva",
      "text": "I can clean that. Have we got time?"
    },
    {
      "id": "p01-b-14-s04",
      "speaker": "Noah",
      "text": "Yes. The clock in the hall is twenty minutes fast. It is only half past four."
    },
    {
      "id": "p01-b-14-s05",
      "speaker": "Eva",
      "text": "Good. I will get the brush from downstairs."
    },
    {
      "id": "p01-b-14-s06",
      "speaker": "Noah",
      "text": "Thanks. Please close the cupboard door when you finish. The cat keeps getting inside."
    },
    {
      "id": "p01-b-14-s07",
      "speaker": "Eva",
      "text": "Will do. Is everything else ready?"
    },
    {
      "id": "p01-b-14-s08",
      "speaker": "Noah",
      "text": "Almost. You do the hall, and I will put fresh towels in the bathroom."
    }
  ],
