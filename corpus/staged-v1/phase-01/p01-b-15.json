{
  "id": "p01-b-15",
  "title_zh": "预约查看皮肤干斑",
  "topic_id": "health",
  "scenario": {
    "id": "routine-clinic-booking",
    "label_zh": "描述问题并预约就诊",
    "goal_zh": "准确说明不适位置并确认预约时间"
  },
  "participants": [
    "Mei",
    "Dylan"
  ],
  "context_zh": "来电者想让医生查看脸上一块持续数周的干燥皮肤；接待员只登记和安排时间。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-15-s01",
      "speaker": "Mei",
      "text": "I would like to see a doctor about a dry patch on my face."
    },
    {
      "id": "p01-b-15-s02",
      "speaker": "Dylan",
      "text": "Where exactly is the patch? I will put that in the booking notes."
    },
    {
      "id": "p01-b-15-s03",
      "speaker": "Mei",
      "text": "Beside my left ear, not near my eye. I feel fine otherwise, but it has been there for a few weeks."
    },
    {
      "id": "p01-b-15-s04",
      "speaker": "Dylan",
      "text": "Thank you. There is an appointment tomorrow at ten. Would that suit you?"
    },
    {
      "id": "p01-b-15-s05",
      "speaker": "Mei",
      "text": "Yes, I can be there then."
    },
    {
      "id": "p01-b-15-s06",
      "speaker": "Dylan",
      "text": "You are booked in. Please arrive a few minutes before ten."
    }
  ],
