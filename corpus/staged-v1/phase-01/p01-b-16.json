{
  "id": "p01-b-16",
  "title_zh": "天黑前不走湿滑的台阶",
  "topic_id": "leisure",
  "scenario": {
    "id": "hill-walk-route-choice",
    "label_zh": "调整山间步行路线",
    "goal_zh": "考虑天色和路面条件后改走短路线"
  },
  "participants": [
    "Finn",
    "Iris"
  ],
  "context_zh": "两位朋友下午散步，原计划登上山顶的旧塔，但时间和路况不合适。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-16-s01",
      "speaker": "Finn",
      "text": "Shall we climb up to the old tower? The view should be lovely."
    },
    {
      "id": "p01-b-16-s02",
      "speaker": "Iris",
      "text": "It will be dark in an hour. I do not want to come back down those steps without a light."
    },
    {
      "id": "p01-b-16-s03",
      "speaker": "Finn",
      "text": "They look wet, too. It rained during lunch."
    },
    {
      "id": "p01-b-16-s04",
      "speaker": "Iris",
      "text": "Exactly. I would rather miss the view than fall on the way down."
    },
    {
      "id": "p01-b-16-s05",
      "speaker": "Finn",
      "text": "It is getting cool as well. Let us take the short path back and come earlier another day."
    },
    {
      "id": "p01-b-16-s06",
      "speaker": "Iris",
      "text": "Agreed. We can still get a cup of tea before the cafe shuts."
    }
  ],
