{
  "id": "p01-b-17",
  "title_zh": "确认价格标签的币种",
  "topic_id": "services",
  "scenario": {
    "id": "souvenir-price-currency",
    "label_zh": "核对纪念品价格和币种",
    "goal_zh": "看懂手写价签后确定付款方式"
  },
  "participants": [
    "Zoe",
    "Marco"
  ],
  "context_zh": "游客在纪念品商店询问一本笔记本的价格，手写货币符号不够清楚。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-17-s01",
      "speaker": "Zoe",
      "text": "How much does this notebook cost? I cannot quite read the label."
    },
    {
      "id": "p01-b-17-s02",
      "speaker": "Marco",
      "text": "It is eighteen euros."
    },
    {
      "id": "p01-b-17-s03",
      "speaker": "Zoe",
      "text": "Oh, is that a euro sign? I thought it was a dollar sign."
    },
    {
      "id": "p01-b-17-s04",
      "speaker": "Marco",
      "text": "Yes, sorry about the handwriting. All our prices are in euros."
    },
    {
      "id": "p01-b-17-s05",
      "speaker": "Zoe",
      "text": "I only have dollars in cash. Can I pay by card?"
    },
    {
      "id": "p01-b-17-s06",
      "speaker": "Marco",
      "text": "Certainly. I can take your payment here."
    },
    {
      "id": "p01-b-17-s07",
      "speaker": "Zoe",
      "text": "Great, I will take the notebook."
    }
  ],
