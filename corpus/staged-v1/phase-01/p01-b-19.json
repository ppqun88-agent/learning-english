{
  "id": "p01-b-19",
  "title_zh": "用四十分钟看一个展厅",
  "topic_id": "leisure",
  "scenario": {
    "id": "short-museum-visit",
    "label_zh": "选择短时间博物馆参观路线",
    "goal_zh": "根据时间和孩子的学习兴趣选定一个展厅"
  },
  "participants": [
    "Beth",
    "Ravi"
  ],
  "context_zh": "一位家长带孩子到博物馆，只能停留四十分钟，向服务台工作人员询问。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-19-s01",
      "speaker": "Beth",
      "text": "Does the guided tour start soon? We have about forty minutes before our train."
    },
    {
      "id": "p01-b-19-s02",
      "speaker": "Ravi",
      "text": "It starts in ten minutes, but it takes two hours."
    },
    {
      "id": "p01-b-19-s03",
      "speaker": "Beth",
      "text": "Oh dear, that is too long for us. My son is learning about Indian culture at school. Is there a gallery we could visit on our own?"
    },
    {
      "id": "p01-b-19-s04",
      "speaker": "Ravi",
      "text": "Yes, the India gallery is upstairs. The museum is famous for its textiles, and there are some beautiful carvings there too."
    },
    {
      "id": "p01-b-19-s05",
      "speaker": "Beth",
      "text": "He loves animals. Is there anything he might particularly like?"
    },
    {
      "id": "p01-b-19-s06",
      "speaker": "Ravi",
      "text": "The wooden elephant is my favourite piece. It is just inside the gallery, so you will not miss it."
    },
    {
      "id": "p01-b-19-s07",
      "speaker": "Beth",
      "text": "That sounds fantastic. We will go straight there."
    },
    {
      "id": "p01-b-19-s08",
      "speaker": "Ravi",
      "text": "Here is a map. The stairs are on your left."
    }
  ],
