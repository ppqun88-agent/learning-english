{
  "id": "p01-b-20",
  "title_zh": "给不同早餐习惯共用一张购物单",
  "topic_id": "food",
  "scenario": {
    "id": "shared-breakfast-planning",
    "label_zh": "商量共享早餐采购",
    "goal_zh": "兼顾不同早餐偏好并确定共用与自用食材"
  },
  "participants": [
    "Sam",
    "Nell"
  ],
  "context_zh": "室友准备采购，想一起承担基础食材费用，但不强求早餐完全一样。",
  "author": "author-phase01-b",
  "sentences": [
    {
      "id": "p01-b-20-s01",
      "speaker": "Sam",
      "text": "Can we discuss the shopping list? Everyone seems to want a different breakfast."
    },
    {
      "id": "p01-b-20-s02",
      "speaker": "Nell",
      "text": "I know. I want a more varied diet, but I do not want three separate shopping trips."
    },
    {
      "id": "p01-b-20-s03",
      "speaker": "Sam",
      "text": "We can share bread and fruit, then buy our own toppings."
    },
    {
      "id": "p01-b-20-s04",
      "speaker": "Nell",
      "text": "That works. I usually have one egg on toast after my morning exercise."
    },
    {
      "id": "p01-b-20-s05",
      "speaker": "Sam",
      "text": "I prefer toast with butter. Is it all right if I keep a little in the fridge?"
    },
    {
      "id": "p01-b-20-s06",
      "speaker": "Nell",
      "text": "Of course. I am not trying to remove all the fat from our food. I just want more choice than cereal."
    },
    {
      "id": "p01-b-20-s07",
      "speaker": "Sam",
      "text": "Good. Bread and fruit go on the shared list, and we can pay for the other things separately."
    }
  ],
