{
  "id": "p01-c-01",
  "title_zh": "报名做节庆志愿者",
  "topic_id": "community",
  "scenario": {
    "id": "festival-volunteer-shift",
    "label_zh": "报名节庆志愿班次",
    "goal_zh": "选择合适班次并确认报名资料"
  },
  "participants": [
    "Rosa",
    "Ben"
  ],
  "context_zh": "居民在社区活动中心询问节庆志愿者岗位。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-01-s01",
      "speaker": "Rosa",
      "text": "Do you still need volunteers for the festival?"
    },
    {
      "id": "p01-c-01-s02",
      "speaker": "Ben",
      "text": "Yes, we have a few places left on the afternoon team."
    },
    {
      "id": "p01-c-01-s03",
      "speaker": "Rosa",
      "text": "I can help at the entrance, but I need some training."
    },
    {
      "id": "p01-c-01-s04",
      "speaker": "Ben",
      "text": "That takes fifteen minutes, and you will work with a group of three experienced volunteers."
    },
    {
      "id": "p01-c-01-s05",
      "speaker": "Rosa",
      "text": "Will the entrance be busy?"
    },
    {
      "id": "p01-c-01-s06",
      "speaker": "Ben",
      "text": "We expect about fifty visitors in the first hour, so nobody will be on their own."
    },
    {
      "id": "p01-c-01-s07",
      "speaker": "Rosa",
      "text": "That sounds manageable; where do I sign up?"
    },
    {
      "id": "p01-c-01-s08",
      "speaker": "Ben",
      "text": "Please fill in this form and include a phone number we can reach you on that day."
    },
    {
      "id": "p01-c-01-s09",
      "speaker": "Rosa",
      "text": "Is there any other information you need?"
    },
    {
      "id": "p01-c-01-s10",
      "speaker": "Ben",
      "text": "Just your preferred shift; I will put you down for the afternoon once you finish."
    }
  ],
