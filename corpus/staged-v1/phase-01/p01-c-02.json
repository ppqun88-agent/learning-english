{
  "id": "p01-c-02",
  "title_zh": "选一部周五看的电影",
  "topic_id": "leisure",
  "scenario": {
    "id": "friends-film-night",
    "label_zh": "商定朋友电影之夜",
    "goal_zh": "兼顾时间与喜好选定影片"
  },
  "participants": [
    "Nina",
    "Owen"
  ],
  "context_zh": "两位朋友想邀请共同的朋友一起看电影。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-02-s01",
      "speaker": "Nina",
      "text": "Are you free on Friday evening?"
    },
    {
      "id": "p01-c-02-s02",
      "speaker": "Owen",
      "text": "Yes; is this about the film your friend suggested?"
    },
    {
      "id": "p01-c-02-s03",
      "speaker": "Nina",
      "text": "It is, but I would rather watch something funny after such a long week."
    },
    {
      "id": "p01-c-02-s04",
      "speaker": "Owen",
      "text": "How about the comedy at the small cinema?"
    },
    {
      "id": "p01-c-02-s05",
      "speaker": "Nina",
      "text": "Great, watching that together should be fun."
    },
    {
      "id": "p01-c-02-s06",
      "speaker": "Owen",
      "text": "I will check the evening times and send you the link before we buy tickets."
    }
  ],
