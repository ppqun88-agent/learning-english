{
  "id": "p01-c-03",
  "title_zh": "加入青少年足球训练",
  "topic_id": "leisure",
  "scenario": {
    "id": "youth-football-registration",
    "label_zh": "加入青少年足球队",
    "goal_zh": "核实年龄要求并了解初次训练安排"
  },
  "participants": [
    "Eli",
    "Coach May"
  ],
  "context_zh": "新学员向教练询问加入社区足球队的要求。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-03-s01",
      "speaker": "Eli",
      "text": "I am fourteen; am I old enough to join the football team?"
    },
    {
      "id": "p01-c-03-s02",
      "speaker": "Coach May",
      "text": "Yes, this team is for players aged thirteen to sixteen."
    },
    {
      "id": "p01-c-03-s03",
      "speaker": "Eli",
      "text": "I want to improve, but I have not played in a proper game before."
    },
    {
      "id": "p01-c-03-s04",
      "speaker": "Coach May",
      "text": "That is fine; your first session will be in the gym, where we practise passing."
    },
    {
      "id": "p01-c-03-s05",
      "speaker": "Eli",
      "text": "Do I need to run fast already?"
    },
    {
      "id": "p01-c-03-s06",
      "speaker": "Coach May",
      "text": "No, we build up slowly, because your health matters more than your speed."
    },
    {
      "id": "p01-c-03-s07",
      "speaker": "Eli",
      "text": "I want to be more active and stay healthy, so that suits me."
    },
    {
      "id": "p01-c-03-s08",
      "speaker": "Coach May",
      "text": "The final activity is a short match, and we finish at six."
    },
    {
      "id": "p01-c-03-s09",
      "speaker": "Eli",
      "text": "Thanks, I will bring my trainers and arrive a little early."
    }
  ],
