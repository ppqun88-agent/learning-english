{
  "id": "p01-c-04",
  "title_zh": "找回孩子落下的外套",
  "topic_id": "services",
  "scenario": {
    "id": "child-lost-clothing",
    "label_zh": "认领遗失外套",
    "goal_zh": "凭衣物与同行人的描述找回失物"
  },
  "participants": [
    "Tessa",
    "Marco",
    "Lucy"
  ],
  "context_zh": "家长带孩子回到商场服务台寻找外套。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-04-s01",
      "speaker": "Tessa",
      "text": "Hi, can you help me find a jacket my daughter left near the cafe?"
    },
    {
      "id": "p01-c-04-s02",
      "speaker": "Marco",
      "text": "Of course; what color is it?"
    },
    {
      "id": "p01-c-04-s03",
      "speaker": "Tessa",
      "text": "It is gray, and there should be a red hat in one pocket."
    },
    {
      "id": "p01-c-04-s04",
      "speaker": "Marco",
      "text": "Was your daughter the girl with short hair and blue jeans?"
    },
    {
      "id": "p01-c-04-s05",
      "speaker": "Tessa",
      "text": "Yes, her name is Lucy; she asked you about it earlier."
    },
    {
      "id": "p01-c-04-s06",
      "speaker": "Marco",
      "text": "I remember; someone brought the jacket to the desk a moment ago."
    },
    {
      "id": "p01-c-04-s07",
      "speaker": "Lucy",
      "text": "Hey, that is mine, with the little star on the sleeve!"
    },
    {
      "id": "p01-c-04-s08",
      "speaker": "Marco",
      "text": "Here you are; please check the pocket before you go."
    },
    {
      "id": "p01-c-04-s09",
      "speaker": "Tessa",
      "text": "The hat is here too, thank you so much."
    }
  ],
