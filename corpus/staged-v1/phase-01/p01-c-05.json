{
  "id": "p01-c-05",
  "title_zh": "领新住处的钥匙",
  "topic_id": "home",
  "scenario": {
    "id": "flat-key-handover",
    "label_zh": "接收新住处钥匙",
    "goal_zh": "分清钥匙并确认备用钥匙存放"
  },
  "participants": [
    "Mina",
    "Jon"
  ],
  "context_zh": "房客搬进新公寓，房东说明两把钥匙的用途。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-05-s01",
      "speaker": "Mina",
      "text": "Is this the key to my flat on the fifth floor?"
    },
    {
      "id": "p01-c-05-s02",
      "speaker": "Jon",
      "text": "Yes, and the smaller one opens the front door downstairs."
    },
    {
      "id": "p01-c-05-s03",
      "speaker": "Mina",
      "text": "Can I keep a spare set with my sister?"
    },
    {
      "id": "p01-c-05-s04",
      "speaker": "Jon",
      "text": "Certainly; I have put both sets in this envelope."
    },
    {
      "id": "p01-c-05-s05",
      "speaker": "Jon",
      "text": "There are four keys altogether, so you and your sister can each have a complete set."
    },
    {
      "id": "p01-c-05-s06",
      "speaker": "Mina",
      "text": "Thanks, it will be lovely to come home without borrowing someone else's keys."
    }
  ],
