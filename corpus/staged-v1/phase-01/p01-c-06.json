{
  "id": "p01-c-06",
  "title_zh": "在小院里种什么",
  "topic_id": "home",
  "scenario": {
    "id": "small-garden-planting",
    "label_zh": "选择小院种植物",
    "goal_zh": "根据光照与围墙高度选定种植位置"
  },
  "participants": [
    "Arun",
    "Beth"
  ],
  "context_zh": "刚搬家的两人商量怎样利用小院里的空花坛。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-06-s01",
      "speaker": "Arun",
      "text": "Now that we have a house with a garden, I would love to grow something."
    },
    {
      "id": "p01-c-06-s02",
      "speaker": "Beth",
      "text": "The wall is quite high, so that corner gets very little sun."
    },
    {
      "id": "p01-c-06-s03",
      "speaker": "Arun",
      "text": "What about the space by the kitchen window?"
    },
    {
      "id": "p01-c-06-s04",
      "speaker": "Beth",
      "text": "That gets plenty of light; we could put a flower bed there."
    },
    {
      "id": "p01-c-06-s05",
      "speaker": "Arun",
      "text": "I would like something with green leaves all year as well."
    },
    {
      "id": "p01-c-06-s06",
      "speaker": "Beth",
      "text": "Let us measure that sunny space and ask at the garden centre before we buy anything."
    }
  ],
