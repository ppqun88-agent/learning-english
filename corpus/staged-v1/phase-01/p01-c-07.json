{
  "id": "p01-c-07",
  "title_zh": "午餐别点太多",
  "topic_id": "food",
  "scenario": {
    "id": "small-lunch-order",
    "label_zh": "选择合适午餐分量",
    "goal_zh": "在饥饿程度与分量之间选定午餐"
  },
  "participants": [
    "Sam",
    "Lena"
  ],
  "context_zh": "两位同事在咖啡馆看菜单，避免点得过多。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-07-s01",
      "speaker": "Sam",
      "text": "I am hungry, but I do not want a huge lunch."
    },
    {
      "id": "p01-c-07-s02",
      "speaker": "Lena",
      "text": "The fish comes with potatoes and vegetables, so that is quite a lot of food."
    },
    {
      "id": "p01-c-07-s03",
      "speaker": "Sam",
      "text": "Could I order half a portion?"
    },
    {
      "id": "p01-c-07-s04",
      "speaker": "Lena",
      "text": "Let us ask; otherwise the hot soup looks good."
    },
    {
      "id": "p01-c-07-s05",
      "speaker": "Sam",
      "text": "Soup and a small roll should be enough without leaving me too full."
    },
    {
      "id": "p01-c-07-s06",
      "speaker": "Lena",
      "text": "I will have that too; we can save the fish for another day."
    }
  ],
