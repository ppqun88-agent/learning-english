  "title_zh": "等甜点时先点饮料",
  "topic_id": "food",
  "scenario": {
    "id": "dessert-wait-drinks",
    "label_zh": "点甜点及饮料",
    "goal_zh": "确认等候时间并说明饮料偏好"
  },
  "participants": [
    "Server Pia",
    "Noah"
  ],
  "context_zh": "顾客在甜品店点水果甜点和饮料。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-08-s01",
      "speaker": "Server Pia",
      "text": "The fruit plate will take about five minutes; can I bring you a drink first?"
    },
    {
      "id": "p01-c-08-s02",
      "speaker": "Noah",
      "text": "Yes, a glass of orange juice, please, with no ice."
    },
    {
      "id": "p01-c-08-s03",
      "speaker": "Server Pia",
      "text": "Certainly; would you like ice cream with the fruit?"
    },
    {
      "id": "p01-c-08-s04",
      "speaker": "Noah",
      "text": "A small scoop of vanilla, please; I am happy to wait for them together."
    }
  ],
