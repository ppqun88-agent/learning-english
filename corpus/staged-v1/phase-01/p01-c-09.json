{
  "id": "p01-c-09",
  "title_zh": "把假期定在六月",
  "topic_id": "travel",
  "scenario": {
    "id": "summer-holiday-timing",
    "label_zh": "选择暑期出游月份",
    "goal_zh": "协调请假月份并决定是否先看航班"
  },
  "participants": [
    "Ada",
    "Leon"
  ],
  "context_zh": "两位伴侣在年初商量夏季出游计划。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-09-s01",
      "speaker": "Ada",
      "text": "It is only January, but should we choose our summer holiday dates now?"
    },
    {
      "id": "p01-c-09-s02",
      "speaker": "Leon",
      "text": "Yes, I cannot take time off in July because of the shop opening."
    },
    {
      "id": "p01-c-09-s03",
      "speaker": "Ada",
      "text": "Could we go in June instead?"
    },
    {
      "id": "p01-c-09-s04",
      "speaker": "Leon",
      "text": "That works for me; would you rather fly somewhere or take the train?"
    },
    {
      "id": "p01-c-09-s05",
      "speaker": "Ada",
      "text": "Let us compare the travel times first, then choose a place we can reach without losing a whole day."
    }
  ],
