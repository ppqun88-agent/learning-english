{
  "id": "p01-c-10",
  "title_zh": "到岛上旅馆之前",
  "topic_id": "travel",
  "scenario": {
    "id": "island-hotel-arrival",
    "label_zh": "确认海岛旅馆到达方式",
    "goal_zh": "核实码头步行距离、船程和客房楼层"
  },
  "participants": [
    "Clara",
    "Receptionist Dev"
  ],
  "context_zh": "旅客打电话给岛上的旅馆，确认抵达后如何搬运行李。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-10-s01",
      "speaker": "Clara",
      "text": "How far is your hotel from the ferry terminal?"
    },
    {
      "id": "p01-c-10-s02",
      "speaker": "Receptionist Dev",
      "text": "About a kilometre, but we can collect you if you have heavy bags."
    },
    {
      "id": "p01-c-10-s03",
      "speaker": "Clara",
      "text": "That would help; the boat takes an hour to reach the island, so we should arrive at two."
    },
    {
      "id": "p01-c-10-s04",
      "speaker": "Receptionist Dev",
      "text": "I will arrange a pickup, and your room will be ready by then."
    },
    {
      "id": "p01-c-10-s05",
      "speaker": "Clara",
      "text": "Our booking says the fourth floor; is there a lift?"
    },
    {
      "id": "p01-c-10-s06",
      "speaker": "Receptionist Dev",
      "text": "Yes, the driver will bring your bags inside, and the lift is beside reception."
    },
    {
      "id": "p01-c-10-s07",
      "speaker": "Clara",
      "text": "Perfect, I will call if the boat is delayed."
    }
  ],
