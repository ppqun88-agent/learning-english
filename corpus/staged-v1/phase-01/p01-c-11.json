{
  "id": "p01-c-11",
  "title_zh": "给作业选一个能研究的问题",
  "topic_id": "learning",
  "scenario": {
    "id": "school-project-question",
    "label_zh": "确定作业研究问题",
    "goal_zh": "把宽泛兴趣缩小为可查证的研究问题"
  },
  "participants": [
    "Pupil Leo",
    "Teacher Chen"
  ],
  "context_zh": "学生在图书馆请老师帮助确定研究作业的切入点。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-11-s01",
      "speaker": "Pupil Leo",
      "text": "For my homework, can I write about the history of our river?"
    },
    {
      "id": "p01-c-11-s02",
      "speaker": "Teacher Chen",
      "text": "Yes, and you could connect it to geography by showing how its route has changed."
    },
    {
      "id": "p01-c-11-s03",
      "speaker": "Pupil Leo",
      "text": "That sounds interesting, but I am more interested in the old bridge."
    },
    {
      "id": "p01-c-11-s04",
      "speaker": "Teacher Chen",
      "text": "Then make that your starting point; your interest will help you stay with the research."
    },
    {
      "id": "p01-c-11-s05",
      "speaker": "Pupil Leo",
      "text": "How can I check when the bridge was built?"
    },
    {
      "id": "p01-c-11-s06",
      "speaker": "Teacher Chen",
      "text": "Start with the town museum website, rather than a random page on the internet."
    },
    {
      "id": "p01-c-11-s07",
      "speaker": "Pupil Leo",
      "text": "It is hard to read the date in this old photograph; can I just guess?"
    },
    {
      "id": "p01-c-11-s08",
      "speaker": "Teacher Chen",
      "text": "Use the photograph as a clue, but look for a dated record before you state a year."
    },
    {
      "id": "p01-c-11-s09",
      "speaker": "Pupil Leo",
      "text": "All right, I will ask the museum whether they have the original building records."
    }
  ],
