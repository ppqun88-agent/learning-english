{
  "id": "p01-c-12",
  "title_zh": "面试前练习举例",
  "topic_id": "work",
  "scenario": {
    "id": "job-interview-example",
    "label_zh": "准备求职面试例子",
    "goal_zh": "把笼统自我评价改成具体工作例子"
  },
  "participants": [
    "Dina",
    "Malik"
  ],
  "context_zh": "求职者请朋友帮忙练习面试回答。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-12-s01",
      "speaker": "Dina",
      "text": "I have an interview for a reception job tomorrow, and I hope I do not freeze."
    },
    {
      "id": "p01-c-12-s02",
      "speaker": "Malik",
      "text": "What would you say if they asked why you would be good at it?"
    },
    {
      "id": "p01-c-12-s03",
      "speaker": "Dina",
      "text": "I would say I am organised and polite."
    },
    {
      "id": "p01-c-12-s04",
      "speaker": "Malik",
      "text": "That is a start; however, a real example would make your answer stronger."
    },
    {
      "id": "p01-c-12-s05",
      "speaker": "Dina",
      "text": "At the sports club, I check bookings and explain delays to visitors."
    },
    {
      "id": "p01-c-12-s06",
      "speaker": "Malik",
      "text": "That is useful; it shows a future employer how you handle people."
    },
    {
      "id": "p01-c-12-s07",
      "speaker": "Dina",
      "text": "Do I have to describe every part of my role?"
    },
    {
      "id": "p01-c-12-s08",
      "speaker": "Malik",
      "text": "No, choose one important moment and explain what you did."
    },
    {
      "id": "p01-c-12-s09",
      "speaker": "Dina",
      "text": "I will use the day two teams arrived for the same court and practise explaining how I sorted it out."
    }
  ],
