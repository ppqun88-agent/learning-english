{
  "id": "p01-c-13",
  "title_zh": "在门口认识新邻居",
  "topic_id": "relationships",
  "scenario": {
    "id": "new-neighbour-introductions",
    "label_zh": "介绍新邻居及同住者",
    "goal_zh": "确认彼此身份并约定归还借用物品"
  },
  "participants": [
    "Alex",
    "Mei",
    "Sofia"
  ],
  "context_zh": "新邻居搬家当天在楼道里认识对门住户。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-13-s01",
      "speaker": "Alex",
      "text": "Hello, I am Alex from the flat across the hall."
    },
    {
      "id": "p01-c-13-s02",
      "speaker": "Mei",
      "text": "Hi, I am Mei; it is nice to meet you."
    },
    {
      "id": "p01-c-13-s03",
      "speaker": "Alex",
      "text": "Let me introduce my girlfriend, Sofia; we have just moved in together."
    },
    {
      "id": "p01-c-13-s04",
      "speaker": "Sofia",
      "text": "Everyone has been so friendly, especially the man who lent us a trolley."
    },
    {
      "id": "p01-c-13-s05",
      "speaker": "Mei",
      "text": "That is my husband, Dan; he is downstairs parking the van."
    },
    {
      "id": "p01-c-13-s06",
      "speaker": "Sofia",
      "text": "Please thank him for us; is the blue trolley his?"
    },
    {
      "id": "p01-c-13-s07",
      "speaker": "Mei",
      "text": "Yes, just leave it outside our door when you are done."
    },
    {
      "id": "p01-c-13-s08",
      "speaker": "Alex",
      "text": "We will bring it back this afternoon, and thanks for making us feel welcome."
    }
  ],
