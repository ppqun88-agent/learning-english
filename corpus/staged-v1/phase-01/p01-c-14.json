{
  "id": "p01-c-14",
  "title_zh": "协调探望祖父的时间",
  "topic_id": "health",
  "scenario": {
    "id": "family-hospital-visit",
    "label_zh": "协调家人探访安排",
    "goal_zh": "避免多人同时探视并照顾陪护者"
  },
  "participants": [
    "Eva",
    "Tom"
  ],
  "context_zh": "兄妹通过电话商量探望住院祖父及接送祖母。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-14-s01",
      "speaker": "Eva",
      "text": "Our grandfather sounded much stronger on the phone today."
    },
    {
      "id": "p01-c-14-s02",
      "speaker": "Tom",
      "text": "I am happy to hear that; when are you going to the hospital?"
    },
    {
      "id": "p01-c-14-s03",
      "speaker": "Eva",
      "text": "At three, but our grandmother wants someone to collect her first."
    },
    {
      "id": "p01-c-14-s04",
      "speaker": "Tom",
      "text": "I can do that; does Lily want to come too?"
    },
    {
      "id": "p01-c-14-s05",
      "speaker": "Eva",
      "text": "Yes, but she is nervous about visiting a grandparent in hospital."
    },
    {
      "id": "p01-c-14-s06",
      "speaker": "Tom",
      "text": "Then let us explain what the ward is like before she goes in."
    },
    {
      "id": "p01-c-14-s07",
      "speaker": "Eva",
      "text": "I will check the visiting limit so we do not all turn up at once."
    },
    {
      "id": "p01-c-14-s08",
      "speaker": "Tom",
      "text": "Send me the time after you check, and I will arrange the lift with her."
    }
  ],
