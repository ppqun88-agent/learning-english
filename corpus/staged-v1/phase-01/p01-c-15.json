{
  "id": "p01-c-15",
  "title_zh": "摔倒后请人帮忙",
  "topic_id": "health",
  "scenario": {
    "id": "walking-fall-assistance",
    "label_zh": "摔倒后寻求帮助",
    "goal_zh": "说明不适并请同伴联系现场急救员"
  },
  "participants": [
    "Grace",
    "Imran"
  ],
  "context_zh": "步行活动中一名参加者绊倒，同伴过来查看。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-15-s01",
      "speaker": "Grace",
      "text": "You fell quite hard; did you hit your head?"
    },
    {
      "id": "p01-c-15-s02",
      "speaker": "Imran",
      "text": "No, I caught myself with my hand, but there is a strange feeling in my left foot."
    },
    {
      "id": "p01-c-15-s03",
      "speaker": "Grace",
      "text": "Do you want help getting up?"
    },
    {
      "id": "p01-c-15-s04",
      "speaker": "Imran",
      "text": "Not yet; I am fine sitting here, but I would like the first-aid volunteer to check it."
    },
    {
      "id": "p01-c-15-s05",
      "speaker": "Grace",
      "text": "Stay where you are; I will ask someone to bring the volunteer over."
    },
    {
      "id": "p01-c-15-s06",
      "speaker": "Imran",
      "text": "Thanks, and could you keep my bag out of the path?"
    }
  ],
