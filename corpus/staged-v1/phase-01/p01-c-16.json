{
  "id": "p01-c-16",
  "title_zh": "听到警报后离开大楼",
  "topic_id": "community",
  "scenario": {
    "id": "building-alarm-evacuation",
    "label_zh": "按指示离开报警大楼",
    "goal_zh": "放下物品并沿安全路线到集合点"
  },
  "participants": [
    "Newcomer Will",
    "Warden Sara"
  ],
  "context_zh": "办公楼警报响起，新员工向楼层负责人确认撤离路线。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-16-s01",
      "speaker": "Newcomer Will",
      "text": "Is that the fire alarm, or a test?"
    },
    {
      "id": "p01-c-16-s02",
      "speaker": "Warden Sara",
      "text": "We need to leave now; follow me to the stairs."
    },
    {
      "id": "p01-c-16-s03",
      "speaker": "Newcomer Will",
      "text": "My coat is still in the meeting room; should I leave it there?"
    },
    {
      "id": "p01-c-16-s04",
      "speaker": "Warden Sara",
      "text": "Forget the coat for now; do not go back into the building until we are told it is safe."
    },
    {
      "id": "p01-c-16-s05",
      "speaker": "Newcomer Will",
      "text": "Does this happen often?"
    },
    {
      "id": "p01-c-16-s06",
      "speaker": "Warden Sara",
      "text": "No; the alarm has its own test schedule, but today is not a test."
    },
    {
      "id": "p01-c-16-s07",
      "speaker": "Newcomer Will",
      "text": "Where do we wait outside?"
    },
    {
      "id": "p01-c-16-s08",
      "speaker": "Warden Sara",
      "text": "At the marked meeting point across the road; I will check everyone is there."
    }
  ],
