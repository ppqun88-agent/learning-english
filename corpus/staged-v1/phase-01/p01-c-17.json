{
  "id": "p01-c-17",
  "title_zh": "先借吉他试试看",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-guitar-loan",
    "label_zh": "咨询初学吉他借用",
    "goal_zh": "先通过借用体验再决定是否购买"
  },
  "participants": [
    "Pavel",
    "Tutor Rose"
  ],
  "context_zh": "初学者在音乐教室询问入门前是否必须买琴。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-17-s01",
      "speaker": "Pavel",
      "text": "I would like to try the guitar as a hobby, but I do not own one."
    },
    {
      "id": "p01-c-17-s02",
      "speaker": "Tutor Rose",
      "text": "You can borrow one here before you decide whether to buy."
    },
    {
      "id": "p01-c-17-s03",
      "speaker": "Pavel",
      "text": "Where can I get a smaller one to try?"
    },
    {
      "id": "p01-c-17-s04",
      "speaker": "Tutor Rose",
      "text": "I can give you this one for the lesson; sit down and see whether it feels comfortable."
    },
    {
      "id": "p01-c-17-s05",
      "speaker": "Pavel",
      "text": "Thanks, that takes the pressure off buying something I have never played."
    }
  ],
