{
  "id": "p01-c-18",
  "title_zh": "选择适合初学者的骑马体验",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-riding-choice",
    "label_zh": "选择初学骑马体验",
    "goal_zh": "比较时长价格并说明对速度的顾虑"
  },
  "participants": [
    "Visitor Kim",
    "Guide Ali"
  ],
  "context_zh": "游客第一次咨询骑马活动，担心路线过长和速度过快。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-18-s01",
      "speaker": "Visitor Kim",
      "text": "I have never ridden a horse; which trip is suitable for a beginner?"
    },
    {
      "id": "p01-c-18-s02",
      "speaker": "Guide Ali",
      "text": "The short guided ride is forty pounds; the full-day trip is a hundred."
    },
    {
      "id": "p01-c-18-s03",
      "speaker": "Visitor Kim",
      "text": "The short one sounds better, but I hate the idea of going too fast."
    },
    {
      "id": "p01-c-18-s04",
      "speaker": "Guide Ali",
      "text": "We start in the yard, and if you are not comfortable, you can stay there with the instructor."
    },
    {
      "id": "p01-c-18-s05",
      "speaker": "Visitor Kim",
      "text": "Could I watch the introduction before I book?"
    },
    {
      "id": "p01-c-18-s06",
      "speaker": "Guide Ali",
      "text": "Of course, the next group starts in ten minutes; you can stand by the fence with me."
    }
  ],
