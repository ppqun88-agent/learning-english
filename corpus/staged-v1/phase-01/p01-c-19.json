{
  "id": "p01-c-19",
  "title_zh": "为朋友挑一条围巾",
  "topic_id": "services",
  "scenario": {
    "id": "scarf-gift-choice",
    "label_zh": "挑选礼物围巾",
    "goal_zh": "根据收礼人的衣服颜色选定围巾"
  },
  "participants": [
    "Customer Jo",
    "Assistant Finn"
  ],
  "context_zh": "顾客在英国服装店为朋友挑礼物，店员帮助比较颜色。",
  "author": "author-phase01-c",
  "sentences": [
    {
      "id": "p01-c-19-s01",
      "speaker": "Customer Jo",
      "text": "I am looking for a scarf for my friend, but I only have a photo of her coat."
    },
    {
      "id": "p01-c-19-s02",
      "speaker": "Assistant Finn",
      "text": "The grey one in the middle might work with that dark blue."
    },
    {
      "id": "p01-c-19-s03",
      "speaker": "Customer Jo",
      "text": "That is a good idea; can you hold it next to the photo?"
    },
    {
      "id": "p01-c-19-s04",
      "speaker": "Assistant Finn",
      "text": "Certainly; imagine it with the coat open so you can see the blue behind it."
    },
    {
      "id": "p01-c-19-s05",
      "speaker": "Customer Jo",
      "text": "Yes, that is just what I wanted, not too bright."
    },
    {
      "id": "p01-c-19-s06",
      "speaker": "Assistant Finn",
      "text": "I can wrap it as a gift at the till."
    },
    {
      "id": "p01-c-19-s07",
      "speaker": "Customer Jo",
      "text": "Thank you; I will take it."
    },
    {
      "id": "p01-c-19-s08",
      "speaker": "Assistant Finn",
      "text": "You are welcome; goodbye, and I hope your friend likes it."
    }
  ],
