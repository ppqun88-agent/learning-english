{
  "id": "p02-a-01",
  "title_zh": "弄懂听力练习中的回答",
  "topic_id": "learning",
  "scenario": {
    "id": "language-practice-clarification",
    "label_zh": "澄清语言练习内容",
    "goal_zh": "弄清听力练习的意思并确定重听的方法。"
  },
  "participants": [
    "Tara",
    "Luis"
  ],
  "context_zh": "学员正在做语言课程的听力练习，向老师确认自己是否听错。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-01-s01",
      "speaker": "Tara",
      "text": "I'm trying to learn Spanish, but this lesson is moving too fast for me."
    },
    {
      "id": "p02-a-01-s02",
      "speaker": "Luis",
      "text": "That's normal when you start a new language. Which part is difficult?"
    },
    {
      "id": "p02-a-01-s03",
      "speaker": "Tara",
      "text": "I know the words, but I can't work out the meaning of the reply."
    },
    {
      "id": "p02-a-01-s04",
      "speaker": "Luis",
      "text": "Listen to the recording again. The woman gives a negative answer to the invitation."
    },
    {
      "id": "p02-a-01-s05",
      "speaker": "Tara",
      "text": "Does she mean that she can't come tonight?"
    },
    {
      "id": "p02-a-01-s06",
      "speaker": "Luis",
      "text": "Exactly. She can come tomorrow instead."
    },
    {
      "id": "p02-a-01-s07",
      "speaker": "Tara",
      "text": "Then there's a mistake in my answer. I wrote that she was coming tonight."
    },
    {
      "id": "p02-a-01-s08",
      "speaker": "Luis",
      "text": "Change that answer, and we'll play the next conversation more slowly."
    }
  ],
