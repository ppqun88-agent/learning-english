{
  "id": "p02-a-02",
  "title_zh": "用信件办理借书证",
  "topic_id": "community",
  "scenario": {
    "id": "library-membership-proof",
    "label_zh": "核对图书馆入会材料",
    "goal_zh": "确认住址证明并办理可以借阅的图书馆会员资格。"
  },
  "participants": [
    "Maya",
    "Dennis"
  ],
  "context_zh": "新居民到图书馆办借书证，柜台人员解释住址证明及借阅规则。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-02-s01",
      "speaker": "Maya",
      "text": "I'd like to become a member of this library."
    },
    {
      "id": "p02-a-02-s02",
      "speaker": "Dennis",
      "text": "Certainly. Do you have something with your name and address on it?"
    },
    {
      "id": "p02-a-02-s03",
      "speaker": "Maya",
      "text": "My bank sent me this letter. Will that do?"
    },
    {
      "id": "p02-a-02-s04",
      "speaker": "Dennis",
      "text": "Yes, that's fine. Please fill in this short form."
    },
    {
      "id": "p02-a-02-s05",
      "speaker": "Maya",
      "text": "Can I borrow a magazine as well as books?"
    },
    {
      "id": "p02-a-02-s06",
      "speaker": "Dennis",
      "text": "You can borrow an older issue, but the current one stays here."
    },
    {
      "id": "p02-a-02-s07",
      "speaker": "Maya",
      "text": "How often do I need to renew the card?"
    },
    {
      "id": "p02-a-02-s08",
      "speaker": "Dennis",
      "text": "Just once a year. I'll put the date on the back."
    },
    {
      "id": "p02-a-02-s09",
      "speaker": "Maya",
      "text": "Great. Here's the completed form."
    }
  ],
