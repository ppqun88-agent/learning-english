{
  "id": "p02-a-03",
  "title_zh": "更正社区会议通知",
  "topic_id": "community",
  "scenario": {
    "id": "local-meeting-notice",
    "label_zh": "更正社区会议通知",
    "goal_zh": "核实会议改期消息并约定告知居民的方式。"
  },
  "participants": [
    "Helen",
    "Omar"
  ],
  "context_zh": "两位居民发现报纸和公告上的会议时间不一致，商量如何纠正。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-03-s01",
      "speaker": "Helen",
      "text": "Have you seen the news about the community meeting? It's on Monday now."
    },
    {
      "id": "p02-a-03-s02",
      "speaker": "Omar",
      "text": "The local newspaper still says Tuesday."
    },
    {
      "id": "p02-a-03-s03",
      "speaker": "Helen",
      "text": "I got a message from the organiser this morning. The hall isn't available on Tuesday."
    },
    {
      "id": "p02-a-03-s04",
      "speaker": "Omar",
      "text": "Then we should put a note beside the old notice."
    },
    {
      "id": "p02-a-03-s05",
      "speaker": "Helen",
      "text": "Good idea. Nobody has corrected the noticeboard yet."
    },
    {
      "id": "p02-a-03-s06",
      "speaker": "Omar",
      "text": "I'll print the new date and ask the organiser to check it before I put it up."
    },
    {
      "id": "p02-a-03-s07",
      "speaker": "Helen",
      "text": "Thanks. I'll tell the newspaper so they can correct the online version."
    }
  ],
