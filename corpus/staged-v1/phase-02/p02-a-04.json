{
  "id": "p02-a-04",
  "title_zh": "选择无肉午餐",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-lunch-ingredients",
    "label_zh": "选择午餐配料",
    "goal_zh": "询问汤品和沙拉的配料后完成午餐点单。"
  },
  "participants": [
    "Nadia",
    "Ben"
  ],
  "context_zh": "顾客想吃一份没有肉的简单午餐，但不要求避免乳制品。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-04-s01",
      "speaker": "Nadia",
      "text": "Could I see the menu? I'm looking for a quick lunch."
    },
    {
      "id": "p02-a-04-s02",
      "speaker": "Ben",
      "text": "Of course. The soup and bread make a filling meal."
    },
    {
      "id": "p02-a-04-s03",
      "speaker": "Nadia",
      "text": "Is there any meat in the soup?"
    },
    {
      "id": "p02-a-04-s04",
      "speaker": "Ben",
      "text": "No, it's vegetable soup. It contains onion and a little milk."
    },
    {
      "id": "p02-a-04-s05",
      "speaker": "Nadia",
      "text": "That sounds fine. Could you make a small salad too?"
    },
    {
      "id": "p02-a-04-s06",
      "speaker": "Ben",
      "text": "Certainly. Would you like bread or crackers with the soup?"
    },
    {
      "id": "p02-a-04-s07",
      "speaker": "Nadia",
      "text": "Bread, please. I'll have a bowl of soup and the salad."
    },
    {
      "id": "p02-a-04-s08",
      "speaker": "Ben",
      "text": "All right. I'll bring them together."
    }
  ],
