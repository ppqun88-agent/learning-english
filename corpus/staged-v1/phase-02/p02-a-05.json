{
  "id": "p02-a-05",
  "title_zh": "挑选预算内的洗衣机",
  "topic_id": "services",
  "scenario": {
    "id": "appliance-budget-choice",
    "label_zh": "比较预算内的洗衣机",
    "goal_zh": "比较洗衣机型号和价格并选出可负担的选项。"
  },
  "participants": [
    "Eric",
    "Sonia"
  ],
  "context_zh": "顾客需要更换洗衣机，销售员根据预算推荐基础款。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-05-s01",
      "speaker": "Eric",
      "text": "I need a washing machine, but I haven't got much money to spend."
    },
    {
      "id": "p02-a-05-s02",
      "speaker": "Sonia",
      "text": "What's your budget?"
    },
    {
      "id": "p02-a-05-s03",
      "speaker": "Eric",
      "text": "Three hundred pounds, including delivery."
    },
    {
      "id": "p02-a-05-s04",
      "speaker": "Sonia",
      "text": "This model is two hundred and eighty, and delivery is free."
    },
    {
      "id": "p02-a-05-s05",
      "speaker": "Eric",
      "text": "Does it have a short wash? That's the setting I use most."
    },
    {
      "id": "p02-a-05-s06",
      "speaker": "Sonia",
      "text": "Yes, a thirty-minute cycle. You can see the controls here."
    },
    {
      "id": "p02-a-05-s07",
      "speaker": "Eric",
      "text": "That has everything I need. I'll take this one."
    }
  ],
