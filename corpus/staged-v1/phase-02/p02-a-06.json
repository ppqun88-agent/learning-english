{
  "id": "p02-a-06",
  "title_zh": "认识刚搬来的邻居",
  "topic_id": "relationships",
  "scenario": {
    "id": "new-neighbour-introductions",
    "label_zh": "介绍新邻居及同住者",
    "goal_zh": "确认彼此身份并约定归还借用物品"
  },
  "participants": [
    "Alicia",
    "Grant"
  ],
  "context_zh": "美国公寓楼的新住户在门口认识邻居，并借用搬家工具。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-06-s01",
      "speaker": "Alicia",
      "text": "Hi, I'm Alicia, your new neighbor. I live in apartment six."
    },
    {
      "id": "p02-a-06-s02",
      "speaker": "Grant",
      "text": "Welcome to the neighborhood! I'm Grant."
    },
    {
      "id": "p02-a-06-s03",
      "speaker": "Alicia",
      "text": "It's nice to meet you. Is there a hardware store near here?"
    },
    {
      "id": "p02-a-06-s04",
      "speaker": "Grant",
      "text": "Two blocks away. What are you looking for?"
    },
    {
      "id": "p02-a-06-s05",
      "speaker": "Alicia",
      "text": "A screwdriver. I need to put my bed together."
    },
    {
      "id": "p02-a-06-s06",
      "speaker": "Grant",
      "text": "You can borrow mine. Just bring it back tomorrow."
    },
    {
      "id": "p02-a-06-s07",
      "speaker": "Alicia",
      "text": "Thanks. I'll knock when I'm finished."
    }
  ],
