{
  "id": "p02-a-08",
  "title_zh": "选一部适合今晚的电影",
  "topic_id": "leisure",
  "scenario": {
    "id": "friends-film-night",
    "label_zh": "商定朋友电影之夜",
    "goal_zh": "兼顾时间与喜好选定影片"
  },
  "participants": [
    "Joel",
    "Priya"
  ],
  "context_zh": "两位朋友打算在家看电影，先沟通口味再选片。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-08-s01",
      "speaker": "Joel",
      "text": "What movie shall we watch tonight?"
    },
    {
      "id": "p02-a-08-s02",
      "speaker": "Priya",
      "text": "I'd like something funny. I need to laugh after the day I've had."
    },
    {
      "id": "p02-a-08-s03",
      "speaker": "Joel",
      "text": "I love the comedy about the two lost musicians. Have you seen it?"
    },
    {
      "id": "p02-a-08-s04",
      "speaker": "Priya",
      "text": "No. What's your opinion of the ending? I don't want anything sad."
    },
    {
      "id": "p02-a-08-s05",
      "speaker": "Joel",
      "text": "It's cheerful, and the music is great."
    },
    {
      "id": "p02-a-08-s06",
      "speaker": "Priya",
      "text": "Maybe that's the right choice. How long is it?"
    },
    {
      "id": "p02-a-08-s07",
      "speaker": "Joel",
      "text": "About eighty minutes, so it won't keep us up all night."
    },
    {
      "id": "p02-a-08-s08",
      "speaker": "Priya",
      "text": "Perfect. Put it on while I get the snacks."
    }
  ],
