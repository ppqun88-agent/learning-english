{
  "id": "p02-a-09",
  "title_zh": "调整书桌位置",
  "topic_id": "home",
  "scenario": {
    "id": "home-desk-fitting",
    "label_zh": "调整书桌位置与照明",
    "goal_zh": "根据桌面尺寸、照明和通道空间安排书桌。"
  },
  "participants": [
    "Camila",
    "Devon"
  ],
  "context_zh": "美国居民与室友一起摆放刚买的书桌，避免挡住通道。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-09-s01",
      "speaker": "Camila",
      "text": "Could you help me move this desk next to the window?"
    },
    {
      "id": "p02-a-09-s02",
      "speaker": "Devon",
      "text": "Sure. It looks quite large. Will it fit in that gap?"
    },
    {
      "id": "p02-a-09-s03",
      "speaker": "Camila",
      "text": "It's just under a meter wide, and the gap is wider than that."
    },
    {
      "id": "p02-a-09-s04",
      "speaker": "Devon",
      "text": "Let's look at the legs before we lift it. One seems loose."
    },
    {
      "id": "p02-a-09-s05",
      "speaker": "Camila",
      "text": "You're right. I'll tighten it first."
    },
    {
      "id": "p02-a-09-s06",
      "speaker": "Devon",
      "text": "Is that little black object a lamp?"
    },
    {
      "id": "p02-a-09-s07",
      "speaker": "Camila",
      "text": "Yes, it's a modern desk lamp. It gives plenty of light without taking up much space."
    },
    {
      "id": "p02-a-09-s08",
      "speaker": "Devon",
      "text": "The leg feels firm now. Ready to lift?"
    },
    {
      "id": "p02-a-09-s09",
      "speaker": "Camila",
      "text": "Ready. This way we can still walk past the bed."
    }
  ],
