{
  "id": "p02-a-11",
  "title_zh": "在自然历史馆选择展厅",
  "topic_id": "leisure",
  "scenario": {
    "id": "museum-animal-history",
    "label_zh": "选择自然历史馆展厅",
    "goal_zh": "根据孩子对动物的兴趣选择适合参观的展厅。"
  },
  "participants": [
    "Seth",
    "Wren",
    "Ellen"
  ],
  "context_zh": "家长和孩子在博物馆咨询台询问，想在闭馆前看一个动物展厅。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-11-s01",
      "speaker": "Seth",
      "text": "We have half an hour in the museum. Which room would you suggest for a child?"
    },
    {
      "id": "p02-a-11-s02",
      "speaker": "Ellen",
      "text": "The natural history gallery is popular. It shows how animal life has changed over time."
    },
    {
      "id": "p02-a-11-s03",
      "speaker": "Wren",
      "text": "Is there a lion in there?"
    },
    {
      "id": "p02-a-11-s04",
      "speaker": "Ellen",
      "text": "There's a model of an extinct lion, and a display of much older sea animals."
    },
    {
      "id": "p02-a-11-s05",
      "speaker": "Wren",
      "text": "How old are the sea animals?"
    },
    {
      "id": "p02-a-11-s06",
      "speaker": "Ellen",
      "text": "Some of the fossils are over a million years old."
    },
    {
      "id": "p02-a-11-s07",
      "speaker": "Seth",
      "text": "That sounds like our sort of room. Where do we go?"
    },
    {
      "id": "p02-a-11-s08",
      "speaker": "Ellen",
      "text": "Through those glass doors. The animal trail starts on your right."
    },
    {
      "id": "p02-a-11-s09",
      "speaker": "Wren",
      "text": "Let's follow the trail, Dad!"
    }
  ],
