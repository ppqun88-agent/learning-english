{
  "id": "p02-a-12",
  "title_zh": "选择可当天走完的海岸山路",
  "topic_id": "leisure",
  "scenario": {
    "id": "hill-walk-route-choice",
    "label_zh": "调整山间步行路线",
    "goal_zh": "考虑天色和路面条件后改走短路线"
  },
  "participants": [
    "Amina",
    "Cole"
  ],
  "context_zh": "游客向步道工作人员询问海岸山地路线，避免走上私人土地或太长的山路。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-12-s01",
      "speaker": "Amina",
      "text": "Can you show me the mountain path on this map?"
    },
    {
      "id": "p02-a-12-s02",
      "speaker": "Cole",
      "text": "This route goes north from the car park, then climbs towards the ridge."
    },
    {
      "id": "p02-a-12-s03",
      "speaker": "Amina",
      "text": "It looks like a long walk. We have to be back before dark."
    },
    {
      "id": "p02-a-12-s04",
      "speaker": "Cole",
      "text": "Then take the lower path. It's about a mile to the viewpoint."
    },
    {
      "id": "p02-a-12-s05",
      "speaker": "Amina",
      "text": "Can we cut across this field on the way back?"
    },
    {
      "id": "p02-a-12-s06",
      "speaker": "Cole",
      "text": "No, that's private land. Stay on the marked path."
    },
    {
      "id": "p02-a-12-s07",
      "speaker": "Amina",
      "text": "Will we still see the ocean from the lower route?"
    },
    {
      "id": "p02-a-12-s08",
      "speaker": "Cole",
      "text": "Yes, there's a clear view from the bench. Take that route today."
    },
    {
      "id": "p02-a-12-s09",
      "speaker": "Amina",
      "text": "We will. I'll mark the turning on the map."
    }
  ],
