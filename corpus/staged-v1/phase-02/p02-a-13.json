{
  "id": "p02-a-13",
  "title_zh": "赶上最后一班接驳车",
  "topic_id": "travel",
  "scenario": {
    "id": "catch-last-shuttle",
    "label_zh": "赶上末班接驳车",
    "goal_zh": "确认末班车出发时间并马上前往上车点。"
  },
  "participants": [
    "Bianca",
    "Hugo"
  ],
  "context_zh": "旅客在车站问讯处确认旅馆接驳车是否还有车。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-13-s01",
      "speaker": "Bianca",
      "text": "Am I too late for the hotel shuttle?"
    },
    {
      "id": "p02-a-13-s02",
      "speaker": "Hugo",
      "text": "Not quite. The last shuttle will leave in a minute."
    },
    {
      "id": "p02-a-13-s03",
      "speaker": "Bianca",
      "text": "Is there a later one if I miss this?"
    },
    {
      "id": "p02-a-13-s04",
      "speaker": "Hugo",
      "text": "No, you'd need a taxi after this one."
    },
    {
      "id": "p02-a-13-s05",
      "speaker": "Bianca",
      "text": "Which door should I use?"
    },
    {
      "id": "p02-a-13-s06",
      "speaker": "Hugo",
      "text": "The sliding doors behind you. Go now and the driver will see you."
    },
    {
      "id": "p02-a-13-s07",
      "speaker": "Bianca",
      "text": "I see the bus. Thanks for your help!"
    }
  ],
