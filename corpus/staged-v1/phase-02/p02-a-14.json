{
  "id": "p02-a-14",
  "title_zh": "确认适合参加的课程日期",
  "topic_id": "learning",
  "scenario": {
    "id": "course-term-calendar",
    "label_zh": "确认课程开课与结课日期",
    "goal_zh": "比较春季与秋季班的月份并选定报名时间。"
  },
  "participants": [
    "Evan",
    "Ruth"
  ],
  "context_zh": "想学陶艺的学员工作安排有变，向课程办公室核对各期开课日期。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-14-s01",
      "speaker": "Evan",
      "text": "I can't attend the course that starts in March. When is the next one?"
    },
    {
      "id": "p02-a-14-s02",
      "speaker": "Ruth",
      "text": "In May. Will you be back by then?"
    },
    {
      "id": "p02-a-14-s03",
      "speaker": "Evan",
      "text": "I'll be away for the whole month, unfortunately. Is there an autumn course?"
    },
    {
      "id": "p02-a-14-s04",
      "speaker": "Ruth",
      "text": "Yes, it starts in October and finishes in November."
    },
    {
      "id": "p02-a-14-s05",
      "speaker": "Evan",
      "text": "That fits my schedule. Can I book now?"
    },
    {
      "id": "p02-a-14-s06",
      "speaker": "Ruth",
      "text": "Registration opens in August. Shall I send you the course dates?"
    },
    {
      "id": "p02-a-14-s07",
      "speaker": "Evan",
      "text": "Please do. I'll put a reminder in my calendar."
    }
  ],
