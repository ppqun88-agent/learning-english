{
  "id": "p02-a-15",
  "title_zh": "安排父母结婚周年聚餐",
  "topic_id": "relationships",
  "scenario": {
    "id": "parents-anniversary-table",
    "label_zh": "安排父母结婚周年聚餐",
    "goal_zh": "确定参加人数并为家庭纪念日协调见面时间。"
  },
  "participants": [
    "Ruby",
    "Nathan"
  ],
  "context_zh": "兄妹为父母的结婚纪念日安排餐馆聚餐，核对谁能提前到场。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-15-s01",
      "speaker": "Ruby",
      "text": "Mom and Dad have been married for nineteen years this Friday. Shall we take them out?"
    },
    {
      "id": "p02-a-15-s02",
      "speaker": "Nathan",
      "text": "Definitely. How many people are coming?"
    },
    {
      "id": "p02-a-15-s03",
      "speaker": "Ruby",
      "text": "Eight. Most guests can get there by six, but Aunt Jean will arrive a bit later."
    },
    {
      "id": "p02-a-15-s04",
      "speaker": "Nathan",
      "text": "Let's meet outside the restaurant at quarter to six to set up the flowers."
    },
    {
      "id": "p02-a-15-s05",
      "speaker": "Ruby",
      "text": "Good plan. Our mother has already guessed we're arranging something."
    },
    {
      "id": "p02-a-15-s06",
      "speaker": "Nathan",
      "text": "Then let's keep the flowers a surprise, at least."
    },
    {
      "id": "p02-a-15-s07",
      "speaker": "Ruby",
      "text": "I'll book a table for eight and tell everyone the time."
    }
  ],
