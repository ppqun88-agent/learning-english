{
  "id": "p02-a-16",
  "title_zh": "配合诊所护士检查",
  "topic_id": "health",
  "scenario": {
    "id": "clinic-examination-cooperation",
    "label_zh": "配合诊所护士检查",
    "goal_zh": "说明身体不适并理解检查期间的要求。"
  },
  "participants": [
    "Marina",
    "Felix"
  ],
  "context_zh": "患者在预约就诊时向护士说明腿部疼痛及感冒症状，由护士安排医生检查。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-16-s01",
      "speaker": "Marina",
      "text": "I'm Marina, the nurse. What would you like the doctor to check today?"
    },
    {
      "id": "p02-a-16-s02",
      "speaker": "Felix",
      "text": "My leg hurts when I walk. I've also got a blocked nose."
    },
    {
      "id": "p02-a-16-s03",
      "speaker": "Marina",
      "text": "I'll make a note of both. Can you lie on the couch while I call the doctor in?"
    },
    {
      "id": "p02-a-16-s04",
      "speaker": "Felix",
      "text": "Yes. Is it all right if I keep my shoes on until then?"
    },
    {
      "id": "p02-a-16-s05",
      "speaker": "Marina",
      "text": "For now, yes. You must tell us if changing position makes the pain worse."
    },
    {
      "id": "p02-a-16-s06",
      "speaker": "Felix",
      "text": "I will. My mouth feels dry too. May I have some water?"
    },
    {
      "id": "p02-a-16-s07",
      "speaker": "Marina",
      "text": "Of course. I'll bring a cup and let the doctor know you're ready."
    }
  ],
