{
  "id": "p02-a-18",
  "title_zh": "进入第一次线上电脑课",
  "topic_id": "learning",
  "scenario": {
    "id": "computer-class-connection",
    "label_zh": "进入线上电脑课程",
    "goal_zh": "找到登录入口并按要求设置课堂摄像头。"
  },
  "participants": [
    "Eli",
    "Keisha"
  ],
  "context_zh": "第一次上网课的学员通过电话请课程助手指导登录。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-18-s01",
      "speaker": "Eli",
      "text": "I've never joined an online class before. I'm at the login screen."
    },
    {
      "id": "p02-a-18-s02",
      "speaker": "Keisha",
      "text": "Do you have a mouse connected?"
    },
    {
      "id": "p02-a-18-s03",
      "speaker": "Eli",
      "text": "Yes, I have one beside the keyboard."
    },
    {
      "id": "p02-a-18-s04",
      "speaker": "Keisha",
      "text": "Use it to click the blue button on the screen."
    },
    {
      "id": "p02-a-18-s05",
      "speaker": "Eli",
      "text": "It asks for a number. Is that my phone number?"
    },
    {
      "id": "p02-a-18-s06",
      "speaker": "Keisha",
      "text": "No, not your phone number. Enter the six digits in the class email."
    },
    {
      "id": "p02-a-18-s07",
      "speaker": "Eli",
      "text": "Done. Should I open the camera window as well?"
    },
    {
      "id": "p02-a-18-s08",
      "speaker": "Keisha",
      "text": "You can leave the camera off until the tutor asks you to introduce yourself."
    },
    {
      "id": "p02-a-18-s09",
      "speaker": "Eli",
      "text": "All right. I can see the tutor now. Thanks!"
    }
  ],
