{
  "id": "p02-a-19",
  "title_zh": "协调足球比赛到场时间",
  "topic_id": "leisure",
  "scenario": {
    "id": "football-match-arrival",
    "label_zh": "协调足球比赛到场时间",
    "goal_zh": "确认比赛时间、时长及接送安排。"
  },
  "participants": [
    "Leonie",
    "Darren"
  ],
  "context_zh": "家长与教练商量周末比赛的到达和接回时间。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-19-s01",
      "speaker": "Leonie",
      "text": "Does the match start at nine?"
    },
    {
      "id": "p02-a-19-s02",
      "speaker": "Darren",
      "text": "No, that's when the team needs to arrive. Kick-off is at half past."
    },
    {
      "id": "p02-a-19-s03",
      "speaker": "Leonie",
      "text": "Oh, I nearly booked a taxi for the wrong time."
    },
    {
      "id": "p02-a-19-s04",
      "speaker": "Darren",
      "text": "It's a full ninety minutes of football, plus the break, so don't rush back too early."
    },
    {
      "id": "p02-a-19-s05",
      "speaker": "Leonie",
      "text": "Would quarter past eleven be sensible for pickup?"
    },
    {
      "id": "p02-a-19-s06",
      "speaker": "Darren",
      "text": "Yes. I'll wait with your son by the clubhouse."
    },
    {
      "id": "p02-a-19-s07",
      "speaker": "Leonie",
      "text": "OK, I'll arrange the taxi for then. Thanks for checking."
    }
  ],
