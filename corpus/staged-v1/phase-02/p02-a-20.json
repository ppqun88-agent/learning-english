{
  "id": "p02-a-20",
  "title_zh": "早班同事交接资料",
  "topic_id": "work",
  "scenario": {
    "id": "morning-task-handover",
    "label_zh": "交接早班工作资料",
    "goal_zh": "确认待打印文件和接替安排以便同事准时离开。"
  },
  "participants": [
    "Rosa",
    "Theo"
  ],
  "context_zh": "两位办公室同事在早班交接时核对访客材料的打印工作。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-20-s01",
      "speaker": "Rosa",
      "text": "Can you cover the office for me this morning? I have an appointment at ten."
    },
    {
      "id": "p02-a-20-s02",
      "speaker": "Theo",
      "text": "Sure. Give me a moment to save this file."
    },
    {
      "id": "p02-a-20-s03",
      "speaker": "Rosa",
      "text": "I need to leave in about twenty minutes. The visitor packs aren't quite ready."
    },
    {
      "id": "p02-a-20-s04",
      "speaker": "Theo",
      "text": "How many more copies do we need?"
    },
    {
      "id": "p02-a-20-s05",
      "speaker": "Rosa",
      "text": "Three. The original is beside the printer, and I've already checked the names."
    },
    {
      "id": "p02-a-20-s06",
      "speaker": "Theo",
      "text": "I'll finish those and put the packs at reception. You can go."
    },
    {
      "id": "p02-a-20-s07",
      "speaker": "Rosa",
      "text": "Thanks a lot. I'll be back before lunch."
    }
  ],
