{
  "id": "p02-a-21",
  "title_zh": "寻找集市里的摊位",
  "topic_id": "services",
  "scenario": {
    "id": "find-market-stall",
    "label_zh": "寻找集市摊位",
    "goal_zh": "根据购物清单和方向说明找到目标摊位。"
  },
  "participants": [
    "Anika",
    "Wes"
  ],
  "context_zh": "顾客在集市入口向工作人员询问蔬菜摊的位置和排队方式。",
  "author": "author-phase02-a",
  "sentences": [
    {
      "id": "p02-a-21-s01",
      "speaker": "Anika",
      "text": "Is this the main entrance to the market?"
    },
    {
      "id": "p02-a-21-s02",
      "speaker": "Wes",
      "text": "Yes. What are you looking for?"
    },
    {
      "id": "p02-a-21-s03",
      "speaker": "Anika",
      "text": "I've got a short shopping list. I need tomatoes and fresh herbs."
    },
    {
      "id": "p02-a-21-s04",
      "speaker": "Wes",
      "text": "Turn left after the bread stall. The vegetable stall is at the end."
    },
    {
      "id": "p02-a-21-s05",
      "speaker": "Anika",
      "text": "Is that long line for the vegetables?"
    },
    {
      "id": "p02-a-21-s06",
      "speaker": "Wes",
      "text": "No, those people are waiting for coffee. You can go straight past them."
    },
    {
      "id": "p02-a-21-s07",
      "speaker": "Anika",
      "text": "Great, I can see the tomatoes now. Thank you."
    }
  ],
