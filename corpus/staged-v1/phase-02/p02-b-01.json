{
  "id": "p02-b-01",
  "title_zh": "点一份清淡的鱼餐",
  "topic_id": "food",
  "scenario": {
    "id": "restaurant-meal-order",
    "label_zh": "在餐厅选择清淡餐点",
    "goal_zh": "核对酱汁、配菜和调味需求后完成点餐"
  },
  "participants": [
    "Elena",
    "Marcus"
  ],
  "context_zh": "顾客第一次来这家餐厅，希望选一份不油腻的晚餐。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-01-s01",
      "speaker": "Elena",
      "text": "Can I order now?"
    },
    {
      "id": "p02-b-01-s02",
      "speaker": "Marcus",
      "text": "Of course. The fish is the most popular dish at this restaurant."
    },
    {
      "id": "p02-b-01-s03",
      "speaker": "Elena",
      "text": "Is the sauce very rich? I prefer something light."
    },
    {
      "id": "p02-b-01-s04",
      "speaker": "Marcus",
      "text": "We can serve the fish without the sauce, with rice and vegetables."
    },
    {
      "id": "p02-b-01-s05",
      "speaker": "Elena",
      "text": "That sounds good. No extra salt, please."
    },
    {
      "id": "p02-b-01-s06",
      "speaker": "Marcus",
      "text": "Would you like some black pepper on the side?"
    },
    {
      "id": "p02-b-01-s07",
      "speaker": "Elena",
      "text": "Yes, and an orange for dessert, if you have one."
    },
    {
      "id": "p02-b-01-s08",
      "speaker": "Marcus",
      "text": "We do. I'll bring the fish first and the fruit afterwards."
    }
  ],
