{
  "id": "p02-b-02",
  "title_zh": "出发前打包野餐",
  "topic_id": "food",
  "scenario": {
    "id": "picnic-packing",
    "label_zh": "核对野餐食物与装包",
    "goal_zh": "确认周末野餐食物已经备好并装入合适的袋子"
  },
  "participants": [
    "Tessa",
    "Owen"
  ],
  "context_zh": "朋友准备周六的野餐，出门前检查冷藏食品。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-02-s01",
      "speaker": "Tessa",
      "text": "Have we got everything for our Saturday picnic?"
    },
    {
      "id": "p02-b-02-s02",
      "speaker": "Owen",
      "text": "Yes. I've made a sandwich for each of us, and there's potato salad in the fridge."
    },
    {
      "id": "p02-b-02-s03",
      "speaker": "Tessa",
      "text": "Shall I put the salad in the cool bag now?"
    },
    {
      "id": "p02-b-02-s04",
      "speaker": "Owen",
      "text": "Please do. The ice packs are already in there."
    },
    {
      "id": "p02-b-02-s05",
      "speaker": "Tessa",
      "text": "Then we're ready, apart from the water."
    },
    {
      "id": "p02-b-02-s06",
      "speaker": "Owen",
      "text": "I've got the bottles. Let's go."
    }
  ],
