{
  "id": "p02-b-03",
  "title_zh": "给姐姐画一幅花",
  "topic_id": "leisure",
  "scenario": {
    "id": "painting-gift-workshop",
    "label_zh": "调整礼物画作的配色",
    "goal_zh": "根据收礼人的喜好调整花卉画的色彩"
  },
  "participants": [
    "Nia",
    "Arthur"
  ],
  "context_zh": "美术课上，学员想画一幅适合姐姐家里摆放的作品。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-03-s01",
      "speaker": "Nia",
      "text": "I want to paint a small picture of these flowers, but the colours look wrong."
    },
    {
      "id": "p02-b-03-s02",
      "speaker": "Arthur",
      "text": "Is the painting a gift?"
    },
    {
      "id": "p02-b-03-s03",
      "speaker": "Nia",
      "text": "Yes, for my sister. Her room is mostly white and pink."
    },
    {
      "id": "p02-b-03-s04",
      "speaker": "Arthur",
      "text": "Then those dark purple flowers may be a little strong. Try using fewer of them."
    },
    {
      "id": "p02-b-03-s05",
      "speaker": "Nia",
      "text": "Could I add a red flower in the middle?"
    },
    {
      "id": "p02-b-03-s06",
      "speaker": "Arthur",
      "text": "You could, but it would draw all the attention. Try a lighter colour first."
    },
    {
      "id": "p02-b-03-s07",
      "speaker": "Nia",
      "text": "Oh, that looks pretty. The flowers look softer now."
    },
    {
      "id": "p02-b-03-s08",
      "speaker": "Arthur",
      "text": "Good. Leave that version to dry before you decide whether to add anything else."
    }
  ],
