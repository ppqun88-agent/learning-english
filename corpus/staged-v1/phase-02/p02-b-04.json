{
  "id": "p02-b-04",
  "title_zh": "换到合适的裤子和鞋",
  "topic_id": "services",
  "scenario": {
    "id": "clothing-fit-exchange",
    "label_zh": "试穿并调整服装尺码",
    "goal_zh": "根据试穿结果更换裤子和鞋的尺码并完成购物"
  },
  "participants": [
    "Gabriel",
    "Lena"
  ],
  "context_zh": "顾客在服装店试穿一套参加聚会的衣服。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-04-s01",
      "speaker": "Gabriel",
      "text": "These pants are too long. Do you have a shorter pair?"
    },
    {
      "id": "p02-b-04-s02",
      "speaker": "Lena",
      "text": "Yes. Would you like to keep the shirt you have on?"
    },
    {
      "id": "p02-b-04-s03",
      "speaker": "Gabriel",
      "text": "I would. The left shoe feels tight, though."
    },
    {
      "id": "p02-b-04-s04",
      "speaker": "Lena",
      "text": "I'll bring a larger size. Is the other shoe tight as well?"
    },
    {
      "id": "p02-b-04-s05",
      "speaker": "Gabriel",
      "text": "A little. Does this shop sell belts too?"
    },
    {
      "id": "p02-b-04-s06",
      "speaker": "Lena",
      "text": "We do, just beside the checkout."
    },
    {
      "id": "p02-b-04-s07",
      "speaker": "Gabriel",
      "text": "Actually, I can use my own belt. I don't need another one."
    },
    {
      "id": "p02-b-04-s08",
      "speaker": "Lena",
      "text": "Here are the shorter pants and the larger shoes. How do they feel?"
    },
    {
      "id": "p02-b-04-s09",
      "speaker": "Gabriel",
      "text": "Much better. I can finally finish my shopping."
    },
    {
      "id": "p02-b-04-s10",
      "speaker": "Lena",
      "text": "Great. I'll take those to the checkout for you."
    }
  ],
