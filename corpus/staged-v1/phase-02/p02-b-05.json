{
  "id": "p02-b-05",
  "title_zh": "重新找回阅读习惯",
  "topic_id": "leisure",
  "scenario": {
    "id": "library-story-choice",
    "label_zh": "挑选轻松易读的故事",
    "goal_zh": "选定一本篇幅适中且结局不悲伤的图书"
  },
  "participants": [
    "Hana",
    "Felix"
  ],
  "context_zh": "读者很久没借书，希望找到容易开始的一本。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-05-s01",
      "speaker": "Hana",
      "text": "I used to do a lot of reading, but I hardly open a book now."
    },
    {
      "id": "p02-b-05-s02",
      "speaker": "Felix",
      "text": "Would a collection of stories help?"
    },
    {
      "id": "p02-b-05-s03",
      "speaker": "Hana",
      "text": "Maybe. I'm a slow reader, so I'd like to read something short."
    },
    {
      "id": "p02-b-05-s04",
      "speaker": "Felix",
      "text": "Try this one. The main character is based on a real person who ran a village shop."
    },
    {
      "id": "p02-b-05-s05",
      "speaker": "Hana",
      "text": "Does it have a sad ending?"
    },
    {
      "id": "p02-b-05-s06",
      "speaker": "Felix",
      "text": "Not really. Some things go wrong, but she makes a new start. Try the first page."
    },
    {
      "id": "p02-b-05-s07",
      "speaker": "Hana",
      "text": "I like the way she talks. I'll borrow this one."
    },
    {
      "id": "p02-b-05-s08",
      "speaker": "Felix",
      "text": "Lovely. Bring it to the desk and we can check it out."
    }
  ],
