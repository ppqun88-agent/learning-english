{
  "id": "p02-b-06",
  "title_zh": "修改课堂短文",
  "topic_id": "learning",
  "scenario": {
    "id": "writing-exercise-revision",
    "label_zh": "核对并修改写作练习",
    "goal_zh": "澄清题目要求后修订段落中的不清楚表达"
  },
  "participants": [
    "Isaac",
    "Priya"
  ],
  "context_zh": "学生交稿前请老师检查旅行短文的开头。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-06-s01",
      "speaker": "Isaac",
      "text": "Can I ask a question about the writing task?"
    },
    {
      "id": "p02-b-06-s02",
      "speaker": "Priya",
      "text": "Of course. Show me your first paragraph."
    },
    {
      "id": "p02-b-06-s03",
      "speaker": "Isaac",
      "text": "Here it is, on this piece of paper. I wrote about the bus journey."
    },
    {
      "id": "p02-b-06-s04",
      "speaker": "Priya",
      "text": "This sentence has two different ideas. Where does the bus stop, and where do you walk from?"
    },
    {
      "id": "p02-b-06-s05",
      "speaker": "Isaac",
      "text": "At the station. I see what you mean. Is the phrase 'from there' clearer?"
    },
    {
      "id": "p02-b-06-s06",
      "speaker": "Priya",
      "text": "Yes, if you name the station first. Use a pencil to try the change."
    },
    {
      "id": "p02-b-06-s07",
      "speaker": "Isaac",
      "text": "Then I'll copy the final version in pen. Is that all right?"
    },
    {
      "id": "p02-b-06-s08",
      "speaker": "Priya",
      "text": "Yes. Keep the rest; the order of events is easy to follow now."
    }
  ],
