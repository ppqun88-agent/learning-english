{
  "id": "p02-b-07",
  "title_zh": "报名九月晚间课程",
  "topic_id": "learning",
  "scenario": {
    "id": "evening-course-place-hold",
    "label_zh": "核对晚间课程报名并暂留名额",
    "goal_zh": "核对课程时间、报名资格与表格填写要求，并确认暂留名额"
  },
  "participants": [
    "Moira",
    "Dev"
  ],
  "context_zh": "家长替即将满十八岁的女儿咨询晚间语言课程。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-07-s01",
      "speaker": "Moira",
      "text": "Does the school have an evening language course in September?"
    },
    {
      "id": "p02-b-07-s02",
      "speaker": "Dev",
      "text": "Yes. It runs for seven weeks. Is the course for you?"
    },
    {
      "id": "p02-b-07-s03",
      "speaker": "Moira",
      "text": "No, for my daughter. She's seventeen. Can she join?"
    },
    {
      "id": "p02-b-07-s04",
      "speaker": "Dev",
      "text": "She can, but a parent must sign the form because she is under eighteen."
    },
    {
      "id": "p02-b-07-s05",
      "speaker": "Moira",
      "text": "Do I fill in her personal details here, or mine?"
    },
    {
      "id": "p02-b-07-s06",
      "speaker": "Dev",
      "text": "Hers in the first box, and yours under emergency contact."
    },
    {
      "id": "p02-b-07-s07",
      "speaker": "Moira",
      "text": "Can she bring the form in person tomorrow?"
    },
    {
      "id": "p02-b-07-s08",
      "speaker": "Dev",
      "text": "Yes. I'll keep a place for her until tomorrow afternoon."
    }
  ],
