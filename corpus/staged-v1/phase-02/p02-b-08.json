{
  "id": "p02-b-08",
  "title_zh": "分工准备生日惊喜",
  "topic_id": "relationships",
  "scenario": {
    "id": "surprise-birthday-planning",
    "label_zh": "安排生日惊喜与分工",
    "goal_zh": "商定人数、食物和礼物以完成惊喜聚会准备"
  },
  "participants": [
    "Amir",
    "Cleo"
  ],
  "context_zh": "两位朋友正在为共同的朋友准备生日惊喜。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-08-s01",
      "speaker": "Amir",
      "text": "How many people are coming to our party for Jo?"
    },
    {
      "id": "p02-b-08-s02",
      "speaker": "Cleo",
      "text": "Eight, including Jo and her partner."
    },
    {
      "id": "p02-b-08-s03",
      "speaker": "Amir",
      "text": "I can prepare the food. Have you bought a present yet?"
    },
    {
      "id": "p02-b-08-s04",
      "speaker": "Cleo",
      "text": "I was thinking of a cookbook."
    },
    {
      "id": "p02-b-08-s05",
      "speaker": "Amir",
      "text": "That's the same gift we gave her last year."
    },
    {
      "id": "p02-b-08-s06",
      "speaker": "Cleo",
      "text": "You're right. What about tickets for a cooking class instead?"
    },
    {
      "id": "p02-b-08-s07",
      "speaker": "Amir",
      "text": "She'd love that. I'll check which evening she's free without telling her why."
    },
    {
      "id": "p02-b-08-s08",
      "speaker": "Cleo",
      "text": "Good idea. I'll wait for your message before I book anything."
    }
  ],
