{
  "id": "p02-b-09",
  "title_zh": "排练前解决合唱难点",
  "topic_id": "leisure",
  "scenario": {
    "id": "choir-rehearsal-plan",
    "label_zh": "安排合唱排练与伴奏",
    "goal_zh": "确认替补伴奏并确定困难声部的练习方式"
  },
  "participants": [
    "Ruth",
    "Jasper"
  ],
  "context_zh": "合唱团的固定伴奏请假，指挥请另一位成员帮忙。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-09-s01",
      "speaker": "Ruth",
      "text": "We have practice at six. Could you play the piano for us?"
    },
    {
      "id": "p02-b-09-s02",
      "speaker": "Jasper",
      "text": "I can. Is your usual piano player away?"
    },
    {
      "id": "p02-b-09-s03",
      "speaker": "Ruth",
      "text": "Yes, until next week. The first piece is easy, but we need help with the next one."
    },
    {
      "id": "p02-b-09-s04",
      "speaker": "Jasper",
      "text": "Could you show me where it gets difficult?"
    },
    {
      "id": "p02-b-09-s05",
      "speaker": "Ruth",
      "text": "Here. The lower voices keep losing their part when the others come in."
    },
    {
      "id": "p02-b-09-s06",
      "speaker": "Jasper",
      "text": "Then let them sing it alone first, without the higher voices."
    },
    {
      "id": "p02-b-09-s07",
      "speaker": "Ruth",
      "text": "Should we repeat those four bars until everyone is comfortable?"
    },
    {
      "id": "p02-b-09-s08",
      "speaker": "Jasper",
      "text": "Yes, and ask them to practise that passage at home before Friday."
    },
    {
      "id": "p02-b-09-s09",
      "speaker": "Ruth",
      "text": "That gives us a clear plan. I'll bring extra copies of the music."
    }
  ],
