{
  "id": "p02-b-10",
  "title_zh": "沿河走到公园",
  "topic_id": "travel",
  "scenario": {
    "id": "riverside-walking-directions",
    "label_zh": "核实到公园的步行路线",
    "goal_zh": "借助地图确认路口方向和过河位置"
  },
  "participants": [
    "Ines",
    "Caleb"
  ],
  "context_zh": "游客向咖啡店员工询问如何步行去河对岸的公园。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-10-s01",
      "speaker": "Ines",
      "text": "Is there a way to walk to the park from here?"
    },
    {
      "id": "p02-b-10-s02",
      "speaker": "Caleb",
      "text": "Yes. Turn right outside this building and follow the road towards the water."
    },
    {
      "id": "p02-b-10-s03",
      "speaker": "Ines",
      "text": "Do I go past the old mill?"
    },
    {
      "id": "p02-b-10-s04",
      "speaker": "Caleb",
      "text": "You do. There's a footbridge just beyond it. Go over the bridge, and the park entrance is on your left."
    },
    {
      "id": "p02-b-10-s05",
      "speaker": "Ines",
      "text": "Could you point to the bridge on my map? I can see the river, but not the crossing."
    },
    {
      "id": "p02-b-10-s06",
      "speaker": "Caleb",
      "text": "Here, beside this small blue mark."
    },
    {
      "id": "p02-b-10-s07",
      "speaker": "Ines",
      "text": "Got it. I'll use that route. Thanks for checking."
    }
  ],
