{
  "id": "p02-b-11",
  "title_zh": "换到安静的客房",
  "topic_id": "travel",
  "scenario": {
    "id": "quiet-hotel-room",
    "label_zh": "入住时选择安静客房",
    "goal_zh": "避开晚间噪音并确认合适的房间"
  },
  "participants": [
    "Sofia",
    "Ben"
  ],
  "context_zh": "客人长途旅行后希望尽快休息，担心街边酒吧的声音。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-11-s01",
      "speaker": "Sofia",
      "text": "Is it possible to have a room away from the street?"
    },
    {
      "id": "p02-b-11-s02",
      "speaker": "Ben",
      "text": "Certainly. Is the noise the main concern?"
    },
    {
      "id": "p02-b-11-s03",
      "speaker": "Sofia",
      "text": "Yes. I'm quite tired, and I'd like somewhere quiet so I can relax."
    },
    {
      "id": "p02-b-11-s04",
      "speaker": "Ben",
      "text": "We have a room facing the courtyard. It is smaller, but there are no bars on that side."
    },
    {
      "id": "p02-b-11-s05",
      "speaker": "Sofia",
      "text": "Does it still have a window that opens?"
    },
    {
      "id": "p02-b-11-s06",
      "speaker": "Ben",
      "text": "It does, and the price is unchanged."
    },
    {
      "id": "p02-b-11-s07",
      "speaker": "Sofia",
      "text": "Perfect. I'll take that one."
    },
    {
      "id": "p02-b-11-s08",
      "speaker": "Ben",
      "text": "Here is the key. I'll move your booking to the courtyard side."
    }
  ],
