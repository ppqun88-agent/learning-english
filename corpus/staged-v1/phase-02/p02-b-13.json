{
  "id": "p02-b-13",
  "title_zh": "更换收音效果不好的收音机",
  "topic_id": "services",
  "scenario": {
    "id": "faulty-radio-return",
    "label_zh": "退换有问题的收音机",
    "goal_zh": "说明质量问题并确认替代商品及费用"
  },
  "participants": [
    "Leo",
    "Mina"
  ],
  "context_zh": "顾客带着新买的收音机和收据到店，希望当天换好。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-13-s01",
      "speaker": "Leo",
      "text": "Can I return this radio? The sound is very poor, even near the window."
    },
    {
      "id": "p02-b-13-s02",
      "speaker": "Mina",
      "text": "What seems to be the problem? Is it noisy on every station?"
    },
    {
      "id": "p02-b-13-s03",
      "speaker": "Leo",
      "text": "Yes, and the product page said it had a headphone socket, but it does not."
    },
    {
      "id": "p02-b-13-s04",
      "speaker": "Mina",
      "text": "You are right. The description is wrong. We have a similar model with that socket."
    },
    {
      "id": "p02-b-13-s05",
      "speaker": "Leo",
      "text": "Would I have to pay anything extra?"
    },
    {
      "id": "p02-b-13-s06",
      "speaker": "Mina",
      "text": "No. We can exchange it at the same price, or give you a refund."
    },
    {
      "id": "p02-b-13-s07",
      "speaker": "Leo",
      "text": "I need a replacement quickly. Can I test the other one here?"
    },
    {
      "id": "p02-b-13-s08",
      "speaker": "Mina",
      "text": "Absolutely. Try these headphones."
    },
    {
      "id": "p02-b-13-s09",
      "speaker": "Leo",
      "text": "That sounds clear. I'll take this one instead."
    },
    {
      "id": "p02-b-13-s10",
      "speaker": "Mina",
      "text": "I'll make the exchange now and correct the description on our website."
    }
  ],
