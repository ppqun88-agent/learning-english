{
  "id": "p02-b-14",
  "title_zh": "让科学报告的结论更谨慎",
  "topic_id": "learning",
  "scenario": {
    "id": "school-science-feedback",
    "label_zh": "根据反馈修改科学项目报告",
    "goal_zh": "区分一次观察结果与普遍结论并补充研究限制"
  },
  "participants": [
    "Asha",
    "Noel"
  ],
  "context_zh": "学生向同学解释科学展示活动后收到的修改建议。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-14-s01",
      "speaker": "Asha",
      "text": "Did the visiting scientist look at your science project?"
    },
    {
      "id": "p02-b-14-s02",
      "speaker": "Noel",
      "text": "Yes. Her feedback was positive, but she said the report needed a clearer ending."
    },
    {
      "id": "p02-b-14-s03",
      "speaker": "Asha",
      "text": "What did your experiment show?"
    },
    {
      "id": "p02-b-14-s04",
      "speaker": "Noel",
      "text": "The result was that one seedling grew taller under the lamp. I wrote that this light helps all plants grow."
    },
    {
      "id": "p02-b-14-s05",
      "speaker": "Asha",
      "text": "But you only tested two seedlings, right?"
    },
    {
      "id": "p02-b-14-s06",
      "speaker": "Noel",
      "text": "Exactly. I'll describe what happened to those two, and say we need to test more."
    },
    {
      "id": "p02-b-14-s07",
      "speaker": "Asha",
      "text": "That sounds much closer to what you actually found."
    }
  ],
