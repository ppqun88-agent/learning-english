{
  "id": "p02-b-15",
  "title_zh": "控制筹款海报的印刷成本",
  "topic_id": "community",
  "scenario": {
    "id": "fundraiser-poster-planning",
    "label_zh": "安排筹款活动海报",
    "goal_zh": "确定照片、印量和线上发布安排"
  },
  "participants": [
    "Bea",
    "Tariq"
  ],
  "context_zh": "社区筹款活动的志愿者讨论海报照片和有限的印刷预算。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-15-s01",
      "speaker": "Bea",
      "text": "Can you photograph the band on Sunday for our fundraiser poster?"
    },
    {
      "id": "p02-b-15-s02",
      "speaker": "Tariq",
      "text": "Yes. A photo of them in the garden would look good. Have they agreed to be on it?"
    },
    {
      "id": "p02-b-15-s03",
      "speaker": "Bea",
      "text": "They have. They are popular locally, so people may recognise them."
    },
    {
      "id": "p02-b-15-s04",
      "speaker": "Tariq",
      "text": "What is the plan for printing?"
    },
    {
      "id": "p02-b-15-s05",
      "speaker": "Bea",
      "text": "I thought we could print seventy copies, but each one costs a pound."
    },
    {
      "id": "p02-b-15-s06",
      "speaker": "Tariq",
      "text": "That's most of our budget. Could we print twenty and send the rest by email?"
    },
    {
      "id": "p02-b-15-s07",
      "speaker": "Bea",
      "text": "Yes, and we can post it on the community website too."
    },
    {
      "id": "p02-b-15-s08",
      "speaker": "Tariq",
      "text": "Good. Remember to include the booking link, not just the date."
    },
    {
      "id": "p02-b-15-s09",
      "speaker": "Bea",
      "text": "I will. Let's get one printed copy first to check the colours."
    },
    {
      "id": "p02-b-15-s10",
      "speaker": "Tariq",
      "text": "Agreed. I'll send you the pictures on Sunday evening."
    }
  ],
