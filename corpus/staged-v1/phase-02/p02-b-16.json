{
  "id": "p02-b-16",
  "title_zh": "在机场出口碰面",
  "topic_id": "travel",
  "scenario": {
    "id": "airport-pickup-location",
    "label_zh": "协调机场接人",
    "goal_zh": "确认机场接人地点、到达时间及联络方式。"
  },
  "participants": [
    "Clara",
    "Hugo"
  ],
  "context_zh": "航班落地后，旅客打电话给前来接机的朋友。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-16-s01",
      "speaker": "Clara",
      "text": "The plane landed at seven o’clock. I am waiting for my bag now."
    },
    {
      "id": "p02-b-16-s02",
      "speaker": "Hugo",
      "text": "That was early. I will probably reach the airport at a quarter past seven."
    },
    {
      "id": "p02-b-16-s03",
      "speaker": "Clara",
      "text": "No rush. Should I phone you when I reach the exit?"
    },
    {
      "id": "p02-b-16-s04",
      "speaker": "Hugo",
      "text": "Yes. Wait a second, which terminal are you in?"
    },
    {
      "id": "p02-b-16-s05",
      "speaker": "Clara",
      "text": "Terminal Two. I can see the sign above the baggage desk."
    },
    {
      "id": "p02-b-16-s06",
      "speaker": "Hugo",
      "text": "Then follow the signs for the short-stay car park. I will meet you beside the lift."
    },
    {
      "id": "p02-b-16-s07",
      "speaker": "Clara",
      "text": "All right. I will call when I get there."
    }
  ],
