{
  "id": "p02-b-19",
  "title_zh": "请病假并交接早班",
  "topic_id": "work",
  "scenario": {
    "id": "sick-day-shift-cover",
    "label_zh": "协调病假期间的班次交接",
    "goal_zh": "确认替班人员及常规工作的交接内容"
  },
  "participants": [
    "Ellis",
    "Zara"
  ],
  "context_zh": "前台员工身体不适，早上联系值班主管安排替班。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-19-s01",
      "speaker": "Ellis",
      "text": "I'm sick and won't be able to cover the opening shift today."
    },
    {
      "id": "p02-b-19-s02",
      "speaker": "Zara",
      "text": "Thanks for calling early. You should stay home. I can ask Dan to cover."
    },
    {
      "id": "p02-b-19-s03",
      "speaker": "Ellis",
      "text": "He has not opened on his own before. I wrote down the morning routine in the desk folder."
    },
    {
      "id": "p02-b-19-s04",
      "speaker": "Zara",
      "text": "Good. I will stay with him through the busy period before ten."
    },
    {
      "id": "p02-b-19-s05",
      "speaker": "Ellis",
      "text": "Could you just tell everyone I am away today?"
    },
    {
      "id": "p02-b-19-s06",
      "speaker": "Zara",
      "text": "Of course. There is no need to share the reason with the whole team."
    },
    {
      "id": "p02-b-19-s07",
      "speaker": "Ellis",
      "text": "Thank you. The folder also has the number for the delivery driver."
    },
    {
      "id": "p02-b-19-s08",
      "speaker": "Zara",
      "text": "That is everything we need. I will handle the shift change."
    }
  ],
