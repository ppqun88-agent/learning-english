{
  "id": "p02-b-22",
  "title_zh": "到失物招领处找钱包",
  "topic_id": "services",
  "scenario": {
    "id": "lost-wallet-report",
    "label_zh": "查询并认领遗失钱包",
    "goal_zh": "说明报失经过并凭物品特征核实钱包"
  },
  "participants": [
    "Cameron",
    "Jules"
  ],
  "context_zh": "旅客按照车站警员的指引来到失物招领窗口。",
  "author": "author-phase02-b",
  "sentences": [
    {
      "id": "p02-b-22-s01",
      "speaker": "Cameron",
      "text": "Is this the right place to ask about a lost wallet?"
    },
    {
      "id": "p02-b-22-s02",
      "speaker": "Jules",
      "text": "Yes. Have you reported it to the police as well?"
    },
    {
      "id": "p02-b-22-s03",
      "speaker": "Cameron",
      "text": "A policeman at the station sent me here. He thought someone might have handed it in."
    },
    {
      "id": "p02-b-22-s04",
      "speaker": "Jules",
      "text": "Did he say whether he had seen it himself?"
    },
    {
      "id": "p02-b-22-s05",
      "speaker": "Cameron",
      "text": "No. Mine is brown, with a broken zip."
    },
    {
      "id": "p02-b-22-s06",
      "speaker": "Jules",
      "text": "We have one like that. Can you describe something inside it before I show it to you?"
    },
    {
      "id": "p02-b-22-s07",
      "speaker": "Cameron",
      "text": "There is a blue library card with my name on it, and a photo of a dog."
    },
    {
      "id": "p02-b-22-s08",
      "speaker": "Jules",
      "text": "Those match. Let us check your name against the card, then you can sign for it."
    }
  ],
