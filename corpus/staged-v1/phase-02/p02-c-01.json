{
  "id": "p02-c-01",
  "title_zh": "为生日演出询问歌曲点播",
  "topic_id": "leisure",
  "scenario": {
    "id": "concert-song-request",
    "label_zh": "为生日演出询问歌曲点播",
    "goal_zh": "确认演出时间、票价和生日点歌是否可行"
  },
  "participants": [
    "Noor",
    "Evan"
  ],
  "context_zh": "Noor 想带妹妹参加小型现场演出，向场地工作人员咨询。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-01-s01",
      "speaker": "Noor",
      "text": "Is Hana Moss the singer at Thursday's show?"
    },
    {
      "id": "p02-c-01-s02",
      "speaker": "Evan",
      "text": "Yes. She isn't a big star yet, but she has a wonderful voice."
    },
    {
      "id": "p02-c-01-s03",
      "speaker": "Noor",
      "text": "My sister loves her music. She'll be sixteen that day, and I'd like to make the evening special."
    },
    {
      "id": "p02-c-01-s04",
      "speaker": "Evan",
      "text": "You could ask Hana for a song. She usually takes requests at the end."
    },
    {
      "id": "p02-c-01-s05",
      "speaker": "Noor",
      "text": "Lovely. What does a ticket cost, and when does the music start?"
    },
    {
      "id": "p02-c-01-s06",
      "speaker": "Evan",
      "text": "It's twelve pounds, and the music starts at six. Doors open half an hour earlier."
    },
    {
      "id": "p02-c-01-s07",
      "speaker": "Noor",
      "text": "Great, thanks. I'll buy our tickets and send in a birthday request."
    }
  ],
