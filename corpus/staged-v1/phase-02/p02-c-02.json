{
  "id": "p02-c-02",
  "title_zh": "挑选合身的上班服装",
  "topic_id": "services",
  "scenario": {
    "id": "outfit-fitting-choice",
    "label_zh": "挑选合身的上班服装",
    "goal_zh": "根据着装要求、身高和预算选择裤装与搭配"
  },
  "participants": [
    "Imani",
    "Beth"
  ],
  "context_zh": "Imani 在服装店为第一天上班挑选衣服。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-02-s01",
      "speaker": "Imani",
      "text": "The dress code says smart but not formal. I don't want to spend much on a whole new outfit."
    },
    {
      "id": "p02-c-02-s02",
      "speaker": "Beth",
      "text": "Would you prefer a skirt or trousers?"
    },
    {
      "id": "p02-c-02-s03",
      "speaker": "Imani",
      "text": "Trousers. I'm tall, and the small size is usually too short."
    },
    {
      "id": "p02-c-02-s04",
      "speaker": "Beth",
      "text": "Try this style. It has a longer leg."
    },
    {
      "id": "p02-c-02-s05",
      "speaker": "Imani",
      "text": "These fit better than I expected. Could I wear them with a plain T-shirt?"
    },
    {
      "id": "p02-c-02-s06",
      "speaker": "Beth",
      "text": "Yes. This sweater would look good over it when it's cold."
    },
    {
      "id": "p02-c-02-s07",
      "speaker": "Imani",
      "text": "I'll take the trousers. I've already got a top and a sweater at home."
    }
  ],
