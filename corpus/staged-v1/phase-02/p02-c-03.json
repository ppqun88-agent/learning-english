{
  "id": "p02-c-03",
  "title_zh": "协商夜间电视音量",
  "topic_id": "home",
  "scenario": {
    "id": "late-night-television-noise",
    "label_zh": "协商夜间电视音量",
    "goal_zh": "说明噪声影响并商定当天停止观看"
  },
  "participants": [
    "Leo",
    "Samira"
  ],
  "context_zh": "两位合租者在晚间讨论穿墙的电视声。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-03-s01",
      "speaker": "Leo",
      "text": "Could you turn down the television? I'm trying to sleep."
    },
    {
      "id": "p02-c-03-s02",
      "speaker": "Samira",
      "text": "Of course. Is the sound coming through your wall?"
    },
    {
      "id": "p02-c-03-s03",
      "speaker": "Leo",
      "text": "Yes. I had a terrible night yesterday, and I'm really tired."
    },
    {
      "id": "p02-c-03-s04",
      "speaker": "Samira",
      "text": "I'm sorry. Sometimes I fall asleep with the TV on."
    },
    {
      "id": "p02-c-03-s05",
      "speaker": "Leo",
      "text": "Could you set a timer so it switches off?"
    },
    {
      "id": "p02-c-03-s06",
      "speaker": "Samira",
      "text": "Good idea. I'll do that tomorrow, and I'll stop watching now."
    },
    {
      "id": "p02-c-03-s07",
      "speaker": "Leo",
      "text": "Thank you. I need an early night tonight."
    },
    {
      "id": "p02-c-03-s08",
      "speaker": "Samira",
      "text": "No problem. Good night."
    }
  ],
