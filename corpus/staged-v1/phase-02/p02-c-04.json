{
  "id": "p02-c-04",
  "title_zh": "发现蛇后改走安全路线",
  "topic_id": "nature",
  "scenario": {
    "id": "park-snake-path-warning",
    "label_zh": "发现蛇后改走安全路线",
    "goal_zh": "保持距离、通知管理人员并避开受影响的小径"
  },
  "participants": [
    "Asha",
    "Finn"
  ],
  "context_zh": "两名遛狗者发现小径附近有蛇，联系公园管理员。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-04-s01",
      "speaker": "Asha",
      "text": "There's a snake on the path beside that tree."
    },
    {
      "id": "p02-c-04-s02",
      "speaker": "Finn",
      "text": "Let's stay back. Is somebody from the park office nearby?"
    },
    {
      "id": "p02-c-04-s03",
      "speaker": "Asha",
      "text": "I'll call them. Please stand over there, by the gate."
    },
    {
      "id": "p02-c-04-s04",
      "speaker": "Finn",
      "text": "It's moving under the bench. I'll keep the dog away."
    },
    {
      "id": "p02-c-04-s05",
      "speaker": "Asha",
      "text": "The ranger says we should use the other path. She's coming to check this one."
    },
    {
      "id": "p02-c-04-s06",
      "speaker": "Finn",
      "text": "All right. Let's go back to the gate."
    }
  ],
