{
  "id": "p02-c-05",
  "title_zh": "选择春季海边短途旅行",
  "topic_id": "travel",
  "scenario": {
    "id": "seasonal-coast-trip-choice",
    "label_zh": "选择春季海边短途旅行",
    "goal_zh": "比较山地和海岸的季节条件并确定出游目的地"
  },
  "participants": [
    "Marta",
    "Jules"
  ],
  "context_zh": "两位朋友商量四月短假去哪里以及需要带什么。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-05-s01",
      "speaker": "Marta",
      "text": "Where should we travel for our short break in April?"
    },
    {
      "id": "p02-c-05-s02",
      "speaker": "Jules",
      "text": "I was thinking about a trip to the mountains, but there could still be snow in spring."
    },
    {
      "id": "p02-c-05-s03",
      "speaker": "Marta",
      "text": "How about the coast in the south? I'd rather go now than in summer, when the beach is crowded."
    },
    {
      "id": "p02-c-05-s04",
      "speaker": "Jules",
      "text": "Good idea. I'm not sure what to pack for the coast, though."
    },
    {
      "id": "p02-c-05-s05",
      "speaker": "Marta",
      "text": "We might get some sun, but let's take an umbrella as well."
    },
    {
      "id": "p02-c-05-s06",
      "speaker": "Jules",
      "text": "Then the coast it is. I'll look for a room near the beach."
    }
  ],
