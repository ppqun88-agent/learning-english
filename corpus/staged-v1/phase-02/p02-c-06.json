{
  "id": "p02-c-06",
  "title_zh": "安排叔叔的生日午餐",
  "topic_id": "relationships",
  "scenario": {
    "id": "uncle-birthday-lunch",
    "label_zh": "安排叔叔的生日午餐",
    "goal_zh": "确认家人参加生日聚餐并协调同行和带蛋糕"
  },
  "participants": [
    "Sofia",
    "Daniel"
  ],
  "context_zh": "Sofia 邀请亲戚 Daniel 一家参加叔叔生日午餐。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-06-s01",
      "speaker": "Sofia",
      "text": "My uncle will be sixty on Sunday. Can your family join us for lunch?"
    },
    {
      "id": "p02-c-06-s02",
      "speaker": "Daniel",
      "text": "Yes. My son is thirteen now. Will he be the only teenager there?"
    },
    {
      "id": "p02-c-06-s03",
      "speaker": "Sofia",
      "text": "No, Ella and Max are coming too. They want to make a cake."
    },
    {
      "id": "p02-c-06-s04",
      "speaker": "Daniel",
      "text": "We can collect them on the way and all arrive together."
    },
    {
      "id": "p02-c-06-s05",
      "speaker": "Sofia",
      "text": "That would help. Their cake will need a flat space in the car."
    },
    {
      "id": "p02-c-06-s06",
      "speaker": "Daniel",
      "text": "We'll clear the boot. Send me the address and I'll arrange a pickup time with them."
    }
  ],
