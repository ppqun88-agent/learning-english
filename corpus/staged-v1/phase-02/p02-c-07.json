{
  "id": "p02-c-07",
  "title_zh": "点汤与热茶并选择座位",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-soup-and-tea-order",
    "label_zh": "点汤与热茶并选择座位",
    "goal_zh": "确定窗边座位、餐点和茶的口味"
  },
  "participants": [
    "Priya",
    "Owen"
  ],
  "context_zh": "两位客人在咖啡馆坐下，服务员接受点单。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-07-s01",
      "speaker": "Priya",
      "text": "Could we sit at that table by the window?"
    },
    {
      "id": "p02-c-07-s02",
      "speaker": "Owen",
      "text": "Yes, I'll bring the menu over."
    },
    {
      "id": "p02-c-07-s03",
      "speaker": "Priya",
      "text": "I'm thirsty. Could I have some water first?"
    },
    {
      "id": "p02-c-07-s04",
      "speaker": "Owen",
      "text": "Of course. Are you ready to order as well?"
    },
    {
      "id": "p02-c-07-s05",
      "speaker": "Priya",
      "text": "Two bowls of tomato soup, please, and a pot of tea."
    },
    {
      "id": "p02-c-07-s06",
      "speaker": "Owen",
      "text": "Do you take sugar?"
    },
    {
      "id": "p02-c-07-s07",
      "speaker": "Priya",
      "text": "No, thank you. We like strong tea, though."
    },
    {
      "id": "p02-c-07-s08",
      "speaker": "Owen",
      "text": "I'll leave it to brew a little longer and bring your water now."
    }
  ],
