{
  "id": "p02-c-08",
  "title_zh": "选择适合初学者的口语班",
  "topic_id": "learning",
  "scenario": {
    "id": "language-tutor-practice-plan",
    "label_zh": "选择适合初学者的口语班",
    "goal_zh": "确认教师、练习内容和每周课程时间"
  },
  "participants": [
    "Hugo",
    "Mei"
  ],
  "context_zh": "新学员向语言中心工作人员询问口语学习支持。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-08-s01",
      "speaker": "Hugo",
      "text": "I'm a new student here. Who can help me speak more confidently?"
    },
    {
      "id": "p02-c-08-s02",
      "speaker": "Mei",
      "text": "Mina is the teacher for our small conversation class."
    },
    {
      "id": "p02-c-08-s03",
      "speaker": "Hugo",
      "text": "Does she teach beginners?"
    },
    {
      "id": "p02-c-08-s04",
      "speaker": "Mei",
      "text": "Yes. Speaking is a skill you can build with practice, even if you only know a few words."
    },
    {
      "id": "p02-c-08-s05",
      "speaker": "Hugo",
      "text": "I also struggle with spelling. I can say a word but sometimes I can't spell it."
    },
    {
      "id": "p02-c-08-s06",
      "speaker": "Mei",
      "text": "She can help you make a practice list after class."
    },
    {
      "id": "p02-c-08-s07",
      "speaker": "Hugo",
      "text": "When does the group meet?"
    },
    {
      "id": "p02-c-08-s08",
      "speaker": "Mei",
      "text": "Twice a week, on Tuesday and Friday evenings."
    },
    {
      "id": "p02-c-08-s09",
      "speaker": "Hugo",
      "text": "Those evenings work for me. Please put me down for a trial lesson."
    }
  ],
