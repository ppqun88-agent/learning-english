{
  "id": "p02-c-09",
  "title_zh": "选择社区运动课程",
  "topic_id": "leisure",
  "scenario": {
    "id": "sports-taster-choice",
    "label_zh": "选择社区运动课程",
    "goal_zh": "选择适合初学者的社区运动体验课并确认用品。"
  },
  "participants": [
    "Nadia",
    "Cal"
  ],
  "context_zh": "Nadia 想参加能认识新朋友的运动活动，向俱乐部教练询问。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-09-s01",
      "speaker": "Nadia",
      "text": "I'd like to take up a sport that helps me meet people."
    },
    {
      "id": "p02-c-09-s02",
      "speaker": "Cal",
      "text": "What do you enjoy doing now?"
    },
    {
      "id": "p02-c-09-s03",
      "speaker": "Nadia",
      "text": "I can swim, but swimming alone gets boring."
    },
    {
      "id": "p02-c-09-s04",
      "speaker": "Cal",
      "text": "Would you like to try tennis? We have a friendly beginners' group."
    },
    {
      "id": "p02-c-09-s05",
      "speaker": "Nadia",
      "text": "Do I have to join a team?"
    },
    {
      "id": "p02-c-09-s06",
      "speaker": "Cal",
      "text": "No. The first lesson is thirty minutes, and we'll lend you a racket."
    },
    {
      "id": "p02-c-09-s07",
      "speaker": "Nadia",
      "text": "That sounds right for me. I'll book the Saturday lesson."
    }
  ],
