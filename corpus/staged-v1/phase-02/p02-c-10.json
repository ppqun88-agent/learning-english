{
  "id": "p02-c-10",
  "title_zh": "问路去剧院及寻找洗手间",
  "topic_id": "travel",
  "scenario": {
    "id": "theatre-facilities-directions",
    "label_zh": "问路去剧院及寻找洗手间",
    "goal_zh": "确认步行路线、转弯位置和最近的洗手间"
  },
  "participants": [
    "Nina",
    "George"
  ],
  "context_zh": "游客 Nina 在城镇广场向工作人员 George 问路。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-10-s01",
      "speaker": "Nina",
      "text": "Could you help a lost tourist? I can't find the theatre."
    },
    {
      "id": "p02-c-10-s02",
      "speaker": "George",
      "text": "It's at the other end of town. Walk through this square, then turn left."
    },
    {
      "id": "p02-c-10-s03",
      "speaker": "Nina",
      "text": "Is it on the first street after the square?"
    },
    {
      "id": "p02-c-10-s04",
      "speaker": "George",
      "text": "No, the third street. You'll see a red sign outside."
    },
    {
      "id": "p02-c-10-s05",
      "speaker": "Nina",
      "text": "Thank you. Is there a toilet nearby before I set off?"
    },
    {
      "id": "p02-c-10-s06",
      "speaker": "George",
      "text": "Yes, inside the library behind you. The entrance is beside the steps."
    },
    {
      "id": "p02-c-10-s07",
      "speaker": "Nina",
      "text": "Perfect. I'll go there first and then head to the show."
    }
  ],
