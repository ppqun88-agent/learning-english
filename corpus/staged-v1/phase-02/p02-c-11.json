{
  "id": "p02-c-11",
  "title_zh": "核对剧场筹款结果",
  "topic_id": "community",
  "scenario": {
    "id": "theater-fundraiser-results",
    "label_zh": "核对剧场筹款结果",
    "goal_zh": "确认可用筹款和下一项空间改善工作"
  },
  "participants": [
    "Avery",
    "Rafael"
  ],
  "context_zh": "社区剧场活动结束后，两位组织者清点成果。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-11-s01",
      "speaker": "Avery",
      "text": "Was the fundraiser a success? Have you finished counting?"
    },
    {
      "id": "p02-c-11-s02",
      "speaker": "Rafael",
      "text": "Yes. We raised a thousand dollars after costs."
    },
    {
      "id": "p02-c-11-s03",
      "speaker": "Avery",
      "text": "Great. Can the theater finally buy shelves for the costumes?"
    },
    {
      "id": "p02-c-11-s04",
      "speaker": "Rafael",
      "text": "It can. Once they're off the floor, we'll have more space to rehearse."
    },
    {
      "id": "p02-c-11-s05",
      "speaker": "Avery",
      "text": "Twenty volunteers helped last night. We should let them know what they made possible."
    },
    {
      "id": "p02-c-11-s06",
      "speaker": "Rafael",
      "text": "I'll send them the total and a thank-you message before I order the shelves."
    }
  ],
