{
  "id": "p02-c-12",
  "title_zh": "更正课程联络方式",
  "topic_id": "learning",
  "scenario": {
    "id": "course-contact-correction",
    "label_zh": "更正课程联络方式",
    "goal_zh": "查明短信无回复的原因并找到联系教师的方式"
  },
  "participants": [
    "Lena",
    "Peter"
  ],
  "context_zh": "Lena 到语言学校办公室询问之前未得到回复的短信。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-12-s01",
      "speaker": "Lena",
      "text": "I sent a text about tomorrow's class, but nobody replied."
    },
    {
      "id": "p02-c-12-s02",
      "speaker": "Peter",
      "text": "That went to our old number. Did someone give you this card?"
    },
    {
      "id": "p02-c-12-s03",
      "speaker": "Lena",
      "text": "Yes, last month. Could you tell me the new number?"
    },
    {
      "id": "p02-c-12-s04",
      "speaker": "Peter",
      "text": "Certainly. You can also use the telephone on that desk to leave a message for your teacher."
    },
    {
      "id": "p02-c-12-s05",
      "speaker": "Lena",
      "text": "I'd like to thank her for holding my place. I'll call her now."
    },
    {
      "id": "p02-c-12-s06",
      "speaker": "Peter",
      "text": "Here you are. I've written the new number on your card."
    }
  ],
