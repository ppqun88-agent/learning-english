{
  "id": "p02-c-13",
  "title_zh": "堵车时改为步行赶火车",
  "topic_id": "travel",
  "scenario": {
    "id": "traffic-delayed-station-transfer",
    "label_zh": "堵车时改为步行赶火车",
    "goal_zh": "了解堵车原因并决定是否下车步行到车站"
  },
  "participants": [
    "Marcus",
    "Tess"
  ],
  "context_zh": "乘客和出租车司机在车站附近遇到堵车。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-13-s01",
      "speaker": "Marcus",
      "text": "We're not moving. What's the situation?"
    },
    {
      "id": "p02-c-13-s02",
      "speaker": "Tess",
      "text": "A truck has broken down ahead, and the traffic is very slow."
    },
    {
      "id": "p02-c-13-s03",
      "speaker": "Marcus",
      "text": "My train leaves in ten minutes. Is there another street we can use?"
    },
    {
      "id": "p02-c-13-s04",
      "speaker": "Tess",
      "text": "Not from here, but the station is a five-minute walk along that path."
    },
    {
      "id": "p02-c-13-s05",
      "speaker": "Marcus",
      "text": "Have I got time to pay and walk?"
    },
    {
      "id": "p02-c-13-s06",
      "speaker": "Tess",
      "text": "Yes. You can pay by card in the taxi, then leave by the door on the pavement side."
    },
    {
      "id": "p02-c-13-s07",
      "speaker": "Marcus",
      "text": "All right. I'll take my bags and walk from here."
    },
    {
      "id": "p02-c-13-s08",
      "speaker": "Tess",
      "text": "The station entrance is just past the corner. You'll see it soon."
    }
  ],
