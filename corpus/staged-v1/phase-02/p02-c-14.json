{
  "id": "p02-c-14",
  "title_zh": "缩小叙事作业的题材",
  "topic_id": "learning",
  "scenario": {
    "id": "story-assignment-topic-choice",
    "label_zh": "缩小叙事作业的题材",
    "goal_zh": "选定真实经历中的具体事件并拟定题目"
  },
  "participants": [
    "Rina",
    "Jonah"
  ],
  "context_zh": "Rina 向老师 Jonah 咨询叙事写作作业。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-14-s01",
      "speaker": "Rina",
      "text": "Can we talk about this writing task? I don't know what to choose."
    },
    {
      "id": "p02-c-14-s02",
      "speaker": "Jonah",
      "text": "It needs to be a true story about someone you know."
    },
    {
      "id": "p02-c-14-s03",
      "speaker": "Rina",
      "text": "Could my grandmother's life be the topic?"
    },
    {
      "id": "p02-c-14-s04",
      "speaker": "Jonah",
      "text": "That's a lot for one page. Choose one thing that happened to her."
    },
    {
      "id": "p02-c-14-s05",
      "speaker": "Rina",
      "text": "I think her first day in this country would be interesting. She once took the wrong bus to work."
    },
    {
      "id": "p02-c-14-s06",
      "speaker": "Jonah",
      "text": "Good. Ask her how she found her way, and let that be the centre of the story."
    },
    {
      "id": "p02-c-14-s07",
      "speaker": "Rina",
      "text": "Then I'll use 'The Wrong Bus' as the title and interview her this weekend."
    }
  ],
