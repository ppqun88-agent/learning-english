{
  "id": "p02-c-15",
  "title_zh": "顺路帮邻居买食品",
  "topic_id": "food",
  "scenario": {
    "id": "neighbour-grocery-errand",
    "label_zh": "顺路帮邻居买食品",
    "goal_zh": "确认购物品种、数量和替代购买地点"
  },
  "participants": [
    "Cam",
    "Zoë"
  ],
  "context_zh": "Cam 要去超市，询问邻居 Zoë 是否需要顺便带东西。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-15-s01",
      "speaker": "Cam",
      "text": "I'm going to the supermarket. Do you need something?"
    },
    {
      "id": "p02-c-15-s02",
      "speaker": "Zoë",
      "text": "Could you get twelve eggs and three apples? We're nearly out."
    },
    {
      "id": "p02-c-15-s03",
      "speaker": "Cam",
      "text": "Of course. Any bread?"
    },
    {
      "id": "p02-c-15-s04",
      "speaker": "Zoë",
      "text": "Yes, a loaf would help."
    },
    {
      "id": "p02-c-15-s05",
      "speaker": "Cam",
      "text": "What type do you want? White or wholemeal?"
    },
    {
      "id": "p02-c-15-s06",
      "speaker": "Zoë",
      "text": "Wholemeal, please. If they're sold out, the little store on Oak Road usually has it."
    },
    {
      "id": "p02-c-15-s07",
      "speaker": "Cam",
      "text": "Got it. I'll bring everything over when I'm back."
    }
  ],
