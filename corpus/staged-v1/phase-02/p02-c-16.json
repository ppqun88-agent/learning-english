{
  "id": "p02-c-16",
  "title_zh": "因牙痛预约牙医",
  "topic_id": "health",
  "scenario": {
    "id": "dental-appointment-request",
    "label_zh": "因牙痛预约牙医",
    "goal_zh": "描述疼痛持续情况并确认可到诊时间"
  },
  "participants": [
    "Anil",
    "Grace"
  ],
  "context_zh": "患者 Anil 给牙科诊所打电话预约检查，不涉及诊断或治疗建议。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-16-s01",
      "speaker": "Anil",
      "text": "I need to see a dentist. This tooth has hurt since yesterday."
    },
    {
      "id": "p02-c-16-s02",
      "speaker": "Grace",
      "text": "I'm sorry you're in pain. Does it hurt all the time?"
    },
    {
      "id": "p02-c-16-s03",
      "speaker": "Anil",
      "text": "Not all the time, but it still hurts when I eat."
    },
    {
      "id": "p02-c-16-s04",
      "speaker": "Grace",
      "text": "We can offer you an appointment at nine tomorrow morning. Can you come then?"
    },
    {
      "id": "p02-c-16-s05",
      "speaker": "Anil",
      "text": "Yes, I can. Please book that for me."
    },
    {
      "id": "p02-c-16-s06",
      "speaker": "Grace",
      "text": "All right. I'll take your name and contact details now."
    }
  ],
