{
  "id": "p02-c-17",
  "title_zh": "安排考试前的复习顺序",
  "topic_id": "learning",
  "scenario": {
    "id": "exam-study-order",
    "label_zh": "安排考试前的复习顺序",
    "goal_zh": "根据考试日期和掌握程度确定今天的复习重点"
  },
  "participants": [
    "Elsa",
    "Benji"
  ],
  "context_zh": "两位同学商量当天下午如何分配复习时间。",
  "author": "author-phase02-c",
  "sentences": [
    {
      "id": "p02-c-17-s01",
      "speaker": "Elsa",
      "text": "Which subject should we study first today, history or maths?"
    },
    {
      "id": "p02-c-17-s02",
      "speaker": "Benji",
      "text": "The history test is tomorrow, so I'd start with that."
    },
    {
      "id": "p02-c-17-s03",
      "speaker": "Elsa",
      "text": "I know the dates, but I can't explain why the events happened."
    },
    {
      "id": "p02-c-17-s04",
      "speaker": "Benji",
      "text": "Let's ask each other questions about the causes. Then we can check our answers against the notes."
    },
    {
      "id": "p02-c-17-s05",
      "speaker": "Elsa",
      "text": "Good plan. We can leave maths until after dinner. I'll get my history notes."
    }
  ],
