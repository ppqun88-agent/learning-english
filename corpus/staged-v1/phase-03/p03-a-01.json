{
  "id": "p03-a-01",
  "title_zh": "申请海外大学的短期课程",
  "topic_id": "learning",
  "scenario": {
    "id": "exchange-course-application",
    "label_zh": "了解海外课程申请",
    "goal_zh": "核对短期海外课程的申请条件并确定提交材料的下一步"
  },
  "participants": [
    "Mira",
    "Tomas"
  ],
  "context_zh": "申请者向课程顾问了解一所虚构大学的短期交换课程。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-01-s01",
      "speaker": "Mira",
      "text": "I found this summer course on the university website. Can beginners apply?"
    },
    {
      "id": "p03-a-01-s02",
      "speaker": "Tomas",
      "text": "Yes. You need some English, but we do not expect perfect grammar."
    },
    {
      "id": "p03-a-01-s03",
      "speaker": "Mira",
      "text": "How do you check my speaking ability?"
    },
    {
      "id": "p03-a-01-s04",
      "speaker": "Tomas",
      "text": "There is a short online conversation. Are you able to join one on Thursday?"
    },
    {
      "id": "p03-a-01-s05",
      "speaker": "Mira",
      "text": "I am. Are there still places available?"
    },
    {
      "id": "p03-a-01-s06",
      "speaker": "Tomas",
      "text": "There are three. We can accept your application until Friday."
    },
    {
      "id": "p03-a-01-s07",
      "speaker": "Mira",
      "text": "Good. This would be my first time studying abroad, so I wanted to check the requirements."
    },
    {
      "id": "p03-a-01-s08",
      "speaker": "Tomas",
      "text": "I will send you the application link and a time for Thursday."
    },
    {
      "id": "p03-a-01-s09",
      "speaker": "Mira",
      "text": "Thank you. I will fill in the form tonight."
    }
  ],
