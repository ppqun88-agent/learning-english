{
  "id": "p03-a-02",
  "title_zh": "把听不懂的视频片段听清楚",
  "topic_id": "learning",
  "scenario": {
    "id": "language-practice-clarification",
    "label_zh": "澄清语言练习内容",
    "goal_zh": "弄清听力练习的意思并确定重听的方法。"
  },
  "participants": [
    "Kai",
    "Lena"
  ],
  "context_zh": "学习者请老师帮助理解一段日常对话视频，而不是逐字翻译整段内容。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-02-s01",
      "speaker": "Kai",
      "text": "I do not understand the last part of this video."
    },
    {
      "id": "p03-a-02-s02",
      "speaker": "Lena",
      "text": "Which part is difficult?"
    },
    {
      "id": "p03-a-02-s03",
      "speaker": "Kai",
      "text": "The woman says one word so quickly that I cannot hear it."
    },
    {
      "id": "p03-a-02-s04",
      "speaker": "Lena",
      "text": "Let us watch that bit again at a slower speed."
    },
    {
      "id": "p03-a-02-s05",
      "speaker": "Kai",
      "text": "Can I use this app to slow it down?"
    },
    {
      "id": "p03-a-02-s06",
      "speaker": "Lena",
      "text": "Yes. That button is useful for listening practice."
    },
    {
      "id": "p03-a-02-s07",
      "speaker": "Kai",
      "text": "Oh, she says the shop closes at six. I thought she said seven."
    },
    {
      "id": "p03-a-02-s08",
      "speaker": "Lena",
      "text": "Exactly. Now try the next line by yourself."
    },
    {
      "id": "p03-a-02-s09",
      "speaker": "Kai",
      "text": "All right. I will listen once before I turn on the subtitles."
    }
  ],
