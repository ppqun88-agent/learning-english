{
  "id": "p03-a-03",
  "title_zh": "讨论冬季旅行航班并约定下一步",
  "topic_id": "travel",
  "scenario": {
    "id": "winter-flight-holiday-planning",
    "label_zh": "初步讨论冬季度假航班",
    "goal_zh": "讨论假期长度、旅行兴趣与直飞航班的便利性，并约定先核对铁路日期再选择航班"
  },
  "participants": [
    "Nora",
    "Eli"
  ],
  "context_zh": "两位朋友讨论虚构的冬季度假计划，尚未购票。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-03-s01",
      "speaker": "Nora",
      "text": "Can we take a vacation together this winter?"
    },
    {
      "id": "p03-a-03-s02",
      "speaker": "Eli",
      "text": "I have one week off in February. What sort of trip do you want?"
    },
    {
      "id": "p03-a-03-s03",
      "speaker": "Nora",
      "text": "A little adventure. I would like to try a mountain railway rather than stay by a pool."
    },
    {
      "id": "p03-a-03-s04",
      "speaker": "Eli",
      "text": "The direct flight to the northern city has one advantage: we would not lose a day changing planes."
    },
    {
      "id": "p03-a-03-s05",
      "speaker": "Nora",
      "text": "Which airline runs it?"
    },
    {
      "id": "p03-a-03-s06",
      "speaker": "Eli",
      "text": "Skybridge. Although the flight leaves early, it gets us there before lunch."
    },
    {
      "id": "p03-a-03-s07",
      "speaker": "Nora",
      "text": "That sounds manageable. I can arrange a hotel near the station."
    },
    {
      "id": "p03-a-03-s08",
      "speaker": "Eli",
      "text": "Let us check the railway dates first, then choose the flight."
    },
    {
      "id": "p03-a-03-s09",
      "speaker": "Nora",
      "text": "Agreed. I will find the timetable tonight."
    }
  ],
