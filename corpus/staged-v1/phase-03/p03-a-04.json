{
  "id": "p03-a-04",
  "title_zh": "选择村落建筑参观路线",
  "topic_id": "travel",
  "scenario": {
    "id": "village-architecture-walk-route",
    "label_zh": "询问村落建筑参观路线",
    "goal_zh": "根据建筑兴趣确认古桥与新展馆之间的步行路线"
  },
  "participants": [
    "Ravi",
    "June"
  ],
  "context_zh": "游客向村里的信息站工作人员询问步行参观的顺序。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-04-s01",
      "speaker": "Ravi",
      "text": "We have two hours in the village. What should we visit?"
    },
    {
      "id": "p03-a-04-s02",
      "speaker": "June",
      "text": "Are you more interested in food or architecture?"
    },
    {
      "id": "p03-a-04-s03",
      "speaker": "Ravi",
      "text": "Architecture. My sister is an architect, and she wants to see the old stone bridge."
    },
    {
      "id": "p03-a-04-s04",
      "speaker": "June",
      "text": "Then start there. It is the ancient bridge in this picture, not the concrete one by the road."
    },
    {
      "id": "p03-a-04-s05",
      "speaker": "Ravi",
      "text": "Which way is it from here?"
    },
    {
      "id": "p03-a-04-s06",
      "speaker": "June",
      "text": "Head west from the square and walk along the river."
    },
    {
      "id": "p03-a-04-s07",
      "speaker": "Ravi",
      "text": "Can we reach the new exhibition hall from the bridge?"
    },
    {
      "id": "p03-a-04-s08",
      "speaker": "June",
      "text": "Yes, it is just across the water. You can see both without coming back here."
    },
    {
      "id": "p03-a-04-s09",
      "speaker": "Ravi",
      "text": "Perfect. We will start with the bridge."
    }
  ],
