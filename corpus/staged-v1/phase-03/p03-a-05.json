{
  "id": "p03-a-05",
  "title_zh": "在前台接待预约访客",
  "topic_id": "work",
  "scenario": {
    "id": "office-visitor-reception",
    "label_zh": "接待办公访客",
    "goal_zh": "核对预约并安排访客等候和前往会议室"
  },
  "participants": [
    "Amal",
    "Ben"
  ],
  "context_zh": "两名有预约的访客到达办公室前台，接待员确认会面安排。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-05-s01",
      "speaker": "Amal",
      "text": "Welcome! Are you here to see Ms Cole?"
    },
    {
      "id": "p03-a-05-s02",
      "speaker": "Ben",
      "text": "Yes. I am her ten o'clock visitor, and this is my colleague."
    },
    {
      "id": "p03-a-05-s03",
      "speaker": "Amal",
      "text": "She is finishing a call. Please wait here until she comes down."
    },
    {
      "id": "p03-a-05-s04",
      "speaker": "Ben",
      "text": "That is fine. Is the meeting room upstairs?"
    },
    {
      "id": "p03-a-05-s05",
      "speaker": "Amal",
      "text": "Yes. She will take you up the stairs beside reception."
    },
    {
      "id": "p03-a-05-s06",
      "speaker": "Ben",
      "text": "Could you let her know that both of us are here?"
    },
    {
      "id": "p03-a-05-s07",
      "speaker": "Amal",
      "text": "Of course. I have sent her a message."
    },
    {
      "id": "p03-a-05-s08",
      "speaker": "Ben",
      "text": "Thanks. We will take a seat."
    }
  ],
