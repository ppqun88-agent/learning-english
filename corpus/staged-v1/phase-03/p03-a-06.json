{
  "id": "p03-a-06",
  "title_zh": "点汤并说明配餐偏好",
  "topic_id": "food",
  "scenario": {
    "id": "restaurant-soup-and-wine-order",
    "label_zh": "点汤及配餐饮料",
    "goal_zh": "询问汤的配料并确定面包与饮料需求"
  },
  "participants": [
    "Clara",
    "Jon",
    "Mateo"
  ],
  "context_zh": "顾客在餐厅向服务员询问当天汤品后完成点单。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-06-s01",
      "speaker": "Clara",
      "text": "Could we ask our waiter about the soup before we order?"
    },
    {
      "id": "p03-a-06-s02",
      "speaker": "Jon",
      "text": "Here he is."
    },
    {
      "id": "p03-a-06-s03",
      "speaker": "Mateo",
      "text": "Hello. What would you like to know?"
    },
    {
      "id": "p03-a-06-s04",
      "speaker": "Clara",
      "text": "Do you have a vegetable soup today?"
    },
    {
      "id": "p03-a-06-s05",
      "speaker": "Mateo",
      "text": "Yes, a white bean soup with carrot and celery."
    },
    {
      "id": "p03-a-06-s06",
      "speaker": "Clara",
      "text": "That sounds good. Could I have it without the cream on top?"
    },
    {
      "id": "p03-a-06-s07",
      "speaker": "Mateo",
      "text": "Certainly. Would you like some warm bread with it?"
    },
    {
      "id": "p03-a-06-s08",
      "speaker": "Clara",
      "text": "Yes, please, and a small glass of red wine."
    },
    {
      "id": "p03-a-06-s09",
      "speaker": "Jon",
      "text": "The same soup for me, but just water to drink."
    },
    {
      "id": "p03-a-06-s10",
      "speaker": "Mateo",
      "text": "Two soups, one without cream, bread, one wine, and water. Thank you."
    }
  ],
