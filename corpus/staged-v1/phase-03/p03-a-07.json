{
  "id": "p03-a-07",
  "title_zh": "约好周末晨间散步",
  "topic_id": "leisure",
  "scenario": {
    "id": "morning-walk-meeting-plan",
    "label_zh": "安排晨间散步",
    "goal_zh": "商定周末散步的时间与集合地点并考虑天气和穿着"
  },
  "participants": [
    "Luis",
    "Bea"
  ],
  "context_zh": "朋友相约在周末到运河边散步。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-07-s01",
      "speaker": "Luis",
      "text": "Shall we go for a walk this weekend?"
    },
    {
      "id": "p03-a-07-s02",
      "speaker": "Bea",
      "text": "Yes, but not too early. What time do you usually wake up?"
    },
    {
      "id": "p03-a-07-s03",
      "speaker": "Luis",
      "text": "Around seven. We could meet at nine instead."
    },
    {
      "id": "p03-a-07-s04",
      "speaker": "Bea",
      "text": "Nine suits me. What is the weather supposed to be like?"
    },
    {
      "id": "p03-a-07-s05",
      "speaker": "Luis",
      "text": "Cool and dry, according to the forecast I saw."
    },
    {
      "id": "p03-a-07-s06",
      "speaker": "Bea",
      "text": "Then I will wear my light jacket."
    },
    {
      "id": "p03-a-07-s07",
      "speaker": "Luis",
      "text": "Great. I will meet you by the canal entrance."
    },
    {
      "id": "p03-a-07-s08",
      "speaker": "Bea",
      "text": "See you there at nine."
    }
  ],
