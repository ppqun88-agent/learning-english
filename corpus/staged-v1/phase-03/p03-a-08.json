{
  "id": "p03-a-08",
  "title_zh": "试色后决定墙面颜色",
  "topic_id": "home",
  "scenario": {
    "id": "room-repainting-colour-choice",
    "label_zh": "选择房间墙面颜色",
    "goal_zh": "通过采光和试色比较确定重刷墙面的颜色"
  },
  "participants": [
    "Freya",
    "Sam"
  ],
  "context_zh": "室友查看墙上的小块试色，准备给客厅重新刷漆。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-08-s01",
      "speaker": "Freya",
      "text": "Which colour do you want for this wall?"
    },
    {
      "id": "p03-a-08-s02",
      "speaker": "Sam",
      "text": "I thought white paint would make the room brighter."
    },
    {
      "id": "p03-a-08-s03",
      "speaker": "Freya",
      "text": "Maybe, but look at the yellow sample near the window."
    },
    {
      "id": "p03-a-08-s04",
      "speaker": "Sam",
      "text": "It looks attractive in the morning light. The darker sample is a bit much."
    },
    {
      "id": "p03-a-08-s05",
      "speaker": "Freya",
      "text": "We could try a larger patch of the pale yellow before buying a whole tin."
    },
    {
      "id": "p03-a-08-s06",
      "speaker": "Sam",
      "text": "Good idea. Let us keep the other walls white so the room does not feel too busy."
    },
    {
      "id": "p03-a-08-s07",
      "speaker": "Freya",
      "text": "Agreed. I will paint the bigger patch this afternoon."
    }
  ],
