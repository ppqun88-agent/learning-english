{
  "id": "p03-a-09",
  "title_zh": "安排亲人周中来访",
  "topic_id": "relationships",
  "scenario": {
    "id": "family-weekday-visit-arrangement",
    "label_zh": "协调亲人周中探访",
    "goal_zh": "确认短暂来访期间的会面时间和参加人员"
  },
  "participants": [
    "Owen",
    "Leah"
  ],
  "context_zh": "亲人结束异地工作后短暂回城，双方通过电话安排见面。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-09-s01",
      "speaker": "Owen",
      "text": "My wife and I will be in town next week. Could we come over?"
    },
    {
      "id": "p03-a-09-s02",
      "speaker": "Leah",
      "text": "Of course. I have not seen you for a year. When do you arrive?"
    },
    {
      "id": "p03-a-09-s03",
      "speaker": "Owen",
      "text": "Tuesday evening. Would Wednesday afternoon work for you?"
    },
    {
      "id": "p03-a-09-s04",
      "speaker": "Leah",
      "text": "Yes. Who else is coming?"
    },
    {
      "id": "p03-a-09-s05",
      "speaker": "Owen",
      "text": "Just the two of us. Our son is staying with his grandparents."
    },
    {
      "id": "p03-a-09-s06",
      "speaker": "Leah",
      "text": "Then come at three. I can finish work before you arrive."
    },
    {
      "id": "p03-a-09-s07",
      "speaker": "Owen",
      "text": "That arrangement suits us. Shall we bring something for tea?"
    },
    {
      "id": "p03-a-09-s08",
      "speaker": "Leah",
      "text": "No need. I will have everything ready."
    }
  ],
