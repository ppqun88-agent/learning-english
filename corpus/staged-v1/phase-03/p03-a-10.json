{
  "id": "p03-a-10",
  "title_zh": "交接第一次助理班次",
  "topic_id": "work",
  "scenario": {
    "id": "first-assistant-shift-handover",
    "label_zh": "交接新助理首班职责",
    "goal_zh": "让新来的临时员工了解工作内容和当班支持人员"
  },
  "participants": [
    "Mae",
    "Dev"
  ],
  "context_zh": "主管在文具仓库向新来的临时助理交接早班工作。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-10-s01",
      "speaker": "Mae",
      "text": "I am the new assistant. Where should I start?"
    },
    {
      "id": "p03-a-10-s02",
      "speaker": "Dev",
      "text": "Most of the work this morning is checking delivery labels."
    },
    {
      "id": "p03-a-10-s03",
      "speaker": "Mae",
      "text": "I was told to report to the worker at the loading desk."
    },
    {
      "id": "p03-a-10-s04",
      "speaker": "Dev",
      "text": "Actually, she is on a break. I can show you the first box."
    },
    {
      "id": "p03-a-10-s05",
      "speaker": "Mae",
      "text": "Thanks. Will I be alone here after you leave?"
    },
    {
      "id": "p03-a-10-s06",
      "speaker": "Dev",
      "text": "No. Hana will be beside you. She has already checked these two shelves."
    },
    {
      "id": "p03-a-10-s07",
      "speaker": "Mae",
      "text": "So I should start with the shelf by the door?"
    },
    {
      "id": "p03-a-10-s08",
      "speaker": "Dev",
      "text": "Exactly. Ask Hana before moving anything with a damaged label."
    },
    {
      "id": "p03-a-10-s09",
      "speaker": "Mae",
      "text": "Understood. I will check the labels first."
    }
  ],
