{
  "id": "p03-a-11",
  "title_zh": "确认作家工作坊适合初学者",
  "topic_id": "learning",
  "scenario": {
    "id": "award-winning-author-workshop",
    "label_zh": "了解作家写作工作坊",
    "goal_zh": "核对讲师背景、活动形式及初学者参与要求后决定报名"
  },
  "participants": [
    "Selma",
    "Noah"
  ],
  "context_zh": "图书馆读者向活动管理员询问一场虚构的作家工作坊。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-11-s01",
      "speaker": "Selma",
      "text": "I saw the writing workshop on your noticeboard. Who is teaching it?"
    },
    {
      "id": "p03-a-11-s02",
      "speaker": "Noah",
      "text": "Iris Vale, the author of The Empty Platform. Her first novel won an award last year."
    },
    {
      "id": "p03-a-11-s03",
      "speaker": "Selma",
      "text": "I have read it. Is she a full-time writer?"
    },
    {
      "id": "p03-a-11-s04",
      "speaker": "Noah",
      "text": "Yes. Her background is in radio, but she now writes fiction."
    },
    {
      "id": "p03-a-11-s05",
      "speaker": "Selma",
      "text": "Will the audience just listen, or will we write something too?"
    },
    {
      "id": "p03-a-11-s06",
      "speaker": "Noah",
      "text": "Both. There is a short talk, followed by an exercise based on a personal memory."
    },
    {
      "id": "p03-a-11-s07",
      "speaker": "Selma",
      "text": "I have never taken a class. Can I still attend?"
    },
    {
      "id": "p03-a-11-s08",
      "speaker": "Noah",
      "text": "Certainly. No experience is needed, and sharing your work is optional."
    },
    {
      "id": "p03-a-11-s09",
      "speaker": "Selma",
      "text": "Then please put my name down. I will bring a notebook."
    }
  ],
