{
  "id": "p03-a-12",
  "title_zh": "为业余跑者设定训练目标",
  "topic_id": "leisure",
  "scenario": {
    "id": "athlete-training-goal",
    "label_zh": "设定跑步训练目标",
    "goal_zh": "根据以往成绩选定具体目标而不只关注名次"
  },
  "participants": [
    "Zoe",
    "Finn"
  ],
  "context_zh": "业余跑者和俱乐部教练讨论下次五公里活动的个人目标；不涉及医疗或个体化健康建议。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-12-s01",
      "speaker": "Zoe",
      "text": "I want to stay active, but I am not trying to become a professional athlete."
    },
    {
      "id": "p03-a-12-s02",
      "speaker": "Finn",
      "text": "That is fine. What would you like to achieve at the next club run?"
    },
    {
      "id": "p03-a-12-s03",
      "speaker": "Zoe",
      "text": "I keep thinking I need to win, even though most people are faster than me."
    },
    {
      "id": "p03-a-12-s04",
      "speaker": "Finn",
      "text": "You do not have to compete against everyone. You can try to beat your own best time."
    },
    {
      "id": "p03-a-12-s05",
      "speaker": "Zoe",
      "text": "My average over the last three runs is thirty-two minutes. My best is thirty-one."
    },
    {
      "id": "p03-a-12-s06",
      "speaker": "Finn",
      "text": "Would finishing under thirty-one be a goal you care about?"
    },
    {
      "id": "p03-a-12-s07",
      "speaker": "Zoe",
      "text": "Yes. That would feel more useful than worrying about my place."
    },
    {
      "id": "p03-a-12-s08",
      "speaker": "Finn",
      "text": "Then let us write that down and review your progress after the next run."
    }
  ],
