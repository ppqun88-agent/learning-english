{
  "id": "p03-a-14",
  "title_zh": "核对失物外观和领取地点",
  "topic_id": "services",
  "scenario": {
    "id": "lost-bag-collection-description",
    "label_zh": "按描述领取遗失手袋",
    "goal_zh": "描述手袋外观并确认失物招领处的领取位置"
  },
  "participants": [
    "Imogen",
    "Alex"
  ],
  "context_zh": "旅客致电车站失物招领处，工作人员按失物外观查找。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-14-s01",
      "speaker": "Imogen",
      "text": "I left a small bag on the station bench. I cannot find it anywhere."
    },
    {
      "id": "p03-a-14-s02",
      "speaker": "Alex",
      "text": "Can you describe its appearance?"
    },
    {
      "id": "p03-a-14-s03",
      "speaker": "Imogen",
      "text": "It is dark blue, almost black, with a silver handle."
    },
    {
      "id": "p03-a-14-s04",
      "speaker": "Alex",
      "text": "Yes, a woman handed in a bag like that about twenty minutes ago."
    },
    {
      "id": "p03-a-14-s05",
      "speaker": "Imogen",
      "text": "Ah, that sounds like mine. Where can I collect it?"
    },
    {
      "id": "p03-a-14-s06",
      "speaker": "Alex",
      "text": "At the information desk beside platform two. We will ask you about the contents before returning it."
    },
    {
      "id": "p03-a-14-s07",
      "speaker": "Imogen",
      "text": "That is fine. I will come to the desk now."
    }
  ],
