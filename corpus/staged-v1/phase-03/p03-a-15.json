{
  "id": "p03-a-15",
  "title_zh": "报告洗衣机的脱水故障",
  "topic_id": "services",
  "scenario": {
    "id": "faulty-washer-service-call",
    "label_zh": "预约故障洗衣机维修",
    "goal_zh": "描述洗衣表现和异常声音后约定维修查看"
  },
  "participants": [
    "Caleb",
    "Marta"
  ],
  "context_zh": "住户向维修店描述洗衣机的具体问题，双方只安排检查而不远程拆修。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-15-s01",
      "speaker": "Caleb",
      "text": "My machine can wash the clothes, but they come out soaking wet."
    },
    {
      "id": "p03-a-15-s02",
      "speaker": "Marta",
      "text": "Does it still spin at the end of the cycle?"
    },
    {
      "id": "p03-a-15-s03",
      "speaker": "Caleb",
      "text": "Not anymore. It makes an awful noise instead."
    },
    {
      "id": "p03-a-15-s04",
      "speaker": "Marta",
      "text": "When did that start?"
    },
    {
      "id": "p03-a-15-s05",
      "speaker": "Caleb",
      "text": "Two days ago. It was shaking badly during the last load."
    },
    {
      "id": "p03-a-15-s06",
      "speaker": "Marta",
      "text": "Something is wrong, but I cannot identify the cause over the phone. We can send someone tomorrow."
    },
    {
      "id": "p03-a-15-s07",
      "speaker": "Caleb",
      "text": "Could they come after ten?"
    },
    {
      "id": "p03-a-15-s08",
      "speaker": "Marta",
      "text": "Yes. I can book a visit between ten and twelve."
    },
    {
      "id": "p03-a-15-s09",
      "speaker": "Caleb",
      "text": "Please do. I will use the laundry downstairs until then."
    }
  ],
