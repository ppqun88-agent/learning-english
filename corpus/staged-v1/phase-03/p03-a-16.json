{
  "id": "p03-a-16",
  "title_zh": "摔倒后请同伴联系急救员",
  "topic_id": "health",
  "scenario": {
    "id": "walking-fall-assistance",
    "label_zh": "摔倒后寻求帮助",
    "goal_zh": "说明不适并请同伴联系现场急救员"
  },
  "participants": [
    "Pia",
    "Jules"
  ],
  "context_zh": "虚构的步行活动中，一位参与者摔倒后请同伴联系现场急救员；不提供诊断或治疗建议。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-16-s01",
      "speaker": "Pia",
      "text": "I had a small accident on the steps. My ankle hurts, and I cannot walk any more."
    },
    {
      "id": "p03-a-16-s02",
      "speaker": "Jules",
      "text": "I am here. Is your other leg all right?"
    },
    {
      "id": "p03-a-16-s03",
      "speaker": "Pia",
      "text": "Yes, but I do not feel well. Could you call the first-aid volunteer?"
    },
    {
      "id": "p03-a-16-s04",
      "speaker": "Jules",
      "text": "Of course. I was going to the desk anyway. I will phone them so I can stay here."
    },
    {
      "id": "p03-a-16-s05",
      "speaker": "Pia",
      "text": "Will they allow my sister to come over too?"
    },
    {
      "id": "p03-a-16-s06",
      "speaker": "Jules",
      "text": "I will ask. What should I tell them about where we are?"
    },
    {
      "id": "p03-a-16-s07",
      "speaker": "Pia",
      "text": "We are beside the steps at the north entrance."
    },
    {
      "id": "p03-a-16-s08",
      "speaker": "Jules",
      "text": "I have told them. Someone is coming to us now."
    }
  ],
