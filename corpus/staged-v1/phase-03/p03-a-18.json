{
  "id": "p03-a-18",
  "title_zh": "一起规划后院小路",
  "topic_id": "home",
  "scenario": {
    "id": "yard-path-layout-help",
    "label_zh": "规划后院小路位置",
    "goal_zh": "确定后院通行路线与花盆位置以保留通道"
  },
  "participants": [
    "Hugo",
    "Esme"
  ],
  "context_zh": "邻居应邀帮忙查看后院的布局，屋主想留出一条到棚屋的小路。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-18-s01",
      "speaker": "Hugo",
      "text": "Could you help me plan a path across the yard?"
    },
    {
      "id": "p03-a-18-s02",
      "speaker": "Esme",
      "text": "Sure. Where do you need it to end?"
    },
    {
      "id": "p03-a-18-s03",
      "speaker": "Hugo",
      "text": "At the shed. I keep losing the stepping stones among all these pots."
    },
    {
      "id": "p03-a-18-s04",
      "speaker": "Esme",
      "text": "Is that your biggest pot beside the gate?"
    },
    {
      "id": "p03-a-18-s05",
      "speaker": "Hugo",
      "text": "Yeah. I can move it to the corner."
    },
    {
      "id": "p03-a-18-s06",
      "speaker": "Esme",
      "text": "Then the path could run straight from the gate to the shed."
    },
    {
      "id": "p03-a-18-s07",
      "speaker": "Hugo",
      "text": "That makes sense. I will move the pots first so we can check the space."
    }
  ],
