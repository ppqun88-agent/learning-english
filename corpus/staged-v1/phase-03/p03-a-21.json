{
  "id": "p03-a-21",
  "title_zh": "澄清订餐日期的误会",
  "topic_id": "services",
  "scenario": {
    "id": "restaurant-booking-date-correction",
    "label_zh": "更正餐厅预约日期误会",
    "goal_zh": "凭预约确认邮件核对日期并为当晚用餐找到可行安排"
  },
  "participants": [
    "Rosa",
    "Ken"
  ],
  "context_zh": "顾客与餐厅接待员发现预约日期不一致，双方查阅邮件而不是争执。",
  "author": "author-phase03-a",
  "sentences": [
    {
      "id": "p03-a-21-s01",
      "speaker": "Rosa",
      "text": "I have a table for two at seven, under Rosa Lane."
    },
    {
      "id": "p03-a-21-s02",
      "speaker": "Ken",
      "text": "I can see that name, but the booking was for yesterday."
    },
    {
      "id": "p03-a-21-s03",
      "speaker": "Rosa",
      "text": "That is very strange. Why does my calendar say tonight?"
    },
    {
      "id": "p03-a-21-s04",
      "speaker": "Ken",
      "text": "Do you have the confirmation email?"
    },
    {
      "id": "p03-a-21-s05",
      "speaker": "Rosa",
      "text": "Yes. Oh, it does say Thursday. I entered the wrong date in my calendar."
    },
    {
      "id": "p03-a-21-s06",
      "speaker": "Ken",
      "text": "I am sorry, but the seven o'clock tables are full."
    },
    {
      "id": "p03-a-21-s07",
      "speaker": "Rosa",
      "text": "I do not want to argue about it. Is there anything later?"
    },
    {
      "id": "p03-a-21-s08",
      "speaker": "Ken",
      "text": "We have a table at eight fifteen. Would that work?"
    },
    {
      "id": "p03-a-21-s09",
      "speaker": "Rosa",
      "text": "Yes, thank you. Please put us down for that."
    }
  ],
