{
  "id": "p03-b-01",
  "title_zh": "两个人分工做牛肉晚饭",
  "topic_id": "food",
  "scenario": {
    "id": "shared-dinner-preparation",
    "label_zh": "分工准备晚饭",
    "goal_zh": "商定晚餐分工、菜品和份量"
  },
  "participants": [
    "Asha",
    "Ben"
  ],
  "context_zh": "阿莎和本刚买好食材，在合租厨房里分工准备晚饭。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-01-s01",
      "speaker": "Asha",
      "text": "Shall we cook the beef tonight, or save it for tomorrow?"
    },
    {
      "id": "p03-b-01-s02",
      "speaker": "Ben",
      "text": "Tonight. I can make noodles to go with it. Shall I make two portions, or extra for lunch tomorrow?"
    },
    {
      "id": "p03-b-01-s03",
      "speaker": "Asha",
      "text": "Let us make four portions so we each have lunch for tomorrow. Can you boil some water while I cut the vegetables?"
    },
    {
      "id": "p03-b-01-s04",
      "speaker": "Ben",
      "text": "Sure. Which ring on the cooker should I use?"
    },
    {
      "id": "p03-b-01-s05",
      "speaker": "Asha",
      "text": "The small one is free. The other pan is on the large ring."
    },
    {
      "id": "p03-b-01-s06",
      "speaker": "Ben",
      "text": "Is this bowl for the cooked noodles?"
    },
    {
      "id": "p03-b-01-s07",
      "speaker": "Asha",
      "text": "Yes. Put them in there and cover it with a plate while I finish the beef."
    },
    {
      "id": "p03-b-01-s08",
      "speaker": "Ben",
      "text": "All right. I will handle the noodles, and you can handle the beef and vegetables."
    }
  ],
