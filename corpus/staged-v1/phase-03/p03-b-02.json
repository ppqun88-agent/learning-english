{
  "id": "p03-b-02",
  "title_zh": "在咖啡店选一份点心",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-snack-order",
    "label_zh": "询问并点购点心",
    "goal_zh": "询问甜点口味和配料，完成简餐点单。"
  },
  "participants": [
    "Naomi",
    "Finn"
  ],
  "context_zh": "娜奥米吃完午餐后，向店员询问当天可点的甜点。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-02-s01",
      "speaker": "Naomi",
      "text": "I would like a small dessert. What do you have?"
    },
    {
      "id": "p03-b-02-s02",
      "speaker": "Finn",
      "text": "There is a lemon biscuit, or a chocolate cookie with a soft centre."
    },
    {
      "id": "p03-b-02-s03",
      "speaker": "Naomi",
      "text": "A soft cookie sounds nice, but I prefer lemon."
    },
    {
      "id": "p03-b-02-s04",
      "speaker": "Finn",
      "text": "Then the biscuit is probably the better choice for you."
    },
    {
      "id": "p03-b-02-s05",
      "speaker": "Naomi",
      "text": "Could you warm it slightly and bring it with my coffee?"
    },
    {
      "id": "p03-b-02-s06",
      "speaker": "Finn",
      "text": "Certainly. One lemon biscuit and a coffee, coming up."
    }
  ],
