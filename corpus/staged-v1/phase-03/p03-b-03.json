{
  "id": "p03-b-03",
  "title_zh": "清理橱柜时分好垃圾",
  "topic_id": "home",
  "scenario": {
    "id": "shared-house-cleanup",
    "label_zh": "分配合租房清洁工作",
    "goal_zh": "明确待清洁区域和离开房间前的操作"
  },
  "participants": [
    "Idris",
    "Ruth"
  ],
  "context_zh": "合租的两位室友整理厨房，发现底层有碎玻璃。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-03-s01",
      "speaker": "Idris",
      "text": "I will wipe the cupboard if you sort the empty boxes."
    },
    {
      "id": "p03-b-03-s02",
      "speaker": "Ruth",
      "text": "Fine. There is a broken jar at the bottom, behind the big tin."
    },
    {
      "id": "p03-b-03-s03",
      "speaker": "Idris",
      "text": "Thanks for warning me. I will be careful."
    },
    {
      "id": "p03-b-03-s04",
      "speaker": "Ruth",
      "text": "I have some thick gloves. Let me pick up the pieces carefully first."
    },
    {
      "id": "p03-b-03-s05",
      "speaker": "Idris",
      "text": "Which bin is for the cardboard?"
    },
    {
      "id": "p03-b-03-s06",
      "speaker": "Ruth",
      "text": "The blue one. Leave the glass for me; I will put it in a separate container."
    },
    {
      "id": "p03-b-03-s07",
      "speaker": "Idris",
      "text": "Deal. Once the shelf is clear, I will clean it and close the cupboard."
    }
  ],
