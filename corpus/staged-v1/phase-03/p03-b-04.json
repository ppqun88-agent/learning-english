{
  "id": "p03-b-04",
  "title_zh": "向朋友借一件面试外套",
  "topic_id": "relationships",
  "scenario": {
    "id": "borrow-clothes-for-interview",
    "label_zh": "借用面试服装",
    "goal_zh": "确认可借用的衣物、腰带及归还安排。"
  },
  "participants": [
    "Leila",
    "Marcus"
  ],
  "context_zh": "莱拉准备参加面试，朋友邀请她从衣柜中借用合适的衣服。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-04-s01",
      "speaker": "Leila",
      "text": "Could I borrow your grey jacket for my interview on Thursday?"
    },
    {
      "id": "p03-b-04-s02",
      "speaker": "Marcus",
      "text": "Of course. It is in the closet, with my work clothing."
    },
    {
      "id": "p03-b-04-s03",
      "speaker": "Leila",
      "text": "Does the brown belt belong to you as well?"
    },
    {
      "id": "p03-b-04-s04",
      "speaker": "Marcus",
      "text": "Yes. Take that too if it fits."
    },
    {
      "id": "p03-b-04-s05",
      "speaker": "Leila",
      "text": "There is a glasses case in the jacket pocket. Shall I leave it here?"
    },
    {
      "id": "p03-b-04-s06",
      "speaker": "Marcus",
      "text": "Please do. I was looking for that."
    },
    {
      "id": "p03-b-04-s07",
      "speaker": "Leila",
      "text": "I will bring the jacket and belt back on Friday, after I have had them cleaned."
    },
    {
      "id": "p03-b-04-s08",
      "speaker": "Marcus",
      "text": "Friday is fine. Good luck with the interview."
    }
  ],
