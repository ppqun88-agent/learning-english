{
  "id": "p03-b-05",
  "title_zh": "说明房内问题并换房",
  "topic_id": "travel",
  "scenario": {
    "id": "hotel-room-fault-replacement",
    "label_zh": "因客房故障申请换房",
    "goal_zh": "向前台说明房内问题并确认替代房间。"
  },
  "participants": [
    "Priya",
    "Ellis"
  ],
  "context_zh": "旅客入住后发现地毯湿了，空调也无法操作，于是联系前台。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-05-s01",
      "speaker": "Priya",
      "text": "I am sorry to complain, but there are two problems with room 214."
    },
    {
      "id": "p03-b-05-s02",
      "speaker": "Ellis",
      "text": "I am sorry to hear that. What seems to be wrong?"
    },
    {
      "id": "p03-b-05-s03",
      "speaker": "Priya",
      "text": "The carpet is wet near the window, and the button on the air conditioner is broken."
    },
    {
      "id": "p03-b-05-s04",
      "speaker": "Ellis",
      "text": "We can move you to another room. I will also ask maintenance to find the cause of the leak."
    },
    {
      "id": "p03-b-05-s05",
      "speaker": "Priya",
      "text": "Thank you. Is the other room in good condition?"
    },
    {
      "id": "p03-b-05-s06",
      "speaker": "Ellis",
      "text": "Yes. We checked it this morning, and the floor is completely dry."
    },
    {
      "id": "p03-b-05-s07",
      "speaker": "Priya",
      "text": "Could I see it before moving my bags? I want to make sure it is comfortable."
    },
    {
      "id": "p03-b-05-s08",
      "speaker": "Ellis",
      "text": "Of course. I will show you room 218 now, and then help with your bags."
    }
  ],
