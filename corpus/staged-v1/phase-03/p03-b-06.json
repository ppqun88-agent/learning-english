{
  "id": "p03-b-06",
  "title_zh": "给生物课展示补上标签",
  "topic_id": "learning",
  "scenario": {
    "id": "anatomy-model-labels",
    "label_zh": "核对人体模型标签",
    "goal_zh": "为生物课展示核实模型部位及图片标签。"
  },
  "participants": [
    "Yara",
    "Felix"
  ],
  "context_zh": "两名学生准备人体模型展示，讨论缺失的标签和插图。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-06-s01",
      "speaker": "Yara",
      "text": "Our biology presentation is tomorrow, and two labels are still missing."
    },
    {
      "id": "p03-b-06-s02",
      "speaker": "Felix",
      "text": "I can make them. Which parts do we need?"
    },
    {
      "id": "p03-b-06-s03",
      "speaker": "Yara",
      "text": "The brain at the top, and this long bone in the leg."
    },
    {
      "id": "p03-b-06-s04",
      "speaker": "Felix",
      "text": "Shall I use the names from our textbook diagram?"
    },
    {
      "id": "p03-b-06-s05",
      "speaker": "Yara",
      "text": "Yes. We also need one picture of a cell, but not on the model itself."
    },
    {
      "id": "p03-b-06-s06",
      "speaker": "Felix",
      "text": "I will put that picture on a separate card beside the model."
    },
    {
      "id": "p03-b-06-s07",
      "speaker": "Yara",
      "text": "Good. Bring the cards to class, and I will bring the model."
    }
  ],
