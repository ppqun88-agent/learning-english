{
  "id": "p03-b-07",
  "title_zh": "去开放日了解化学专业",
  "topic_id": "learning",
  "scenario": {
    "id": "science-degree-open-day",
    "label_zh": "安排科学专业开放日",
    "goal_zh": "根据学位兴趣选择院系并约定校园开放日参观。"
  },
  "participants": [
    "Soren",
    "Amina"
  ],
  "context_zh": "准大学生在开放日信息台咨询化学专业的参观安排。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-07-s01",
      "speaker": "Soren",
      "text": "I am interested in a degree in chemistry. Is there a talk about that today?"
    },
    {
      "id": "p03-b-07-s02",
      "speaker": "Amina",
      "text": "Yes. The chemistry department is running a session at eleven."
    },
    {
      "id": "p03-b-07-s03",
      "speaker": "Soren",
      "text": "Is it here in this building?"
    },
    {
      "id": "p03-b-07-s04",
      "speaker": "Amina",
      "text": "No, it is on the north side of campus. I can mark the building on your map."
    },
    {
      "id": "p03-b-07-s05",
      "speaker": "Soren",
      "text": "Thanks. Will there be someone to ask about the first-year courses?"
    },
    {
      "id": "p03-b-07-s06",
      "speaker": "Amina",
      "text": "A lecturer will stay after the talk to answer questions."
    },
    {
      "id": "p03-b-07-s07",
      "speaker": "Soren",
      "text": "Perfect. I will go to that session and ask about the course options."
    }
  ],
