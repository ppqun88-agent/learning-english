{
  "id": "p03-b-08",
  "title_zh": "安排慈善晚会的捐款台",
  "topic_id": "community",
  "scenario": {
    "id": "charity-donation-desk",
    "label_zh": "安排慈善活动捐款台",
    "goal_zh": "明确筹款人员分工并妥善收取现场捐款。"
  },
  "participants": [
    "Wendy",
    "Omar"
  ],
  "context_zh": "志愿者在一场虚构慈善活动开始前明确接待与捐款收取职责。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-08-s01",
      "speaker": "Wendy",
      "text": "Can you look after the donation desk for the charity tonight?"
    },
    {
      "id": "p03-b-08-s02",
      "speaker": "Omar",
      "text": "Yes. Am I also greeting the guests?"
    },
    {
      "id": "p03-b-08-s03",
      "speaker": "Wendy",
      "text": "No, I will do that. A local businessman is bringing the first group at six."
    },
    {
      "id": "p03-b-08-s04",
      "speaker": "Omar",
      "text": "Is he the celebrity mentioned on the poster?"
    },
    {
      "id": "p03-b-08-s05",
      "speaker": "Wendy",
      "text": "No, that is the singer who performs later. You only need to collect the donations."
    },
    {
      "id": "p03-b-08-s06",
      "speaker": "Omar",
      "text": "If someone gives cash, should I put it straight into this locked box?"
    },
    {
      "id": "p03-b-08-s07",
      "speaker": "Wendy",
      "text": "Yes, and write the amount on this sheet. We will count everything together afterward."
    },
    {
      "id": "p03-b-08-s08",
      "speaker": "Omar",
      "text": "Understood. I will stay at the desk, and you will handle the guests."
    }
  ],
