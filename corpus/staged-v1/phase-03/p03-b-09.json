{
  "id": "p03-b-09",
  "title_zh": "帮孩子适应新班级",
  "topic_id": "relationships",
  "scenario": {
    "id": "child-classroom-support",
    "label_zh": "商量孩子的课堂支持",
    "goal_zh": "了解课堂表现并商定孩子难过时的求助方式。"
  },
  "participants": [
    "Grace",
    "Mr. Reed"
  ],
  "context_zh": "家长和教师讨论孩子在新班级里因紧张而躲开活动的情况，使用美式拼写。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-09-s01",
      "speaker": "Grace",
      "text": "I wanted to ask about Milo. Has his behavior in class been a problem?"
    },
    {
      "id": "p03-b-09-s02",
      "speaker": "Mr. Reed",
      "text": "He has been quiet, but he has not hurt or upset anyone."
    },
    {
      "id": "p03-b-09-s03",
      "speaker": "Grace",
      "text": "At home he keeps asking whether he knows how to behave at school."
    },
    {
      "id": "p03-b-09-s04",
      "speaker": "Mr. Reed",
      "text": "He does. I think he needs time to feel at home here."
    },
    {
      "id": "p03-b-09-s05",
      "speaker": "Grace",
      "text": "He worries that he might cry if he misses us."
    },
    {
      "id": "p03-b-09-s06",
      "speaker": "Mr. Reed",
      "text": "That is all right. While he is in our care, he can come to me whenever he feels upset."
    },
    {
      "id": "p03-b-09-s07",
      "speaker": "Grace",
      "text": "Could we tell him that together when I bring him tomorrow?"
    },
    {
      "id": "p03-b-09-s08",
      "speaker": "Mr. Reed",
      "text": "Certainly. I will meet you at the classroom door."
    }
  ],
