{
  "id": "p03-b-10",
  "title_zh": "首次参赛前确认规则",
  "topic_id": "leisure",
  "scenario": {
    "id": "first-team-competition-rules",
    "label_zh": "确认首次团队比赛规则",
    "goal_zh": "核实参赛资格、教练安排及场上行为要求。"
  },
  "participants": [
    "Toby",
    "Coach Elena"
  ],
  "context_zh": "俱乐部的新成员向教练询问比赛安排及行为要求，使用英式拼写。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-10-s01",
      "speaker": "Toby",
      "text": "Am I ready to compete this Saturday?"
    },
    {
      "id": "p03-b-10-s02",
      "speaker": "Coach Elena",
      "text": "Yes. This competition has a beginner group, and I have entered you in it."
    },
    {
      "id": "p03-b-10-s03",
      "speaker": "Toby",
      "text": "Will you be there as my coach?"
    },
    {
      "id": "p03-b-10-s04",
      "speaker": "Coach Elena",
      "text": "I will. We will warm up together before your first game."
    },
    {
      "id": "p03-b-10-s05",
      "speaker": "Toby",
      "text": "Is there anything else I should know?"
    },
    {
      "id": "p03-b-10-s06",
      "speaker": "Coach Elena",
      "text": "Good behaviour matters as much as the score. Listen to the referee and be polite to the other players."
    },
    {
      "id": "p03-b-10-s07",
      "speaker": "Toby",
      "text": "Understood. I will meet you at the entrance at nine."
    }
  ],
