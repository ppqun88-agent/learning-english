{
  "id": "p03-b-13",
  "title_zh": "海边起风后缩短骑行",
  "topic_id": "leisure",
  "scenario": {
    "id": "coastal-cycle-weather",
    "label_zh": "根据海边天气调整骑行",
    "goal_zh": "结合眼前天气和遮雨条件选择较短的骑行路线"
  },
  "participants": [
    "Pavel",
    "Holly"
  ],
  "context_zh": "两位朋友在虚构骑行途中观察海边天色，决定改走可避雨的短路线。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-13-s01",
      "speaker": "Pavel",
      "text": "Shall we cycle all the way along the coast?"
    },
    {
      "id": "p03-b-13-s02",
      "speaker": "Holly",
      "text": "It is bright here, but look at that dark cloud over the water."
    },
    {
      "id": "p03-b-13-s03",
      "speaker": "Pavel",
      "text": "You are right. And the wind could blow straight at us on the exposed path."
    },
    {
      "id": "p03-b-13-s04",
      "speaker": "Holly",
      "text": "Let us take the short loop instead. There is a cafe halfway round if it rains."
    },
    {
      "id": "p03-b-13-s05",
      "speaker": "Pavel",
      "text": "Good idea. We can turn inland at the next sign."
    },
    {
      "id": "p03-b-13-s06",
      "speaker": "Holly",
      "text": "Agreed. The long coastal ride can wait for another day."
    }
  ],
