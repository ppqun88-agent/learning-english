{
  "id": "p03-b-15",
  "title_zh": "绕开封闭小桥去城堡",
  "topic_id": "travel",
  "scenario": {
    "id": "historic-town-walking-route",
    "label_zh": "确认古城步行路线",
    "goal_zh": "根据封路情况确认到城堡的替代步行路线。"
  },
  "participants": [
    "Benita",
    "Driver Hassan"
  ],
  "context_zh": "游客在古城下车后，向司机确认替代步行路线与回程上车点。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-15-s01",
      "speaker": "Benita",
      "text": "Is this the right stop for the castle?"
    },
    {
      "id": "p03-b-15-s02",
      "speaker": "Driver Hassan",
      "text": "Yes, but the bridge on the direct route is closed today."
    },
    {
      "id": "p03-b-15-s03",
      "speaker": "Benita",
      "text": "Which direction should I go instead?"
    },
    {
      "id": "p03-b-15-s04",
      "speaker": "Driver Hassan",
      "text": "Walk one block to the church, then turn left at the corner."
    },
    {
      "id": "p03-b-15-s05",
      "speaker": "Benita",
      "text": "Do I cross the river there?"
    },
    {
      "id": "p03-b-15-s06",
      "speaker": "Driver Hassan",
      "text": "Yes. Use the stone bridge beside the church. The castle is just beyond it."
    },
    {
      "id": "p03-b-15-s07",
      "speaker": "Benita",
      "text": "Thanks. Where do I board the bus for the return journey?"
    },
    {
      "id": "p03-b-15-s08",
      "speaker": "Driver Hassan",
      "text": "At the stop opposite this one. You can catch the last bus at six."
    },
    {
      "id": "p03-b-15-s09",
      "speaker": "Benita",
      "text": "Got it. I will use the stone bridge and be back here before six."
    }
  ],
