{
  "id": "p03-b-16",
  "title_zh": "描述牙痛并预约检查",
  "topic_id": "health",
  "scenario": {
    "id": "dental-appointment-request",
    "label_zh": "因牙痛预约牙医",
    "goal_zh": "描述疼痛持续情况并确认可到诊时间"
  },
  "participants": [
    "Nadia",
    "Receptionist Paul"
  ],
  "context_zh": "虚构患者向牙科前台说明症状和可到诊时间；对话不诊断或提供治疗建议。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-16-s01",
      "speaker": "Nadia",
      "text": "Could I make an appointment with the dentist? One of my teeth has hurt since Monday."
    },
    {
      "id": "p03-b-16-s02",
      "speaker": "Receptionist Paul",
      "text": "I can help with the booking. Is there anything else you want me to note?"
    },
    {
      "id": "p03-b-16-s03",
      "speaker": "Nadia",
      "text": "I notice some blood when I brush my teeth."
    },
    {
      "id": "p03-b-16-s04",
      "speaker": "Receptionist Paul",
      "text": "I will add that to the message for the dentist."
    },
    {
      "id": "p03-b-16-s05",
      "speaker": "Nadia",
      "text": "It has made my daily routine quite uncomfortable."
    },
    {
      "id": "p03-b-16-s06",
      "speaker": "Receptionist Paul",
      "text": "We have an appointment at ten tomorrow morning. Can you come then?"
    },
    {
      "id": "p03-b-16-s07",
      "speaker": "Nadia",
      "text": "Yes. Please book that for me. I will describe the problem in more detail when I arrive."
    }
  ],
