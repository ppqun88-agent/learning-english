{
  "id": "p03-b-18",
  "title_zh": "修改活动海报上的卡通角色",
  "topic_id": "work",
  "scenario": {
    "id": "cartoon-character-sketch",
    "label_zh": "修改卡通角色草图",
    "goal_zh": "讨论角色形象及设计修改并确认下一版草图。"
  },
  "participants": [
    "Anton",
    "Designer Iris"
  ],
  "context_zh": "项目负责人和设计师商量海报角色的外形，明确下一版草图的修改范围。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-18-s01",
      "speaker": "Anton",
      "text": "Are you the designer working on our reading-club poster?"
    },
    {
      "id": "p03-b-18-s02",
      "speaker": "Designer Iris",
      "text": "Yes. I have brought a sketch of the cartoon character."
    },
    {
      "id": "p03-b-18-s03",
      "speaker": "Anton",
      "text": "I like the curly hair, but the face looks rather serious."
    },
    {
      "id": "p03-b-18-s04",
      "speaker": "Designer Iris",
      "text": "I can make the expression friendlier. Do you want to keep the little book?"
    },
    {
      "id": "p03-b-18-s05",
      "speaker": "Anton",
      "text": "Definitely. The idea of a book that walks is creative and fits the club."
    },
    {
      "id": "p03-b-18-s06",
      "speaker": "Designer Iris",
      "text": "Then I will keep the hair and book, and only change the face."
    },
    {
      "id": "p03-b-18-s07",
      "speaker": "Anton",
      "text": "That sounds right. Send me the new sketch tomorrow, and we can choose the colours."
    }
  ],
