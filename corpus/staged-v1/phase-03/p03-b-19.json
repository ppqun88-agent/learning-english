{
  "id": "p03-b-19",
  "title_zh": "周五电影夜选喜剧",
  "topic_id": "leisure",
  "scenario": {
    "id": "friends-film-night",
    "label_zh": "商定朋友电影之夜",
    "goal_zh": "兼顾时间与喜好选定影片"
  },
  "participants": [
    "Ravi",
    "Elise"
  ],
  "context_zh": "两位朋友确认可用时间，并从两部电影中选定一部。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-19-s01",
      "speaker": "Ravi",
      "text": "Are you still free for our film night on Friday?"
    },
    {
      "id": "p03-b-19-s02",
      "speaker": "Elise",
      "text": "Yes, but I need to leave by ten. What shall we watch?"
    },
    {
      "id": "p03-b-19-s03",
      "speaker": "Ravi",
      "text": "I was thinking of that long space drama."
    },
    {
      "id": "p03-b-19-s04",
      "speaker": "Elise",
      "text": "I disagree with that choice. We would not have time to finish it. How about a comedy?"
    },
    {
      "id": "p03-b-19-s05",
      "speaker": "Ravi",
      "text": "There is a new one by the director who made our favourite film last year."
    },
    {
      "id": "p03-b-19-s06",
      "speaker": "Elise",
      "text": "I have not seen it. Let us give it a chance."
    },
    {
      "id": "p03-b-19-s07",
      "speaker": "Ravi",
      "text": "It is only ninety minutes, so a seven o'clock start would work."
    },
    {
      "id": "p03-b-19-s08",
      "speaker": "Elise",
      "text": "Then I can definitely stay for the whole film. See you at seven."
    }
  ],
