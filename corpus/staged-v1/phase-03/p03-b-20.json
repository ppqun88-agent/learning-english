{
  "id": "p03-b-20",
  "title_zh": "先弄清悬疑剧的角色关系",
  "topic_id": "leisure",
  "scenario": {
    "id": "mystery-scene-rehearsal",
    "label_zh": "排练悬疑剧片段",
    "goal_zh": "澄清虚构案件的角色关系并确定继续排练的位置。"
  },
  "participants": [
    "Actor Beatrice",
    "Director Samir"
  ],
  "context_zh": "业余剧团排练原创虚构悬疑剧，演员确认角色知道的信息，再继续排练。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-20-s01",
      "speaker": "Actor Beatrice",
      "text": "Before we continue, can we check what my character knows in this scene?"
    },
    {
      "id": "p03-b-20-s02",
      "speaker": "Director Samir",
      "text": "You play the detective. You know that a crime has taken place, but you do not know who did it."
    },
    {
      "id": "p03-b-20-s03",
      "speaker": "Actor Beatrice",
      "text": "Is the man on the floor already dead when I enter?"
    },
    {
      "id": "p03-b-20-s04",
      "speaker": "Director Samir",
      "text": "Yes. His death is what brings you to the house."
    },
    {
      "id": "p03-b-20-s05",
      "speaker": "Actor Beatrice",
      "text": "And the woman at the door is the criminal?"
    },
    {
      "id": "p03-b-20-s06",
      "speaker": "Director Samir",
      "text": "She is, but your character does not discover that until the last scene."
    },
    {
      "id": "p03-b-20-s07",
      "speaker": "Actor Beatrice",
      "text": "Right. I was looking at her as if I already knew. Let us start again from my entrance."
    },
    {
      "id": "p03-b-20-s08",
      "speaker": "Director Samir",
      "text": "Good. Everyone back to the doorway, please."
    }
  ],
