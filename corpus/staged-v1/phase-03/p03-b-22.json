{
  "id": "p03-b-22",
  "title_zh": "开会前交接签到接待",
  "topic_id": "work",
  "scenario": {
    "id": "conference-welcome-handover",
    "label_zh": "交接会议接待安排",
    "goal_zh": "明确同事接待职责和会议当天联络方式。"
  },
  "participants": [
    "Bianca",
    "Luis"
  ],
  "context_zh": "同事在工作交接时明确会议接待职责和临时联络方式。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-22-s01",
      "speaker": "Bianca",
      "text": "Do you have time for a quick chat about tomorrow's conference?"
    },
    {
      "id": "p03-b-22-s02",
      "speaker": "Luis",
      "text": "Yes. My boss said I should help at the welcome desk."
    },
    {
      "id": "p03-b-22-s03",
      "speaker": "Bianca",
      "text": "Thank you. My colleague Hana will show you the guest list at eight thirty."
    },
    {
      "id": "p03-b-22-s04",
      "speaker": "Luis",
      "text": "How will we communicate if a guest is missing from the list?"
    },
    {
      "id": "p03-b-22-s05",
      "speaker": "Bianca",
      "text": "Send me a message on the staff app. I will be near the main hall."
    },
    {
      "id": "p03-b-22-s06",
      "speaker": "Luis",
      "text": "All right. I will check names, and Hana can hand out the badges."
    },
    {
      "id": "p03-b-22-s07",
      "speaker": "Bianca",
      "text": "Perfect. I will tell her that you are arriving at eight thirty."
    }
  ],
