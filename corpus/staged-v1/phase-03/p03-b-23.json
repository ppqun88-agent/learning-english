{
  "id": "p03-b-23",
  "title_zh": "确认演示屏幕已连接",
  "topic_id": "work",
  "scenario": {
    "id": "presentation-display-connection",
    "label_zh": "连接演示设备",
    "goal_zh": "检查屏幕连接与控制方式后确认开始演示。"
  },
  "participants": [
    "Malik",
    "Technician Zoe"
  ],
  "context_zh": "演讲者在会议室准备演示，技术人员协助连接电脑并检查翻页控制。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-23-s01",
      "speaker": "Malik",
      "text": "Can you help me connect my laptop to the screen?"
    },
    {
      "id": "p03-b-23-s02",
      "speaker": "Technician Zoe",
      "text": "Sure. Select the device called Meeting Room Three."
    },
    {
      "id": "p03-b-23-s03",
      "speaker": "Malik",
      "text": "It is asking for a code."
    },
    {
      "id": "p03-b-23-s04",
      "speaker": "Technician Zoe",
      "text": "Use the temporary number shown on the screen. It changes for each meeting."
    },
    {
      "id": "p03-b-23-s05",
      "speaker": "Malik",
      "text": "Done. The status now says \"connected\", and I can see my first slide."
    },
    {
      "id": "p03-b-23-s06",
      "speaker": "Technician Zoe",
      "text": "Good. This digital display also plays sound. Do you need that today?"
    },
    {
      "id": "p03-b-23-s07",
      "speaker": "Malik",
      "text": "No, just the slides. Can I control them from my laptop?"
    },
    {
      "id": "p03-b-23-s08",
      "speaker": "Technician Zoe",
      "text": "Yes. Try moving to the next one."
    },
    {
      "id": "p03-b-23-s09",
      "speaker": "Malik",
      "text": "That works. I am ready to start."
    }
  ],
