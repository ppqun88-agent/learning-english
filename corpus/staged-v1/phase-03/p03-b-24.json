{
  "id": "p03-b-24",
  "title_zh": "把草稿里不明确的变化说清楚",
  "topic_id": "work",
  "scenario": {
    "id": "draft-feedback",
    "label_zh": "反馈与修改草稿",
    "goal_zh": "提出可操作反馈并协商修订安排"
  },
  "participants": [
    "Editor Rosa",
    "Writer Theo"
  ],
  "context_zh": "编辑根据读者反馈与作者讨论一篇社区简讯草稿，约定当天修订。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-24-s01",
      "speaker": "Editor Rosa",
      "text": "I have one comment on the opening paragraph of your draft."
    },
    {
      "id": "p03-b-24-s02",
      "speaker": "Writer Theo",
      "text": "Is it the sentence about the new timetable?"
    },
    {
      "id": "p03-b-24-s03",
      "speaker": "Editor Rosa",
      "text": "Yes. I am not certain which service has changed."
    },
    {
      "id": "p03-b-24-s04",
      "speaker": "Writer Theo",
      "text": "I assumed readers had seen last week's notice."
    },
    {
      "id": "p03-b-24-s05",
      "speaker": "Editor Rosa",
      "text": "Without that context, they may understand the sentence differently."
    },
    {
      "id": "p03-b-24-s06",
      "speaker": "Writer Theo",
      "text": "I see. I should name the bus service and say exactly what has changed."
    },
    {
      "id": "p03-b-24-s07",
      "speaker": "Editor Rosa",
      "text": "Would you consider adding the old and new times? That would explain it clearly."
    },
    {
      "id": "p03-b-24-s08",
      "speaker": "Writer Theo",
      "text": "Yes. I will make those changes and send you the revised paragraph by four."
    }
  ],
