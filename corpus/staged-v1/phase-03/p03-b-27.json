{
  "id": "p03-b-27",
  "title_zh": "大胆尝试前先保留原型",
  "topic_id": "work",
  "scenario": {
    "id": "prototype-backup-agreement",
    "label_zh": "为试验原型保留备份",
    "goal_zh": "讨论新点子并在开发试验前保存原版本。"
  },
  "participants": [
    "Ines",
    "Noah"
  ],
  "context_zh": "同事讨论一个尚未实施的展示原型，在尝试新方案前约定保留原版本。",
  "author": "author-phase03-b",
  "sentences": [
    {
      "id": "p03-b-27-s01",
      "speaker": "Ines",
      "text": "This may sound crazy, but could our display change colour when someone walks past?"
    },
    {
      "id": "p03-b-27-s02",
      "speaker": "Noah",
      "text": "That is a clever idea. Do you want to develop a small test version?"
    },
    {
      "id": "p03-b-27-s03",
      "speaker": "Ines",
      "text": "Yes. I could change the files from our current display."
    },
    {
      "id": "p03-b-27-s04",
      "speaker": "Noah",
      "text": "Let us save a separate version first. We do not want the experiment to destroy our only working copy."
    },
    {
      "id": "p03-b-27-s05",
      "speaker": "Ines",
      "text": "Good point. I will keep the original untouched and work in a new folder."
    },
    {
      "id": "p03-b-27-s06",
      "speaker": "Noah",
      "text": "Then I will sketch how the visitor test could work. We can compare our ideas tomorrow."
    }
  ],
