{
  "id": "p03-c-01",
  "title_zh": "给救助物资腾出位置",
  "topic_id": "community",
  "scenario": {
    "id": "flood-supply-sorting",
    "label_zh": "分配洪水救助物资整理工作",
    "goal_zh": "确认临时物资间和大件捐赠物的安放位置"
  },
  "participants": [
    "Amina",
    "Joel"
  ],
  "context_zh": "虚构社区洪水过后，志愿者在物资点分配整理工作。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-01-s01",
      "speaker": "Amina",
      "text": "Where should I put these donated chairs?"
    },
    {
      "id": "p03-c-01-s02",
      "speaker": "Joel",
      "text": "The hall is full. There's an empty classroom next door."
    },
    {
      "id": "p03-c-01-s03",
      "speaker": "Amina",
      "text": "Can we put all the furniture in there? Some of the tables are enormous."
    },
    {
      "id": "p03-c-01-s04",
      "speaker": "Joel",
      "text": "Just the chairs for now. We'll measure the doorway before moving the tables."
    },
    {
      "id": "p03-c-01-s05",
      "speaker": "Amina",
      "text": "I didn't expect so many donations after the disaster."
    },
    {
      "id": "p03-c-01-s06",
      "speaker": "Joel",
      "text": "People have been generous. Could you put a sign on the classroom door?"
    },
    {
      "id": "p03-c-01-s07",
      "speaker": "Amina",
      "text": "Of course. I'll mark it 'Chairs' and leave the doorway clear."
    }
  ],
