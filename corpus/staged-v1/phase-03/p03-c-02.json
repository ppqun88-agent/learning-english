{
  "id": "p03-c-02",
  "title_zh": "查证旧地图上的聚落",
  "topic_id": "reasoning",
  "scenario": {
    "id": "archive-map-discovery",
    "label_zh": "核对旧地图发现",
    "goal_zh": "查证旧地图是否支持曾有聚落的解释"
  },
  "participants": [
    "Inez",
    "Tom"
  ],
  "context_zh": "地方档案室中，两名研究者讨论一幅新找到的旧地图能证明什么。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-02-s01",
      "speaker": "Inez",
      "text": "Did you discover anything useful in that box?"
    },
    {
      "id": "p03-c-02-s02",
      "speaker": "Tom",
      "text": "An old map. This document shows three buildings beside the river."
    },
    {
      "id": "p03-c-02-s03",
      "speaker": "Inez",
      "text": "That's an interesting discovery. Do the buildings still exist?"
    },
    {
      "id": "p03-c-02-s04",
      "speaker": "Tom",
      "text": "I don't know. There are no buildings there on the modern map."
    },
    {
      "id": "p03-c-02-s05",
      "speaker": "Inez",
      "text": "So can we say there was a human settlement there?"
    },
    {
      "id": "p03-c-02-s06",
      "speaker": "Tom",
      "text": "Not yet. They might have been storage buildings, with nobody living there."
    },
    {
      "id": "p03-c-02-s07",
      "speaker": "Inez",
      "text": "Let's ask an expert on local history to look at it."
    },
    {
      "id": "p03-c-02-s08",
      "speaker": "Tom",
      "text": "Good idea. I'll send the archive reference and a picture of the map."
    }
  ],
