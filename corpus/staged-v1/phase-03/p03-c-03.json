{
  "id": "p03-c-03",
  "title_zh": "让短剧结尾更可信",
  "topic_id": "leisure",
  "scenario": {
    "id": "short-play-ending-rehearsal",
    "label_zh": "修改短剧结尾表演",
    "goal_zh": "根据角色动机调整冲突场景和结尾的表演方式"
  },
  "participants": [
    "Luca",
    "Mabel"
  ],
  "context_zh": "业余剧团排练一部虚构短剧，演员和导演协商结尾的情绪表达。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-03-s01",
      "speaker": "Luca",
      "text": "The ending feels sudden. Why does the hero forgive his brother?"
    },
    {
      "id": "p03-c-03-s02",
      "speaker": "Mabel",
      "text": "Because he realizes they both want the same thing. This is a family drama, not an action film."
    },
    {
      "id": "p03-c-03-s03",
      "speaker": "Luca",
      "text": "Then do we need the fight in the last scene?"
    },
    {
      "id": "p03-c-03-s04",
      "speaker": "Mabel",
      "text": "We can remove it. He can put down the toy gun and listen instead."
    },
    {
      "id": "p03-c-03-s05",
      "speaker": "Luca",
      "text": "How do I express his anger without shouting?"
    },
    {
      "id": "p03-c-03-s06",
      "speaker": "Mabel",
      "text": "Try a long pause. Let your face do some of the work."
    },
    {
      "id": "p03-c-03-s07",
      "speaker": "Luca",
      "text": "Like this?"
    },
    {
      "id": "p03-c-03-s08",
      "speaker": "Mabel",
      "text": "Yes. That expression looks hurt rather than cruel."
    },
    {
      "id": "p03-c-03-s09",
      "speaker": "Luca",
      "text": "That makes the apology easier to believe. Let's try the scene again without the struggle."
    }
  ],
