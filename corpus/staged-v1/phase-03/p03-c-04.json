{
  "id": "p03-c-04",
  "title_zh": "找回下载后看不见的文件",
  "topic_id": "services",
  "scenario": {
    "id": "missing-pdf-download",
    "label_zh": "排查电子文件下载失败",
    "goal_zh": "重现文件消失问题并确认正确的保存方法"
  },
  "participants": [
    "Zoe",
    "Malik"
  ],
  "context_zh": "图书馆的电脑帮助台协助读者保存一份电子报名表。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-04-s01",
      "speaker": "Zoe",
      "text": "I can open the electronic form, but it seems to disappear when I close the browser."
    },
    {
      "id": "p03-c-04-s02",
      "speaker": "Malik",
      "text": "Did you download it, or just open the preview?"
    },
    {
      "id": "p03-c-04-s03",
      "speaker": "Zoe",
      "text": "Just the preview. When I try to save it, I get an error."
    },
    {
      "id": "p03-c-04-s04",
      "speaker": "Malik",
      "text": "What's the exact message?"
    },
    {
      "id": "p03-c-04-s05",
      "speaker": "Zoe",
      "text": "It says, 'Choose a file name.'"
    },
    {
      "id": "p03-c-04-s06",
      "speaker": "Malik",
      "text": "That helps. We can fix this by giving the file a name before saving it."
    },
    {
      "id": "p03-c-04-s07",
      "speaker": "Zoe",
      "text": "Should I type the name exactly as it appears at the top of the form?"
    },
    {
      "id": "p03-c-04-s08",
      "speaker": "Malik",
      "text": "You can use a shorter name. Try 'Course form' and save it in Documents."
    },
    {
      "id": "p03-c-04-s09",
      "speaker": "Zoe",
      "text": "There it is. I've closed the browser and can still open the file. Thanks!"
    }
  ],
