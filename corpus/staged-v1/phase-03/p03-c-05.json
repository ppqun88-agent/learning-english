{
  "id": "p03-c-05",
  "title_zh": "了解工厂学徒岗位",
  "topic_id": "work",
  "scenario": {
    "id": "factory-apprentice-job-inquiry",
    "label_zh": "询问工厂学徒岗位",
    "goal_zh": "核实岗位经验要求、培训机会和报酬"
  },
  "participants": [
    "Nadia",
    "Mr Cole"
  ],
  "context_zh": "求职者参加一家虚构制造厂的公开招聘咨询，询问培训岗位。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-05-s01",
      "speaker": "Nadia",
      "text": "Do you employ people who haven't worked in a factory before?"
    },
    {
      "id": "p03-c-05-s02",
      "speaker": "Mr Cole",
      "text": "Yes. Our apprentice roles don't require previous experience."
    },
    {
      "id": "p03-c-05-s03",
      "speaker": "Nadia",
      "text": "I'd like to become an engineer, but I can't afford to stop working."
    },
    {
      "id": "p03-c-05-s04",
      "speaker": "Mr Cole",
      "text": "You'd earn a wage while you train. Part of the week is spent at college."
    },
    {
      "id": "p03-c-05-s05",
      "speaker": "Nadia",
      "text": "So I could continue my education and still be an employee?"
    },
    {
      "id": "p03-c-05-s06",
      "speaker": "Mr Cole",
      "text": "Exactly. The job and the college course run together."
    },
    {
      "id": "p03-c-05-s07",
      "speaker": "Nadia",
      "text": "My current employer needs four weeks' notice. Would that be a problem?"
    },
    {
      "id": "p03-c-05-s08",
      "speaker": "Mr Cole",
      "text": "No. The next group starts in January. Here's the application page."
    },
    {
      "id": "p03-c-05-s09",
      "speaker": "Nadia",
      "text": "Thanks. I'll read the course details before I apply."
    }
  ],
