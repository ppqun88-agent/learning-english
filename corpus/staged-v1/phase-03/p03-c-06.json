{
  "id": "p03-c-06",
  "title_zh": "只改变浇水量的实验",
  "topic_id": "learning",
  "scenario": {
    "id": "seed-trial-design",
    "label_zh": "制定种子生长对照实验",
    "goal_zh": "只改变浇水量并约定观察记录方式"
  },
  "participants": [
    "Sofia",
    "Ben"
  ],
  "context_zh": "两名学生在教师监督的课堂项目中商量种子对照实验的记录方法。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-06-s01",
      "speaker": "Sofia",
      "text": "For our experiment, should we change the amount of water and the light?"
    },
    {
      "id": "p03-c-06-s02",
      "speaker": "Ben",
      "text": "Let's focus on water. If we change both, we won't know which one made a difference."
    },
    {
      "id": "p03-c-06-s03",
      "speaker": "Sofia",
      "text": "All right. We'll use the same seeds and the same amount of earth in each pot."
    },
    {
      "id": "p03-c-06-s04",
      "speaker": "Ben",
      "text": "And put the pots together, so light isn't another factor."
    },
    {
      "id": "p03-c-06-s05",
      "speaker": "Sofia",
      "text": "This earth feels dry already. Shall we note that before we start?"
    },
    {
      "id": "p03-c-06-s06",
      "speaker": "Ben",
      "text": "Yes. Then we can record how much water each pot gets."
    },
    {
      "id": "p03-c-06-s07",
      "speaker": "Sofia",
      "text": "How will we measure the effect?"
    },
    {
      "id": "p03-c-06-s08",
      "speaker": "Ben",
      "text": "Let's count how many seeds grow, and ask our teacher if that comparison makes sense."
    },
    {
      "id": "p03-c-06-s09",
      "speaker": "Sofia",
      "text": "I'll make a table with a separate column for each pot."
    }
  ],
