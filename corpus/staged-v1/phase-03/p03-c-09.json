{
  "id": "p03-c-09",
  "title_zh": "第一次帮忙喂鸭子",
  "topic_id": "nature",
  "scenario": {
    "id": "volunteer-duck-feeding",
    "label_zh": "交接农场鸭群喂养",
    "goal_zh": "识别照护对象并核对工作人员安排的喂食位置"
  },
  "participants": [
    "Mae",
    "Owen"
  ],
  "context_zh": "教育农场的工作人员向新志愿者交接当天已安排好的鸭群照护工作。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-09-s01",
      "speaker": "Mae",
      "text": "I've never worked in farming. Could you show me where to start?"
    },
    {
      "id": "p03-c-09-s02",
      "speaker": "Owen",
      "text": "Of course. Today you'll help me feed the ducks, using the portions I've prepared."
    },
    {
      "id": "p03-c-09-s03",
      "speaker": "Mae",
      "text": "Are they in the field behind the barn?"
    },
    {
      "id": "p03-c-09-s04",
      "speaker": "Owen",
      "text": "Yes, through this gate. Please close it behind us."
    },
    {
      "id": "p03-c-09-s05",
      "speaker": "Mae",
      "text": "Does the female duck with the blue tag eat with the others?"
    },
    {
      "id": "p03-c-09-s06",
      "speaker": "Owen",
      "text": "Not today. Her portion goes in the separate pen, and I'll take it to her."
    },
    {
      "id": "p03-c-09-s07",
      "speaker": "Mae",
      "text": "So I only carry the two bowls marked 'Main group'?"
    },
    {
      "id": "p03-c-09-s08",
      "speaker": "Owen",
      "text": "That's right. Bring those, and we'll do the round together."
    }
  ],
