{
  "id": "p03-c-10",
  "title_zh": "避开池边的小动物",
  "topic_id": "nature",
  "scenario": {
    "id": "pond-cleanup-observation",
    "label_zh": "调整池塘清洁位置",
    "goal_zh": "发现蛙类后避开栖息区域并安排垃圾清理"
  },
  "participants": [
    "Tariq",
    "Ellen"
  ],
  "context_zh": "公园清洁志愿者在林边池塘发现小动物，调整清洁范围并联系管理人员。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-10-s01",
      "speaker": "Tariq",
      "text": "There's a frog in the grass beside that plastic bag."
    },
    {
      "id": "p03-c-10-s02",
      "speaker": "Ellen",
      "text": "Let's leave that patch alone for now. We don't want to disturb it."
    },
    {
      "id": "p03-c-10-s03",
      "speaker": "Tariq",
      "text": "Should we collect the garbage on the path instead?"
    },
    {
      "id": "p03-c-10-s04",
      "speaker": "Ellen",
      "text": "Yes. There's plenty on the ground near the benches."
    },
    {
      "id": "p03-c-10-s05",
      "speaker": "Tariq",
      "text": "I thought we'd start at the edge of the forest."
    },
    {
      "id": "p03-c-10-s06",
      "speaker": "Ellen",
      "text": "We can ask the ranger which areas are suitable. Protecting the environment also means being careful about where we walk."
    },
    {
      "id": "p03-c-10-s07",
      "speaker": "Tariq",
      "text": "I'll speak to her. You can take the path, and I'll join you when I know more."
    }
  ],
