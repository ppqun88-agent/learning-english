{
  "id": "p03-c-12",
  "title_zh": "挑选一次运动体验",
  "topic_id": "leisure",
  "scenario": {
    "id": "sports-taster-choice",
    "label_zh": "选择社区运动课程",
    "goal_zh": "选择适合初学者的社区运动体验课并确认用品。"
  },
  "participants": [
    "Keira",
    "Leon"
  ],
  "context_zh": "社区运动中心工作人员帮助初学者选择周末体验活动。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-12-s01",
      "speaker": "Keira",
      "text": "I'm a hockey fan, but I've never played. Is your taster session suitable for me?"
    },
    {
      "id": "p03-c-12-s02",
      "speaker": "Leon",
      "text": "Yes. We start with how to hold the stick and hit the ball."
    },
    {
      "id": "p03-c-12-s03",
      "speaker": "Keira",
      "text": "I'm not very fit. Is it a full match?"
    },
    {
      "id": "p03-c-12-s04",
      "speaker": "Leon",
      "text": "No. We practise in pairs, then try passing the ball towards a goal."
    },
    {
      "id": "p03-c-12-s05",
      "speaker": "Keira",
      "text": "I was also considering golf. Is that quieter?"
    },
    {
      "id": "p03-c-12-s06",
      "speaker": "Leon",
      "text": "That session moves more slowly, but it's on Sunday. Hockey is on Saturday."
    },
    {
      "id": "p03-c-12-s07",
      "speaker": "Keira",
      "text": "Saturday works better. Do I need my own stick?"
    },
    {
      "id": "p03-c-12-s08",
      "speaker": "Leon",
      "text": "We lend you one. Bring trainers and the other items on this kit list."
    },
    {
      "id": "p03-c-12-s09",
      "speaker": "Keira",
      "text": "Great. I'll book the hockey session and check the list tonight."
    }
  ],
