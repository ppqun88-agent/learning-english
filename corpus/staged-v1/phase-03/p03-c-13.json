{
  "id": "p03-c-13",
  "title_zh": "天黑前改走短路",
  "topic_id": "leisure",
  "scenario": {
    "id": "hill-walk-route-choice",
    "label_zh": "调整山间步行路线",
    "goal_zh": "考虑天色和路面条件后改走短路线"
  },
  "participants": [
    "Petra",
    "Sam"
  ],
  "context_zh": "两名朋友看见天色和山路条件变化，重新选择短途步行路线。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-13-s01",
      "speaker": "Petra",
      "text": "What's the distance from here to the top of the hill?"
    },
    {
      "id": "p03-c-13-s02",
      "speaker": "Sam",
      "text": "About six kilometres, and it's getting dark already."
    },
    {
      "id": "p03-c-13-s03",
      "speaker": "Petra",
      "text": "It's extremely windy, too. We haven't brought equipment for extreme weather."
    },
    {
      "id": "p03-c-13-s04",
      "speaker": "Sam",
      "text": "Then let's stay off the ridge. There's a lower path beside the river."
    },
    {
      "id": "p03-c-13-s05",
      "speaker": "Petra",
      "text": "That suits me. My fear of heights would make the ridge unpleasant anyway."
    },
    {
      "id": "p03-c-13-s06",
      "speaker": "Sam",
      "text": "The guide at the visitor centre recommended the short riverside loop for an evening walk."
    },
    {
      "id": "p03-c-13-s07",
      "speaker": "Petra",
      "text": "Does it start beside that huge rock?"
    },
    {
      "id": "p03-c-13-s08",
      "speaker": "Sam",
      "text": "Yes, but look at the mud beyond it. Let's check whether the paved path loops back instead."
    },
    {
      "id": "p03-c-13-s09",
      "speaker": "Petra",
      "text": "The map says it does. Twenty minutes back to the car park."
    },
    {
      "id": "p03-c-13-s10",
      "speaker": "Sam",
      "text": "Let's take that one. I'd rather finish before dark."
    }
  ],
