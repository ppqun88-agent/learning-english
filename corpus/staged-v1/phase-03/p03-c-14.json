{
  "id": "p03-c-14",
  "title_zh": "给柜子找一个合适的位置",
  "topic_id": "home",
  "scenario": {
    "id": "cabinet-moving-plan",
    "label_zh": "协作搬动柜子",
    "goal_zh": "核对通道尺寸并协调柜子移动和暂放位置"
  },
  "participants": [
    "Otis",
    "Nell"
  ],
  "context_zh": "两位室友测量新柜子的安放空间，协调短距离移动。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-14-s01",
      "speaker": "Otis",
      "text": "Have you checked the height of the cabinet? It looks taller than the old one."
    },
    {
      "id": "p03-c-14-s02",
      "speaker": "Nell",
      "text": "Yes, it fits under the shelf. I'm more worried about the gap beside the door."
    },
    {
      "id": "p03-c-14-s03",
      "speaker": "Otis",
      "text": "You're right. I can barely get one finger between the handle and the wall."
    },
    {
      "id": "p03-c-14-s04",
      "speaker": "Nell",
      "text": "Let's put it against the opposite wall instead."
    },
    {
      "id": "p03-c-14-s05",
      "speaker": "Otis",
      "text": "It's heavy. Should we take the drawers out first?"
    },
    {
      "id": "p03-c-14-s06",
      "speaker": "Nell",
      "text": "Yes. Hold this one while I make space on the table."
    },
    {
      "id": "p03-c-14-s07",
      "speaker": "Otis",
      "text": "I've got it. Don't drop the loose handle; it's sitting inside."
    },
    {
      "id": "p03-c-14-s08",
      "speaker": "Nell",
      "text": "Thanks for spotting that. I'll put it in the tray."
    },
    {
      "id": "p03-c-14-s09",
      "speaker": "Otis",
      "text": "The cabinet is much lighter now. Shall we move it forward a little?"
    },
    {
      "id": "p03-c-14-s10",
      "speaker": "Nell",
      "text": "Just to the tape mark. Then we'll have room to turn it."
    },
    {
      "id": "p03-c-14-s11",
      "speaker": "Otis",
      "text": "There. The door opens properly in this position. Let's leave it here."
    }
  ],
