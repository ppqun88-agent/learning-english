{
  "id": "p03-c-15",
  "title_zh": "尊重家人的合影安排",
  "topic_id": "relationships",
  "scenario": {
    "id": "family-photo-arrangements",
    "label_zh": "协调家庭合影安排",
    "goal_zh": "尊重离异亲人的意愿并明确合影及接人安排"
  },
  "participants": [
    "Bea",
    "Marcus"
  ],
  "context_zh": "家庭聚会前，两名成年亲属核对合影和接送安排，不替离异亲人决定是否同框。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-15-s01",
      "speaker": "Bea",
      "text": "Are we asking everyone to stand together for the family photo?"
    },
    {
      "id": "p03-c-15-s02",
      "speaker": "Marcus",
      "text": "Let's ask Eva first. She and Martin are divorced, and I don't want to make assumptions."
    },
    {
      "id": "p03-c-15-s03",
      "speaker": "Bea",
      "text": "Eva said she'd happily join the group photo. She's choosing the smaller family photos herself."
    },
    {
      "id": "p03-c-15-s04",
      "speaker": "Marcus",
      "text": "Good. And Martin can decide for himself whether he wants separate pictures."
    },
    {
      "id": "p03-c-15-s05",
      "speaker": "Bea",
      "text": "Whose camera are we using? Is the one on the table Eva's?"
    },
    {
      "id": "p03-c-15-s06",
      "speaker": "Marcus",
      "text": "Yes, it's hers. She said we could borrow it."
    },
    {
      "id": "p03-c-15-s07",
      "speaker": "Bea",
      "text": "What about the guy collecting Grandma? Does he know we're starting at two?"
    },
    {
      "id": "p03-c-15-s08",
      "speaker": "Marcus",
      "text": "That's my neighbour, Arun. I've given him the time, and Grandma has his number."
    },
    {
      "id": "p03-c-15-s09",
      "speaker": "Bea",
      "text": "Great. I'll check with Martin before I arrange anyone for the photo."
    }
  ],
