{
  "id": "p03-c-17",
  "title_zh": "核对晚饭还缺什么",
  "topic_id": "food",
  "scenario": {
    "id": "meal-preparation-sharing",
    "label_zh": "分工采购并准备晚餐",
    "goal_zh": "核对现有食材与餐具并分配缺少物品的采购"
  },
  "participants": [
    "Anika",
    "Paul"
  ],
  "context_zh": "合住的朋友准备晚饭，核对食材和缺少的餐具。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-17-s01",
      "speaker": "Anika",
      "text": "I'm going to the grocery. Do we need anything for tonight?"
    },
    {
      "id": "p03-c-17-s02",
      "speaker": "Paul",
      "text": "Some fresh tomatoes. There's pasta in the cupboard and cheese in the fridge."
    },
    {
      "id": "p03-c-17-s03",
      "speaker": "Anika",
      "text": "Large tomatoes or the small ones?"
    },
    {
      "id": "p03-c-17-s04",
      "speaker": "Paul",
      "text": "Either type is fine. We're cutting them up anyway."
    },
    {
      "id": "p03-c-17-s05",
      "speaker": "Anika",
      "text": "Anything else?"
    },
    {
      "id": "p03-c-17-s06",
      "speaker": "Paul",
      "text": "A fork for Jo, if you pass the kitchen shop. We only have two."
    },
    {
      "id": "p03-c-17-s07",
      "speaker": "Anika",
      "text": "I can borrow one from next door instead."
    },
    {
      "id": "p03-c-17-s08",
      "speaker": "Paul",
      "text": "That would help, especially since the kitchen shop closes early."
    },
    {
      "id": "p03-c-17-s09",
      "speaker": "Anika",
      "text": "All right. I'll get the tomatoes and borrow the fork. You can start the pasta."
    }
  ],
