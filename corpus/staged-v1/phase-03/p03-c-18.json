{
  "id": "p03-c-18",
  "title_zh": "为读书小组选一本小说",
  "topic_id": "leisure",
  "scenario": {
    "id": "reading-group-book-choice",
    "label_zh": "选择读书小组作品",
    "goal_zh": "比较故事题材与讨论安排后选定共读作品"
  },
  "participants": [
    "Mina",
    "Evan"
  ],
  "context_zh": "读书小组成员在两本虚构作品间选择，安排讨论日期。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-18-s01",
      "speaker": "Mina",
      "text": "What kind of fiction shall we read next? We've had two crime novels in a row."
    },
    {
      "id": "p03-c-18-s02",
      "speaker": "Evan",
      "text": "How about this story about a god who loses his memory?"
    },
    {
      "id": "p03-c-18-s03",
      "speaker": "Mina",
      "text": "Is it difficult to follow?"
    },
    {
      "id": "p03-c-18-s04",
      "speaker": "Evan",
      "text": "Not really. It begins with a strange dream, but the main story is quite clear."
    },
    {
      "id": "p03-c-18-s05",
      "speaker": "Mina",
      "text": "Who wrote it?"
    },
    {
      "id": "p03-c-18-s06",
      "speaker": "Evan",
      "text": "A foreign writer I hadn't read before. This is an English translation."
    },
    {
      "id": "p03-c-18-s07",
      "speaker": "Mina",
      "text": "Could we read the opening chapter this week and have a discussion next Thursday?"
    },
    {
      "id": "p03-c-18-s08",
      "speaker": "Evan",
      "text": "I'm away then. Would the following Thursday work?"
    },
    {
      "id": "p03-c-18-s09",
      "speaker": "Mina",
      "text": "Yes. That gives everyone more time. I'll suggest the book and the later date to the group."
    }
  ],
