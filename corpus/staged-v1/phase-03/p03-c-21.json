{
  "id": "p03-c-21",
  "title_zh": "确认社区活动的迎宾路线",
  "topic_id": "community",
  "scenario": {
    "id": "community-event-welcome",
    "label_zh": "安排社区活动迎宾",
    "goal_zh": "确认入口与电梯位置并分配接待工作"
  },
  "participants": [
    "Dara",
    "Luis"
  ],
  "context_zh": "志愿者在活动前核实市中心场馆的入口、无障碍路线和分工。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-21-s01",
      "speaker": "Dara",
      "text": "Is the workshop at the downtown centre or the one by the park?"
    },
    {
      "id": "p03-c-21-s02",
      "speaker": "Luis",
      "text": "Downtown. We'll use the side entrance because the front steps are being repaired."
    },
    {
      "id": "p03-c-21-s03",
      "speaker": "Dara",
      "text": "Where should I greet people?"
    },
    {
      "id": "p03-c-21-s04",
      "speaker": "Luis",
      "text": "Just inside the side door. Ask each guest to collect a name badge."
    },
    {
      "id": "p03-c-21-s05",
      "speaker": "Dara",
      "text": "Can everyone enter there, including anyone using a wheelchair?"
    },
    {
      "id": "p03-c-21-s06",
      "speaker": "Luis",
      "text": "Yes, that's the step-free entrance. The elevator is straight ahead and takes people to our floor."
    },
    {
      "id": "p03-c-21-s07",
      "speaker": "Dara",
      "text": "I'll put a sign at the front so nobody waits by the closed door."
    },
    {
      "id": "p03-c-21-s08",
      "speaker": "Luis",
      "text": "Thanks. I'll stay upstairs and show people into the room."
    }
  ],
