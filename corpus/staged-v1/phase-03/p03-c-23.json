{
  "id": "p03-c-23",
  "title_zh": "让论文的论据更清楚",
  "topic_id": "learning",
  "scenario": {
    "id": "essay-feedback",
    "label_zh": "根据反馈修改议论文",
    "goal_zh": "澄清论点与数字出处并约定修订顺序"
  },
  "participants": [
    "Jules",
    "Tutor Sana"
  ],
  "context_zh": "学生请教师说明作文修改重点，并核对引用数字。",
  "author": "author-phase03-c",
  "sentences": [
    {
      "id": "p03-c-23-s01",
      "speaker": "Jules",
      "text": "Could you help me with my essay about technology in everyday life?"
    },
    {
      "id": "p03-c-23-s02",
      "speaker": "Tutor Sana",
      "text": "Yes. Your examples are clear, but the main argument needs work."
    },
    {
      "id": "p03-c-23-s03",
      "speaker": "Jules",
      "text": "What should I change first? I don't want to fail because I've misunderstood the question."
    },
    {
      "id": "p03-c-23-s04",
      "speaker": "Tutor Sana",
      "text": "Well, firstly, say whether you think the changes are mostly helpful. Then explain why."
    },
    {
      "id": "p03-c-23-s05",
      "speaker": "Jules",
      "text": "I also used a figure of sixty percent, but I can't find the source now."
    },
    {
      "id": "p03-c-23-s06",
      "speaker": "Tutor Sana",
      "text": "Don't leave in a number you can't support. Find the source or remove the claim."
    },
    {
      "id": "p03-c-23-s07",
      "speaker": "Jules",
      "text": "So I'll rewrite the opening, check the evidence, and finally look at the conclusion."
    },
    {
      "id": "p03-c-23-s08",
      "speaker": "Tutor Sana",
      "text": "That order makes sense. Bring the revised opening tomorrow and we'll discuss it."
    },
    {
      "id": "p03-c-23-s09",
      "speaker": "Jules",
      "text": "Thanks. That's helpful. I know where to start now."
    }
  ],
