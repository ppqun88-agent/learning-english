{
  "id": "p04-a-01",
  "title_zh": "散步摔倒后请同伴联系急救员",
  "topic_id": "health",
  "scenario": {
    "id": "walking-fall-assistance",
    "label_zh": "摔倒后寻求帮助",
    "goal_zh": "说明不适并请同伴联系现场急救员"
  },
  "participants": [
    "Rosa",
    "Ben"
  ],
  "context_zh": "散步者跌倒后向同行朋友说明情况；对话只练习现场求助沟通。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-01-s01",
      "speaker": "Rosa",
      "text": "I slipped on that step and hurt my knee."
    },
    {
      "id": "p04-a-01-s02",
      "speaker": "Ben",
      "text": "Can you tell me where the pain is?"
    },
    {
      "id": "p04-a-01-s03",
      "speaker": "Rosa",
      "text": "Just here. I would rather not try to walk yet."
    },
    {
      "id": "p04-a-01-s04",
      "speaker": "Ben",
      "text": "There is a first-aid tent by the gate. I will call them immediately."
    },
    {
      "id": "p04-a-01-s05",
      "speaker": "Rosa",
      "text": "Please tell them about the knee injury and ask them to come here."
    },
    {
      "id": "p04-a-01-s06",
      "speaker": "Ben",
      "text": "I will. You do not have to go looking for medical help on your own."
    }
  ],
