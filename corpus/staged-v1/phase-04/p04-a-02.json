{
  "id": "p04-a-02",
  "title_zh": "生病请假并确认今天的替班",
  "topic_id": "work",
  "scenario": {
    "id": "sick-day-shift-cover",
    "label_zh": "协调病假期间的班次交接",
    "goal_zh": "确认替班人员及常规工作的交接内容"
  },
  "participants": [
    "Yasmin",
    "Owen"
  ],
  "context_zh": "员工因病致电同事，确认日常任务由谁接手。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-02-s01",
      "speaker": "Yasmin",
      "text": "I am too ill to come in today. Can you manage without me?"
    },
    {
      "id": "p04-a-02-s02",
      "speaker": "Owen",
      "text": "Yes. I can cover the front desk, and Priya has offered to do the deliveries."
    },
    {
      "id": "p04-a-02-s03",
      "speaker": "Yasmin",
      "text": "Thanks. I normally print the delivery list before nine."
    },
    {
      "id": "p04-a-02-s04",
      "speaker": "Owen",
      "text": "I will print it now. Is the latest copy in the shared folder?"
    },
    {
      "id": "p04-a-02-s05",
      "speaker": "Yasmin",
      "text": "Yes, under today’s date. Should I choose illness as the reason on the absence form?"
    },
    {
      "id": "p04-a-02-s06",
      "speaker": "Owen",
      "text": "Yes. I will also tell the afternoon manager that you are away."
    },
    {
      "id": "p04-a-02-s07",
      "speaker": "Yasmin",
      "text": "Good, that is everything for this morning. Thank you for covering."
    }
  ],
