{
  "id": "p04-a-03",
  "title_zh": "预约颈部不适检查",
  "topic_id": "health",
  "scenario": {
    "id": "routine-clinic-booking",
    "label_zh": "描述问题并预约就诊",
    "goal_zh": "准确说明不适位置并确认预约时间"
  },
  "participants": [
    "Leila",
    "Receptionist"
  ],
  "context_zh": "患者与诊所接待员核对预约时间及应向医生提供的信息；不讨论诊断或用药调整。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-03-s01",
      "speaker": "Leila",
      "text": "Could I book an appointment? My neck has been sore since yesterday."
    },
    {
      "id": "p04-a-03-s02",
      "speaker": "Receptionist",
      "text": "Is there anything you want me to add to the booking note?"
    },
    {
      "id": "p04-a-03-s03",
      "speaker": "Leila",
      "text": "The pain is mild, but it does not feel normal. I also have a question about my medicine."
    },
    {
      "id": "p04-a-03-s04",
      "speaker": "Receptionist",
      "text": "Please mention that to the doctor and bring the name of the medicine. Can you come at ten tomorrow?"
    },
    {
      "id": "p04-a-03-s05",
      "speaker": "Leila",
      "text": "Yes, ten is fine."
    },
    {
      "id": "p04-a-03-s06",
      "speaker": "Receptionist",
      "text": "You are booked for ten tomorrow morning with Dr Lee."
    }
  ],
