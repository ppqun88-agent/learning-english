{
  "id": "p04-a-04",
  "title_zh": "把飞进屋里的飞蛾放出去",
  "topic_id": "nature",
  "scenario": {
    "id": "indoor-insect-release",
    "label_zh": "让飞入室内的昆虫离开",
    "goal_zh": "确认室内昆虫的位置并协作打开通道让它离开"
  },
  "participants": [
    "Tessa",
    "Hugo"
  ],
  "context_zh": "两位室友发现一只飞蛾，商量让它离开房间。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-04-s01",
      "speaker": "Tessa",
      "text": "There is an insect inside the house, just above the curtain."
    },
    {
      "id": "p04-a-04-s02",
      "speaker": "Hugo",
      "text": "It is a moth. Please do not kill it."
    },
    {
      "id": "p04-a-04-s03",
      "speaker": "Tessa",
      "text": "I was only going to open the window. Could you move the curtain?"
    },
    {
      "id": "p04-a-04-s04",
      "speaker": "Hugo",
      "text": "Sure. There it goes, out into the garden."
    },
    {
      "id": "p04-a-04-s05",
      "speaker": "Tessa",
      "text": "Good. I will close the window now."
    }
  ],
