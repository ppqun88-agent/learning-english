{
  "id": "p04-a-05",
  "title_zh": "先借吉他体验再决定购买",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-guitar-loan",
    "label_zh": "咨询初学吉他借用",
    "goal_zh": "先通过借用体验再决定是否购买"
  },
  "participants": [
    "Ellis",
    "Maya"
  ],
  "context_zh": "喜欢爵士乐的初学者向乐手朋友咨询并借用吉他。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-05-s01",
      "speaker": "Ellis",
      "text": "I love jazz, but I have only ever been a listener. I would like to try playing."
    },
    {
      "id": "p04-a-05-s02",
      "speaker": "Maya",
      "text": "Have you thought about learning a musical instrument?"
    },
    {
      "id": "p04-a-05-s03",
      "speaker": "Ellis",
      "text": "The guitar, maybe. You are a musician. Do you think it is a good place to start?"
    },
    {
      "id": "p04-a-05-s04",
      "speaker": "Maya",
      "text": "It can be. You do not need to buy one straight away."
    },
    {
      "id": "p04-a-05-s05",
      "speaker": "Ellis",
      "text": "That helps. I am nervous about spending money before I know if I enjoy it."
    },
    {
      "id": "p04-a-05-s06",
      "speaker": "Maya",
      "text": "I can lend you my spare guitar for a month. We can try a few chords on Saturday."
    },
    {
      "id": "p04-a-05-s07",
      "speaker": "Ellis",
      "text": "Thank you. I will try that before I decide whether to buy one."
    }
  ],
