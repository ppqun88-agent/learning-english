{
  "id": "p04-a-06",
  "title_zh": "确认婚礼邀请和轻松的着装要求",
  "topic_id": "relationships",
  "scenario": {
    "id": "wedding-guest-invitation",
    "label_zh": "确认婚礼邀请安排",
    "goal_zh": "邀请朋友及其伴侣参加婚礼并澄清着装要求"
  },
  "participants": [
    "Nadia",
    "Beth"
  ],
  "context_zh": "新人向朋友发出小型婚礼邀请，并说明可以携伴参加。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-06-s01",
      "speaker": "Nadia",
      "text": "Sam and I plan to marry in July. We would love you to come."
    },
    {
      "id": "p04-a-06-s02",
      "speaker": "Beth",
      "text": "What lovely news! Is the wedding here in town?"
    },
    {
      "id": "p04-a-06-s03",
      "speaker": "Nadia",
      "text": "Yes, in the garden behind the old library. I will send you an invitation with the date and address."
    },
    {
      "id": "p04-a-06-s04",
      "speaker": "Beth",
      "text": "Thank you. Should I wear something very formal?"
    },
    {
      "id": "p04-a-06-s05",
      "speaker": "Nadia",
      "text": "No, it will be quite informal. And we would like to invite Jo as well."
    },
    {
      "id": "p04-a-06-s06",
      "speaker": "Beth",
      "text": "I will tell him. We would both love to be there."
    }
  ],
