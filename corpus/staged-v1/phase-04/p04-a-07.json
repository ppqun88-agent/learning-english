{
  "id": "p04-a-07",
  "title_zh": "排练时给观众的笑声留出时间",
  "topic_id": "leisure",
  "scenario": {
    "id": "comedy-audibility-rehearsal",
    "label_zh": "调整喜剧台词的音量与停顿",
    "goal_zh": "降低伴奏音量并约定在观众笑声后继续说台词"
  },
  "participants": [
    "Callum",
    "Zoe"
  ],
  "context_zh": "两位演员排练喜剧，发现背景音乐和过快的接话影响台词。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-07-s01",
      "speaker": "Callum",
      "text": "The music is too loud. I cannot hear the end of your joke."
    },
    {
      "id": "p04-a-07-s02",
      "speaker": "Zoe",
      "text": "I will turn it down. Should I speak more loudly too?"
    },
    {
      "id": "p04-a-07-s03",
      "speaker": "Callum",
      "text": "A little, but the bigger problem is the timing. Wait for the laughter to stop before your next line."
    },
    {
      "id": "p04-a-07-s04",
      "speaker": "Zoe",
      "text": "So I should look at you and pause, rather than talk over the audience?"
    },
    {
      "id": "p04-a-07-s05",
      "speaker": "Callum",
      "text": "Exactly. Let us try that bit again with the music lower."
    },
    {
      "id": "p04-a-07-s06",
      "speaker": "Zoe",
      "text": "Ready. Start from your entrance."
    }
  ],
