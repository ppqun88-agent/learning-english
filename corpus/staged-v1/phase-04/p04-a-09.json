{
  "id": "p04-a-09",
  "title_zh": "凭刻字认领遗失的首饰袋",
  "topic_id": "services",
  "scenario": {
    "id": "lost-jewellery-identification",
    "label_zh": "描述并认领遗失的首饰袋",
    "goal_zh": "凭首饰袋外观和内装物特征核实归属并办理领取"
  },
  "participants": [
    "Ruth",
    "Imran"
  ],
  "context_zh": "访客到英国一家休闲中心的失物处查询首饰袋并核对内容。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-09-s01",
      "speaker": "Ruth",
      "text": "My jewellery pouch is missing. I think I left it in the changing room."
    },
    {
      "id": "p04-a-09-s02",
      "speaker": "Imran",
      "text": "We have a box of lost property. Can you describe the pouch?"
    },
    {
      "id": "p04-a-09-s03",
      "speaker": "Ruth",
      "text": "It is green, with a tiny white flower on the front."
    },
    {
      "id": "p04-a-09-s04",
      "speaker": "Imran",
      "text": "We have one like that. Can you identify something inside it?"
    },
    {
      "id": "p04-a-09-s05",
      "speaker": "Ruth",
      "text": "A silver ring with the date 12 June on the inside."
    },
    {
      "id": "p04-a-09-s06",
      "speaker": "Imran",
      "text": "Yes, that ring is here. Is there another item in the pouch?"
    },
    {
      "id": "p04-a-09-s07",
      "speaker": "Ruth",
      "text": "A small gold chain. This is definitely mine."
    },
    {
      "id": "p04-a-09-s08",
      "speaker": "Imran",
      "text": "That matches. Please sign this collection record, and I can give it back to you."
    },
    {
      "id": "p04-a-09-s09",
      "speaker": "Ruth",
      "text": "Here you are. Thank you for keeping it safe."
    }
  ],
