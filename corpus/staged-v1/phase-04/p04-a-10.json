{
  "id": "p04-a-10",
  "title_zh": "先了解出版翻译工作再考虑转行",
  "topic_id": "work",
  "scenario": {
    "id": "career-change-discussion",
    "label_zh": "讨论职业方向",
    "goal_zh": "讨论转行念头并确定低风险了解行业的下一步。"
  },
  "participants": [
    "Marco",
    "Sian"
  ],
  "context_zh": "朋友讨论转入出版行业的想法，商定先向从业者请教。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-10-s01",
      "speaker": "Marco",
      "text": "I would like to move into the publishing industry, perhaps as a translator."
    },
    {
      "id": "p04-a-10-s02",
      "speaker": "Sian",
      "text": "Would you want a staff job or independent work?"
    },
    {
      "id": "p04-a-10-s03",
      "speaker": "Marco",
      "text": "Independent work appeals to me, but I do not know how people find clients."
    },
    {
      "id": "p04-a-10-s04",
      "speaker": "Sian",
      "text": "My cousin translates books for an international publisher. I could ask if she would talk to you."
    },
    {
      "id": "p04-a-10-s05",
      "speaker": "Marco",
      "text": "That would be a useful opportunity. I want to know what the work would involve day to day."
    },
    {
      "id": "p04-a-10-s06",
      "speaker": "Sian",
      "text": "She has worked for small firms and a major publisher, so she could explain both."
    },
    {
      "id": "p04-a-10-s07",
      "speaker": "Marco",
      "text": "Great. I will write down a few questions before I speak to her."
    },
    {
      "id": "p04-a-10-s08",
      "speaker": "Sian",
      "text": "I will ask her whether she has time for a short call next week."
    }
  ],
