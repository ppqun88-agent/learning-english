{
  "id": "p04-a-11",
  "title_zh": "为市长问答准备一条地方问题",
  "topic_id": "society",
  "scenario": {
    "id": "local-press-question-preparation",
    "label_zh": "准备地方公共问答的采访问题",
    "goal_zh": "把宽泛的全国议题缩小为图书馆重开进度及责任人的具体提问"
  },
  "participants": [
    "Anika",
    "Joel"
  ],
  "context_zh": "虚构地方报社的记者与编辑准备公共问答问题；不涉及真实新闻或人物。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-11-s01",
      "speaker": "Anika",
      "text": "As the new journalist on the local desk, what should I ask at tomorrow’s meeting?"
    },
    {
      "id": "p04-a-11-s02",
      "speaker": "Joel",
      "text": "The mayor is taking questions about public services. Our readers keep asking about the closed library."
    },
    {
      "id": "p04-a-11-s03",
      "speaker": "Anika",
      "text": "Should I ask about national spending plans first?"
    },
    {
      "id": "p04-a-11-s04",
      "speaker": "Joel",
      "text": "Other media are covering that. We can ask when residents will get a clear reopening date."
    },
    {
      "id": "p04-a-11-s05",
      "speaker": "Anika",
      "text": "I will ask what still needs to happen before the library can reopen."
    },
    {
      "id": "p04-a-11-s06",
      "speaker": "Joel",
      "text": "Good. And if the answer is vague, ask who is responsible for the next step."
    }
  ],
