{
  "id": "p04-a-13",
  "title_zh": "把一次数学低分变成具体练习计划",
  "topic_id": "learning",
  "scenario": {
    "id": "math-feedback-study-plan",
    "label_zh": "根据数学作业反馈安排练习",
    "goal_zh": "找出计算失误的位置并商定重做与检查的具体步骤"
  },
  "participants": [
    "Ethan",
    "Val"
  ],
  "context_zh": "学习者因数学成绩失望，辅导老师帮助他找出错误类型并安排练习。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-13-s01",
      "speaker": "Ethan",
      "text": "I got a low mark in math again. Perhaps I am just not intelligent enough."
    },
    {
      "id": "p04-a-13-s02",
      "speaker": "Val",
      "text": "Let us look at the work before we decide what went wrong."
    },
    {
      "id": "p04-a-13-s03",
      "speaker": "Ethan",
      "text": "Most of these mistakes are in the last step. I suppose I was lazy."
    },
    {
      "id": "p04-a-13-s04",
      "speaker": "Val",
      "text": "That label does not help us. You understood the questions, but you rushed the final calculations."
    },
    {
      "id": "p04-a-13-s05",
      "speaker": "Ethan",
      "text": "So I should check each last step instead of starting another whole page?"
    },
    {
      "id": "p04-a-13-s06",
      "speaker": "Val",
      "text": "Yes. Learning takes practice, and today we can focus on just that part."
    },
    {
      "id": "p04-a-13-s07",
      "speaker": "Ethan",
      "text": "All right. I will redo these three answers slowly, then check them with you."
    }
  ],
