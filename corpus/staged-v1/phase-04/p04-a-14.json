{
  "id": "p04-a-14",
  "title_zh": "了解数学入门课并安排试听",
  "topic_id": "learning",
  "scenario": {
    "id": "mathematics-course-preview",
    "label_zh": "了解数学入门课程并安排试听",
    "goal_zh": "核对课程内容和先备知识后约定先试听再决定报名"
  },
  "participants": [
    "Iona",
    "Peter"
  ],
  "context_zh": "多年未学数学的成年人向课程教师了解难度和试听安排。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-14-s01",
      "speaker": "Iona",
      "text": "I have not done any maths for years. Would your evening course be too difficult?"
    },
    {
      "id": "p04-a-14-s02",
      "speaker": "Peter",
      "text": "It is a gentle introduction. We start with things like comparing prices and reading graphs."
    },
    {
      "id": "p04-a-14-s03",
      "speaker": "Iona",
      "text": "How much knowledge do I need before the first class?"
    },
    {
      "id": "p04-a-14-s04",
      "speaker": "Peter",
      "text": "Just basic arithmetic. We use everyday examples to make mathematics less abstract."
    },
    {
      "id": "p04-a-14-s05",
      "speaker": "Iona",
      "text": "Could I sit in on a lecture before I sign up?"
    },
    {
      "id": "p04-a-14-s06",
      "speaker": "Peter",
      "text": "Certainly. Come to Tuesday’s session at six, and see how you find it."
    },
    {
      "id": "p04-a-14-s07",
      "speaker": "Iona",
      "text": "Thank you. I will come on Tuesday and decide afterwards."
    }
  ],
