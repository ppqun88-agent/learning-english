{
  "id": "p04-a-15",
  "title_zh": "在初学舞蹈课上澄清动作",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-dance-step-practice",
    "label_zh": "澄清初学舞蹈动作并获得反馈",
    "goal_zh": "弄清第一组舞步的顺序并请教练单独示范转向"
  },
  "participants": [
    "Noor",
    "Diego"
  ],
  "context_zh": "初学者向当日教练确认第一组舞步并请求个别反馈。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-15-s01",
      "speaker": "Noor",
      "text": "Are you the instructor for the beginners’ class?"
    },
    {
      "id": "p04-a-15-s02",
      "speaker": "Diego",
      "text": "Yes. Come over here; we are just starting."
    },
    {
      "id": "p04-a-15-s03",
      "speaker": "Noor",
      "text": "I missed your first instruction. Do we step to the left or jump?"
    },
    {
      "id": "p04-a-15-s04",
      "speaker": "Diego",
      "text": "Step to the left first. Watch the movement once before you try it."
    },
    {
      "id": "p04-a-15-s05",
      "speaker": "Noor",
      "text": "Like this? I keep turning the wrong way."
    },
    {
      "id": "p04-a-15-s06",
      "speaker": "Diego",
      "text": "Almost. I will give you some individual feedback while the others practise."
    },
    {
      "id": "p04-a-15-s07",
      "speaker": "Noor",
      "text": "Thanks. Please show me the turn again slowly."
    },
    {
      "id": "p04-a-15-s08",
      "speaker": "Diego",
      "text": "Of course. Start with your feet together and watch which way I face."
    }
  ],
