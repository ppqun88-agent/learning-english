{
  "id": "p04-a-16",
  "title_zh": "确定湖边自然观察路线和带队人",
  "topic_id": "nature",
  "scenario": {
    "id": "lakeside-nature-walk-route",
    "label_zh": "核对湖边自然观察的短路线",
    "goal_zh": "原领队缺席时确认替代带队人、步行路段和集合安排"
  },
  "participants": [
    "Gareth",
    "Amina"
  ],
  "context_zh": "自然观察小组原领队临时缺席，两位成员核对一条熟悉的短路线。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-16-s01",
      "speaker": "Gareth",
      "text": "Our group leader cannot come today. Could you lead the nature walk instead?"
    },
    {
      "id": "p04-a-16-s02",
      "speaker": "Amina",
      "text": "I can, if we stay on the path I know beside the lake."
    },
    {
      "id": "p04-a-16-s03",
      "speaker": "Gareth",
      "text": "How far is it from here to the viewing point?"
    },
    {
      "id": "p04-a-16-s04",
      "speaker": "Amina",
      "text": "About one kilometer. The path gets narrow near the reeds, so we will need to walk in a line there."
    },
    {
      "id": "p04-a-16-s05",
      "speaker": "Gareth",
      "text": "That is fine. We can turn back at the viewing point rather than go all the way round."
    },
    {
      "id": "p04-a-16-s06",
      "speaker": "Amina",
      "text": "Agreed. Tell the others we will meet at this gate in ten minutes."
    }
  ],
