{
  "id": "p04-a-17",
  "title_zh": "等云散后在阳台短暂观月",
  "topic_id": "leisure",
  "scenario": {
    "id": "evening-moon-viewing-plan",
    "label_zh": "根据云量安排短暂观月",
    "goal_zh": "商定先等候云层移动并约定看不到时改到晚餐后"
  },
  "participants": [
    "Jules",
    "Finn"
  ],
  "context_zh": "两位朋友根据眼前天色决定晚餐前在阳台观察月亮。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-17-s01",
      "speaker": "Jules",
      "text": "It is nearly dark. Shall we take the telescope onto the balcony?"
    },
    {
      "id": "p04-a-17-s02",
      "speaker": "Finn",
      "text": "There is a cloud in front of the moon at the moment."
    },
    {
      "id": "p04-a-17-s03",
      "speaker": "Jules",
      "text": "It might move soon. The view through your telescope was incredible last time."
    },
    {
      "id": "p04-a-17-s04",
      "speaker": "Finn",
      "text": "Let us give it ten minutes. If the cloud stays, we can try after dinner."
    },
    {
      "id": "p04-a-17-s05",
      "speaker": "Jules",
      "text": "Sounds good. I will bring out two chairs while we wait."
    }
  ],
