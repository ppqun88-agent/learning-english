{
  "id": "p04-a-18",
  "title_zh": "调整桌面照明并给门留出空间",
  "topic_id": "home",
  "scenario": {
    "id": "home-desk-fitting",
    "label_zh": "调整书桌位置与照明",
    "goal_zh": "根据桌面尺寸、照明和通道空间安排书桌。"
  },
  "participants": [
    "Harper",
    "Milan"
  ],
  "context_zh": "室友帮助调整书桌、电脑与台灯的位置。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-18-s01",
      "speaker": "Harper",
      "text": "There is hardly any room for my laptop beside this lamp."
    },
    {
      "id": "p04-a-18-s02",
      "speaker": "Milan",
      "text": "Could the lamp go on the shelf above the desk?"
    },
    {
      "id": "p04-a-18-s03",
      "speaker": "Harper",
      "text": "Yes, but its lowest setting is too low for reading. Can we increase the brightness?"
    },
    {
      "id": "p04-a-18-s04",
      "speaker": "Milan",
      "text": "This switch does that. Is this better?"
    },
    {
      "id": "p04-a-18-s05",
      "speaker": "Harper",
      "text": "Much better. Now the screen fits, but the chair blocks the door."
    },
    {
      "id": "p04-a-18-s06",
      "speaker": "Milan",
      "text": "The desk is only a metre wide. We could move it against that wall and keep the doorway clear."
    },
    {
      "id": "p04-a-18-s07",
      "speaker": "Harper",
      "text": "Let us do that. I will unplug everything before we move it."
    }
  ],
