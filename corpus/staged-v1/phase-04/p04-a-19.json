{
  "id": "p04-a-19",
  "title_zh": "把错投的信件送到正确邻居家",
  "topic_id": "relationships",
  "scenario": {
    "id": "misdelivered-mail-return",
    "label_zh": "核对错投信件的收件人",
    "goal_zh": "确认信件所属邻居及送还时的敲门和楼门关闭安排"
  },
  "participants": [
    "Theo",
    "Mrs Bell"
  ],
  "context_zh": "住户发现别人的信件，向熟悉楼内住户的邻居核对收件人。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-19-s01",
      "speaker": "Theo",
      "text": "This is not my mail. Do you know someone called Helen Price?"
    },
    {
      "id": "p04-a-19-s02",
      "speaker": "Mrs Bell",
      "text": "Yes, she is the lady in number six. She moved in last week."
    },
    {
      "id": "p04-a-19-s03",
      "speaker": "Theo",
      "text": "I will take it upstairs. Should I knock, or is there a doorbell?"
    },
    {
      "id": "p04-a-19-s04",
      "speaker": "Mrs Bell",
      "text": "There is no bell yet, so knock. She said she would be home this morning."
    },
    {
      "id": "p04-a-19-s05",
      "speaker": "Theo",
      "text": "Thanks. I will leave the building door shut while I go up."
    },
    {
      "id": "p04-a-19-s06",
      "speaker": "Mrs Bell",
      "text": "Good. Please lock it when you leave; the catch does not always hold."
    }
  ],
