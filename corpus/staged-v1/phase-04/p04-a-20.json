{
  "id": "p04-a-20",
  "title_zh": "请搬运人员把柜子暂放在毯子上",
  "topic_id": "home",
  "scenario": {
    "id": "cabinet-moving-plan",
    "label_zh": "协作搬动柜子",
    "goal_zh": "核对通道尺寸并协调柜子移动和暂放位置"
  },
  "participants": [
    "Gwen",
    "Pavel"
  ],
  "context_zh": "住户与搬运负责人核对柜子、门口宽度及室内暂放位置。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-20-s01",
      "speaker": "Gwen",
      "text": "The cabinet is still on the lorry. I cannot lift it by myself."
    },
    {
      "id": "p04-a-20-s02",
      "speaker": "Pavel",
      "text": "Please leave it to the moving crew. We have two people and the right equipment."
    },
    {
      "id": "p04-a-20-s03",
      "speaker": "Gwen",
      "text": "I measured the front doorway. The cabinet should fit if we take its doors off."
    },
    {
      "id": "p04-a-20-s04",
      "speaker": "Pavel",
      "text": "Good. Where would you like us to put it?"
    },
    {
      "id": "p04-a-20-s05",
      "speaker": "Gwen",
      "text": "Not in the middle of the hall. That would make it impossible to get to the kitchen."
    },
    {
      "id": "p04-a-20-s06",
      "speaker": "Pavel",
      "text": "There is enough room by the wall. We can lower it onto that thick blanket until you choose its final position."
    },
    {
      "id": "p04-a-20-s07",
      "speaker": "Gwen",
      "text": "That works. I will clear the shoes away and show the crew the space."
    }
  ],
