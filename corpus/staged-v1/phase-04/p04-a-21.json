{
  "id": "p04-a-21",
  "title_zh": "让访客手机连上正确的无线网络",
  "topic_id": "services",
  "scenario": {
    "id": "guest-wifi-troubleshooting",
    "label_zh": "排查访客手机的无线连接",
    "goal_zh": "选对访客无线网络并打开登录页面后确认已连通"
  },
  "participants": [
    "Freya",
    "Receptionist"
  ],
  "context_zh": "访客向接待员求助，通过选择访客网络和打开登录页恢复连接。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-21-s01",
      "speaker": "Freya",
      "text": "My mobile will not connect. None of these saved networks works here."
    },
    {
      "id": "p04-a-21-s02",
      "speaker": "Receptionist",
      "text": "Choose the network called Visitor instead. Your saved ones are from other places."
    },
    {
      "id": "p04-a-21-s03",
      "speaker": "Freya",
      "text": "I have chosen it, but the page is blank. Is something wrong with the phone itself?"
    },
    {
      "id": "p04-a-21-s04",
      "speaker": "Receptionist",
      "text": "Try the sign-in link on this information page."
    },
    {
      "id": "p04-a-21-s05",
      "speaker": "Freya",
      "text": "That has opened the welcome screen. Do I press Continue?"
    },
    {
      "id": "p04-a-21-s06",
      "speaker": "Receptionist",
      "text": "Yes, that completes the connection."
    },
    {
      "id": "p04-a-21-s07",
      "speaker": "Freya",
      "text": "It is working now. Thank you."
    }
  ],
