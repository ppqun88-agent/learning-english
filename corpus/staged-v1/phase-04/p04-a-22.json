{
  "id": "p04-a-22",
  "title_zh": "向邻居反映深夜电视声",
  "topic_id": "home",
  "scenario": {
    "id": "late-night-television-noise",
    "label_zh": "协商夜间电视音量",
    "goal_zh": "说明噪声影响并商定当天停止观看"
  },
  "participants": [
    "Martin",
    "Elena"
  ],
  "context_zh": "邻居说明深夜电视声穿过墙壁影响睡眠，住户同意今晚关机。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-22-s01",
      "speaker": "Martin",
      "text": "Hi, may I ask you about the television? The noise is coming straight through our bedroom wall."
    },
    {
      "id": "p04-a-22-s02",
      "speaker": "Elena",
      "text": "Oh, sorry. I did not realise it was so noisy next door."
    },
    {
      "id": "p04-a-22-s03",
      "speaker": "Martin",
      "text": "Would you mind turning it down? We are trying to sleep."
    },
    {
      "id": "p04-a-22-s04",
      "speaker": "Elena",
      "text": "Of course. If I make it less loud, would that help?"
    },
    {
      "id": "p04-a-22-s05",
      "speaker": "Martin",
      "text": "It might, but the wall carries the deeper sounds even at a low volume."
    },
    {
      "id": "p04-a-22-s06",
      "speaker": "Elena",
      "text": "I understand. I will turn it off now and finish the programme tomorrow."
    },
    {
      "id": "p04-a-22-s07",
      "speaker": "Martin",
      "text": "Thank you. I appreciate it."
    }
  ],
