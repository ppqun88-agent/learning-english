{
  "id": "p04-a-27",
  "title_zh": "骑摩托车遇封桥后问清绕行和停车位置",
  "topic_id": "travel",
  "scenario": {
    "id": "motorcycle-road-closure-directions",
    "label_zh": "遇封路时核对摩托车绕行路线",
    "goal_zh": "了解桥梁封闭情况并确认替代路线和停车后步行的安排"
  },
  "participants": [
    "Nikhil",
    "Officer Price"
  ],
  "context_zh": "骑手向封路现场的警员询问路线，并决定停好车后步行到目的地。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-27-s01",
      "speaker": "Nikhil",
      "text": "Excuse me, officer. Can I take my motorcycle across the bridge?"
    },
    {
      "id": "p04-a-27-s02",
      "speaker": "Officer Price",
      "text": "No, the notice by the barrier explains that it is closed to all traffic today."
    },
    {
      "id": "p04-a-27-s03",
      "speaker": "Nikhil",
      "text": "Is it likely to open this afternoon? I need to get to the museum."
    },
    {
      "id": "p04-a-27-s04",
      "speaker": "Officer Price",
      "text": "Not today. Use the north bridge, then turn left into Market Street."
    },
    {
      "id": "p04-a-27-s05",
      "speaker": "Nikhil",
      "text": "There seems to be nowhere to park by the museum entrance."
    },
    {
      "id": "p04-a-27-s06",
      "speaker": "Officer Price",
      "text": "There is a public car park at the end of Market Street, with spaces for motorcycles."
    },
    {
      "id": "p04-a-27-s07",
      "speaker": "Nikhil",
      "text": "Thanks. I will go that way, park there, and walk the last bit."
    }
  ],
