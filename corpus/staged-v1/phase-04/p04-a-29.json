{
  "id": "p04-a-29",
  "title_zh": "确认孩子能否试演国王角色",
  "topic_id": "leisure",
  "scenario": {
    "id": "community-play-casting",
    "label_zh": "确认角色分配和排练",
    "goal_zh": "剧团根据角色要求讨论试演人选及排练时间。"
  },
  "participants": [
    "Beatrice",
    "Amos"
  ],
  "context_zh": "家长向社区剧团负责人询问角色要求、试演和排练时间。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-29-s01",
      "speaker": "Beatrice",
      "text": "My son wants to try for the king, but he is the youngest kid in the group. Is that a problem?"
    },
    {
      "id": "p04-a-29-s02",
      "speaker": "Amos",
      "text": "No. The role needs a clear voice, not a tall actor."
    },
    {
      "id": "p04-a-29-s03",
      "speaker": "Beatrice",
      "text": "He will feel lucky just to have a chance. When should he come?"
    },
    {
      "id": "p04-a-29-s04",
      "speaker": "Amos",
      "text": "The audition is on Wednesday at four. If he gets the part, rehearsals will be at the same time each week."
    },
    {
      "id": "p04-a-29-s05",
      "speaker": "Beatrice",
      "text": "That works for us. He will practise the short speech you sent."
    },
    {
      "id": "p04-a-29-s06",
      "speaker": "Amos",
      "text": "Good. Wish him luck, and remind him to bring the script on Wednesday."
    }
  ],
