{
  "id": "p04-a-31",
  "title_zh": "根据园区照片寻找猴群所在区域",
  "topic_id": "nature",
  "scenario": {
    "id": "zoo-monkey-viewing-location",
    "label_zh": "根据照片询问猴群的观赏位置",
    "goal_zh": "确认照片中的猴子所在展区并问清前往观赏区的路线"
  },
  "participants": [
    "Lena",
    "Keeper"
  ],
  "context_zh": "访客向园区工作人员询问宣传照片里的猴子及前往观赏区的路线。",
  "author": "author-phase04-a",
  "sentences": [
    {
      "id": "p04-a-31-s01",
      "speaker": "Lena",
      "text": "My daughter wants to see the monkey in this image. Is it here at the zoo?"
    },
    {
      "id": "p04-a-31-s02",
      "speaker": "Keeper",
      "text": "Yes. That is Oscar, a male monkey from our forest enclosure."
    },
    {
      "id": "p04-a-31-s03",
      "speaker": "Lena",
      "text": "Which way is that? We have only found the bird house so far."
    },
    {
      "id": "p04-a-31-s04",
      "speaker": "Keeper",
      "text": "Follow this path past the bird house, then turn right. His group has an outdoor viewing area there."
    },
    {
      "id": "p04-a-31-s05",
      "speaker": "Lena",
      "text": "Thank you. We will go there next."
    }
  ],
