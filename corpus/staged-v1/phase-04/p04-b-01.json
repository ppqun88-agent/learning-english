{
  "id": "p04-b-01",
  "title_zh": "把六人份食谱减半做晚饭",
  "topic_id": "food",
  "scenario": {
    "id": "shared-dinner-preparation",
    "label_zh": "分工准备晚饭",
    "goal_zh": "商定晚餐分工、菜品和份量"
  },
  "participants": [
    "Lucy",
    "Omar"
  ],
  "context_zh": "露西和奥马尔在家做三人份烤蔬菜晚饭，商定份量并分工。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-01-s01",
      "speaker": "Lucy",
      "text": "Shall we cook dinner ourselves tonight? We have enough vegetables."
    },
    {
      "id": "p04-b-01-s02",
      "speaker": "Omar",
      "text": "Yes. This recipe looks easy, but the quantity is for six people."
    },
    {
      "id": "p04-b-01-s03",
      "speaker": "Lucy",
      "text": "Then use half of everything. We only need three portions."
    },
    {
      "id": "p04-b-01-s04",
      "speaker": "Omar",
      "text": "I will prepare the vegetables. Could you heat the oven?"
    },
    {
      "id": "p04-b-01-s05",
      "speaker": "Lucy",
      "text": "Sure. Do we have anything to serve with them?"
    },
    {
      "id": "p04-b-01-s06",
      "speaker": "Omar",
      "text": "There is some tomato sauce in the refrigerator. We can warm it in a pan."
    },
    {
      "id": "p04-b-01-s07",
      "speaker": "Lucy",
      "text": "Good. Pass me that plate, please. I need somewhere to put the peelings."
    },
    {
      "id": "p04-b-01-s08",
      "speaker": "Omar",
      "text": "Here you are. You handle the sauce, and I will get the vegetables ready for the oven."
    }
  ],
