{
  "id": "p04-b-03",
  "title_zh": "选一幅带黑框的画作送礼",
  "topic_id": "services",
  "scenario": {
    "id": "gallery-print-gift-choice",
    "label_zh": "在画廊挑选礼物画作",
    "goal_zh": "按收礼人喜好选定画作和边框颜色"
  },
  "participants": [
    "Nina",
    "Hugo"
  ],
  "context_zh": "顾客在画廊寻找给姐姐的礼物，确认画作类型后选定作品和边框。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-03-s01",
      "speaker": "Nina",
      "text": "I was going to get my sister an ordinary birthday card, but I would like something she can keep."
    },
    {
      "id": "p04-b-03-s02",
      "speaker": "Hugo",
      "text": "Does she like art? I can recommend this small painting of the harbour."
    },
    {
      "id": "p04-b-03-s03",
      "speaker": "Nina",
      "text": "Who is the painter?"
    },
    {
      "id": "p04-b-03-s04",
      "speaker": "Hugo",
      "text": "A local artist called Eva Chen. Your sister may know her work from the town exhibition."
    },
    {
      "id": "p04-b-03-s05",
      "speaker": "Nina",
      "text": "Is this an original painting, or a copy?"
    },
    {
      "id": "p04-b-03-s06",
      "speaker": "Hugo",
      "text": "It is an original painting. The copies are on the other wall."
    },
    {
      "id": "p04-b-03-s07",
      "speaker": "Nina",
      "text": "I will take it with the black frame. It will suit her blue room."
    },
    {
      "id": "p04-b-03-s08",
      "speaker": "Hugo",
      "text": "Of course. Shall I pack it in a gift box?"
    },
    {
      "id": "p04-b-03-s09",
      "speaker": "Nina",
      "text": "Yes, please. I am taking it to her tomorrow."
    }
  ],
