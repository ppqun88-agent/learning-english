{
  "id": "p04-b-04",
  "title_zh": "确认去海港的列车站台与座位",
  "topic_id": "travel",
  "scenario": {
    "id": "station-departure-platform",
    "label_zh": "核对列车出发与站台",
    "goal_zh": "核实列车班次、到达时间、站台和已订座位后确认上车安排"
  },
  "participants": [
    "Ibrahim",
    "Ruth"
  ],
  "context_zh": "旅客在车站询问列车班次，并核对车票上的座位。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-04-s01",
      "speaker": "Ibrahim",
      "text": "Does the railway schedule show a regular train to the harbour, or just the weekend service?"
    },
    {
      "id": "p04-b-04-s02",
      "speaker": "Ruth",
      "text": "There is a train every hour on weekdays. The next one leaves at ten twenty."
    },
    {
      "id": "p04-b-04-s03",
      "speaker": "Ibrahim",
      "text": "Will it reach the harbour before eleven?"
    },
    {
      "id": "p04-b-04-s04",
      "speaker": "Ruth",
      "text": "Yes, at ten fifty. It leaves from platform four."
    },
    {
      "id": "p04-b-04-s05",
      "speaker": "Ibrahim",
      "text": "My ticket says coach B, seat twelve. Is that near the front?"
    },
    {
      "id": "p04-b-04-s06",
      "speaker": "Ruth",
      "text": "It is the second coach from the front. Each passenger with a reservation has a coach letter on the ticket."
    },
    {
      "id": "p04-b-04-s07",
      "speaker": "Ibrahim",
      "text": "Thanks. I will go to platform four and look for coach B."
    }
  ],
