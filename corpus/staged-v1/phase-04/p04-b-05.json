{
  "id": "p04-b-05",
  "title_zh": "从铁路博物馆的区域展厅开始参观",
  "topic_id": "leisure",
  "scenario": {
    "id": "museum-history-room",
    "label_zh": "询问博物馆展览位置",
    "goal_zh": "向博物馆工作人员询问地方历史展览与资料。"
  },
  "participants": [
    "Sofia",
    "Marcus"
  ],
  "context_zh": "一名海外游客询问美国一座铁路博物馆展示哪些地方的历史。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-05-s01",
      "speaker": "Sofia",
      "text": "I live overseas and I am visiting for a few days. Does this railroad museum cover the whole country?"
    },
    {
      "id": "p04-b-05-s02",
      "speaker": "Marcus",
      "text": "No, it focuses on this region and the towns that grew around the railway lines."
    },
    {
      "id": "p04-b-05-s03",
      "speaker": "Sofia",
      "text": "That is what I wanted to learn about. Where should I start?"
    },
    {
      "id": "p04-b-05-s04",
      "speaker": "Marcus",
      "text": "The gallery on your left has a map of the early routes. The engine shed comes after that."
    },
    {
      "id": "p04-b-05-s05",
      "speaker": "Sofia",
      "text": "Great. I will start with the map, then visit the shed."
    }
  ],
