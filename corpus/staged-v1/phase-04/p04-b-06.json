{
  "id": "p04-b-06",
  "title_zh": "租车前核对每天费用和还车要求",
  "topic_id": "services",
  "scenario": {
    "id": "car-hire-cost-check",
    "label_zh": "核对租车费用",
    "goal_zh": "确认每日费率、服务和自付费用，并索取完整报价供决定"
  },
  "participants": [
    "Marta",
    "Ken"
  ],
  "context_zh": "顾客向租车柜台询问报价中包含什么，尚未完成租车。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-06-s01",
      "speaker": "Marta",
      "text": "What is the daily rate for this small car?"
    },
    {
      "id": "p04-b-06-s02",
      "speaker": "Ken",
      "text": "Forty-five pounds per day. That includes basic cover and roadside help."
    },
    {
      "id": "p04-b-06-s03",
      "speaker": "Marta",
      "text": "Do you charge extra for that service?"
    },
    {
      "id": "p04-b-06-s04",
      "speaker": "Ken",
      "text": "No. We provide a phone number you can use if the car breaks down."
    },
    {
      "id": "p04-b-06-s05",
      "speaker": "Marta",
      "text": "And what about petrol and parking?"
    },
    {
      "id": "p04-b-06-s06",
      "speaker": "Ken",
      "text": "You pay for both. The tank is full now, and you must return it full."
    },
    {
      "id": "p04-b-06-s07",
      "speaker": "Marta",
      "text": "All right. Please show me the full three-day quote and the cover details before I decide."
    }
  ],
