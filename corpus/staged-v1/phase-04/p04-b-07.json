{
  "id": "p04-b-07",
  "title_zh": "分工筹办阅读项目的慈善抽奖",
  "topic_id": "community",
  "scenario": {
    "id": "charity-raffle-planning",
    "label_zh": "分工筹备慈善抽奖",
    "goal_zh": "确定筹款用途、奖品和筹备分工，并约定售票前核对活动规则"
  },
  "participants": [
    "Bea",
    "Arun"
  ],
  "context_zh": "社区阅读组织的两位成员商量抽奖活动的筹备职责。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-07-s01",
      "speaker": "Bea",
      "text": "Our organization needs to raise money for the new reading group. Could we hold a raffle at the fair?"
    },
    {
      "id": "p04-b-07-s02",
      "speaker": "Arun",
      "text": "Yes. The bookshop has offered a box of books as a prize."
    },
    {
      "id": "p04-b-07-s03",
      "speaker": "Bea",
      "text": "Who will organize the tickets and the draw?"
    },
    {
      "id": "p04-b-07-s04",
      "speaker": "Arun",
      "text": "I can handle the tickets. Would you ask our president to lead the draw?"
    },
    {
      "id": "p04-b-07-s05",
      "speaker": "Bea",
      "text": "I will ask her today. We should explain that the money will buy books for the group."
    },
    {
      "id": "p04-b-07-s06",
      "speaker": "Arun",
      "text": "Agreed. I will prepare the ticket design, and we can check the event rules with the fair manager before selling any."
    }
  ],
