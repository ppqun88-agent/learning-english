{
  "id": "p04-b-08",
  "title_zh": "确定筹款海报印量与发布分工",
  "topic_id": "community",
  "scenario": {
    "id": "fundraiser-poster-planning",
    "label_zh": "安排筹款活动海报",
    "goal_zh": "确定照片、印量和线上发布安排"
  },
  "participants": [
    "Tessa",
    "Dev"
  ],
  "context_zh": "两位志愿者检查筹款海报，准备打印并发布。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-08-s01",
      "speaker": "Tessa",
      "text": "Can we use this photo for the fundraiser poster? Everyone in it has agreed."
    },
    {
      "id": "p04-b-08-s02",
      "speaker": "Dev",
      "text": "Yes. It clearly shows the reading room we want to improve. How many copies should we print?"
    },
    {
      "id": "p04-b-08-s03",
      "speaker": "Tessa",
      "text": "Twenty for the library and local shops. They have agreed to display them in public areas."
    },
    {
      "id": "p04-b-08-s04",
      "speaker": "Dev",
      "text": "The printer can produce twenty, but I need to replace the empty ink cartridge first."
    },
    {
      "id": "p04-b-08-s05",
      "speaker": "Tessa",
      "text": "Is there anything else to check in the printing process?"
    },
    {
      "id": "p04-b-08-s06",
      "speaker": "Dev",
      "text": "I will print one test copy to check the date and the size before doing the rest."
    },
    {
      "id": "p04-b-08-s07",
      "speaker": "Tessa",
      "text": "Good. Once we approve that, I will put the same design on our website."
    },
    {
      "id": "p04-b-08-s08",
      "speaker": "Dev",
      "text": "Then I will handle the paper copies. Let us check the test together this afternoon."
    }
  ],
