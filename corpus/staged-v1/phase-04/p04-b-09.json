{
  "id": "p04-b-09",
  "title_zh": "报告屋顶漏水并约定检查时间",
  "topic_id": "home",
  "scenario": {
    "id": "roof-leak-inspection-appointment",
    "label_zh": "预约屋顶漏水检查",
    "goal_zh": "说明漏水情况及已采取的隔离措施，约定检查时间并在检查后讨论维修选项"
  },
  "participants": [
    "Gareth",
    "Lina"
  ],
  "context_zh": "屋主致电维修人员，说明已经采取的隔离安排并预约检查。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-09-s01",
      "speaker": "Gareth",
      "text": "I am the owner of the house on Mill Lane. Water is coming through the roof into the spare room."
    },
    {
      "id": "p04-b-09-s02",
      "speaker": "Lina",
      "text": "Is anyone using that room now?"
    },
    {
      "id": "p04-b-09-s03",
      "speaker": "Gareth",
      "text": "No. An electrician has already turned off the power to it, and we are keeping the door closed."
    },
    {
      "id": "p04-b-09-s04",
      "speaker": "Lina",
      "text": "Good to know. Has the water reached any furniture?"
    },
    {
      "id": "p04-b-09-s05",
      "speaker": "Gareth",
      "text": "We moved the furniture earlier to protect it. Can you stop more water getting in?"
    },
    {
      "id": "p04-b-09-s06",
      "speaker": "Lina",
      "text": "I need to inspect the roof before I can say what work will prevent another leak. I can come at two today."
    },
    {
      "id": "p04-b-09-s07",
      "speaker": "Gareth",
      "text": "Two is fine. We will stay out of the room until you have checked it."
    },
    {
      "id": "p04-b-09-s08",
      "speaker": "Lina",
      "text": "I will inspect it then and explain the repair options before starting work."
    }
  ],
