{
  "id": "p04-b-10",
  "title_zh": "给环境调查报道加上样本限制",
  "topic_id": "reasoning",
  "scenario": {
    "id": "survey-evidence",
    "label_zh": "讨论调查证据",
    "goal_zh": "核对样本、局限与结论的依据"
  },
  "participants": [
    "Lena",
    "Dr Bell"
  ],
  "context_zh": "记者与研究者核对一项虚构的近期调查，避免把受访者意见写成全城事实。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-10-s01",
      "speaker": "Lena",
      "text": "I am the reporter working on your recent survey. Can I say that air pollution worries half the city?"
    },
    {
      "id": "p04-b-10-s02",
      "speaker": "Dr Bell",
      "text": "Not from these results. Forty percent of the people who answered mentioned it, not half."
    },
    {
      "id": "p04-b-10-s03",
      "speaker": "Lena",
      "text": "And the people who answered are not necessarily like the whole population?"
    },
    {
      "id": "p04-b-10-s04",
      "speaker": "Dr Bell",
      "text": "Exactly. We invited members of two neighbourhood groups. As a researcher, I need to make that limit clear."
    },
    {
      "id": "p04-b-10-s05",
      "speaker": "Lena",
      "text": "Can the survey predict whether air quality will get worse?"
    },
    {
      "id": "p04-b-10-s06",
      "speaker": "Dr Bell",
      "text": "No. We asked people what worried them. We did not measure the air."
    },
    {
      "id": "p04-b-10-s07",
      "speaker": "Lena",
      "text": "Then I will describe the respondents and avoid a forecast. Can you check that paragraph before we publish it?"
    },
    {
      "id": "p04-b-10-s08",
      "speaker": "Dr Bell",
      "text": "Yes. Send me the paragraph, and I will check that it matches the findings."
    }
  ],
