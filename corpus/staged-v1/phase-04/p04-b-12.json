{
  "id": "p04-b-12",
  "title_zh": "为物理课选择能看清轨道的模型",
  "topic_id": "learning",
  "scenario": {
    "id": "classroom-orbit-model-plan",
    "label_zh": "规划课堂轨道模型",
    "goal_zh": "根据演示目的选择简易轨道模型，说明比例局限并分工制作"
  },
  "participants": [
    "Theo",
    "Rina"
  ],
  "context_zh": "两位学生准备一个简易课堂演示，确认展示目的并避免误导观众。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-12-s01",
      "speaker": "Theo",
      "text": "Our physics professor wants a model for tomorrow. Should we build the whole solar system?"
    },
    {
      "id": "p04-b-12-s02",
      "speaker": "Rina",
      "text": "What is the purpose of the demonstration?"
    },
    {
      "id": "p04-b-12-s03",
      "speaker": "Theo",
      "text": "To show how a planet moves around a star, not to compare the planets."
    },
    {
      "id": "p04-b-12-s04",
      "speaker": "Rina",
      "text": "Then use one large ball in the middle and a smaller one on a circular track."
    },
    {
      "id": "p04-b-12-s05",
      "speaker": "Theo",
      "text": "Why only two balls?"
    },
    {
      "id": "p04-b-12-s06",
      "speaker": "Rina",
      "text": "First, people can see the motion more clearly. Secondly, we can finish it today. We must also say the sizes and distances are not to scale."
    },
    {
      "id": "p04-b-12-s07",
      "speaker": "Theo",
      "text": "Agreed. I will make the track, and you can prepare the explanation about the model."
    }
  ],
