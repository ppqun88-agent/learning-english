{
  "id": "p04-b-13",
  "title_zh": "改去酒吧听摇滚乐队",
  "topic_id": "leisure",
  "scenario": {
    "id": "live-music-evening",
    "label_zh": "安排现场音乐之夜",
    "goal_zh": "朋友相约听现场音乐并核对场地与购买专辑安排。"
  },
  "participants": [
    "Milo",
    "Beth"
  ],
  "context_zh": "两位朋友发现原想去的演出取消，另选一个现场音乐场所。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-13-s01",
      "speaker": "Milo",
      "text": "Are the singers still going to perform at the arts centre tonight?"
    },
    {
      "id": "p04-b-13-s02",
      "speaker": "Beth",
      "text": "Sadly, the show has been cancelled. There is a band at the Fox pub instead."
    },
    {
      "id": "p04-b-13-s03",
      "speaker": "Milo",
      "text": "What kind of music do they play? I would rather hear rock than pop tonight."
    },
    {
      "id": "p04-b-13-s04",
      "speaker": "Beth",
      "text": "Then you will like them. They are a professional band, and the show starts at eight."
    },
    {
      "id": "p04-b-13-s05",
      "speaker": "Milo",
      "text": "Do they sell their album there? I heard one song online and liked it."
    },
    {
      "id": "p04-b-13-s06",
      "speaker": "Beth",
      "text": "Yes, at a table near the stage. We can get a copy after the show."
    },
    {
      "id": "p04-b-13-s07",
      "speaker": "Milo",
      "text": "Let us meet outside the Fox at seven thirty, then."
    },
    {
      "id": "p04-b-13-s08",
      "speaker": "Beth",
      "text": "See you there. That should give us time to find a table."
    }
  ],
