{
  "id": "p04-b-14",
  "title_zh": "凭刻字认领母亲留下的戒指",
  "topic_id": "services",
  "scenario": {
    "id": "lost-ring-identification",
    "label_zh": "描述并认领遗失戒指",
    "goal_zh": "凭外观和刻字核实遗失戒指的归属并领取"
  },
  "participants": [
    "Hazel",
    "Owen"
  ],
  "context_zh": "访客向场馆失物招领处描述遗失戒指，并用细节核实归属。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-14-s01",
      "speaker": "Hazel",
      "text": "Has anyone handed in a silver ring? I put it in my coat pocket during the workshop, and now it is gone."
    },
    {
      "id": "p04-b-14-s02",
      "speaker": "Owen",
      "text": "We have one. Before I show it to you, can you describe a detail that would help identify it?"
    },
    {
      "id": "p04-b-14-s03",
      "speaker": "Hazel",
      "text": "There is a small blue stone, and the letters M and H are inside. It was my mother’s most treasured possession."
    },
    {
      "id": "p04-b-14-s04",
      "speaker": "Owen",
      "text": "Those details match. Is this the one?"
    },
    {
      "id": "p04-b-14-s05",
      "speaker": "Hazel",
      "text": "Yes. I recognize the little scratch beside the stone."
    },
    {
      "id": "p04-b-14-s06",
      "speaker": "Owen",
      "text": "A cleaner found it under a chair. You can sign this collection record and take it."
    },
    {
      "id": "p04-b-14-s07",
      "speaker": "Hazel",
      "text": "Thank you. I was about to search the whole room again. I will sign here."
    }
  ],
