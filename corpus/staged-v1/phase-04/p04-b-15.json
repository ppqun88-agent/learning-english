{
  "id": "p04-b-15",
  "title_zh": "先在工作人员陪同下认识一只狗",
  "topic_id": "nature",
  "scenario": {
    "id": "shelter-dog-first-meeting",
    "label_zh": "安排初次接触收容所的狗",
    "goal_zh": "说明养狗顾虑并同意在工作人员陪同下先短暂见面"
  },
  "participants": [
    "Jules",
    "Mina"
  ],
  "context_zh": "一位考虑养宠物的人向收容所说明自己的顾虑，决定先短暂见面。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-15-s01",
      "speaker": "Jules",
      "text": "I moved into a house recently, and I am thinking about getting a pet. But I am a little scared of large dogs."
    },
    {
      "id": "p04-b-15-s02",
      "speaker": "Mina",
      "text": "You do not have to choose one today. What kind of personality would suit you?"
    },
    {
      "id": "p04-b-15-s03",
      "speaker": "Jules",
      "text": "A calm dog. How does this small one react when someone new arrives?"
    },
    {
      "id": "p04-b-15-s04",
      "speaker": "Mina",
      "text": "He usually watches for a while before coming closer. We can meet him together in the quiet room."
    },
    {
      "id": "p04-b-15-s05",
      "speaker": "Jules",
      "text": "He does seem calm from here. Could you stay with me for the first few minutes?"
    },
    {
      "id": "p04-b-15-s06",
      "speaker": "Mina",
      "text": "Of course. We will start with a short visit, and you can tell me when you want to stop."
    },
    {
      "id": "p04-b-15-s07",
      "speaker": "Jules",
      "text": "That sounds good. Let us try the short visit before discussing anything else."
    }
  ],
