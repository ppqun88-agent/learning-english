{
  "id": "p04-b-16",
  "title_zh": "把拒绝临时加班的回复写得清楚有礼",
  "topic_id": "work",
  "scenario": {
    "id": "polite-work-request-refusal",
    "label_zh": "修改拒绝工作请求的措辞",
    "goal_zh": "把拒绝临时加班的草稿改为明确有礼且时间承诺可行的回复"
  },
  "participants": [
    "Paula",
    "Dion"
  ],
  "context_zh": "一位员工请同事帮忙检查准备发送的拒绝措辞，尚未发送消息。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-16-s01",
      "speaker": "Paula",
      "text": "I need to refuse another request to stay late tonight. Does this reply sound rude?"
    },
    {
      "id": "p04-b-16-s02",
      "speaker": "Dion",
      "text": "Read it to me."
    },
    {
      "id": "p04-b-16-s03",
      "speaker": "Paula",
      "text": "No, I already said I am busy."
    },
    {
      "id": "p04-b-16-s04",
      "speaker": "Dion",
      "text": "That sounds irritated. You can be polite without changing your answer: I cannot stay tonight, but I can finish the task tomorrow morning."
    },
    {
      "id": "p04-b-16-s05",
      "speaker": "Paula",
      "text": "Tomorrow morning is realistic. I will use that and leave out the comment about having said it already."
    },
    {
      "id": "p04-b-16-s06",
      "speaker": "Dion",
      "text": "Good. It gives a clear answer and tells them when the work can be done."
    }
  ],
