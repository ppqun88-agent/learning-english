{
  "id": "p04-b-22",
  "title_zh": "选第一部轻松的影片在家看",
  "topic_id": "leisure",
  "scenario": {
    "id": "home-film-choice",
    "label_zh": "商量在家看电影",
    "goal_zh": "在不出门的前提下选定双方都想看的影片"
  },
  "participants": [
    "Alina",
    "Jonah"
  ],
  "context_zh": "两位朋友不想出门，比较同一系列的两部电影并选定不吓人的一部。",
  "author": "author-phase04-b",
  "sentences": [
    {
      "id": "p04-b-22-s01",
      "speaker": "Alina",
      "text": "Let us stay in tonight. Which film should we watch?"
    },
    {
      "id": "p04-b-22-s02",
      "speaker": "Jonah",
      "text": "The second one in the Harbour House series is available. Shall I put it on the big screen?"
    },
    {
      "id": "p04-b-22-s03",
      "speaker": "Alina",
      "text": "Is it scary? I do not want anything that will keep me awake."
    },
    {
      "id": "p04-b-22-s04",
      "speaker": "Jonah",
      "text": "The review I read mentions a frightening scene in a dark cellar."
    },
    {
      "id": "p04-b-22-s05",
      "speaker": "Alina",
      "text": "Then not that one. What about the first film? You said it was a comedy."
    },
    {
      "id": "p04-b-22-s06",
      "speaker": "Jonah",
      "text": "It is. There is a mystery, but no horror. I enjoyed it enough to watch it again."
    },
    {
      "id": "p04-b-22-s07",
      "speaker": "Alina",
      "text": "Good. Let us watch the first one on the television, then."
    }
  ],
