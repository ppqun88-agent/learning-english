{
  "id": "p04-c-01",
  "title_zh": "挑选露台铺路砖样品",
  "topic_id": "services",
  "scenario": {
    "id": "paving-sample-comparison",
    "label_zh": "挑选露台铺路砖样品",
    "goal_zh": "说明材质与形状需求，比较厚度并选定带回家检查开门空间的样品"
  },
  "participants": [
    "Mara",
    "Ivo"
  ],
  "context_zh": "玛拉到建材店借铺路砖样品，准备回家核对露台门下的空间。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-01-s01",
      "speaker": "Mara",
      "text": "We need a stone tile for our little patio. Can I compare these samples?"
    },
    {
      "id": "p04-c-01-s02",
      "speaker": "Ivo",
      "text": "Of course. What shape do you want?"
    },
    {
      "id": "p04-c-01-s03",
      "speaker": "Mara",
      "text": "A square tile would line up with the path. This one looks rather thin."
    },
    {
      "id": "p04-c-01-s04",
      "speaker": "Ivo",
      "text": "It's two centimetres thick. The other sample is three."
    },
    {
      "id": "p04-c-01-s05",
      "speaker": "Mara",
      "text": "I'll take the thicker sample home and check that the door can still open over it."
    },
    {
      "id": "p04-c-01-s06",
      "speaker": "Ivo",
      "text": "Here you are. Bring it back when you've measured the space."
    }
  ],
