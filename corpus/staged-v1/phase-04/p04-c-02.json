{
  "id": "p04-c-02",
  "title_zh": "试穿运动鞋并确认尺码",
  "topic_id": "services",
  "scenario": {
    "id": "sports-shoe-fitting",
    "label_zh": "试穿运动鞋并确认尺码",
    "goal_zh": "比较试穿感受并选定合脚的一双鞋"
  },
  "participants": [
    "Andre",
    "Nina"
  ],
  "context_zh": "安德烈试穿室内足球运动鞋，与店员比较脚趾空间和内衬触感。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-02-s01",
      "speaker": "Andre",
      "text": "I need shoes for indoor soccer. Can I try this pair?"
    },
    {
      "id": "p04-c-02-s02",
      "speaker": "Nina",
      "text": "Certainly. What size do you usually wear?"
    },
    {
      "id": "p04-c-02-s03",
      "speaker": "Andre",
      "text": "Nine, but this sneaker is tight across my toes."
    },
    {
      "id": "p04-c-02-s04",
      "speaker": "Nina",
      "text": "Let's try a ten. Keep the same sock on so you can compare the fit."
    },
    {
      "id": "p04-c-02-s05",
      "speaker": "Andre",
      "text": "That feels better, and the lining is soft. My heel stays in place when I walk."
    },
    {
      "id": "p04-c-02-s06",
      "speaker": "Nina",
      "text": "Would you like to try the other foot too?"
    },
    {
      "id": "p04-c-02-s07",
      "speaker": "Andre",
      "text": "Yes, please. That one fits as well. I'll take the pair."
    }
  ],
