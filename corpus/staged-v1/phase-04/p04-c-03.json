{
  "id": "p04-c-03",
  "title_zh": "办理礼物包裹与贺卡邮寄",
  "topic_id": "services",
  "scenario": {
    "id": "parcel-and-card-posting",
    "label_zh": "办理礼物包裹与贺卡邮寄",
    "goal_zh": "核对邮寄去向、标签和贺卡邮资并交寄"
  },
  "participants": [
    "Rowan",
    "Elena"
  ],
  "context_zh": "罗文在邮寄柜台寄送礼物包裹，并为随行的一张贺卡购买邮票。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-03-s01",
      "speaker": "Rowan",
      "text": "I'd like to ship this box to another state. It contains several small gifts."
    },
    {
      "id": "p04-c-03-s02",
      "speaker": "Elena",
      "text": "Have you written the full address on the label?"
    },
    {
      "id": "p04-c-03-s03",
      "speaker": "Rowan",
      "text": "Yes. Could I also get a stamp for this card?"
    },
    {
      "id": "p04-c-03-s04",
      "speaker": "Elena",
      "text": "Yes, sir. I'll weigh the box first, then give you the total."
    },
    {
      "id": "p04-c-03-s05",
      "speaker": "Rowan",
      "text": "That's fine. Here's my card for the payment."
    },
    {
      "id": "p04-c-03-s06",
      "speaker": "Elena",
      "text": "The payment went through. Please sign this receipt for the insured parcel."
    },
    {
      "id": "p04-c-03-s07",
      "speaker": "Rowan",
      "text": "Done. I'll leave the box and the stamped card with you."
    },
    {
      "id": "p04-c-03-s08",
      "speaker": "Elena",
      "text": "Thank you. Both will go out with today's collection."
    }
  ],
