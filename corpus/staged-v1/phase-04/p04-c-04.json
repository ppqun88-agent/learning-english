{
  "id": "p04-c-04",
  "title_zh": "调整山间步行路线",
  "topic_id": "leisure",
  "scenario": {
    "id": "hill-walk-route-choice",
    "label_zh": "调整山间步行路线",
    "goal_zh": "考虑天色和路面条件后改走短路线"
  },
  "participants": [
    "Sana",
    "Ellis"
  ],
  "context_zh": "两名徒步者发现天色转暗，决定放弃山顶景色并沿较短路线返回。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-04-s01",
      "speaker": "Sana",
      "text": "The sky has suddenly gone dark. Do you think a storm is coming?"
    },
    {
      "id": "p04-c-04-s02",
      "speaker": "Ellis",
      "text": "Maybe. We still have a long climb before we get a view of the valley."
    },
    {
      "id": "p04-c-04-s03",
      "speaker": "Sana",
      "text": "I'd rather miss the view than be up there in bad weather."
    },
    {
      "id": "p04-c-04-s04",
      "speaker": "Ellis",
      "text": "Agreed. The path towards the village is shorter, and the surface looks firmer than this muddy trail."
    },
    {
      "id": "p04-c-04-s05",
      "speaker": "Sana",
      "text": "Let's take that path now. We can come back for the hill another day."
    }
  ],
