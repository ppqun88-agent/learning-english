{
  "id": "p04-c-05",
  "title_zh": "确认首次滑雪课的练习安排",
  "topic_id": "leisure",
  "scenario": {
    "id": "first-ski-lesson-plan",
    "label_zh": "确认首次滑雪课的练习安排",
    "goal_zh": "说明滑雪经验并确认教练带领的低速入门练习"
  },
  "participants": [
    "Beth",
    "Maya"
  ],
  "context_zh": "贝丝在滑雪学校说明自己经验很少，并确认入门训练有教练陪同。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-05-s01",
      "speaker": "Beth",
      "text": "I can ski a little, but downhill skiing still makes me nervous."
    },
    {
      "id": "p04-c-05-s02",
      "speaker": "Maya",
      "text": "Then today's training will start on this gentle slope."
    },
    {
      "id": "p04-c-05-s03",
      "speaker": "Beth",
      "text": "Will a trainer stay with me? I get worried about my speed."
    },
    {
      "id": "p04-c-05-s04",
      "speaker": "Maya",
      "text": "Yes, I'll be beside you. We'll move slowly and practise stopping before we try anything longer."
    },
    {
      "id": "p04-c-05-s05",
      "speaker": "Beth",
      "text": "That sounds manageable. Let's start here."
    }
  ],
