{
  "id": "p04-c-08",
  "title_zh": "索取双床房的备用寝具",
  "topic_id": "travel",
  "scenario": {
    "id": "hotel-extra-linen-request",
    "label_zh": "索取双床房的备用寝具",
    "goal_zh": "核对房型和备用毛巾床单位置并安排送到客房"
  },
  "participants": [
    "Luca",
    "Dora"
  ],
  "context_zh": "旅客向前台询问双床房的备用寝具，并请求补送毛巾。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-08-s01",
      "speaker": "Luca",
      "text": "We're in the twin room, number twelve. Could we have another towel and a spare sheet?"
    },
    {
      "id": "p04-c-08-s02",
      "speaker": "Dora",
      "text": "Of course. Did you check the cupboard by the door?"
    },
    {
      "id": "p04-c-08-s03",
      "speaker": "Luca",
      "text": "Yes. I thought there might be one somewhere in there, but it's empty."
    },
    {
      "id": "p04-c-08-s04",
      "speaker": "Dora",
      "text": "That's the usual place for spare linen. I'm sorry it wasn't filled."
    },
    {
      "id": "p04-c-08-s05",
      "speaker": "Luca",
      "text": "No problem. We'll be in the room for the next hour."
    },
    {
      "id": "p04-c-08-s06",
      "speaker": "Dora",
      "text": "I'll bring the towel and sheet up in a few minutes."
    }
  ],
