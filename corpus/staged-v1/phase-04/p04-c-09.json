{
  "id": "p04-c-09",
  "title_zh": "处理烤焦食物后的厨房清洁",
  "topic_id": "home",
  "scenario": {
    "id": "kitchen-toast-smoke-cleanup",
    "label_zh": "处理烤焦食物后的厨房清洁",
    "goal_zh": "确认灶具已经关闭并等锅冷却后清洁厨房"
  },
  "participants": [
    "Jules",
    "Asha"
  ],
  "context_zh": "室友把平底锅里的面包烤焦了；灶具已关闭，烟气已经散去，两人商量后续清洁。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-09-s01",
      "speaker": "Jules",
      "text": "I can still smell the bread I burned."
    },
    {
      "id": "p04-c-09-s02",
      "speaker": "Asha",
      "text": "The smoke has cleared now. Is the stove definitely off?"
    },
    {
      "id": "p04-c-09-s03",
      "speaker": "Jules",
      "text": "Yes, I checked it. The empty pan is still hot, though."
    },
    {
      "id": "p04-c-09-s04",
      "speaker": "Asha",
      "text": "Then don't touch it yet. We can wash it once it's cool."
    },
    {
      "id": "p04-c-09-s05",
      "speaker": "Jules",
      "text": "I'll wipe the table while we wait. Could you shut the cupboard so I can reach that corner?"
    },
    {
      "id": "p04-c-09-s06",
      "speaker": "Asha",
      "text": "Sure. I'll do the dishes after you finish the table."
    }
  ],
