{
  "id": "p04-c-11",
  "title_zh": "安排合唱排练与伴奏",
  "topic_id": "leisure",
  "scenario": {
    "id": "choir-rehearsal-plan",
    "label_zh": "安排合唱排练与伴奏",
    "goal_zh": "确认替补伴奏并确定困难声部的练习方式"
  },
  "participants": [
    "Priya",
    "Tomas"
  ],
  "context_zh": "合唱团原伴奏者缺席，团员确认替补人员并安排困难段落的练习。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-11-s01",
      "speaker": "Priya",
      "text": "Ada can't come tonight. Can you play the piano for our singing practice?"
    },
    {
      "id": "p04-c-11-s02",
      "speaker": "Tomas",
      "text": "Yes. I have the music. Shall we start with the last verse?"
    },
    {
      "id": "p04-c-11-s03",
      "speaker": "Priya",
      "text": "Please. My voice keeps dropping out on the high part."
    },
    {
      "id": "p04-c-11-s04",
      "speaker": "Tomas",
      "text": "We'll try it quietly first, before everyone goes onto the stage."
    },
    {
      "id": "p04-c-11-s05",
      "speaker": "Priya",
      "text": "That takes some pressure off. You've even got a smile out of me."
    },
    {
      "id": "p04-c-11-s06",
      "speaker": "Tomas",
      "text": "Good. I'll play the difficult line once, and then you can join me."
    }
  ],
