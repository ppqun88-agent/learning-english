{
  "id": "p04-c-12",
  "title_zh": "调整社区讲座的讲法",
  "topic_id": "work",
  "scenario": {
    "id": "community-talk-rehearsal",
    "label_zh": "调整社区讲座的讲法",
    "goal_zh": "澄清讲座结构和重点后决定重练开场"
  },
  "participants": [
    "Farah",
    "Ben"
  ],
  "context_zh": "社区讲座主讲人与同事试讲，调整结构并突出实际报名步骤。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-12-s01",
      "speaker": "Farah",
      "text": "You're the first speaker tomorrow. Would you like to try your opening on me?"
    },
    {
      "id": "p04-c-12-s02",
      "speaker": "Ben",
      "text": "Yes. My speech is about our repair club, but I'm not sure the structure is clear."
    },
    {
      "id": "p04-c-12-s03",
      "speaker": "Farah",
      "text": "Start with the broken chair you fixed. It's more specific than saying the club does useful work."
    },
    {
      "id": "p04-c-12-s04",
      "speaker": "Ben",
      "text": "Then I can explain how people join."
    },
    {
      "id": "p04-c-12-s05",
      "speaker": "Farah",
      "text": "Exactly. And stress that beginners are welcome. People may think they need experience."
    },
    {
      "id": "p04-c-12-s06",
      "speaker": "Ben",
      "text": "Right. Story first, invitation second. Let me try that opening again."
    }
  ],
