{
  "id": "p04-c-13",
  "title_zh": "澄清数学题并完成解题",
  "topic_id": "learning",
  "scenario": {
    "id": "math-problem-support",
    "label_zh": "澄清数学题并完成解题",
    "goal_zh": "指出卡住的步骤并在同伴支持下核对解法"
  },
  "participants": [
    "Amy",
    "Noel"
  ],
  "context_zh": "艾米做数学题时在第二步卡住，同伴帮她理解每组人数和总人数的关系。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-13-s01",
      "speaker": "Amy",
      "text": "I feel stupid. I can't solve this problem about twelve students in three equal groups."
    },
    {
      "id": "p04-c-13-s02",
      "speaker": "Noel",
      "text": "You're not stupid. Show me the step where you get stuck."
    },
    {
      "id": "p04-c-13-s03",
      "speaker": "Amy",
      "text": "I know there are three groups, but I keep multiplying twelve by three."
    },
    {
      "id": "p04-c-13-s04",
      "speaker": "Noel",
      "text": "Try a simple drawing. Share the twelve dots between three circles."
    },
    {
      "id": "p04-c-13-s05",
      "speaker": "Amy",
      "text": "Four in each circle. So the solution is four students in each group, not thirty-six."
    },
    {
      "id": "p04-c-13-s06",
      "speaker": "Noel",
      "text": "Yes. How would you check your understanding?"
    },
    {
      "id": "p04-c-13-s07",
      "speaker": "Amy",
      "text": "Four plus four plus four makes twelve. Thanks for the support. I'll try the next one myself."
    }
  ],
