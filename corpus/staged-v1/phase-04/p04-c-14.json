{
  "id": "p04-c-14",
  "title_zh": "核对历史制服展品说明",
  "topic_id": "learning",
  "scenario": {
    "id": "museum-uniform-label-check",
    "label_zh": "核对历史制服展品说明",
    "goal_zh": "区分可证实的服装细节与未经证实的个人身份"
  },
  "participants": [
    "Zoe",
    "Mr Bell"
  ],
  "context_zh": "学生为地方历史展写说明，在老师帮助下核对制服照片能支持哪些描述。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-14-s01",
      "speaker": "Zoe",
      "text": "Can I say this uniform belonged to the soldier in the photograph?"
    },
    {
      "id": "p04-c-14-s02",
      "speaker": "Mr Bell",
      "text": "Not yet. The photo is one source, but it doesn't connect him to this particular coat."
    },
    {
      "id": "p04-c-14-s03",
      "speaker": "Zoe",
      "text": "What about the silver badge? The one in the photograph looks the same."
    },
    {
      "id": "p04-c-14-s04",
      "speaker": "Mr Bell",
      "text": "We can describe the matching symbol, but we shouldn't identify the owner from that alone."
    },
    {
      "id": "p04-c-14-s05",
      "speaker": "Zoe",
      "text": "Then I'll label it as a uniform of the same period and leave the owner's name unknown."
    },
    {
      "id": "p04-c-14-s06",
      "speaker": "Mr Bell",
      "text": "Good. I'll help you check the museum record before we add anything more."
    }
  ],
