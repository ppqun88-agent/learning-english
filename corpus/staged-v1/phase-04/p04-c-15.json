{
  "id": "p04-c-15",
  "title_zh": "加入传统节庆志愿活动",
  "topic_id": "community",
  "scenario": {
    "id": "heritage-festival-volunteering",
    "label_zh": "加入传统节庆志愿活动",
    "goal_zh": "了解社团目标和节庆习俗并约定首次帮忙的工作"
  },
  "participants": [
    "Nadia",
    "Colin"
  ],
  "context_zh": "新人想参加当地历史社团的节庆志愿活动，询问活动是否欢迎外来居民。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-15-s01",
      "speaker": "Nadia",
      "text": "I'd like to help at the festival. Is your society only for people who grew up here?"
    },
    {
      "id": "p04-c-15-s02",
      "speaker": "Colin",
      "text": "Not at all. We're united by an interest in the town, not by where we were born."
    },
    {
      "id": "p04-c-15-s03",
      "speaker": "Nadia",
      "text": "I saw the traditional clothes in last year's photos. Is the festival mainly a performance?"
    },
    {
      "id": "p04-c-15-s04",
      "speaker": "Colin",
      "text": "There's music, but the lunch is a social event for everyone. Sharing bread at one long table is a local tradition."
    },
    {
      "id": "p04-c-15-s05",
      "speaker": "Nadia",
      "text": "That sounds welcoming. I could help set up the tables."
    },
    {
      "id": "p04-c-15-s06",
      "speaker": "Colin",
      "text": "Lovely. Meet us outside the hall at nine on Saturday, and we'll show you where everything goes."
    }
  ],
