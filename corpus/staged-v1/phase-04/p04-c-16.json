{
  "id": "p04-c-16",
  "title_zh": "协助首次使用平板设备",
  "topic_id": "services",
  "scenario": {
    "id": "tablet-first-use-help",
    "label_zh": "协助首次使用平板设备",
    "goal_zh": "说明设备操作困难并练习打开视频通话应用"
  },
  "participants": [
    "Inez",
    "Sam"
  ],
  "context_zh": "社区设备服务台协助一位新用户在平板上找到视频通话应用。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-16-s01",
      "speaker": "Inez",
      "text": "I can use my smartphone, but this tablet is confusing. I'm not very confident with technology."
    },
    {
      "id": "p04-c-16-s02",
      "speaker": "Sam",
      "text": "That's all right. What are you having trouble with?"
    },
    {
      "id": "p04-c-16-s03",
      "speaker": "Inez",
      "text": "I can't find the video-call app. I'm a new user, so please go slowly."
    },
    {
      "id": "p04-c-16-s04",
      "speaker": "Sam",
      "text": "The system puts all your apps on this screen. Swipe once, then look for the blue camera."
    },
    {
      "id": "p04-c-16-s05",
      "speaker": "Inez",
      "text": "Here it is. I've opened it, and I can see my contacts now."
    },
    {
      "id": "p04-c-16-s06",
      "speaker": "Sam",
      "text": "Good. Close it and try finding it once more without my help."
    },
    {
      "id": "p04-c-16-s07",
      "speaker": "Inez",
      "text": "Done. It's much less confusing when I know where to start."
    }
  ],
