{
  "id": "p04-c-17",
  "title_zh": "试味后选择奶昔",
  "topic_id": "food",
  "scenario": {
    "id": "milkshake-counter-choice",
    "label_zh": "试味后选择奶昔",
    "goal_zh": "询问奶昔种类和甜度并完成点单"
  },
  "participants": [
    "Miles",
    "Vera"
  ],
  "context_zh": "顾客在饮品柜台试尝草莓奶昔，确认甜度后点了一小杯。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-17-s01",
      "speaker": "Miles",
      "text": "What sort of shake is that pink one?"
    },
    {
      "id": "p04-c-17-s02",
      "speaker": "Vera",
      "text": "Strawberry. We have a variety of fruit flavours as well as chocolate."
    },
    {
      "id": "p04-c-17-s03",
      "speaker": "Miles",
      "text": "Could I taste the strawberry before I decide?"
    },
    {
      "id": "p04-c-17-s04",
      "speaker": "Vera",
      "text": "Certainly. Here's a little sample and a spoon."
    },
    {
      "id": "p04-c-17-s05",
      "speaker": "Miles",
      "text": "That's sweet, but not too sweet for me. I'll have a small one, please."
    },
    {
      "id": "p04-c-17-s06",
      "speaker": "Vera",
      "text": "One small strawberry shake. I'll make it now."
    }
  ],
