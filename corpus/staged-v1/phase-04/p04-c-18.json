{
  "id": "p04-c-18",
  "title_zh": "整理玩具架并区分去留",
  "topic_id": "home",
  "scenario": {
    "id": "toy-shelf-cleanup",
    "label_zh": "整理玩具架并区分去留",
    "goal_zh": "把玩具、捐赠物和垃圾分开并整理上层架子"
  },
  "participants": [
    "Rosa",
    "Finn"
  ],
  "context_zh": "家长与孩子一起整理玩具架，把留下、捐赠和丢弃的物品分开。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-18-s01",
      "speaker": "Rosa",
      "text": "Let's tidy this shelf before we get another toy out."
    },
    {
      "id": "p04-c-18-s02",
      "speaker": "Finn",
      "text": "Can I throw the broken boxes away?"
    },
    {
      "id": "p04-c-18-s03",
      "speaker": "Rosa",
      "text": "Yes, those can go in the trash. But put the things you no longer play with in this separate bag."
    },
    {
      "id": "p04-c-18-s04",
      "speaker": "Finn",
      "text": "For the donation box? I'll put my old cars in there."
    },
    {
      "id": "p04-c-18-s05",
      "speaker": "Rosa",
      "text": "Good idea. Your puzzles can stay on the top shelf."
    },
    {
      "id": "p04-c-18-s06",
      "speaker": "Finn",
      "text": "There. The puzzles are back, the cars are in the bag, and I can see the floor again."
    }
  ],
