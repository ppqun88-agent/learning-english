{
  "id": "p04-c-20",
  "title_zh": "选择城市轨道交通日票",
  "topic_id": "travel",
  "scenario": {
    "id": "city-transit-day-pass",
    "label_zh": "选择城市轨道交通日票",
    "goal_zh": "确认旅客可购买的车票和地下站台方向"
  },
  "participants": [
    "Evan",
    "Clerk Jo"
  ],
  "context_zh": "短期商务旅客在车站咨询日票及市中心方向的站台。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-20-s01",
      "speaker": "Evan",
      "text": "I'm a business traveler here for two days. Can visitors buy a day pass for public transportation?"
    },
    {
      "id": "p04-c-20-s02",
      "speaker": "Clerk Jo",
      "text": "Yes. You don't need a local address."
    },
    {
      "id": "p04-c-20-s03",
      "speaker": "Evan",
      "text": "Does it cover the subway as well as buses?"
    },
    {
      "id": "p04-c-20-s04",
      "speaker": "Clerk Jo",
      "text": "It does. You can buy it at this machine, then use the underground platform downstairs."
    },
    {
      "id": "p04-c-20-s05",
      "speaker": "Evan",
      "text": "Which way is the train to the city center?"
    },
    {
      "id": "p04-c-20-s06",
      "speaker": "Clerk Jo",
      "text": "Walk toward the blue sign. Trains for the center leave from track two."
    },
    {
      "id": "p04-c-20-s07",
      "speaker": "Evan",
      "text": "Great. I'll get a day pass and head down there."
    }
  ],
