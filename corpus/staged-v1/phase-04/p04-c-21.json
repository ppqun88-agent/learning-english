{
  "id": "p04-c-21",
  "title_zh": "询问钟塔导览和步行路线",
  "topic_id": "travel",
  "scenario": {
    "id": "tower-walking-tour-choice",
    "label_zh": "询问钟塔导览和步行路线",
    "goal_zh": "核对旅游咨询处提供的导览并确认到钟塔的路线"
  },
  "participants": [
    "Petra",
    "Nico"
  ],
  "context_zh": "游客在咨询处询问钟塔步行导览的内容，并确认从广场出发的路线。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-21-s01",
      "speaker": "Petra",
      "text": "Is there a tour that includes the old tower?"
    },
    {
      "id": "p04-c-21-s02",
      "speaker": "Nico",
      "text": "Yes, at two. The guide explains how tourism has changed the town, as well as the tower's history."
    },
    {
      "id": "p04-c-21-s03",
      "speaker": "Petra",
      "text": "That sounds interesting. Where does it start?"
    },
    {
      "id": "p04-c-21-s04",
      "speaker": "Nico",
      "text": "At the tower entrance. Walk straight across the square, then take the narrow street beside the bakery."
    },
    {
      "id": "p04-c-21-s05",
      "speaker": "Petra",
      "text": "Which side of the street is the entrance on?"
    },
    {
      "id": "p04-c-21-s06",
      "speaker": "Nico",
      "text": "The left, just after the fountain."
    },
    {
      "id": "p04-c-21-s07",
      "speaker": "Petra",
      "text": "Thanks. I'll go that way and meet the guide at two."
    }
  ],
