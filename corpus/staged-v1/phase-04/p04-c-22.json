{
  "id": "p04-c-22",
  "title_zh": "安排携行李旅客接送",
  "topic_id": "travel",
  "scenario": {
    "id": "nervous-traveller-transfer",
    "label_zh": "安排携行李旅客接送",
    "goal_zh": "说明肩部受伤带来的行李搬运需求，核对上车及通行条件并约定接送时间"
  },
  "participants": [
    "Gareth",
    "Rina"
  ],
  "context_zh": "一位肩部受伤的旅客向旅馆工作人员询问带行李前往车站的接送安排。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-22-s01",
      "speaker": "Gareth",
      "text": "Do you offer help for a traveller with a shoulder injury? I have two heavy bags."
    },
    {
      "id": "p04-c-22-s02",
      "speaker": "Rina",
      "text": "Yes. We can transport you and your bags to the station in our small van."
    },
    {
      "id": "p04-c-22-s03",
      "speaker": "Gareth",
      "text": "Is the vehicle easy to get into? I can walk, but I cannot lift the bags."
    },
    {
      "id": "p04-c-22-s04",
      "speaker": "Rina",
      "text": "It has a wide sliding door. Come and look before you decide. I'll carry the bags."
    },
    {
      "id": "p04-c-22-s05",
      "speaker": "Gareth",
      "text": "Are there any stairs between this desk and the pickup point?"
    },
    {
      "id": "p04-c-22-s06",
      "speaker": "Rina",
      "text": "No, it's level all the way out of the side entrance."
    },
    {
      "id": "p04-c-22-s07",
      "speaker": "Gareth",
      "text": "I've seen the van through the window. That should work for me. I'll bring my bags to the desk at ten."
    },
    {
      "id": "p04-c-22-s08",
      "speaker": "Rina",
      "text": "Ten is fine. I'll arrange for the driver to meet you here."
    }
  ],
