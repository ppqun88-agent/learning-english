{
  "id": "p04-c-23",
  "title_zh": "制定小组学习任务目标",
  "topic_id": "learning",
  "scenario": {
    "id": "study-task-target-plan",
    "label_zh": "制定小组学习任务目标",
    "goal_zh": "把宽泛的学习目标分成可执行任务并约定先试一种策略"
  },
  "participants": [
    "Mei",
    "Oscar"
  ],
  "context_zh": "两名同学把一周的学习目标拆成短时段，并明确如何判断自己是否真正理解。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-23-s01",
      "speaker": "Mei",
      "text": "What's our target for this week?"
    },
    {
      "id": "p04-c-23-s02",
      "speaker": "Oscar",
      "text": "To finish chapter six, but that's such a big task after work."
    },
    {
      "id": "p04-c-23-s03",
      "speaker": "Mei",
      "text": "My first thought was to split it over five evenings."
    },
    {
      "id": "p04-c-23-s04",
      "speaker": "Oscar",
      "text": "I suppose we could, but we both work late on Tuesday. What's your suggestion for that day?"
    },
    {
      "id": "p04-c-23-s05",
      "speaker": "Mei",
      "text": "Let's leave Tuesday free. A better strategy might be three short sessions and one review on Sunday."
    },
    {
      "id": "p04-c-23-s06",
      "speaker": "Oscar",
      "text": "I like your thinking. What would a successful week look like, apart from getting through the pages?"
    },
    {
      "id": "p04-c-23-s07",
      "speaker": "Mei",
      "text": "If we can each explain the three main ideas without the book, we'll know we've understood them."
    },
    {
      "id": "p04-c-23-s08",
      "speaker": "Oscar",
      "text": "Then let's take one idea per session. I think we can succeed if we keep each session short."
    },
    {
      "id": "p04-c-23-s09",
      "speaker": "Mei",
      "text": "Agreed. We'll start with the first idea tonight and test ourselves on Sunday."
    }
  ],
