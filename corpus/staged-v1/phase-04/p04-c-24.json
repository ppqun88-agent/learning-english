{
  "id": "p04-c-24",
  "title_zh": "安排青少年课程活动",
  "topic_id": "learning",
  "scenario": {
    "id": "teenage-class-planning",
    "label_zh": "安排青少年课程活动",
    "goal_zh": "根据学期进度调整教学单元并给学生独立完成的空间"
  },
  "participants": [
    "David",
    "Salma"
  ],
  "context_zh": "两位教师商量下一个教学单元，为青少年学生安排更多独立活动。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-24-s01",
      "speaker": "David",
      "text": "How is the teaching going with your teenage students?"
    },
    {
      "id": "p04-c-24-s02",
      "speaker": "Salma",
      "text": "Better this term. They talk more when I give them time to work together."
    },
    {
      "id": "p04-c-24-s03",
      "speaker": "David",
      "text": "What's in the next unit?"
    },
    {
      "id": "p04-c-24-s04",
      "speaker": "Salma",
      "text": "Planning a short radio programme. I was going to choose all the topics."
    },
    {
      "id": "p04-c-24-s05",
      "speaker": "David",
      "text": "Could they choose the topics themselves? That might give them more reason to speak."
    },
    {
      "id": "p04-c-24-s06",
      "speaker": "Salma",
      "text": "Yes. I'll give them three broad options, then let each group decide and plan its own programme."
    }
  ],
