{
  "id": "p04-c-25",
  "title_zh": "按新喜好挑选生日服饰礼物",
  "topic_id": "relationships",
  "scenario": {
    "id": "birthday-outfit-gift",
    "label_zh": "按新喜好挑选生日服饰礼物",
    "goal_zh": "核对收礼人穿衣习惯的变化并决定礼物和包装方式"
  },
  "participants": [
    "Emilia",
    "Dylan"
  ],
  "context_zh": "兄妹商量给父亲的生日礼物，发现他的着装习惯已经改变，改选他现在会用的物品。",
  "author": "author-phase04-c",
  "sentences": [
    {
      "id": "p04-c-25-s01",
      "speaker": "Emilia",
      "text": "I'd like Dad's gift to be a surprise. What about a tie for his grey suit?"
    },
    {
      "id": "p04-c-25-s02",
      "speaker": "Dylan",
      "text": "He used to wear ties every day, but he hasn't worn one since he changed jobs."
    },
    {
      "id": "p04-c-25-s03",
      "speaker": "Emilia",
      "text": "I was surprised to see him in that bright yellow shirt last week."
    },
    {
      "id": "p04-c-25-s04",
      "speaker": "Dylan",
      "text": "He loves it. Maybe a casual shirt would be more useful than another tie."
    },
    {
      "id": "p04-c-25-s05",
      "speaker": "Emilia",
      "text": "Good point. I'll choose a green one in the same style and have it wrapped."
    },
    {
      "id": "p04-c-25-s06",
      "speaker": "Dylan",
      "text": "Great. I'll check the size on his yellow shirt so you don't have to guess."
    }
  ],
