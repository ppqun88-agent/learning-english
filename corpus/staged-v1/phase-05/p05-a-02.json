{
  "id": "p05-a-02",
  "title_zh": "分好洗衣与厨房清洁工作",
  "topic_id": "home",
  "scenario": {
    "id": "shared-house-cleanup",
    "label_zh": "分配合租房清洁工作",
    "goal_zh": "明确待清洁区域和离开房间前的操作"
  },
  "participants": [
    "Nadia",
    "Felix"
  ],
  "context_zh": "两名室友打算出门前完成洗衣和厨房清洁，先确认分工。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-02-s01",
      "speaker": "Nadia",
      "text": "Can you hang out the washing while I clean the kitchen?"
    },
    {
      "id": "p05-a-02-s02",
      "speaker": "Felix",
      "text": "Sure. Is everything in the machine ready to come out?"
    },
    {
      "id": "p05-a-02-s03",
      "speaker": "Nadia",
      "text": "Yes, but hang the red towel on its own. It is still dripping."
    },
    {
      "id": "p05-a-02-s04",
      "speaker": "Felix",
      "text": "All right. Do you need this cloth for the counter?"
    },
    {
      "id": "p05-a-02-s05",
      "speaker": "Nadia",
      "text": "Yes, please. I need to wipe the whole counter. The blue cloth is for the floor."
    },
    {
      "id": "p05-a-02-s06",
      "speaker": "Felix",
      "text": "The washing is outside now. Shall I leave the machine door open?"
    },
    {
      "id": "p05-a-02-s07",
      "speaker": "Nadia",
      "text": "Please do, and turn off the kitchen light when you leave."
    },
    {
      "id": "p05-a-02-s08",
      "speaker": "Felix",
      "text": "Done. I will meet you by the front door."
    }
  ],
