{
  "id": "p05-a-04",
  "title_zh": "先拆底座再搬柜子",
  "topic_id": "home",
  "scenario": {
    "id": "cabinet-moving-plan",
    "label_zh": "协作搬动柜子",
    "goal_zh": "核对通道尺寸并协调柜子移动和暂放位置"
  },
  "participants": [
    "Marta",
    "Leon"
  ],
  "context_zh": "室友测量旧柜子和门口，商量如何让柜子通过狭窄入口。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-04-s01",
      "speaker": "Marta",
      "text": "This cabinet is too wide to get through the doorway like this."
    },
    {
      "id": "p05-a-04-s02",
      "speaker": "Leon",
      "text": "Can we turn it on its side?"
    },
    {
      "id": "p05-a-04-s03",
      "speaker": "Marta",
      "text": "Not with those wooden feet sticking out. Do you know its weight?"
    },
    {
      "id": "p05-a-04-s04",
      "speaker": "Leon",
      "text": "About thirty kilos without the shelves. The base comes off, though."
    },
    {
      "id": "p05-a-04-s05",
      "speaker": "Marta",
      "text": "Good. Let us take that part off rather than pull the whole cabinet apart."
    },
    {
      "id": "p05-a-04-s06",
      "speaker": "Leon",
      "text": "I will remove the shelves and the base first. Can you clear the shoes from the doorway?"
    },
    {
      "id": "p05-a-04-s07",
      "speaker": "Marta",
      "text": "Yes. Then we can carry it sideways and put it against the empty wall."
    },
    {
      "id": "p05-a-04-s08",
      "speaker": "Leon",
      "text": "Agreed. We will move it together once the path is clear."
    }
  ],
