{
  "id": "p05-a-07",
  "title_zh": "挑选婚礼相册里的照片",
  "topic_id": "relationships",
  "scenario": {
    "id": "wedding-photo-album-plan",
    "label_zh": "挑选婚礼相册照片",
    "goal_zh": "按婚礼流程选出相册照片并约定摄影师提供版面草稿"
  },
  "participants": [
    "Aisha",
    "Tom"
  ],
  "context_zh": "新婚的朋友与摄影师一起选相册照片，决定保留仪式和庆祝的不同瞬间。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-07-s01",
      "speaker": "Aisha",
      "text": "Wow, I had not seen this photo of everyone dancing!"
    },
    {
      "id": "p05-a-07-s02",
      "speaker": "Tom",
      "text": "It is my favourite from your wedding. You look so cheerful."
    },
    {
      "id": "p05-a-07-s03",
      "speaker": "Aisha",
      "text": "I was. By then I could stop thinking about being the bride and just enjoy the party."
    },
    {
      "id": "p05-a-07-s04",
      "speaker": "Tom",
      "text": "Would you like it at the front of the album?"
    },
    {
      "id": "p05-a-07-s05",
      "speaker": "Aisha",
      "text": "My one wish is to tell the story of the day in order. Can we start with the ceremony?"
    },
    {
      "id": "p05-a-07-s06",
      "speaker": "Tom",
      "text": "Yes. This picture of you exchanging rings would make a strong opening."
    },
    {
      "id": "p05-a-07-s07",
      "speaker": "Aisha",
      "text": "Then the family photo, and the dancing at the end. That shows the whole celebration."
    },
    {
      "id": "p05-a-07-s08",
      "speaker": "Tom",
      "text": "What about the formal picture beside the car?"
    },
    {
      "id": "p05-a-07-s09",
      "speaker": "Aisha",
      "text": "Leave it out. I would rather have the one where my grandmother is laughing."
    },
    {
      "id": "p05-a-07-s10",
      "speaker": "Tom",
      "text": "Done. I will arrange those four sections and send you the layout tomorrow."
    }
  ],
