{
  "id": "p05-a-08",
  "title_zh": "向护士说明不适并配合检查",
  "topic_id": "health",
  "scenario": {
    "id": "clinic-examination-cooperation",
    "label_zh": "配合诊所护士检查",
    "goal_zh": "说明身体不适并理解检查期间的要求。"
  },
  "participants": [
    "Evan",
    "Nurse Park"
  ],
  "context_zh": "虚构诊所里，一位患者已经向前台报告不适，护士正在当面检查；对话仅练习就诊沟通。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-08-s01",
      "speaker": "Evan",
      "text": "I feel weak, and there is a tight feeling in my chest."
    },
    {
      "id": "p05-a-08-s02",
      "speaker": "Nurse Park",
      "text": "I am going to stay with you while the doctor comes over. Has your breathing changed?"
    },
    {
      "id": "p05-a-08-s03",
      "speaker": "Evan",
      "text": "Yes. I feel as if I cannot take a full breath."
    },
    {
      "id": "p05-a-08-s04",
      "speaker": "Nurse Park",
      "text": "Thank you for telling me. Did that start today?"
    },
    {
      "id": "p05-a-08-s05",
      "speaker": "Evan",
      "text": "About half an hour ago. I am worried because it has not stopped."
    },
    {
      "id": "p05-a-08-s06",
      "speaker": "Nurse Park",
      "text": "I understand. I need to check your oxygen level with this small device on your finger."
    },
    {
      "id": "p05-a-08-s07",
      "speaker": "Evan",
      "text": "Do I have to breathe in a special way?"
    },
    {
      "id": "p05-a-08-s08",
      "speaker": "Nurse Park",
      "text": "No, just breathe normally while I take the reading. The doctor is on the way."
    },
    {
      "id": "p05-a-08-s09",
      "speaker": "Evan",
      "text": "All right. I feel a little more calm knowing someone is here."
    }
  ],
