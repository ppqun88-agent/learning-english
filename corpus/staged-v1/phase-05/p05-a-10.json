{
  "id": "p05-a-10",
  "title_zh": "排练后认领有标记的帽子",
  "topic_id": "leisure",
  "scenario": {
    "id": "rehearsal-cap-return",
    "label_zh": "归还排练后遗留的帽子",
    "goal_zh": "凭帽子内侧标记核实归属并交还物主"
  },
  "participants": [
    "Diego",
    "Molly"
  ],
  "context_zh": "演员收拾排练室时，用帽子内侧的彩色缝线辨认物主。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-10-s01",
      "speaker": "Diego",
      "text": "Whose cap is this? It was under the piano."
    },
    {
      "id": "p05-a-10-s02",
      "speaker": "Molly",
      "text": "It might be mine. Is there any colored thread inside the back?"
    },
    {
      "id": "p05-a-10-s03",
      "speaker": "Diego",
      "text": "Yes, a little red cross. So it is yours?"
    },
    {
      "id": "p05-a-10-s04",
      "speaker": "Molly",
      "text": "Yes. I sewed that in so I could tell it from the others."
    },
    {
      "id": "p05-a-10-s05",
      "speaker": "Diego",
      "text": "Here you are. I nearly put it in the costume box."
    },
    {
      "id": "p05-a-10-s06",
      "speaker": "Molly",
      "text": "Thanks. I will put it in my bag before we leave."
    }
  ],
