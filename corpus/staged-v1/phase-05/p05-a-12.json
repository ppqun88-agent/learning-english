{
  "id": "p05-a-12",
  "title_zh": "选择课程期间的住宿并核对抵达安排",
  "topic_id": "travel",
  "scenario": {
    "id": "course-stay-price-and-arrival",
    "label_zh": "核对短期课程住宿并预订",
    "goal_zh": "比较住宿总价，核对取消条款和抵达时间后确认预订"
  },
  "participants": [
    "Priya",
    "Travel agent"
  ],
  "context_zh": "学员通过旅行代理了解三晚住宿的总价和取消条件，选择可负担的房间。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-12-s01",
      "speaker": "Priya",
      "text": "I need accommodation for three nights near the language school. I can afford up to three hundred pounds in total."
    },
    {
      "id": "p05-a-12-s02",
      "speaker": "Travel agent",
      "text": "The guesthouse is two hundred and ten. The hotel next door is three hundred and sixty."
    },
    {
      "id": "p05-a-12-s03",
      "speaker": "Priya",
      "text": "Does the cheaper room have its own bathroom?"
    },
    {
      "id": "p05-a-12-s04",
      "speaker": "Travel agent",
      "text": "Yes. As your agent, I can send you the full booking agreement before you decide."
    },
    {
      "id": "p05-a-12-s05",
      "speaker": "Priya",
      "text": "I have it open now. What does this clause about cancellation mean for my booking?"
    },
    {
      "id": "p05-a-12-s06",
      "speaker": "Travel agent",
      "text": "It says you can cancel without a charge until noon two days before arrival. After that, the first night is charged."
    },
    {
      "id": "p05-a-12-s07",
      "speaker": "Priya",
      "text": "That is clear. My train gets in at six, so I should reach the guesthouse at approximately half past six."
    },
    {
      "id": "p05-a-12-s08",
      "speaker": "Travel agent",
      "text": "Reception is open until nine. Shall I reserve the guesthouse room?"
    },
    {
      "id": "p05-a-12-s09",
      "speaker": "Priya",
      "text": "Yes, please. It is within my budget, and the arrival time works."
    },
    {
      "id": "p05-a-12-s10",
      "speaker": "Travel agent",
      "text": "Your room is reserved. I will send the confirmation to the same email address."
    }
  ],
