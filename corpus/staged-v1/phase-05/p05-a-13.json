{
  "id": "p05-a-13",
  "title_zh": "重新上传课程申请附件并确认提交",
  "topic_id": "learning",
  "scenario": {
    "id": "course-application-upload-support",
    "label_zh": "协助提交课程申请附件",
    "goal_zh": "解决附件未上传的问题，提交课程申请并确认收到自动回执"
  },
  "participants": [
    "Malik",
    "Course administrator"
  ],
  "context_zh": "申请人联系课程办公室，解决文件未附上的问题并确认收到了提交回执。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-13-s01",
      "speaker": "Malik",
      "text": "My application is ready, but the page says there is no document attached."
    },
    {
      "id": "p05-a-13-s02",
      "speaker": "Course administrator",
      "text": "Are you signed into your own account?"
    },
    {
      "id": "p05-a-13-s03",
      "speaker": "Malik",
      "text": "Yes. I can see my name at the top."
    },
    {
      "id": "p05-a-13-s04",
      "speaker": "Course administrator",
      "text": "Click the paperclip beside the qualifications box, then choose the file. That will attach it to this form."
    },
    {
      "id": "p05-a-13-s05",
      "speaker": "Malik",
      "text": "I see the filename now. Do I need to email another copy to the administration office?"
    },
    {
      "id": "p05-a-13-s06",
      "speaker": "Course administrator",
      "text": "No. Once you submit the form, our system sends an automatic confirmation."
    },
    {
      "id": "p05-a-13-s07",
      "speaker": "Malik",
      "text": "I have pressed Submit. The page says the application has been received."
    },
    {
      "id": "p05-a-13-s08",
      "speaker": "Course administrator",
      "text": "Check your inbox. The receipt should arrive automatically within a minute."
    },
    {
      "id": "p05-a-13-s09",
      "speaker": "Malik",
      "text": "There it is, with the reference number. Thank you for helping me finish it."
    }
  ],
