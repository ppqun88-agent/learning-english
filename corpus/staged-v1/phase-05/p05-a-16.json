{
  "id": "p05-a-16",
  "title_zh": "依据规则处理答题比赛资格",
  "topic_id": "leisure",
  "scenario": {
    "id": "quiz-prize-eligibility-check",
    "label_zh": "核对答题比赛的获奖资格",
    "goal_zh": "参赛者承认违规使用答案并交回奖券，主持人确认撤销资格及复核其余成绩"
  },
  "participants": [
    "Leo",
    "Quiz host"
  ],
  "context_zh": "虚构社区答题赛结束后，参赛者向主持人承认看到答案，双方依据规则处理名次。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-16-s01",
      "speaker": "Leo",
      "text": "Before you name the winner, I need to admit something. I saw an answer on my phone."
    },
    {
      "id": "p05-a-16-s02",
      "speaker": "Quiz host",
      "text": "Did you open the answer page during the round?"
    },
    {
      "id": "p05-a-16-s03",
      "speaker": "Leo",
      "text": "Yes. At first I thought I was only checking a message, but then I used the answer."
    },
    {
      "id": "p05-a-16-s04",
      "speaker": "Quiz host",
      "text": "That is not just careless. Using outside help breaks the rules."
    },
    {
      "id": "p05-a-16-s05",
      "speaker": "Leo",
      "text": "I know. I did cheat, and I should not keep the prize."
    },
    {
      "id": "p05-a-16-s06",
      "speaker": "Quiz host",
      "text": "I appreciate you telling me now. Your entry cannot count in the individual category."
    },
    {
      "id": "p05-a-16-s07",
      "speaker": "Leo",
      "text": "Will Ana become the champion, then?"
    },
    {
      "id": "p05-a-16-s08",
      "speaker": "Quiz host",
      "text": "She has the highest eligible score, yes. I will check the scores with the other judge before announcing it."
    },
    {
      "id": "p05-a-16-s09",
      "speaker": "Leo",
      "text": "She solved that final challenge without any help. I admire how carefully she works through a problem."
    },
    {
      "id": "p05-a-16-s10",
      "speaker": "Quiz host",
      "text": "It was a real achievement. We will credit her result, not turn this into a story about you."
    },
    {
      "id": "p05-a-16-s11",
      "speaker": "Leo",
      "text": "Understood. I will return the prize voucher now."
    },
    {
      "id": "p05-a-16-s12",
      "speaker": "Quiz host",
      "text": "Thank you. I will record your withdrawal and finish checking the scores."
    }
  ],
