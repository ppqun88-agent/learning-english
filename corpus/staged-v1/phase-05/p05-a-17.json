{
  "id": "p05-a-17",
  "title_zh": "为夜间电视噪声道歉并关机",
  "topic_id": "home",
  "scenario": {
    "id": "late-night-television-noise",
    "label_zh": "协商夜间电视音量",
    "goal_zh": "说明噪声影响并商定当天停止观看"
  },
  "participants": [
    "Nell",
    "Patrick"
  ],
  "context_zh": "一位室友被持续的电视音量打扰，另一位同意今晚停止观看。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-17-s01",
      "speaker": "Nell",
      "text": "Could we talk about the television? I am getting annoyed because I can hear every word in my room."
    },
    {
      "id": "p05-a-17-s02",
      "speaker": "Patrick",
      "text": "Sorry. I did not mean to annoy you. I thought the volume was low enough."
    },
    {
      "id": "p05-a-17-s03",
      "speaker": "Nell",
      "text": "The dialogue is not too bad, but the music gets much louder. That is the annoying part."
    },
    {
      "id": "p05-a-17-s04",
      "speaker": "Patrick",
      "text": "I understand. I apologize for keeping you awake."
    },
    {
      "id": "p05-a-17-s05",
      "speaker": "Nell",
      "text": "Would you mind switching it off for tonight? I have an early start."
    },
    {
      "id": "p05-a-17-s06",
      "speaker": "Patrick",
      "text": "Absolutely. I will finish the programme tomorrow."
    },
    {
      "id": "p05-a-17-s07",
      "speaker": "Nell",
      "text": "I appreciate that. Thank you."
    },
    {
      "id": "p05-a-17-s08",
      "speaker": "Patrick",
      "text": "It is off now. Good night."
    }
  ],
