{
  "id": "p05-a-19",
  "title_zh": "调整合影位置后拍照",
  "topic_id": "leisure",
  "scenario": {
    "id": "group-portrait-position-adjustment",
    "label_zh": "调整合影站位",
    "goal_zh": "让前排人物后退以露出其他人，并完成合影拍摄"
  },
  "participants": [
    "Photographer",
    "Jonah"
  ],
  "context_zh": "摄影师让站在最前面的人稍向后移，使朋友们都能入镜。",
  "author": "author-phase05-a",
  "sentences": [
    {
      "id": "p05-a-19-s01",
      "speaker": "Photographer",
      "text": "Jonah, could you move backward a little? You are hiding the person beside you."
    },
    {
      "id": "p05-a-19-s02",
      "speaker": "Jonah",
      "text": "Like this, or farther back?"
    },
    {
      "id": "p05-a-19-s03",
      "speaker": "Photographer",
      "text": "That is enough. Now turn slightly toward the others."
    },
    {
      "id": "p05-a-19-s04",
      "speaker": "Jonah",
      "text": "Can you see everyone now?"
    },
    {
      "id": "p05-a-19-s05",
      "speaker": "Photographer",
      "text": "Yes. Hold that position and look at the camera."
    },
    {
      "id": "p05-a-19-s06",
      "speaker": "Jonah",
      "text": "Ready."
    },
    {
      "id": "p05-a-19-s07",
      "speaker": "Photographer",
      "text": "Got it. Everyone is in the picture this time."
    }
  ],
