{
  "id": "p05-b-01",
  "title_zh": "选浅黄色棉布窗帘",
  "topic_id": "home",
  "scenario": {
    "id": "curtain-colour-fabric-choice",
    "label_zh": "比较窗帘材质与配色",
    "goal_zh": "比较窗帘的材质、透光性和颜色后选定样品。"
  },
  "participants": [
    "Inez",
    "Harper"
  ],
  "context_zh": "顾客希望保留房间采光，店员帮助比较窗帘布料。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-01-s01",
      "speaker": "Inez",
      "text": "I want a coloured curtain rather than another white one."
    },
    {
      "id": "p05-b-01-s02",
      "speaker": "Harper",
      "text": "Do you want it to block the light completely?"
    },
    {
      "id": "p05-b-01-s03",
      "speaker": "Inez",
      "text": "No. I like reading beside that window in the afternoon."
    },
    {
      "id": "p05-b-01-s04",
      "speaker": "Harper",
      "text": "This one is made of cotton. It lets more light through than the thick polyester one."
    },
    {
      "id": "p05-b-01-s05",
      "speaker": "Inez",
      "text": "Would the yellow look odd against my blue wall?"
    },
    {
      "id": "p05-b-01-s06",
      "speaker": "Harper",
      "text": "There would be a strong contrast, but the pale yellow is softer than this orange."
    },
    {
      "id": "p05-b-01-s07",
      "speaker": "Inez",
      "text": "The pale yellow cotton is the one I want. Can I take a sample home?"
    },
    {
      "id": "p05-b-01-s08",
      "speaker": "Harper",
      "text": "Of course. Check it against the wall in daylight before you order."
    }
  ],
