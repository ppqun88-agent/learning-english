{
  "id": "p05-b-03",
  "title_zh": "选择费用明确的印刷报价",
  "topic_id": "work",
  "scenario": {
    "id": "supplier-price-comparison",
    "label_zh": "比较供应商报价",
    "goal_zh": "比较印刷报价中的运费和预算风险后选定供应商。"
  },
  "participants": [
    "Naomi",
    "Ellis"
  ],
  "context_zh": "活动组织者比较两家印刷公司的书面报价。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-03-s01",
      "speaker": "Naomi",
      "text": "Have you finished the comparison of the two printing quotes?"
    },
    {
      "id": "p05-b-03-s02",
      "speaker": "Ellis",
      "text": "Yes. Our usual supplier charges four hundred pounds, including delivery."
    },
    {
      "id": "p05-b-03-s03",
      "speaker": "Naomi",
      "text": "And its competitor?"
    },
    {
      "id": "p05-b-03-s04",
      "speaker": "Ellis",
      "text": "Three hundred and fifty, but delivery is extra and they cannot price it yet."
    },
    {
      "id": "p05-b-03-s05",
      "speaker": "Naomi",
      "text": "That sounds competitive until we add the missing cost."
    },
    {
      "id": "p05-b-03-s06",
      "speaker": "Ellis",
      "text": "Exactly. Our budget is tight, so an unknown charge is a financial risk."
    },
    {
      "id": "p05-b-03-s07",
      "speaker": "Naomi",
      "text": "Is the first quote a fixed price, even if their delivery costs rise?"
    },
    {
      "id": "p05-b-03-s08",
      "speaker": "Ellis",
      "text": "Yes. They confirmed that in writing."
    },
    {
      "id": "p05-b-03-s09",
      "speaker": "Naomi",
      "text": "Then use our usual supplier. Certainty matters more than a possible saving this time."
    }
  ],
