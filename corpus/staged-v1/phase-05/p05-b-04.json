{
  "id": "p05-b-04",
  "title_zh": "报名节庆上午班",
  "topic_id": "community",
  "scenario": {
    "id": "festival-volunteer-shift",
    "label_zh": "报名节庆志愿班次",
    "goal_zh": "选择合适班次并确认报名资料"
  },
  "participants": [
    "Leah",
    "Omar"
  ],
  "context_zh": "志愿者向协调员确认能够承担的节庆班次及报名方式。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-04-s01",
      "speaker": "Leah",
      "text": "I can help at the festival, but I cannot commit to the whole weekend."
    },
    {
      "id": "p05-b-04-s02",
      "speaker": "Omar",
      "text": "Would Saturday from nine to twelve work?"
    },
    {
      "id": "p05-b-04-s03",
      "speaker": "Leah",
      "text": "Yes, I can give you a definite answer for that shift: I am available."
    },
    {
      "id": "p05-b-04-s04",
      "speaker": "Omar",
      "text": "Good. Your main duty will be to welcome visitors at the west gate."
    },
    {
      "id": "p05-b-04-s05",
      "speaker": "Leah",
      "text": "Who should I contact if the gate gets too busy?"
    },
    {
      "id": "p05-b-04-s06",
      "speaker": "Omar",
      "text": "Call me on the volunteer radio. Clear communication matters when several groups arrive together."
    },
    {
      "id": "p05-b-04-s07",
      "speaker": "Leah",
      "text": "Do you need anything else from me to sign up?"
    },
    {
      "id": "p05-b-04-s08",
      "speaker": "Omar",
      "text": "Just your name and email on this form. Then I will send your shift confirmation."
    },
    {
      "id": "p05-b-04-s09",
      "speaker": "Leah",
      "text": "Here is the completed form. I will be at the west gate before nine."
    }
  ],
