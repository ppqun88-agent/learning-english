{
  "id": "p05-b-06",
  "title_zh": "先把复杂题目拆成三步",
  "topic_id": "learning",
  "scenario": {
    "id": "study-task-target-plan",
    "label_zh": "制定小组学习任务目标",
    "goal_zh": "把宽泛的学习目标分成可执行任务并约定先试一种策略"
  },
  "participants": [
    "Sana",
    "Joel"
  ],
  "context_zh": "两名同学商量如何利用晚上的时间复习一道复杂的数学题。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-06-s01",
      "speaker": "Sana",
      "text": "This problem is so complex that I do not know where to begin."
    },
    {
      "id": "p05-b-06-s02",
      "speaker": "Joel",
      "text": "Which part is giving you difficulty?"
    },
    {
      "id": "p05-b-06-s03",
      "speaker": "Sana",
      "text": "I am confused about the two diagrams. I keep treating them as the same shape."
    },
    {
      "id": "p05-b-06-s04",
      "speaker": "Joel",
      "text": "The similar labels can confuse anyone. Let us redraw them on separate pages."
    },
    {
      "id": "p05-b-06-s05",
      "speaker": "Sana",
      "text": "Then I can concentrate on one shape at a time."
    },
    {
      "id": "p05-b-06-s06",
      "speaker": "Joel",
      "text": "Yes. To use our time effectively, we should identify the shapes, list the measurements, and only then calculate."
    },
    {
      "id": "p05-b-06-s07",
      "speaker": "Sana",
      "text": "Let us try that order on this problem before doing the others."
    },
    {
      "id": "p05-b-06-s08",
      "speaker": "Joel",
      "text": "All right. You draw the first shape, and I will check its labels with you."
    }
  ],
