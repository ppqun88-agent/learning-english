{
  "id": "p05-b-08",
  "title_zh": "先核对印刷样稿再确认交付",
  "topic_id": "work",
  "scenario": {
    "id": "project-delivery",
    "label_zh": "协调项目交付",
    "goal_zh": "澄清依赖、范围、风险与承诺"
  },
  "participants": [
    "Priya",
    "Leon"
  ],
  "context_zh": "设计负责人和印刷协调员讨论手册交付前的文件检查与时间风险。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-08-s01",
      "speaker": "Priya",
      "text": "The brochures are due on Friday. Is that still your expected delivery date?"
    },
    {
      "id": "p05-b-08-s02",
      "speaker": "Leon",
      "text": "It is, provided we approve the proof today. The current file has an old telephone number."
    },
    {
      "id": "p05-b-08-s03",
      "speaker": "Priya",
      "text": "I am currently correcting that. Can we determine whether the printer has started the job?"
    },
    {
      "id": "p05-b-08-s04",
      "speaker": "Leon",
      "text": "They have not. They are waiting for our approval."
    },
    {
      "id": "p05-b-08-s05",
      "speaker": "Priya",
      "text": "Good. What would be the consequence of approving it tomorrow instead?"
    },
    {
      "id": "p05-b-08-s06",
      "speaker": "Leon",
      "text": "They could not promise Friday. The delivery might move to Monday."
    },
    {
      "id": "p05-b-08-s07",
      "speaker": "Priya",
      "text": "Then I will send the corrected file by two. Please check the number before approving it."
    },
    {
      "id": "p05-b-08-s08",
      "speaker": "Leon",
      "text": "I will. Once it is approved, they can deliver the boxes to reception on Friday morning."
    },
    {
      "id": "p05-b-08-s09",
      "speaker": "Priya",
      "text": "I will tell reception to expect them, but only after you confirm the printer has accepted the schedule."
    },
    {
      "id": "p05-b-08-s10",
      "speaker": "Leon",
      "text": "Agreed. I will check the proof and get their confirmation this afternoon."
    }
  ],
