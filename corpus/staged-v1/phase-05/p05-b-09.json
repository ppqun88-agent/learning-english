{
  "id": "p05-b-09",
  "title_zh": "核对玉米面包的配方",
  "topic_id": "food",
  "scenario": {
    "id": "cornbread-cooking-method",
    "label_zh": "核对玉米面包制作方法",
    "goal_zh": "澄清配方中的粉类和鲜玉米用法并分工准备面糊。"
  },
  "participants": [
    "Tess",
    "Amir"
  ],
  "context_zh": "两名室友准备照着家传食谱做玉米面包。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-09-s01",
      "speaker": "Tess",
      "text": "Does this bread consist entirely of cornmeal?"
    },
    {
      "id": "p05-b-09-s02",
      "speaker": "Amir",
      "text": "No. The recipe also uses wheat flour, eggs, milk, and butter."
    },
    {
      "id": "p05-b-09-s03",
      "speaker": "Tess",
      "text": "I have some cooked corn in the pan. Can we add a few kernels?"
    },
    {
      "id": "p05-b-09-s04",
      "speaker": "Amir",
      "text": "Yes, but drain them first so the mixture does not become too wet."
    },
    {
      "id": "p05-b-09-s05",
      "speaker": "Tess",
      "text": "Should I combine the dry ingredients in this bowl?"
    },
    {
      "id": "p05-b-09-s06",
      "speaker": "Amir",
      "text": "Please do. I will mix the eggs and milk in the jug."
    },
    {
      "id": "p05-b-09-s07",
      "speaker": "Tess",
      "text": "And what is this container for?"
    },
    {
      "id": "p05-b-09-s08",
      "speaker": "Amir",
      "text": "The leftover corn. Put the lid on and keep it in the fridge."
    },
    {
      "id": "p05-b-09-s09",
      "speaker": "Tess",
      "text": "Got it. I will drain the corn, put half away, and start on the dry ingredients."
    }
  ],
