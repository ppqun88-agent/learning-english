{
  "id": "p05-b-14",
  "title_zh": "核对探险出发前的装备",
  "topic_id": "leisure",
  "scenario": {
    "id": "guided-expedition-departure-check",
    "label_zh": "核对带队探险出发安排",
    "goal_zh": "确认领队经验、出发时间与装备检查后前往集合点。"
  },
  "participants": [
    "Aiden",
    "Soraya"
  ],
  "context_zh": "参加者在游客中心为一项有向导带队的洞穴考察做最后确认。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-14-s01",
      "speaker": "Aiden",
      "text": "Is the expedition still going ahead despite the rain?"
    },
    {
      "id": "p05-b-14-s02",
      "speaker": "Soraya",
      "text": "Yes. The guide has checked the route. If conditions change, she will cancel it."
    },
    {
      "id": "p05-b-14-s03",
      "speaker": "Aiden",
      "text": "Good. I have never been inside a cave before."
    },
    {
      "id": "p05-b-14-s04",
      "speaker": "Soraya",
      "text": "She is an experienced guide, and this is the introductory route. What is worrying you?"
    },
    {
      "id": "p05-b-14-s05",
      "speaker": "Aiden",
      "text": "Mostly the equipment. Is a helmet essential?"
    },
    {
      "id": "p05-b-14-s06",
      "speaker": "Soraya",
      "text": "Yes. The guide will fit it and check it before departure at ten."
    },
    {
      "id": "p05-b-14-s07",
      "speaker": "Aiden",
      "text": "Should I fasten the strap now?"
    },
    {
      "id": "p05-b-14-s08",
      "speaker": "Soraya",
      "text": "Wait until she has adjusted it for you. Take your helmet to the marked meeting point."
    },
    {
      "id": "p05-b-14-s09",
      "speaker": "Aiden",
      "text": "All right. I will go there now and ask her to check the fit."
    }
  ],
