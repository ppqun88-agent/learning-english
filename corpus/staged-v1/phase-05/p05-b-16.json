{
  "id": "p05-b-16",
  "title_zh": "为家庭观看改选纪录片集数",
  "topic_id": "leisure",
  "scenario": {
    "id": "documentary-family-viewing-choice",
    "label_zh": "选择适合共同观看的纪录片集数",
    "goal_zh": "了解纪录片中的战争画面后改选没有战斗内容的集数。"
  },
  "participants": [
    "Nadia",
    "Hugo"
  ],
  "context_zh": "两位家长决定晚上的家庭观看内容，不根据片名直接判断适合程度。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-16-s01",
      "speaker": "Nadia",
      "text": "Shall we watch that historical documentary with the family tonight?"
    },
    {
      "id": "p05-b-16-s02",
      "speaker": "Hugo",
      "text": "Which episode? The first one shows a lot of fighting."
    },
    {
      "id": "p05-b-16-s03",
      "speaker": "Nadia",
      "text": "I thought it was mainly about how people rebuilt the town."
    },
    {
      "id": "p05-b-16-s04",
      "speaker": "Hugo",
      "text": "That is the second one. In the first, villagers escape before the enemy arrives."
    },
    {
      "id": "p05-b-16-s05",
      "speaker": "Nadia",
      "text": "Does it show what happens to the people who stay?"
    },
    {
      "id": "p05-b-16-s06",
      "speaker": "Hugo",
      "text": "Yes. The soldiers are cruel to them, and I found those scenes hard to watch."
    },
    {
      "id": "p05-b-16-s07",
      "speaker": "Nadia",
      "text": "Then I would rather not choose that one for tonight. Have you seen the second?"
    },
    {
      "id": "p05-b-16-s08",
      "speaker": "Hugo",
      "text": "I have. It follows families repairing their homes, with no battle scenes."
    },
    {
      "id": "p05-b-16-s09",
      "speaker": "Nadia",
      "text": "Let us watch that one together and leave the first for another time."
    }
  ],
