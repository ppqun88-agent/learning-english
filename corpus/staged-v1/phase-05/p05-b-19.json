{
  "id": "p05-b-19",
  "title_zh": "约好周五去看摄影展",
  "topic_id": "leisure",
  "scenario": {
    "id": "museum-evening-invitation",
    "label_zh": "相约参观晚间展览",
    "goal_zh": "确认展览内容、入场费用和会合时间后约定参观。"
  },
  "participants": [
    "Jules",
    "Anika"
  ],
  "context_zh": "朋友邀请同伴看一场记录城市变化的摄影展。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-19-s01",
      "speaker": "Jules",
      "text": "Do you fancy going to the photography exhibition on Friday?"
    },
    {
      "id": "p05-b-19-s02",
      "speaker": "Anika",
      "text": "What is it about?"
    },
    {
      "id": "p05-b-19-s03",
      "speaker": "Jules",
      "text": "The city over the last decade. The photographer took a picture from the same bridge every month."
    },
    {
      "id": "p05-b-19-s04",
      "speaker": "Anika",
      "text": "That sounds fascinating. We could see exactly when the old factory disappeared."
    },
    {
      "id": "p05-b-19-s05",
      "speaker": "Jules",
      "text": "Yes. There has been a lot of excitement about the final picture, but I have avoided the online previews."
    },
    {
      "id": "p05-b-19-s06",
      "speaker": "Anika",
      "text": "How much is entry?"
    },
    {
      "id": "p05-b-19-s07",
      "speaker": "Jules",
      "text": "Eight pounds, and it stays open until eight on Fridays."
    },
    {
      "id": "p05-b-19-s08",
      "speaker": "Anika",
      "text": "Then let us meet outside at six. I want enough time to compare the pictures."
    },
    {
      "id": "p05-b-19-s09",
      "speaker": "Jules",
      "text": "Six it is. We can buy our tickets at the door."
    }
  ],
