{
  "id": "p05-b-21",
  "title_zh": "凭钻石和刻字领回戒指",
  "topic_id": "services",
  "scenario": {
    "id": "lost-ring-identification",
    "label_zh": "描述并认领遗失戒指",
    "goal_zh": "凭外观和刻字核实遗失戒指的归属并领取"
  },
  "participants": [
    "Audrey",
    "Malik"
  ],
  "context_zh": "失主在场馆失物招领处描述订婚戒指并核实内侧刻字。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-21-s01",
      "speaker": "Audrey",
      "text": "I lost a ring here yesterday. It has a single diamond and a narrow gold band."
    },
    {
      "id": "p05-b-21-s02",
      "speaker": "Malik",
      "text": "We have one that matches that description. Is there anything written inside?"
    },
    {
      "id": "p05-b-21-s03",
      "speaker": "Audrey",
      "text": "Yes. It says Leo and Audrey, followed by the date we got engaged."
    },
    {
      "id": "p05-b-21-s04",
      "speaker": "Malik",
      "text": "May I examine the inside under this light? The writing is very small."
    },
    {
      "id": "p05-b-21-s05",
      "speaker": "Audrey",
      "text": "Of course. The date is the third of May, twenty twenty-two."
    },
    {
      "id": "p05-b-21-s06",
      "speaker": "Malik",
      "text": "That matches. Does the pattern beside the names look familiar?"
    },
    {
      "id": "p05-b-21-s07",
      "speaker": "Audrey",
      "text": "Yes, it is a tiny leaf. I doubt another ring would have exactly the same names, date, and leaf."
    },
    {
      "id": "p05-b-21-s08",
      "speaker": "Malik",
      "text": "Those details match our record. Please sign the collection slip, and the ring is yours."
    },
    {
      "id": "p05-b-21-s09",
      "speaker": "Audrey",
      "text": "Done. Thank you for keeping it safe."
    }
  ],
