{
  "id": "p05-b-28",
  "title_zh": "先索取工程职业工作坊的报名链接",
  "topic_id": "learning",
  "scenario": {
    "id": "engineering-career-workshop-inquiry",
    "label_zh": "了解工程职业入门工作坊",
    "goal_zh": "核对工作坊的教育目的、参加背景和内容后索取报名链接。"
  },
  "participants": [
    "Helena",
    "Owen"
  ],
  "context_zh": "一位受过其他专业教育的成年人询问图书馆举办的工程职业工作坊。",
  "author": "author-phase05-b",
  "sentences": [
    {
      "id": "p05-b-28-s01",
      "speaker": "Helena",
      "text": "Do I need experience in engineering to attend this workshop?"
    },
    {
      "id": "p05-b-28-s02",
      "speaker": "Owen",
      "text": "No. It is part of our career development programme for adults considering a change."
    },
    {
      "id": "p05-b-28-s03",
      "speaker": "Helena",
      "text": "I am well educated, but my degree is in history. Would the technical material be beyond me?"
    },
    {
      "id": "p05-b-28-s04",
      "speaker": "Owen",
      "text": "The aim is to educate people about different kinds of engineering work, not to test technical knowledge."
    },
    {
      "id": "p05-b-28-s05",
      "speaker": "Helena",
      "text": "I want to expand my understanding before I apply for anything."
    },
    {
      "id": "p05-b-28-s06",
      "speaker": "Owen",
      "text": "Then it should suit you. There will be a simple design activity and a conversation with two engineers."
    },
    {
      "id": "p05-b-28-s07",
      "speaker": "Helena",
      "text": "Does the session include information about employment opportunities?"
    },
    {
      "id": "p05-b-28-s08",
      "speaker": "Owen",
      "text": "It explains entry routes, but it is an educational event, not a recruitment interview."
    },
    {
      "id": "p05-b-28-s09",
      "speaker": "Helena",
      "text": "That is exactly what I need. Please send me the registration link."
    },
    {
      "id": "p05-b-28-s10",
      "speaker": "Owen",
      "text": "Here it is. You can choose the morning or afternoon session when you register."
    }
  ],
