{
  "id": "p05-c-01",
  "title_zh": "先量好位置再挂照片",
  "topic_id": "home",
  "scenario": {
    "id": "picture-hanging-placement",
    "label_zh": "确定挂画位置与固定材料",
    "goal_zh": "测量相框和墙面后确定挂画位置，并先选合适挂钩再动工"
  },
  "participants": [
    "Noah",
    "Ada"
  ],
  "context_zh": "诺亚和艾达想把一张合影挂在沙发上方。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-01-s01",
      "speaker": "Noah",
      "text": "Would this frame look better above the sofa or beside the door?"
    },
    {
      "id": "p05-c-01-s02",
      "speaker": "Ada",
      "text": "Above the sofa, I think. Can you hold it there for a moment?"
    },
    {
      "id": "p05-c-01-s03",
      "speaker": "Noah",
      "text": "Like this? I want to hang it low enough for everyone to see."
    },
    {
      "id": "p05-c-01-s04",
      "speaker": "Ada",
      "text": "A little higher. Let me measure the space above the cushions."
    },
    {
      "id": "p05-c-01-s05",
      "speaker": "Noah",
      "text": "The length of the frame is sixty centimetres, so it should fit."
    },
    {
      "id": "p05-c-01-s06",
      "speaker": "Ada",
      "text": "It fits, but that little nail is not meant for something this heavy."
    },
    {
      "id": "p05-c-01-s07",
      "speaker": "Noah",
      "text": "Then we should find the right hook before making a hole."
    },
    {
      "id": "p05-c-01-s08",
      "speaker": "Ada",
      "text": "Agreed. I will mark this position lightly, and we can take the frame details to the shop."
    }
  ],
