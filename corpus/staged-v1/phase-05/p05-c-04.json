{
  "id": "p05-c-04",
  "title_zh": "确定民间音乐会的开场",
  "topic_id": "leisure",
  "scenario": {
    "id": "folk-concert-opening-plan",
    "label_zh": "安排民间音乐会开场",
    "goal_zh": "确定开场曲目与介绍方式，并安排观众集合和主持人到位"
  },
  "participants": [
    "Leila",
    "Ivan"
  ],
  "context_zh": "乐手伊万和主持人莱拉在演出前核对开场安排。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-04-s01",
      "speaker": "Leila",
      "text": "As the host, should I introduce every musician before the first song?"
    },
    {
      "id": "p05-c-04-s02",
      "speaker": "Ivan",
      "text": "Just introduce the group. We will explain the instruments after we play."
    },
    {
      "id": "p05-c-04-s03",
      "speaker": "Leila",
      "text": "Which song are you opening with?"
    },
    {
      "id": "p05-c-04-s04",
      "speaker": "Ivan",
      "text": "A folk song that my grandmother taught me. It has passed from one generation to the next in our family."
    },
    {
      "id": "p05-c-04-s05",
      "speaker": "Leila",
      "text": "That story could be a lovely highlight of the evening."
    },
    {
      "id": "p05-c-04-s06",
      "speaker": "Ivan",
      "text": "I will tell it briefly before the second song. When should we gather backstage?"
    },
    {
      "id": "p05-c-04-s07",
      "speaker": "Leila",
      "text": "At half past six. I will ask the audience to take their seats at twenty to seven."
    },
    {
      "id": "p05-c-04-s08",
      "speaker": "Ivan",
      "text": "Perfect. We will be ready when you introduce us."
    }
  ],
