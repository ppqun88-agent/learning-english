{
  "id": "p05-c-05",
  "title_zh": "为失约道歉并重新约见",
  "topic_id": "relationships",
  "scenario": {
    "id": "friend-apology-and-reconnection",
    "label_zh": "向朋友道歉并重新安排见面",
    "goal_zh": "承认失约及其影响，澄清彼此感受并约定下一次见面"
  },
  "participants": [
    "Dan",
    "Mei"
  ],
  "context_zh": "丹因为临时忘记约定而让朋友梅等候，现在主动解释。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-05-s01",
      "speaker": "Dan",
      "text": "I owe you an apology for leaving you waiting yesterday."
    },
    {
      "id": "p05-c-05-s02",
      "speaker": "Mei",
      "text": "I was mad because you did not answer my messages. I thought something had happened."
    },
    {
      "id": "p05-c-05-s03",
      "speaker": "Dan",
      "text": "I feel guilty about that. I lost track of time, and that is not a good excuse."
    },
    {
      "id": "p05-c-05-s04",
      "speaker": "Mei",
      "text": "I would rather you be honest than invent a reason."
    },
    {
      "id": "p05-c-05-s05",
      "speaker": "Dan",
      "text": "Our friendship matters to me. Could I make it up to you with lunch on Saturday?"
    },
    {
      "id": "p05-c-05-s06",
      "speaker": "Mei",
      "text": "Lunch would be nice. Can we meet at twelve at the usual cafe?"
    },
    {
      "id": "p05-c-05-s07",
      "speaker": "Dan",
      "text": "Yes. I will put it in my calendar now, and let you know early if anything changes."
    },
    {
      "id": "p05-c-05-s08",
      "speaker": "Mei",
      "text": "Thanks. I am glad we talked about it."
    }
  ],
