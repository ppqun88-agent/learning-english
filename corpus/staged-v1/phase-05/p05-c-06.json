{
  "id": "p05-c-06",
  "title_zh": "今晚选一部不吓人的电影",
  "topic_id": "leisure",
  "scenario": {
    "id": "friends-film-night",
    "label_zh": "商定朋友电影之夜",
    "goal_zh": "兼顾时间与喜好选定影片"
  },
  "participants": [
    "Anna",
    "Jack"
  ],
  "context_zh": "朋友安娜和杰克在晚饭后挑选今晚一起看的电影。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-06-s01",
      "speaker": "Anna",
      "text": "We have time for one film before ten. What about The Old House?"
    },
    {
      "id": "p05-c-06-s02",
      "speaker": "Jack",
      "text": "Is that the one with a ghost in the bathroom?"
    },
    {
      "id": "p05-c-06-s03",
      "speaker": "Anna",
      "text": "Yes. The trailer looks frightening, but people say the ending is funny."
    },
    {
      "id": "p05-c-06-s04",
      "speaker": "Jack",
      "text": "I do not enjoy horror. I was frightened for hours after the last film you chose."
    },
    {
      "id": "p05-c-06-s05",
      "speaker": "Anna",
      "text": "Sorry, I do not want to frighten you again. We can choose something else."
    },
    {
      "id": "p05-c-06-s06",
      "speaker": "Jack",
      "text": "Thanks. I had a horrible day at work, and I would rather laugh tonight."
    },
    {
      "id": "p05-c-06-s07",
      "speaker": "Anna",
      "text": "How about the comedy with the two lost tourists? It is only ninety minutes."
    },
    {
      "id": "p05-c-06-s08",
      "speaker": "Jack",
      "text": "That sounds much better. Let us watch that one."
    }
  ],
