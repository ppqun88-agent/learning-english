{
  "id": "p05-c-07",
  "title_zh": "分工煮汤并保存多余份量",
  "topic_id": "food",
  "scenario": {
    "id": "soup-cooking-and-portioning",
    "label_zh": "分工煮汤并安排剩余份量",
    "goal_zh": "确定汤的配料、调味与口感，分配烹饪工作并约定保存多余份量"
  },
  "participants": [
    "Beth",
    "Andy"
  ],
  "context_zh": "安迪和贝丝查看食谱，准备今晚的豌豆汤。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-07-s01",
      "speaker": "Beth",
      "text": "This recipe serves six, but there are only three of us tonight."
    },
    {
      "id": "p05-c-07-s02",
      "speaker": "Andy",
      "text": "We can freeze the extra portions for another evening."
    },
    {
      "id": "p05-c-07-s03",
      "speaker": "Beth",
      "text": "Good. The vegetables are mainly peas, with one onion and a potato."
    },
    {
      "id": "p05-c-07-s04",
      "speaker": "Andy",
      "text": "We have frozen peas. Do I add them at the beginning?"
    },
    {
      "id": "p05-c-07-s05",
      "speaker": "Beth",
      "text": "Not yet. First, I will fry the onion while you cut the potato."
    },
    {
      "id": "p05-c-07-s06",
      "speaker": "Andy",
      "text": "How much liquid does the recipe call for?"
    },
    {
      "id": "p05-c-07-s07",
      "speaker": "Beth",
      "text": "A litre of stock. Then we cook the vegetables until they are soft."
    },
    {
      "id": "p05-c-07-s08",
      "speaker": "Andy",
      "text": "Would you like me to mix in the cream at the end?"
    },
    {
      "id": "p05-c-07-s09",
      "speaker": "Beth",
      "text": "Yes, but only half of it. I want a thick mixture, not a thin soup."
    },
    {
      "id": "p05-c-07-s10",
      "speaker": "Andy",
      "text": "What about this chilli powder?"
    },
    {
      "id": "p05-c-07-s11",
      "speaker": "Beth",
      "text": "Let us keep the soup mild. You can add some to your own bowl."
    },
    {
      "id": "p05-c-07-s12",
      "speaker": "Andy",
      "text": "Done. I will start on the potato and set out three bowls and containers for the rest."
    }
  ],
