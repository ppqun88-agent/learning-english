{
  "id": "p05-c-08",
  "title_zh": "约好送车检查异响",
  "topic_id": "services",
  "scenario": {
    "id": "garage-engine-noise-booking",
    "label_zh": "预约检查汽车异响",
    "goal_zh": "描述驾驶中的异响并确认送检及反馈时间"
  },
  "participants": [
    "Harry",
    "Priya"
  ],
  "context_zh": "哈里打电话给修车厂，描述汽车最近的异常。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-08-s01",
      "speaker": "Harry",
      "text": "Is this Green Street garage? I would like to book a check for my car."
    },
    {
      "id": "p05-c-08-s02",
      "speaker": "Priya",
      "text": "Yes. What seems to be the issue?"
    },
    {
      "id": "p05-c-08-s03",
      "speaker": "Harry",
      "text": "There is a rattling noise when I accelerate, and it is happening more frequently now."
    },
    {
      "id": "p05-c-08-s04",
      "speaker": "Priya",
      "text": "Have you noticed any other changes?"
    },
    {
      "id": "p05-c-08-s05",
      "speaker": "Harry",
      "text": "There is a loss of power on hills, and I seem to be using more fuel than usual."
    },
    {
      "id": "p05-c-08-s06",
      "speaker": "Priya",
      "text": "We will need to inspect it before we can explain the cause. Can you bring it in at nine tomorrow?"
    },
    {
      "id": "p05-c-08-s07",
      "speaker": "Harry",
      "text": "Yes. Will someone call me before doing any repair work?"
    },
    {
      "id": "p05-c-08-s08",
      "speaker": "Priya",
      "text": "Of course. We will call you by noon with what we find and a price before going ahead."
    },
    {
      "id": "p05-c-08-s09",
      "speaker": "Harry",
      "text": "Thank you. I will bring it in at nine."
    }
  ],
