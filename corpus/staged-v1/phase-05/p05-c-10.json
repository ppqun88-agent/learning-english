{
  "id": "p05-c-10",
  "title_zh": "为进口货物延误调整备货",
  "topic_id": "work",
  "scenario": {
    "id": "imported-stock-delay-plan",
    "label_zh": "商定进口货物延误的应对安排",
    "goal_zh": "核实延误对店铺的影响，并决定询问本地替代品报价及更新预计到货通知"
  },
  "participants": [
    "Asha",
    "Ben"
  ],
  "context_zh": "一家小店的采购员和店长讨论供应商发来的延误通知；情节虚构。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-10-s01",
      "speaker": "Asha",
      "text": "The supplier says our goods will arrive two weeks late."
    },
    {
      "id": "p05-c-10-s02",
      "speaker": "Ben",
      "text": "Is that just our shipment, or is there a wider problem?"
    },
    {
      "id": "p05-c-10-s03",
      "speaker": "Asha",
      "text": "They describe it as a global shipping delay, but we only know the date for our own order."
    },
    {
      "id": "p05-c-10-s04",
      "speaker": "Ben",
      "text": "We import all our large baskets from them. What is the impact on next week's display?"
    },
    {
      "id": "p05-c-10-s05",
      "speaker": "Asha",
      "text": "We have enough small baskets, but only two large ones left."
    },
    {
      "id": "p05-c-10-s06",
      "speaker": "Ben",
      "text": "Then let us ask the local maker for a small batch rather than promise stock we do not have."
    },
    {
      "id": "p05-c-10-s07",
      "speaker": "Asha",
      "text": "I agree. This shows the importance of having a second supplier."
    },
    {
      "id": "p05-c-10-s08",
      "speaker": "Ben",
      "text": "Please get a local quote today. I will update the display notice with the new expected date."
    }
  ],
