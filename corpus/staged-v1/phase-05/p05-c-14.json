{
  "id": "p05-c-14",
  "title_zh": "只改变水量的种子实验",
  "topic_id": "learning",
  "scenario": {
    "id": "seed-trial-design",
    "label_zh": "制定种子生长对照实验",
    "goal_zh": "只改变浇水量并约定观察记录方式"
  },
  "participants": [
    "Tara",
    "Niko"
  ],
  "context_zh": "两名学生在教师指定的实验室里计划小麦种子的生长观察。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-14-s01",
      "speaker": "Tara",
      "text": "We have two identical pots ready in the laboratory. What will we change between them?"
    },
    {
      "id": "p05-c-14-s02",
      "speaker": "Niko",
      "text": "Only the amount of water. Each pot will get one grain of wheat from the same packet."
    },
    {
      "id": "p05-c-14-s03",
      "speaker": "Tara",
      "text": "And the soil must be the same in both. Shall we cover each seed with a thin layer of it?"
    },
    {
      "id": "p05-c-14-s04",
      "speaker": "Niko",
      "text": "Yes, the same depth in each pot. We will keep them beside the same window."
    },
    {
      "id": "p05-c-14-s05",
      "speaker": "Tara",
      "text": "How will we record growth?"
    },
    {
      "id": "p05-c-14-s06",
      "speaker": "Niko",
      "text": "Measure the height every morning and write it in our journal, along with the amount of water."
    },
    {
      "id": "p05-c-14-s07",
      "speaker": "Tara",
      "text": "Should we also record when the first leaf appears?"
    },
    {
      "id": "p05-c-14-s08",
      "speaker": "Niko",
      "text": "Definitely. But one taller plant would not indicate that our result applies to all wheat."
    },
    {
      "id": "p05-c-14-s09",
      "speaker": "Tara",
      "text": "Then we will call this a small trial and include that limit in the report."
    },
    {
      "id": "p05-c-14-s10",
      "speaker": "Niko",
      "text": "Agreed. I will label the pots, and you can prepare the record sheet before we plant."
    }
  ],
