{
  "id": "p05-c-23",
  "title_zh": "核对悬疑剧角色再继续排练",
  "topic_id": "leisure",
  "scenario": {
    "id": "mystery-scene-rehearsal",
    "label_zh": "排练悬疑剧片段",
    "goal_zh": "澄清虚构案件的角色关系并确定继续排练的位置。"
  },
  "participants": [
    "Hugo",
    "Lena"
  ],
  "context_zh": "导演和演员排练一部虚构的法庭悬疑剧，讨论剧情而非真实案件。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-23-s01",
      "speaker": "Hugo",
      "text": "Before we start, why does my character investigate the murder herself? Is she a detective?"
    },
    {
      "id": "p05-c-23-s02",
      "speaker": "Lena",
      "text": "Yes. I play the judge, and you are the detective called to explain the evidence."
    },
    {
      "id": "p05-c-23-s03",
      "speaker": "Hugo",
      "text": "Does the audience see the killing?"
    },
    {
      "id": "p05-c-23-s04",
      "speaker": "Lena",
      "text": "No, it happens before the play begins. They hear about it through the witnesses."
    },
    {
      "id": "p05-c-23-s05",
      "speaker": "Hugo",
      "text": "And I already know that Peter is innocent?"
    },
    {
      "id": "p05-c-23-s06",
      "speaker": "Lena",
      "text": "You believe he is, but you have not found the missing letter that proves where he was."
    },
    {
      "id": "p05-c-23-s07",
      "speaker": "Hugo",
      "text": "So I should sound certain about Peter, but not explain the whole mystery yet."
    },
    {
      "id": "p05-c-23-s08",
      "speaker": "Lena",
      "text": "Exactly. Let us begin again at the point where the judge asks you about the letter."
    },
    {
      "id": "p05-c-23-s09",
      "speaker": "Hugo",
      "text": "Ready. I will wait for your question before I approach the table."
    }
  ],
