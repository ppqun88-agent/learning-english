{
  "id": "p05-c-25",
  "title_zh": "先试办一次小型维修工作坊",
  "topic_id": "work",
  "scenario": {
    "id": "workshop-pilot-resource-agreement",
    "label_zh": "商定工作坊试办资源",
    "goal_zh": "根据时间、人员和场地限制缩小试办范围，并明确预算上限和筹备分工"
  },
  "participants": [
    "Grace",
    "Omar"
  ],
  "context_zh": "两名志愿者准备在社区中心试办一次物品维修工作坊。",
  "author": "author-phase05-c",
  "sentences": [
    {
      "id": "p05-c-25-s01",
      "speaker": "Grace",
      "text": "Do you intend to run this every weekend? I cannot give up that much time."
    },
    {
      "id": "p05-c-25-s02",
      "speaker": "Omar",
      "text": "No. My intention is to try one Saturday session and see whether people find it useful."
    },
    {
      "id": "p05-c-25-s03",
      "speaker": "Grace",
      "text": "In that case, I would like to stay involved. I can help with the bookings."
    },
    {
      "id": "p05-c-25-s04",
      "speaker": "Omar",
      "text": "Thanks. How much time could you invest in preparing the first session?"
    },
    {
      "id": "p05-c-25-s05",
      "speaker": "Grace",
      "text": "Two hours this week. Our bigger problem is the lack of storage space for equipment."
    },
    {
      "id": "p05-c-25-s06",
      "speaker": "Omar",
      "text": "Then let us borrow tools on the day rather than buy anything we have to keep here."
    },
    {
      "id": "p05-c-25-s07",
      "speaker": "Grace",
      "text": "That also helps with the budget. We have a limit of fifty pounds for this trial."
    },
    {
      "id": "p05-c-25-s08",
      "speaker": "Omar",
      "text": "Agreed. I will ask the tool library about borrowing, and you can prepare a booking list for ten places."
    },
    {
      "id": "p05-c-25-s09",
      "speaker": "Grace",
      "text": "I will do that tonight. We can check the arrangements together before we advertise."
    }
  ],
