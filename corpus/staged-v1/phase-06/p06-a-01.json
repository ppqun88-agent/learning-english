{
  "id": "p06-a-01",
  "title_zh": "选一本适合讨论双重视角的小说",
  "topic_id": "leisure",
  "scenario": {
    "id": "reading-group-book-choice",
    "label_zh": "选择读书小组作品",
    "goal_zh": "比较故事题材与讨论安排后选定共读作品"
  },
  "participants": [
    "Mara",
    "Ivo"
  ],
  "context_zh": "读书小组成员玛拉和伊沃正在选择下个月的共读作品；书名及情节均为虚构。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-01-s01",
      "speaker": "Mara",
      "text": "Do you have a recommendation for our next reading-group book?"
    },
    {
      "id": "p06-a-01-s02",
      "speaker": "Ivo",
      "text": "The Night Ferry. Its narrative moves between a mother and her adult son."
    },
    {
      "id": "p06-a-01-s03",
      "speaker": "Mara",
      "text": "Is the plot hard to follow?"
    },
    {
      "id": "p06-a-01-s04",
      "speaker": "Ivo",
      "text": "Not really. It's about their search for a missing letter, rather than a complicated mystery."
    },
    {
      "id": "p06-a-01-s05",
      "speaker": "Mara",
      "text": "Personally, I'd prefer that to another crime novel. Is it a long book?"
    },
    {
      "id": "p06-a-01-s06",
      "speaker": "Ivo",
      "text": "Only 180 pages. I found the ending powerful, especially when the son finally reads the letter."
    },
    {
      "id": "p06-a-01-s07",
      "speaker": "Mara",
      "text": "Then let's read that. We can discuss the two viewpoints at our meeting on the last Thursday."
    },
    {
      "id": "p06-a-01-s08",
      "speaker": "Ivo",
      "text": "Agreed. I'll put the title and date in our group message."
    }
  ],
