{
  "id": "p06-a-02",
  "title_zh": "请朋友帮忙缝回纽扣",
  "topic_id": "home",
  "scenario": {
    "id": "shirt-button-sewing-help",
    "label_zh": "请同伴指导缝回纽扣",
    "goal_zh": "确认纽扣位置与针线工具，并约定先在碎布上练习再处理衬衫"
  },
  "participants": [
    "Ada",
    "Jo"
  ],
  "context_zh": "艾达想保留一件旧衬衫，请会缝纫的朋友乔帮忙处理掉落的纽扣。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-02-s01",
      "speaker": "Ada",
      "text": "Can you help me sew this button back on? I want to keep the shirt."
    },
    {
      "id": "p06-a-02-s02",
      "speaker": "Jo",
      "text": "Of course. I like these old-fashioned buttons. Where did this one come off?"
    },
    {
      "id": "p06-a-02-s03",
      "speaker": "Ada",
      "text": "The cuff. The tailor left a pin where the button should go."
    },
    {
      "id": "p06-a-02-s04",
      "speaker": "Jo",
      "text": "Good, we have the position. I'll remove that and thread a needle."
    },
    {
      "id": "p06-a-02-s05",
      "speaker": "Ada",
      "text": "My stitches never look neat. Could I watch you do the first few?"
    },
    {
      "id": "p06-a-02-s06",
      "speaker": "Jo",
      "text": "Yes. Then you can try. Don't pull the thread too tight or the button won't sit properly."
    },
    {
      "id": "p06-a-02-s07",
      "speaker": "Ada",
      "text": "Let's practise on this scrap of cloth first. I don't want to spoil the cuff."
    },
    {
      "id": "p06-a-02-s08",
      "speaker": "Jo",
      "text": "Good idea. I'll show you here before we touch the shirt."
    }
  ],
