{
  "id": "p06-a-04",
  "title_zh": "为能源展示区分预测与证据",
  "topic_id": "reasoning",
  "scenario": {
    "id": "classroom-energy-claim-revision",
    "label_zh": "修订课堂能源展示的证据表述",
    "goal_zh": "区分历史数据与预测，承认相关关系不等于因果，并约定修订图表标题和说明"
  },
  "participants": [
    "Noah",
    "Sami"
  ],
  "context_zh": "诺亚向同学萨米展示课堂报告草稿；两人讨论的图表和国家均为虚构教学材料。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-04-s01",
      "speaker": "Noah",
      "text": "Could you check this slide for my presentation on nuclear energy?"
    },
    {
      "id": "p06-a-04-s02",
      "speaker": "Sami",
      "text": "Your chart shows energy prices for two years. Why does the title say that a new power station will lower bills?"
    },
    {
      "id": "p06-a-04-s03",
      "speaker": "Noah",
      "text": "Prices fell in the year after it opened. I thought that would prove my point."
    },
    {
      "id": "p06-a-04-s04",
      "speaker": "Sami",
      "text": "Not necessarily. Other things could have changed in the same year."
    },
    {
      "id": "p06-a-04-s05",
      "speaker": "Noah",
      "text": "So I can describe the relation between the two events, but not say that one caused the other?"
    },
    {
      "id": "p06-a-04-s06",
      "speaker": "Sami",
      "text": "Exactly. And your figure for next year is a prediction, not a recorded price."
    },
    {
      "id": "p06-a-04-s07",
      "speaker": "Noah",
      "text": "I'll label it clearly and change the title to a question about prices."
    },
    {
      "id": "p06-a-04-s08",
      "speaker": "Sami",
      "text": "That works. Put the possible alternative explanations underneath the chart too."
    },
    {
      "id": "p06-a-04-s09",
      "speaker": "Noah",
      "text": "I will. Then the slide will show what we know and what still needs checking."
    }
  ],
