{
  "id": "p06-a-05",
  "title_zh": "选一条安静的观鸟步道",
  "topic_id": "nature",
  "scenario": {
    "id": "guided-bird-walk-route",
    "label_zh": "选择安静的湖边观鸟路线",
    "goal_zh": "按观鸟兴趣选定步道及停留位置，并确认不离开小径靠近鸟巢"
  },
  "participants": [
    "Erin",
    "Ben"
  ],
  "context_zh": "游客埃琳向自然公园向导本咨询短程观鸟路线。鸟种和公园场景为虚构。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-05-s01",
      "speaker": "Erin",
      "text": "I'd like to spend an hour outdoors, somewhere away from the playground."
    },
    {
      "id": "p06-a-05-s02",
      "speaker": "Ben",
      "text": "Try the path along the northern edge of the lake. It is usually peaceful in the morning."
    },
    {
      "id": "p06-a-05-s03",
      "speaker": "Erin",
      "text": "Are the small brown birds near that path native to this area?"
    },
    {
      "id": "p06-a-05-s04",
      "speaker": "Ben",
      "text": "Yes. They nest here every spring. You might also see a rare visitor, but I would not count on it."
    },
    {
      "id": "p06-a-05-s05",
      "speaker": "Erin",
      "text": "The ordinary lake birds are enough for me. Can I leave the path to get a closer photograph?"
    },
    {
      "id": "p06-a-05-s06",
      "speaker": "Ben",
      "text": "Please stay on it and use your zoom. The reeds beside it contain nests."
    },
    {
      "id": "p06-a-05-s07",
      "speaker": "Erin",
      "text": "Understood. I'll take the lake path and watch from a distance."
    },
    {
      "id": "p06-a-05-s08",
      "speaker": "Ben",
      "text": "Here it is on the map. The bench halfway along gives you a clear view."
    }
  ],
