{
  "id": "p06-a-06",
  "title_zh": "借好初次羽毛球体验的器材",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-badminton-equipment",
    "label_zh": "确认初学羽毛球器材与集合点",
    "goal_zh": "确认可借用的球拍归属，并约定到指定球网旁等待教练"
  },
  "participants": [
    "Kai",
    "Ruth"
  ],
  "context_zh": "初次参加社区羽毛球体验的凯前来问器材借用，教练鲁思指引他加入初学组。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-06-s01",
      "speaker": "Kai",
      "text": "Is this the queue for the beginner session?"
    },
    {
      "id": "p06-a-06-s02",
      "speaker": "Ruth",
      "text": "Yes. Have you brought a racket?"
    },
    {
      "id": "p06-a-06-s03",
      "speaker": "Kai",
      "text": "Neither my sister nor I own one. Can we borrow two?"
    },
    {
      "id": "p06-a-06-s04",
      "speaker": "Ruth",
      "text": "Certainly. Choose from that basket. The rackets with blue handles are ours; the red ones belong to another club."
    },
    {
      "id": "p06-a-06-s05",
      "speaker": "Kai",
      "text": "Thanks. Should we start at the court by the door?"
    },
    {
      "id": "p06-a-06-s06",
      "speaker": "Ruth",
      "text": "Use the court at the far end. Its net is already up. I'll meet you there after you collect the rackets."
    },
    {
      "id": "p06-a-06-s07",
      "speaker": "Kai",
      "text": "All right. We'll take two blue-handled ones and wait at the far court."
    }
  ],
