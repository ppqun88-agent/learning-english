{
  "id": "p06-a-08",
  "title_zh": "给户外工作坊留好雨天方案",
  "topic_id": "community",
  "scenario": {
    "id": "outdoor-workshop-rain-plan",
    "label_zh": "分工准备户外工作坊雨天方案",
    "goal_zh": "确认室内备用场地，并约定场地决定时间及搬运和通知分工"
  },
  "participants": [
    "Diane",
    "Omar"
  ],
  "context_zh": "社区活动组织者黛安和志愿者奥马尔讨论周六工作坊，尚未发布最终场地通知。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-08-s01",
      "speaker": "Diane",
      "text": "I'm the organizer of Saturday's outdoor workshop. Could you help with the rain plan?"
    },
    {
      "id": "p06-a-08-s02",
      "speaker": "Omar",
      "text": "Certainly. How many people want to participate?"
    },
    {
      "id": "p06-a-08-s03",
      "speaker": "Diane",
      "text": "Twelve so far, possibly a few more. The hall can take twenty."
    },
    {
      "id": "p06-a-08-s04",
      "speaker": "Omar",
      "text": "Then we should be prepared for everyone to move inside. Is the hall definitely available?"
    },
    {
      "id": "p06-a-08-s05",
      "speaker": "Diane",
      "text": "Yes, I have the key. The planning is nearly finished, but I haven't assigned anyone to contact the group."
    },
    {
      "id": "p06-a-08-s06",
      "speaker": "Omar",
      "text": "I can do that. You are very organized with the equipment, so why don't you handle moving it?"
    },
    {
      "id": "p06-a-08-s07",
      "speaker": "Diane",
      "text": "That works. I'll decide on the venue at eight on Saturday and call you."
    },
    {
      "id": "p06-a-08-s08",
      "speaker": "Omar",
      "text": "Then I'll send the group the final location. Until that call, I won't tell them that we're moving indoors."
    }
  ],
