{
  "id": "p06-a-11",
  "title_zh": "先试拍一张轻松的肖像照",
  "topic_id": "leisure",
  "scenario": {
    "id": "portrait-session-comfort-plan",
    "label_zh": "调整肖像试拍方式以减轻紧张",
    "goal_zh": "照顾被拍者的紧张感，商定先边聊天边试拍一张并共同查看"
  },
  "participants": [
    "Dean",
    "Ines"
  ],
  "context_zh": "业余摄影师伊内丝为朋友迪恩拍摄个人肖像，迪恩不习惯面对镜头。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-11-s01",
      "speaker": "Dean",
      "text": "I need a portrait for my music-club profile, but I always freeze in front of a camera."
    },
    {
      "id": "p06-a-11-s02",
      "speaker": "Ines",
      "text": "You don't have to stare at the lens. We can start with you sitting by the window."
    },
    {
      "id": "p06-a-11-s03",
      "speaker": "Dean",
      "text": "Do you work as a photographer now?"
    },
    {
      "id": "p06-a-11-s04",
      "speaker": "Ines",
      "text": "No, photography is still a hobby. I have a passion for it, though, especially pictures of people I know."
    },
    {
      "id": "p06-a-11-s05",
      "speaker": "Dean",
      "text": "That makes me feel better. Please tell me if my smile looks forced."
    },
    {
      "id": "p06-a-11-s06",
      "speaker": "Ines",
      "text": "I will. Just tell me about your last concert and let yourself smile naturally."
    },
    {
      "id": "p06-a-11-s07",
      "speaker": "Dean",
      "text": "Talking about music might help me feel more relaxed. Can we check the first picture together?"
    },
    {
      "id": "p06-a-11-s08",
      "speaker": "Ines",
      "text": "Absolutely. We'll take one test shot by the window, look at it, and change anything you dislike."
    },
    {
      "id": "p06-a-11-s09",
      "speaker": "Dean",
      "text": "Great. I'll sit here and tell you about the drummer who forgot his sticks."
    }
  ],
