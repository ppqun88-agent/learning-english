{
  "id": "p06-a-12",
  "title_zh": "为读诗晚会选择开场作品和引文",
  "topic_id": "leisure",
  "scenario": {
    "id": "poetry-reading-selection",
    "label_zh": "安排读诗晚会开场与节目引文",
    "goal_zh": "选定开场诗作，取得作者对短引文的同意，并确认出处信息和朗读分工"
  },
  "participants": [
    "Wen",
    "Felix"
  ],
  "context_zh": "社区读诗活动主持人温与受邀诗人费利克斯准备节目。作品《River Windows》是此虚构场景中的诗人原创。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-12-s01",
      "speaker": "Wen",
      "text": "You're our guest poet on Thursday. Which piece would you like to read first?"
    },
    {
      "id": "p06-a-12-s02",
      "speaker": "Felix",
      "text": "River Windows. It is a short poem from my new booklet, and it is a pleasure to read aloud."
    },
    {
      "id": "p06-a-12-s03",
      "speaker": "Wen",
      "text": "That sounds right for a poetry evening with several first-time visitors. Could I quote two lines in the programme?"
    },
    {
      "id": "p06-a-12-s04",
      "speaker": "Felix",
      "text": "Yes, use the opening two lines. They give people the setting without giving away the ending."
    },
    {
      "id": "p06-a-12-s05",
      "speaker": "Wen",
      "text": "Should the quotation have the title underneath it?"
    },
    {
      "id": "p06-a-12-s06",
      "speaker": "Felix",
      "text": "Please add a full reference: my name, the title, and page four of the booklet."
    },
    {
      "id": "p06-a-12-s07",
      "speaker": "Wen",
      "text": "I'll do that. I'll introduce you, and then you can read the whole piece."
    },
    {
      "id": "p06-a-12-s08",
      "speaker": "Felix",
      "text": "Agreed. I'll bring my marked copy so I can begin straight after the introduction."
    }
  ],
