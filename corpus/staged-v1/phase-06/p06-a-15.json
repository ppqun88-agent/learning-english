{
  "id": "p06-a-15",
  "title_zh": "先询问港口附近的小屋",
  "topic_id": "travel",
  "scenario": {
    "id": "coastal-cottage-choice",
    "label_zh": "比较海边小屋并询问住宿条件",
    "goal_zh": "根据无车出行需求比较两处房源，选定先询问港口附近小屋的短住与噪音条件"
  },
  "participants": [
    "Nadia",
    "Ellis"
  ],
  "context_zh": "纳迪娅和艾利斯比较两个虚构的海边小屋，希望度过无需开车的短假期。",
  "author": "author-phase06-a",
  "sentences": [
    {
      "id": "p06-a-15-s01",
      "speaker": "Nadia",
      "text": "Which cottage should we ask about for our weekend away?"
    },
    {
      "id": "p06-a-15-s02",
      "speaker": "Ellis",
      "text": "The remote one on the cliff looks beautiful, but the nearest shop is five miles away."
    },
    {
      "id": "p06-a-15-s03",
      "speaker": "Nadia",
      "text": "We are not taking a car. The property near the port would be easier to reach."
    },
    {
      "id": "p06-a-15-s04",
      "speaker": "Ellis",
      "text": "True. Its garden looks pleasant, and we could walk to dinner."
    },
    {
      "id": "p06-a-15-s05",
      "speaker": "Nadia",
      "text": "I want a relaxing weekend, not two days of arranging taxis. Could we rent that one for just two nights?"
    },
    {
      "id": "p06-a-15-s06",
      "speaker": "Ellis",
      "text": "The listing does not say. It also does not tell us whether the bedrooms face the busy road."
    },
    {
      "id": "p06-a-15-s07",
      "speaker": "Nadia",
      "text": "Then let's ask about a two-night stay and the bedroom windows before we decide."
    },
    {
      "id": "p06-a-15-s08",
      "speaker": "Ellis",
      "text": "Agreed. I'll contact the owner of the cottage near the port with both questions."
    }
  ],
