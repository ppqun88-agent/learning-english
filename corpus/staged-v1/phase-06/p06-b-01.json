{
  "id": "p06-b-01",
  "title_zh": "商定退休后的图书馆志愿工作",
  "topic_id": "community",
  "scenario": {
    "id": "retirement-volunteer-role",
    "label_zh": "选择退休后的志愿职责",
    "goal_zh": "确认适合的图书整理工作并约定试做，长期值班安排仍待决定"
  },
  "participants": [
    "Evan",
    "Mina"
  ],
  "context_zh": "埃文即将退休，向图书馆志愿协调员米娜询问每周能承担的一项工作。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-01-s01",
      "speaker": "Evan",
      "text": "I'm going to retire in June. Could I help here one morning a week?"
    },
    {
      "id": "p06-b-01-s02",
      "speaker": "Mina",
      "text": "Certainly. Several retired volunteers help us, and nobody has to commit to more than they can manage."
    },
    {
      "id": "p06-b-01-s03",
      "speaker": "Evan",
      "text": "I could take responsibility for sorting returned books, but I don't want to run a group."
    },
    {
      "id": "p06-b-01-s04",
      "speaker": "Mina",
      "text": "We respect that. Sorting would be a suitable role, and someone would work alongside you at first."
    },
    {
      "id": "p06-b-01-s05",
      "speaker": "Evan",
      "text": "Could I try it before I promise to come every week?"
    },
    {
      "id": "p06-b-01-s06",
      "speaker": "Mina",
      "text": "Yes. Come in next Thursday at nine for a trial morning."
    },
    {
      "id": "p06-b-01-s07",
      "speaker": "Evan",
      "text": "Thanks. I'll try that, then decide about a regular morning in June."
    }
  ],
