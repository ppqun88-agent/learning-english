{
  "id": "p06-b-02",
  "title_zh": "让课堂机器人重新读出条码",
  "topic_id": "learning",
  "scenario": {
    "id": "robot-demo-scan-troubleshooting",
    "label_zh": "排查课堂机器人的扫描演示",
    "goal_zh": "依据错误提示更新软件，重新扫描并确认演示恢复"
  },
  "participants": [
    "Noor",
    "Mr Bell"
  ],
  "context_zh": "机器人课上，学生努尔向教师贝尔先生求助，设备能够移动却无法读取练习卡的条码。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-02-s01",
      "speaker": "Noor",
      "text": "The robot moves, but it won't scan this card."
    },
    {
      "id": "p06-b-02-s02",
      "speaker": "Mr Bell",
      "text": "What does the message on the screen say?"
    },
    {
      "id": "p06-b-02-s03",
      "speaker": "Noor",
      "text": "It says the software is too old for this type of code. Is that a technical problem we can fix here?"
    },
    {
      "id": "p06-b-02-s04",
      "speaker": "Mr Bell",
      "text": "Yes. These classroom tablets already have the approved installer. Let's update the scanner program."
    },
    {
      "id": "p06-b-02-s05",
      "speaker": "Noor",
      "text": "It's finished. Shall I hold the same card in front of the camera?"
    },
    {
      "id": "p06-b-02-s06",
      "speaker": "Mr Bell",
      "text": "Yes, keep it inside the square on the screen."
    },
    {
      "id": "p06-b-02-s07",
      "speaker": "Noor",
      "text": "It read the code successfully this time, and the name is correct."
    },
    {
      "id": "p06-b-02-s08",
      "speaker": "Mr Bell",
      "text": "Good. Use that card for your demonstration, and keep the error message in your project notes."
    }
  ],
