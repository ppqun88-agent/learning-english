{
  "id": "p06-b-04",
  "title_zh": "先确认帆船课的天气条件",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-sailing-weather-check",
    "label_zh": "核对初学帆船课的开课条件",
    "goal_zh": "了解课程季节与天气限制，并约定确认可开课时段的下一步"
  },
  "participants": [
    "Imogen",
    "Sailing Instructor"
  ],
  "context_zh": "伊莫金致电帆船学校，询问秋季初学课程是否仍开课，以及眼下风浪会不会影响安排。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-04-s01",
      "speaker": "Imogen",
      "text": "Do you still offer beginner lessons in October?"
    },
    {
      "id": "p06-b-04-s02",
      "speaker": "Sailing Instructor",
      "text": "Yes, until the end of the month, but the sea is too rough today."
    },
    {
      "id": "p06-b-04-s03",
      "speaker": "Imogen",
      "text": "My brother is an experienced sailor. Could he take me out instead?"
    },
    {
      "id": "p06-b-04-s04",
      "speaker": "Sailing Instructor",
      "text": "For safety, we'd recommend postponing your first outing. The forecast warns of sudden changes in the wind."
    },
    {
      "id": "p06-b-04-s05",
      "speaker": "Imogen",
      "text": "That sounds sensible. I'd rather start with an instructor in calmer conditions."
    },
    {
      "id": "p06-b-04-s06",
      "speaker": "Sailing Instructor",
      "text": "Call tomorrow after nine. We'll have the morning forecast and can discuss any lessons that can go ahead."
    },
    {
      "id": "p06-b-04-s07",
      "speaker": "Imogen",
      "text": "All right. I won't book a time yet; I'll call tomorrow."
    }
  ],
