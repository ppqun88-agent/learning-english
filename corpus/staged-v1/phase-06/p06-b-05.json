{
  "id": "p06-b-05",
  "title_zh": "约好橄榄球比赛的入场会合点",
  "topic_id": "leisure",
  "scenario": {
    "id": "rugby-stadium-meeting",
    "label_zh": "约好橄榄球赛观赛会合",
    "goal_zh": "核对看台座位和进场安排并约定见面地点"
  },
  "participants": [
    "Callum",
    "Rosa"
  ],
  "context_zh": "卡勒姆第一次陪罗莎去看橄榄球比赛，两人在出发前核对球场入口和座位。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-05-s01",
      "speaker": "Callum",
      "text": "I've never watched rugby at the stadium before. Which entrance should I use?"
    },
    {
      "id": "p06-b-05-s02",
      "speaker": "Rosa",
      "text": "The east entrance. Our tickets are for row C, seats twelve and thirteen."
    },
    {
      "id": "p06-b-05-s03",
      "speaker": "Callum",
      "text": "Will I look out of place without a team shirt?"
    },
    {
      "id": "p06-b-05-s04",
      "speaker": "Rosa",
      "text": "Not at all. You don't have to be a lifelong supporter to come along."
    },
    {
      "id": "p06-b-05-s05",
      "speaker": "Callum",
      "text": "You always sound excited about this team."
    },
    {
      "id": "p06-b-05-s06",
      "speaker": "Rosa",
      "text": "I love their team spirit, especially when a match isn't going well."
    },
    {
      "id": "p06-b-05-s07",
      "speaker": "Callum",
      "text": "Then I'll meet you outside the east entrance at three."
    },
    {
      "id": "p06-b-05-s08",
      "speaker": "Rosa",
      "text": "Perfect. That gives us half an hour to find our seats."
    }
  ],
