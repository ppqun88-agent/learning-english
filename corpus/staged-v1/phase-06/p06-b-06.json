{
  "id": "p06-b-06",
  "title_zh": "留在步道边观察潮池小鱼",
  "topic_id": "nature",
  "scenario": {
    "id": "rock-pool-observation-position",
    "label_zh": "选择潮池观察位置",
    "goal_zh": "辨认浅水中的动物并决定留在步道旁安静观察"
  },
  "participants": [
    "Ada",
    "Coastal Ranger"
  ],
  "context_zh": "游客艾达在海岸木步道旁发现一个潮池，向管理员询问看到的动物并选择观察位置。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-06-s01",
      "speaker": "Ada",
      "text": "Is that something moving under the sand?"
    },
    {
      "id": "p06-b-06-s02",
      "speaker": "Coastal Ranger",
      "text": "Yes, a tiny fish. Look beside the empty shell."
    },
    {
      "id": "p06-b-06-s03",
      "speaker": "Ada",
      "text": "I can see its tail now. Oh, there are several more behind it!"
    },
    {
      "id": "p06-b-06-s04",
      "speaker": "Coastal Ranger",
      "text": "They blend in until they move."
    },
    {
      "id": "p06-b-06-s05",
      "speaker": "Ada",
      "text": "What a lovely sight. Can I get closer by stepping down into the pool?"
    },
    {
      "id": "p06-b-06-s06",
      "speaker": "Coastal Ranger",
      "text": "Please stay on the boardwalk. You can see them clearly from the low rail on your left."
    },
    {
      "id": "p06-b-06-s07",
      "speaker": "Ada",
      "text": "I'll watch from there, then. I don't want to disturb them."
    }
  ],
