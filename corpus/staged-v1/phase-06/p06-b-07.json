{
  "id": "p06-b-07",
  "title_zh": "先练习陶土表面的处理方法",
  "topic_id": "leisure",
  "scenario": {
    "id": "clay-sculpture-finishing-feedback",
    "label_zh": "调整陶土作品的表面",
    "goal_zh": "讨论作品边缘与表面处理，并约定先在余料上练习"
  },
  "participants": [
    "Pavel",
    "Jo"
  ],
  "context_zh": "陶艺初学者帕维尔正在制作尚未烧制的陶土鸟，请教师乔帮助改善触感。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-07-s01",
      "speaker": "Pavel",
      "text": "My sculpture looks all right from here, but the edge of the wing feels sharp."
    },
    {
      "id": "p06-b-07-s02",
      "speaker": "Jo",
      "text": "The clay is still soft, so we can round that edge before it dries."
    },
    {
      "id": "p06-b-07-s03",
      "speaker": "Pavel",
      "text": "I'd also like the surface to be smooth, rather than covered in fingerprints."
    },
    {
      "id": "p06-b-07-s04",
      "speaker": "Jo",
      "text": "I can show you a technique using this damp sponge. Too much water would make the clay difficult to work with."
    },
    {
      "id": "p06-b-07-s05",
      "speaker": "Pavel",
      "text": "Could I practise on a leftover piece first? I don't want to flatten the wing."
    },
    {
      "id": "p06-b-07-s06",
      "speaker": "Jo",
      "text": "Of course. Try it on this scrap, and we'll look at the result together before you touch the bird."
    }
  ],
