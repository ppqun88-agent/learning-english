{
  "id": "p06-b-08",
  "title_zh": "商定同形材料的浮沉观察",
  "topic_id": "learning",
  "scenario": {
    "id": "classroom-floating-prediction",
    "label_zh": "澄清浮沉实验的预测",
    "goal_zh": "保持样本形状和大小相同，商定比较不同材料浮沉的观察记录"
  },
  "participants": [
    "Luca",
    "Ms Chen"
  ],
  "context_zh": "科学课上，卢卡想用两个物体的外形预测浮沉，陈老师请他缩小结论并设计下一次观察。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-08-s01",
      "speaker": "Luca",
      "text": "My theory is that objects with the same shape will behave similarly in water."
    },
    {
      "id": "p06-b-08-s02",
      "speaker": "Ms Chen",
      "text": "That's a prediction we can test. Which objects do you want to use?"
    },
    {
      "id": "p06-b-08-s03",
      "speaker": "Luca",
      "text": "These cubes. One is wood and the other is metal, but the similarity in shape should help us compare them."
    },
    {
      "id": "p06-b-08-s04",
      "speaker": "Ms Chen",
      "text": "Good. Each cube is made from a different substance. Are they the same size, too?"
    },
    {
      "id": "p06-b-08-s05",
      "speaker": "Luca",
      "text": "Yes, and both are solid, not hollow. I think they'll both sink."
    },
    {
      "id": "p06-b-08-s06",
      "speaker": "Ms Chen",
      "text": "Write that down before we test them. A scientific report needs your observations, even if they disagree with your prediction."
    },
    {
      "id": "p06-b-08-s07",
      "speaker": "Luca",
      "text": "I'll draw a table with one row for each cube and record what actually happens."
    },
    {
      "id": "p06-b-08-s08",
      "speaker": "Ms Chen",
      "text": "Do that, then bring the table to the water tray. We'll test these two cubes first."
    }
  ],
