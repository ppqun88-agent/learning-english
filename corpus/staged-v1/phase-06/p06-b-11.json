{
  "id": "p06-b-11",
  "title_zh": "约定与工会代表私下谈话",
  "topic_id": "work",
  "scenario": {
    "id": "workplace-private-report-meeting",
    "label_zh": "安排私下讨论职场不当言行",
    "goal_zh": "说明对不当言行的担忧，并约定与工会代表私下讨论"
  },
  "participants": [
    "Amira",
    "Gareth"
  ],
  "context_zh": "虚构职场情景：阿米拉向工会代表加雷思询问如何私下讨论会议中的不当言论，尚未提交正式投诉。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-11-s01",
      "speaker": "Amira",
      "text": "The way I was treated at yesterday's meeting felt unfair. The comments were about my sex, not my work."
    },
    {
      "id": "p06-b-11-s02",
      "speaker": "Gareth",
      "text": "I'm sorry you had that experience. As your union representative, I can listen and explain the options."
    },
    {
      "id": "p06-b-11-s03",
      "speaker": "Amira",
      "text": "There were sexual jokes as well. I don't want the details passed around among the staff."
    },
    {
      "id": "p06-b-11-s04",
      "speaker": "Gareth",
      "text": "I take concerns like this seriously. I won't forward your notes without discussing that with you first."
    },
    {
      "id": "p06-b-11-s05",
      "speaker": "Amira",
      "text": "I feel strongly about it, but I'm not ready to make a formal complaint today."
    },
    {
      "id": "p06-b-11-s06",
      "speaker": "Gareth",
      "text": "We can start with a private conversation. Are you free at four?"
    },
    {
      "id": "p06-b-11-s07",
      "speaker": "Amira",
      "text": "Yes. I'll bring my notes, and we can discuss what I want to do next."
    },
    {
      "id": "p06-b-11-s08",
      "speaker": "Gareth",
      "text": "I'll meet you in the small meeting room at four. We won't submit anything at that meeting unless you decide to."
    }
  ],
