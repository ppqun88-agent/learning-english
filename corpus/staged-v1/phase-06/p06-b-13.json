{
  "id": "p06-b-13",
  "title_zh": "分清手工材料并安排标签整理",
  "topic_id": "community",
  "scenario": {
    "id": "craft-room-storage-sort",
    "label_zh": "整理活动室手工材料",
    "goal_zh": "区分材料归属和用途，商定存放及标签方式"
  },
  "participants": [
    "Tessa",
    "Omar"
  ],
  "context_zh": "两名社区中心志愿者整理共用手工活动室，需要把另一个小组的用品和本组材料分开。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-13-s01",
      "speaker": "Tessa",
      "text": "Is this set of brushes ours, or does it belong to the painting group?"
    },
    {
      "id": "p06-b-13-s02",
      "speaker": "Omar",
      "text": "It's theirs. Our stuff is in the two boxes by the door."
    },
    {
      "id": "p06-b-13-s03",
      "speaker": "Tessa",
      "text": "Then I'll leave their brushes on the top shelf. What should I do with this string?"
    },
    {
      "id": "p06-b-13-s04",
      "speaker": "Omar",
      "text": "Keep it for making gift tags. There's a tin with spare scissors in the blue box; the string can go in there too."
    },
    {
      "id": "p06-b-13-s05",
      "speaker": "Tessa",
      "text": "Found it. We've also got three partly used rolls of tape."
    },
    {
      "id": "p06-b-13-s06",
      "speaker": "Omar",
      "text": "Put them together in the shallow tray, so we can finish those before opening a new roll."
    },
    {
      "id": "p06-b-13-s07",
      "speaker": "Tessa",
      "text": "I'll stick a label on each container. That should stop us borrowing the other group's supplies by mistake."
    },
    {
      "id": "p06-b-13-s08",
      "speaker": "Omar",
      "text": "Good idea. I'll put our two labelled boxes in the lower cupboard when you're done."
    }
  ],
