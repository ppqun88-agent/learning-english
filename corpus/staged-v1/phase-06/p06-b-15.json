{
  "id": "p06-b-15",
  "title_zh": "调整反光并试拍产品短片",
  "topic_id": "work",
  "scenario": {
    "id": "product-film-lighting-rehearsal",
    "label_zh": "试拍产品短片的灯光与提示",
    "goal_zh": "调整反光和拍摄提示，完成一次试拍并约定检查录音"
  },
  "participants": [
    "Mae",
    "Rafi"
  ],
  "context_zh": "摄影师梅和同事拉菲在小型摄影棚试拍水瓶短片，开拍前需要处理反光和讲话提示。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-15-s01",
      "speaker": "Mae",
      "text": "Can we keep the studio silent while we record? The microphone is picking up every conversation."
    },
    {
      "id": "p06-b-15-s02",
      "speaker": "Rafi",
      "text": "I'll close the door. Are we ready to shoot?"
    },
    {
      "id": "p06-b-15-s03",
      "speaker": "Mae",
      "text": "Almost. Don't shine the lamp straight at the bottle; that shiny label is reflecting the light into the camera."
    },
    {
      "id": "p06-b-15-s04",
      "speaker": "Rafi",
      "text": "How about this angle? I can still read the name on the screen."
    },
    {
      "id": "p06-b-15-s05",
      "speaker": "Mae",
      "text": "That's better. The script says you turn the bottle once and then put it down."
    },
    {
      "id": "p06-b-15-s06",
      "speaker": "Rafi",
      "text": "Should I keep talking throughout the shot, even while I turn it?"
    },
    {
      "id": "p06-b-15-s07",
      "speaker": "Mae",
      "text": "Yes. My raised hand will be your signal to begin, and I'll lower it when we have enough."
    },
    {
      "id": "p06-b-15-s08",
      "speaker": "Rafi",
      "text": "Okay. Let's try one take."
    },
    {
      "id": "p06-b-15-s09",
      "speaker": "Mae",
      "text": "That's recorded. The label stayed clear, but let's listen to the sound before we move anything."
    },
    {
      "id": "p06-b-15-s10",
      "speaker": "Rafi",
      "text": "Good idea. I'll leave the bottle and lamp where they are."
    }
  ],
