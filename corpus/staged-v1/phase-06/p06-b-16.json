{
  "id": "p06-b-16",
  "title_zh": "为社区戏剧安排角色试演",
  "topic_id": "leisure",
  "scenario": {
    "id": "community-play-casting",
    "label_zh": "确认角色分配和排练",
    "goal_zh": "剧团根据角色要求讨论试演人选及排练时间。"
  },
  "participants": [
    "Ellis",
    "Mo"
  ],
  "context_zh": "社区剧团的新成员埃利斯担心在陌生人面前表演，导演莫和他讨论适合试演的角色与排练时间。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-16-s01",
      "speaker": "Ellis",
      "text": "I'd like to join the play, but I'm shy around people I don't know."
    },
    {
      "id": "p06-b-16-s02",
      "speaker": "Mo",
      "text": "We can start with a reading in a small group. You have a real talent for changing your voice."
    },
    {
      "id": "p06-b-16-s03",
      "speaker": "Ellis",
      "text": "Does that mean you want me to play the stranger who arrives in scene two?"
    },
    {
      "id": "p06-b-16-s04",
      "speaker": "Mo",
      "text": "Possibly. His voice has to be different from everyone else's, and that's your strength."
    },
    {
      "id": "p06-b-16-s05",
      "speaker": "Ellis",
      "text": "The others are so talented. I'm worried I'll slow them down."
    },
    {
      "id": "p06-b-16-s06",
      "speaker": "Mo",
      "text": "They all need rehearsal too. Would you read the part with Nina and me on Tuesday at seven?"
    },
    {
      "id": "p06-b-16-s07",
      "speaker": "Ellis",
      "text": "Yes, I'd be comfortable with that. I'll read the scene beforehand."
    },
    {
      "id": "p06-b-16-s08",
      "speaker": "Mo",
      "text": "Good. We'll try that role on Tuesday, then decide together whether it suits you."
    }
  ],
