{
  "id": "p06-b-17",
  "title_zh": "点一个按偏好制作的面包卷",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-sandwich-filling-order",
    "label_zh": "点购指定配料的三明治",
    "goal_zh": "核对面包和馅料口味后确定制作方式"
  },
  "participants": [
    "Faye",
    "Deli Assistant"
  ],
  "context_zh": "费伊在熟食柜台买午餐，询问面包和酱料，想要味道温和的现做三明治。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-17-s01",
      "speaker": "Faye",
      "text": "Could I have a roll with a slice of cheese and some tomato, please?"
    },
    {
      "id": "p06-b-17-s02",
      "speaker": "Deli Assistant",
      "text": "Of course. Would you like our red pepper sauce?"
    },
    {
      "id": "p06-b-17-s03",
      "speaker": "Faye",
      "text": "Is it spicy? I prefer something mild."
    },
    {
      "id": "p06-b-17-s04",
      "speaker": "Deli Assistant",
      "text": "It has quite a lot of chilli. I can use butter instead."
    },
    {
      "id": "p06-b-17-s05",
      "speaker": "Faye",
      "text": "Butter, please. Could you warm the bread slightly first? I don't want it toasted."
    },
    {
      "id": "p06-b-17-s06",
      "speaker": "Deli Assistant",
      "text": "Certainly. I'll warm the roll, spread a little butter inside, and add the cheese and tomato."
    },
    {
      "id": "p06-b-17-s07",
      "speaker": "Faye",
      "text": "That's exactly what I'd like. No sauce, thank you."
    }
  ],
