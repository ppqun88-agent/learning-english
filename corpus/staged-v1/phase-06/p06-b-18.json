{
  "id": "p06-b-18",
  "title_zh": "索取五十英镑预算内的印刷报价",
  "topic_id": "services",
  "scenario": {
    "id": "printing-quote-scope-request",
    "label_zh": "索取预算内的印刷报价",
    "goal_zh": "说明印刷需求及含税预算，约定店员发送完整报价"
  },
  "participants": [
    "Sonia",
    "Print Shop Owner"
  ],
  "context_zh": "索尼娅为社区活动询问少量传单印刷，先说明数量、印制要求和含税预算，不在此时下单。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-18-s01",
      "speaker": "Sonia",
      "text": "Do you specialize in small print runs? I only need eighty leaflets."
    },
    {
      "id": "p06-b-18-s02",
      "speaker": "Print Shop Owner",
      "text": "We do. What sort of paper and printing do you need?"
    },
    {
      "id": "p06-b-18-s03",
      "speaker": "Sonia",
      "text": "Specifically, I'd like colour on the front and plain text on the back. Ordinary paper is fine."
    },
    {
      "id": "p06-b-18-s04",
      "speaker": "Print Shop Owner",
      "text": "Do you have a spending limit?"
    },
    {
      "id": "p06-b-18-s05",
      "speaker": "Sonia",
      "text": "My total budget is fifty pounds, including tax. I can collect them, so there's no delivery charge to add."
    },
    {
      "id": "p06-b-18-s06",
      "speaker": "Print Shop Owner",
      "text": "Send me the file and I'll email a full quote. I won't start printing until you approve it."
    },
    {
      "id": "p06-b-18-s07",
      "speaker": "Sonia",
      "text": "Thanks. I'll send the file today and wait for the quote before making a decision."
    }
  ],
