{
  "id": "p06-b-19",
  "title_zh": "缩小就业调查标题的结论范围",
  "topic_id": "reasoning",
  "scenario": {
    "id": "employment-survey-headline-limits",
    "label_zh": "限定就业调查标题的结论",
    "goal_zh": "核对样本与统计口径，删除无法支持的全市趋势结论"
  },
  "participants": [
    "Jin",
    "Marta"
  ],
  "context_zh": "两名学生审核一份虚构求职俱乐部调查的报告标题，避免把少量成员的情况写成全市就业趋势。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-19-s01",
      "speaker": "Jin",
      "text": "At the start of this month, forty residents in our survey were unemployed. Eight have since found work. Can our headline say unemployment is falling across the city?"
    },
    {
      "id": "p06-b-19-s02",
      "speaker": "Marta",
      "text": "No. That's a statistic about one job club, not a measure of the whole city."
    },
    {
      "id": "p06-b-19-s03",
      "speaker": "Jin",
      "text": "But doesn't it show a positive trend?"
    },
    {
      "id": "p06-b-19-s04",
      "speaker": "Marta",
      "text": "We only have this month's survey. We don't have a comparable result from last month."
    },
    {
      "id": "p06-b-19-s05",
      "speaker": "Jin",
      "text": "And it's unlikely that this one club represents everyone looking for work."
    },
    {
      "id": "p06-b-19-s06",
      "speaker": "Marta",
      "text": "Right. We should therefore keep the headline about the people we actually surveyed."
    },
    {
      "id": "p06-b-19-s07",
      "speaker": "Jin",
      "text": "I'll change it to 'Eight survey participants found work this month' and explain the sample underneath."
    },
    {
      "id": "p06-b-19-s08",
      "speaker": "Marta",
      "text": "That matches our evidence. Let's use that version."
    }
  ],
