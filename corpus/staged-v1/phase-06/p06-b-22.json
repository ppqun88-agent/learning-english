{
  "id": "p06-b-22",
  "title_zh": "挑选舒适的保暖内搭",
  "topic_id": "services",
  "scenario": {
    "id": "walking-clothes-layer-choice",
    "label_zh": "选择舒适的徒步内搭",
    "goal_zh": "说明试穿不适并改选宽松款，暂不购买不必要的衣物"
  },
  "participants": [
    "Nico",
    "Outdoor Shop Assistant"
  ],
  "context_zh": "尼科在户外用品店选择徒步时穿的保暖内搭，已按店内要求试穿，并询问是否还需要配套上衣。",
  "author": "author-phase06-b",
  "sentences": [
    {
      "id": "p06-b-22-s01",
      "speaker": "Nico",
      "text": "I'm looking for thermal underwear, but these long johns feel tight around the waist."
    },
    {
      "id": "p06-b-22-s02",
      "speaker": "Outdoor Shop Assistant",
      "text": "We have the same style one size larger. Would you like to try those?"
    },
    {
      "id": "p06-b-22-s03",
      "speaker": "Nico",
      "text": "Please. This pair is too uncomfortable to wear all day."
    },
    {
      "id": "p06-b-22-s04",
      "speaker": "Outdoor Shop Assistant",
      "text": "Here you are. The fitting room is still free."
    },
    {
      "id": "p06-b-22-s05",
      "speaker": "Nico",
      "text": "These feel totally different. I can sit down comfortably now. Do I need the matching top as well?"
    },
    {
      "id": "p06-b-22-s06",
      "speaker": "Outdoor Shop Assistant",
      "text": "You said you already have a warm base layer for your upper body. Another one may be unnecessary."
    },
    {
      "id": "p06-b-22-s07",
      "speaker": "Nico",
      "text": "Then I'll just take the larger long johns and use the top I already own."
    }
  ],
