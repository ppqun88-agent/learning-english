{
  "id": "p06-c-01",
  "title_zh": "决定购买适合练习的二手钢琴",
  "topic_id": "services",
  "scenario": {
    "id": "secondhand-piano-purchase",
    "label_zh": "挑选二手练习钢琴",
    "goal_zh": "核对二手钢琴的来源、声音和价格后决定是否购买"
  },
  "participants": [
    "Nadia",
    "Graham"
  ],
  "context_zh": "娜迪娅在二手乐器店挑选练习用钢琴，格雷厄姆是店员。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-01-s01",
      "speaker": "Nadia",
      "text": "Is this a used piano, or has it only been on display?"
    },
    {
      "id": "p06-c-01-s02",
      "speaker": "Graham",
      "text": "Used. We bought it at an auction, then had our technician check and tune it."
    },
    {
      "id": "p06-c-01-s03",
      "speaker": "Nadia",
      "text": "Is it a valuable antique? I need something to play, not something to collect."
    },
    {
      "id": "p06-c-01-s04",
      "speaker": "Graham",
      "text": "No, it is an ordinary practice piano. You can try it now."
    },
    {
      "id": "p06-c-01-s05",
      "speaker": "Nadia",
      "text": "The lower notes sound much clearer than on the other one. I value a clear sound more than an impressive label."
    },
    {
      "id": "p06-c-01-s06",
      "speaker": "Graham",
      "text": "This one is four hundred pounds, including local delivery. The other one is three hundred."
    },
    {
      "id": "p06-c-01-s07",
      "speaker": "Nadia",
      "text": "Four hundred is still affordable for me. Is the difference worth an extra hundred pounds?"
    },
    {
      "id": "p06-c-01-s08",
      "speaker": "Graham",
      "text": "Only if you prefer playing this one. The cheaper piano is not a bargain if you dislike its sound."
    },
    {
      "id": "p06-c-01-s09",
      "speaker": "Nadia",
      "text": "Then I will take this one. Could you arrange delivery for next Thursday?"
    },
    {
      "id": "p06-c-01-s10",
      "speaker": "Graham",
      "text": "Yes. Thursday morning is available; I will put that on your order."
    }
  ],
