{
  "id": "p06-c-02",
  "title_zh": "把报告中的增长改为同口径比较",
  "topic_id": "work",
  "scenario": {
    "id": "report-data-reconciliation",
    "label_zh": "核对报告版本与数据口径",
    "goal_zh": "查明两个报告数字不同的原因并约定修订可比较的数据和说明"
  },
  "participants": [
    "Samir",
    "Elise"
  ],
  "context_zh": "分析员萨米尔与项目同事埃莉斯检查一份虚构月度报告，发现图表可能使用了不同数据范围。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-02-s01",
      "speaker": "Samir",
      "text": "Which version did you send to the team? My chart ends in June, but yours includes July."
    },
    {
      "id": "p06-c-02-s02",
      "speaker": "Elise",
      "text": "I sent the file you shared this morning. I thought the extra column had been checked."
    },
    {
      "id": "p06-c-02-s03",
      "speaker": "Samir",
      "text": "As the analyst, I should have marked it as unfinished. July includes two shops that were not in the June total."
    },
    {
      "id": "p06-c-02-s04",
      "speaker": "Elise",
      "text": "So the apparent rise might just reflect the extra shops?"
    },
    {
      "id": "p06-c-02-s05",
      "speaker": "Samir",
      "text": "Yes. We need the actual sales figures for the same shops in both months."
    },
    {
      "id": "p06-c-02-s06",
      "speaker": "Elise",
      "text": "I can copy those figures from the shop reports. Will you check that I have entered them accurately?"
    },
    {
      "id": "p06-c-02-s07",
      "speaker": "Samir",
      "text": "Of course. Accuracy matters more than getting this out before lunch."
    },
    {
      "id": "p06-c-02-s08",
      "speaker": "Elise",
      "text": "And we should state our assumption that every shop recorded returns in the same way."
    },
    {
      "id": "p06-c-02-s09",
      "speaker": "Samir",
      "text": "Agreed. Replace the chart, add that note, and send the draft back to me before it goes to the team."
    }
  ],
