{
  "id": "p06-c-03",
  "title_zh": "改看战后重建的纪录片一集",
  "topic_id": "leisure",
  "scenario": {
    "id": "documentary-family-viewing-choice",
    "label_zh": "选择适合共同观看的纪录片集数",
    "goal_zh": "了解纪录片中的战争画面后改选没有战斗内容的集数。"
  },
  "participants": [
    "Mara",
    "Colin"
  ],
  "context_zh": "两位家长在家庭观影前查看战争纪录片的分集说明，希望避开战斗画面。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-03-s01",
      "speaker": "Mara",
      "text": "Could we watch this history series with Mia tonight?"
    },
    {
      "id": "p06-c-03-s02",
      "speaker": "Colin",
      "text": "Maybe, but episode one follows the arms trade, including footage of armed groups."
    },
    {
      "id": "p06-c-03-s03",
      "speaker": "Mara",
      "text": "Is there a content warning?"
    },
    {
      "id": "p06-c-03-s04",
      "speaker": "Colin",
      "text": "Yes. It says there is a violent scene near the beginning."
    },
    {
      "id": "p06-c-03-s05",
      "speaker": "Mara",
      "text": "That does not sound suitable for a young viewer. What about episode three?"
    },
    {
      "id": "p06-c-03-s06",
      "speaker": "Colin",
      "text": "That one follows a school being rebuilt after the war. I watched it yesterday; there are no battle scenes."
    },
    {
      "id": "p06-c-03-s07",
      "speaker": "Mara",
      "text": "Does anyone fire a weapon in it? Even a brief scene would bother her."
    },
    {
      "id": "p06-c-03-s08",
      "speaker": "Colin",
      "text": "No. It focuses on the teachers and the children returning to class."
    },
    {
      "id": "p06-c-03-s09",
      "speaker": "Mara",
      "text": "Then let us watch episode three together and leave the first one for another evening."
    }
  ],
