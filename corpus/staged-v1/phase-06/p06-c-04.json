{
  "id": "p06-c-04",
  "title_zh": "在一小时内参观航空展厅",
  "topic_id": "leisure",
  "scenario": {
    "id": "aviation-museum-route",
    "label_zh": "确定航空展参观路线",
    "goal_zh": "根据展品位置和可用时间选定航空展厅的参观路线"
  },
  "participants": [
    "Theo",
    "Ruth"
  ],
  "context_zh": "西奥向航空博物馆工作人员露丝询问旧飞机和机翼展品的位置。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-04-s01",
      "speaker": "Theo",
      "text": "I wonder which hall has the early passenger aircraft. We have to leave within an hour."
    },
    {
      "id": "p06-c-04-s02",
      "speaker": "Ruth",
      "text": "Go to the western hall. The red arrow on this map points to its entrance."
    },
    {
      "id": "p06-c-04-s03",
      "speaker": "Theo",
      "text": "Is that where I can see inside a wing? I saw a photograph of one with the cover removed."
    },
    {
      "id": "p06-c-04-s04",
      "speaker": "Ruth",
      "text": "Yes. That display stands alongside the full-size aircraft, so you can look at both in the same hall."
    },
    {
      "id": "p06-c-04-s05",
      "speaker": "Theo",
      "text": "Will we have time for the upstairs gallery as well?"
    },
    {
      "id": "p06-c-04-s06",
      "speaker": "Ruth",
      "text": "Probably not if you want to stop and read the labels."
    },
    {
      "id": "p06-c-04-s07",
      "speaker": "Theo",
      "text": "We will stay in the western hall, then. Could you show me the quickest way back to this exit?"
    },
    {
      "id": "p06-c-04-s08",
      "speaker": "Ruth",
      "text": "Take this corridor straight back. You do not need to go upstairs."
    }
  ],
