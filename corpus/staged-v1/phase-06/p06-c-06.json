{
  "id": "p06-c-06",
  "title_zh": "明确社区活动入口和接待分工",
  "topic_id": "community",
  "scenario": {
    "id": "community-event-welcome",
    "label_zh": "安排社区活动迎宾",
    "goal_zh": "确认入口与电梯位置并分配接待工作"
  },
  "participants": [
    "Yasmin",
    "Joel"
  ],
  "context_zh": "社区活动负责人亚斯敏向首次来帮忙的乔尔交接迎宾工作。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-06-s01",
      "speaker": "Yasmin",
      "text": "You are our new volunteer, right? Here is a badge so visitors know they can ask you for help."
    },
    {
      "id": "p06-c-06-s02",
      "speaker": "Joel",
      "text": "Thanks. Should I stand by the front steps?"
    },
    {
      "id": "p06-c-06-s03",
      "speaker": "Yasmin",
      "text": "Use the side entrance instead. People arrive with various needs, and that entrance leads straight to the lift."
    },
    {
      "id": "p06-c-06-s04",
      "speaker": "Joel",
      "text": "Can the lift accommodate someone with a wheelchair and a companion?"
    },
    {
      "id": "p06-c-06-s05",
      "speaker": "Yasmin",
      "text": "Yes, both can travel together. Please ask before offering any physical assistance."
    },
    {
      "id": "p06-c-06-s06",
      "speaker": "Joel",
      "text": "Who should I contact if someone needs more help than I can give?"
    },
    {
      "id": "p06-c-06-s07",
      "speaker": "Yasmin",
      "text": "I will assign Lian to the lift area. Call her whenever you are unsure; she knows the building well."
    },
    {
      "id": "p06-c-06-s08",
      "speaker": "Joel",
      "text": "All right. I will welcome people at the side door and direct them to Lian when needed."
    },
    {
      "id": "p06-c-06-s09",
      "speaker": "Yasmin",
      "text": "Exactly. I will stay at the registration desk just inside that door."
    }
  ],
