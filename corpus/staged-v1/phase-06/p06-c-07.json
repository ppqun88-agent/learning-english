{
  "id": "p06-c-07",
  "title_zh": "表决采用活动室清洁轮值表",
  "topic_id": "community",
  "scenario": {
    "id": "association-meeting-decision",
    "label_zh": "表决活动室清洁安排",
    "goal_zh": "居民协会讨论清洁轮值方案并明确采用决定和后续说明责任"
  },
  "participants": [
    "Bea",
    "Kofi",
    "Lin"
  ],
  "context_zh": "小型居民协会的三名委员全部到场，讨论由协会自行管理的活动室清洁安排。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-07-s01",
      "speaker": "Bea",
      "text": "The next item on our agenda is the cleaning rota for the shared room."
    },
    {
      "id": "p06-c-07-s02",
      "speaker": "Kofi",
      "text": "Does the association need the building manager's approval for that?"
    },
    {
      "id": "p06-c-07-s03",
      "speaker": "Bea",
      "text": "Not for cleaning. Our agreement lets us manage this room, but changes to the building still need permission."
    },
    {
      "id": "p06-c-07-s04",
      "speaker": "Lin",
      "text": "Then can we approve the rota today? Every household has already agreed to its week."
    },
    {
      "id": "p06-c-07-s05",
      "speaker": "Kofi",
      "text": "I support it, as long as people can swap weeks when problems arise."
    },
    {
      "id": "p06-c-07-s06",
      "speaker": "Bea",
      "text": "That is in the note at the bottom. Shall we take a vote on whether to adopt this rota? I am in favour."
    },
    {
      "id": "p06-c-07-s07",
      "speaker": "Kofi",
      "text": "Yes from me too."
    },
    {
      "id": "p06-c-07-s08",
      "speaker": "Lin",
      "text": "And me. I will put the rota on the noticeboard and explain how to arrange a swap."
    },
    {
      "id": "p06-c-07-s09",
      "speaker": "Bea",
      "text": "Thank you. That is agreed by all three of us."
    }
  ],
