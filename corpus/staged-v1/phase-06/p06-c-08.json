{
  "id": "p06-c-08",
  "title_zh": "承认拿错笔记本并为误指责道歉",
  "topic_id": "relationships",
  "scenario": {
    "id": "misplaced-notebook-apology",
    "label_zh": "纠正误指责并道歉",
    "goal_zh": "承认自己拿错物品造成误会并向朋友道歉，约定归还物品"
  },
  "participants": [
    "Evan",
    "Rosa"
  ],
  "context_zh": "埃文发现自己误拿了罗莎的笔记本，此前却指责罗莎拿走了他的。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-08-s01",
      "speaker": "Evan",
      "text": "Rosa, I found your notebook in my bag. I accidentally picked it up after class."
    },
    {
      "id": "p06-c-08-s02",
      "speaker": "Rosa",
      "text": "Then why did you tell everyone I had taken yours? I was really upset."
    },
    {
      "id": "p06-c-08-s03",
      "speaker": "Evan",
      "text": "I had no right to accuse you. I saw an empty space on my desk and jumped to a conclusion."
    },
    {
      "id": "p06-c-08-s04",
      "speaker": "Rosa",
      "text": "It was not just the missing notebook. You would not listen when I explained."
    },
    {
      "id": "p06-c-08-s05",
      "speaker": "Evan",
      "text": "I need to acknowledge that too. My anger was not an excuse to speak to you like that."
    },
    {
      "id": "p06-c-08-s06",
      "speaker": "Rosa",
      "text": "I appreciate you saying so, but the others still think I took it."
    },
    {
      "id": "p06-c-08-s07",
      "speaker": "Evan",
      "text": "I am ashamed of that. You deserve an apology in front of the same people. May I explain what happened before class tomorrow?"
    },
    {
      "id": "p06-c-08-s08",
      "speaker": "Rosa",
      "text": "Yes, please. And bring my notebook; I need it for the lesson."
    },
    {
      "id": "p06-c-08-s09",
      "speaker": "Evan",
      "text": "I will. I will also make clear that none of this was your fault."
    }
  ],
