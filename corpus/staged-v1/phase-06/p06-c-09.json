{
  "id": "p06-c-09",
  "title_zh": "先借笔记试讲展示开场",
  "topic_id": "learning",
  "scenario": {
    "id": "student-presentation-support-plan",
    "label_zh": "约定先练习课堂展示的开场",
    "goal_zh": "说明公开发言顾虑，并同意借助笔记向同伴试讲开场"
  },
  "participants": [
    "Niko",
    "Asha"
  ],
  "context_zh": "尼科准备课堂展示时感到紧张，同学阿莎提出先听他试讲开场。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-09-s01",
      "speaker": "Niko",
      "text": "I feel anxious every time I imagine standing in front of the class."
    },
    {
      "id": "p06-c-09-s02",
      "speaker": "Asha",
      "text": "Is it remembering your points, or having everyone look at you?"
    },
    {
      "id": "p06-c-09-s03",
      "speaker": "Niko",
      "text": "Both. The anxiety gets worse when I lose my place, and then there is an awkward silence."
    },
    {
      "id": "p06-c-09-s04",
      "speaker": "Asha",
      "text": "Could you put the first three points on a card and try the opening with me?"
    },
    {
      "id": "p06-c-09-s05",
      "speaker": "Niko",
      "text": "Yes, but please do not correct me halfway through."
    },
    {
      "id": "p06-c-09-s06",
      "speaker": "Asha",
      "text": "I can assure you that I will wait until you finish. We can talk about it afterward."
    },
    {
      "id": "p06-c-09-s07",
      "speaker": "Niko",
      "text": "Thanks. Would you also accompany me to the classroom tomorrow?"
    },
    {
      "id": "p06-c-09-s08",
      "speaker": "Asha",
      "text": "Of course. For now, get your notes and start whenever you are ready."
    },
    {
      "id": "p06-c-09-s09",
      "speaker": "Niko",
      "text": "All right. Here is my card. I will try just the first minute."
    }
  ],
