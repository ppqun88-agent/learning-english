{
  "id": "p06-c-13",
  "title_zh": "选择面向工作交流的口语试课",
  "topic_id": "learning",
  "scenario": {
    "id": "language-tutor-practice-plan",
    "label_zh": "选择适合初学者的口语班",
    "goal_zh": "确认教师、练习内容和每周课程时间"
  },
  "participants": [
    "Jun",
    "Tutor Beth"
  ],
  "context_zh": "君想提高与商店顾客交谈的能力，向贝丝老师询问初学口语班。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-13-s01",
      "speaker": "Jun",
      "text": "I want to acquire the language skills I need to talk to customers. Is your class suitable for a beginner?"
    },
    {
      "id": "p06-c-13-s02",
      "speaker": "Tutor Beth",
      "text": "Yes. I teach it myself. What would you like to accomplish in the first month?"
    },
    {
      "id": "p06-c-13-s03",
      "speaker": "Jun",
      "text": "I would like to explain where things are and answer simple questions about prices. I am not trying to copy a particular accent."
    },
    {
      "id": "p06-c-13-s04",
      "speaker": "Tutor Beth",
      "text": "That is a useful goal. My approach is to practise short conversations, then repeat them with a small change."
    },
    {
      "id": "p06-c-13-s05",
      "speaker": "Jun",
      "text": "Could we use situations from my shop rather than a restaurant?"
    },
    {
      "id": "p06-c-13-s06",
      "speaker": "Tutor Beth",
      "text": "Certainly. I can adapt the activities to your work. A few minutes of practice between classes would be beneficial too."
    },
    {
      "id": "p06-c-13-s07",
      "speaker": "Jun",
      "text": "When does the class meet?"
    },
    {
      "id": "p06-c-13-s08",
      "speaker": "Tutor Beth",
      "text": "Every Tuesday at six. You can attend one trial lesson before deciding about the full course."
    },
    {
      "id": "p06-c-13-s09",
      "speaker": "Jun",
      "text": "I will come next Tuesday at six, then. I can bring examples of questions customers ask."
    }
  ],
