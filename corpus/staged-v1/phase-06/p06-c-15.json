{
  "id": "p06-c-15",
  "title_zh": "调整画廊灯光以保留画作效果",
  "topic_id": "work",
  "scenario": {
    "id": "gallery-exhibition-lighting-plan",
    "label_zh": "调整展览画作照明",
    "goal_zh": "比较画作在不同照明角度下的观看效果并确定安装调整"
  },
  "participants": [
    "Curator Mei",
    "Installer Tomas"
  ],
  "context_zh": "策展人梅与灯光安装员托马斯在布展现场查看一幅抽象画。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-15-s01",
      "speaker": "Curator Mei",
      "text": "This abstract painting looks quite different under the artificial light. The pale shapes almost disappear."
    },
    {
      "id": "p06-c-15-s02",
      "speaker": "Installer Tomas",
      "text": "The lamp is pointing straight at the surface. I can change the angle and let you compare."
    },
    {
      "id": "p06-c-15-s03",
      "speaker": "Curator Mei",
      "text": "Please do. The artist wants the shapes to emerge slowly; that is an artistic choice we need to preserve."
    },
    {
      "id": "p06-c-15-s04",
      "speaker": "Installer Tomas",
      "text": "How about this position? Stand by the doorway and see what a visitor would see."
    },
    {
      "id": "p06-c-15-s05",
      "speaker": "Curator Mei",
      "text": "That is better. The pale shapes are visible now, and there is no bright reflection across the artwork."
    },
    {
      "id": "p06-c-15-s06",
      "speaker": "Installer Tomas",
      "text": "Shall I secure the lamp here?"
    },
    {
      "id": "p06-c-15-s07",
      "speaker": "Curator Mei",
      "text": "Yes. Keep this position, and I will check it once more after the other room lights are on."
    }
  ],
