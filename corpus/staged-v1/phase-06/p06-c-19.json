{
  "id": "p06-c-19",
  "title_zh": "缩短距离后继续练习击球",
  "topic_id": "leisure",
  "scenario": {
    "id": "beginner-cricket-batting-practice",
    "label_zh": "调整初学板球击球练习",
    "goal_zh": "根据初学者遇到的困难改用更慢的近距离投球，并约定继续尝试"
  },
  "participants": [
    "Ollie",
    "Coach Farah"
  ],
  "context_zh": "奥利第一次参加板球体验，在多次没击中球后向教练法拉求助。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-19-s01",
      "speaker": "Ollie",
      "text": "I have barely touched the ball all morning. Maybe I am just not athletic enough for this."
    },
    {
      "id": "p06-c-19-s02",
      "speaker": "Coach Farah",
      "text": "You are learning a new movement. Let me see how you are holding the bat."
    },
    {
      "id": "p06-c-19-s03",
      "speaker": "Ollie",
      "text": "Like this. Should I stand closer?"
    },
    {
      "id": "p06-c-19-s04",
      "speaker": "Coach Farah",
      "text": "Stay on that mark. I will move closer and send the ball more slowly so you have time to watch it."
    },
    {
      "id": "p06-c-19-s05",
      "speaker": "Ollie",
      "text": "All right. I will have one more attempt before the break."
    },
    {
      "id": "p06-c-19-s06",
      "speaker": "Coach Farah",
      "text": "Good. You do not have to abandon the whole activity because the first few tries were difficult."
    },
    {
      "id": "p06-c-19-s07",
      "speaker": "Ollie",
      "text": "That slower ball was easier to follow. Could we do the same thing again?"
    },
    {
      "id": "p06-c-19-s08",
      "speaker": "Coach Farah",
      "text": "Yes. We will keep this distance for a few more tries."
    }
  ],
