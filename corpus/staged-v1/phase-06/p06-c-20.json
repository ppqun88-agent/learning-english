{
  "id": "p06-c-20",
  "title_zh": "商定父母周年聚餐的人数和时间",
  "topic_id": "relationships",
  "scenario": {
    "id": "parents-anniversary-table",
    "label_zh": "安排父母结婚周年聚餐",
    "goal_zh": "确定参加人数并为家庭纪念日协调见面时间。"
  },
  "participants": [
    "Daisy",
    "Marco"
  ],
  "context_zh": "兄妹黛西和马尔科为父母结婚周年安排一顿小型家庭聚餐。",
  "author": "author-phase06-c",
  "sentences": [
    {
      "id": "p06-c-20-s01",
      "speaker": "Daisy",
      "text": "Mum and Dad want their anniversary dinner to be a small affair, not a big party."
    },
    {
      "id": "p06-c-20-s02",
      "speaker": "Marco",
      "text": "Then it is just them, us, and our partners. Six people altogether."
    },
    {
      "id": "p06-c-20-s03",
      "speaker": "Daisy",
      "text": "Can everyone meet at the restaurant at seven on Saturday?"
    },
    {
      "id": "p06-c-20-s04",
      "speaker": "Marco",
      "text": "Yes. I checked with both partners, and Mum and Dad said seven suits them."
    },
    {
      "id": "p06-c-20-s05",
      "speaker": "Daisy",
      "text": "Would a single gold balloon by their chairs be too much?"
    },
    {
      "id": "p06-c-20-s06",
      "speaker": "Marco",
      "text": "No, that would be nice. I will ask the restaurant if we can bring it when I reserve the table."
    },
    {
      "id": "p06-c-20-s07",
      "speaker": "Daisy",
      "text": "And afterwards we can walk back to my flat for coffee, if they feel like it."
    },
    {
      "id": "p06-c-20-s08",
      "speaker": "Marco",
      "text": "Good plan. I will request a table for six at seven, and you can bring the decoration once they confirm it is allowed."
    }
  ],
