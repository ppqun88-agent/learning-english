{
  "id": "p07-a-03",
  "title_zh": "选定沿运河到老桥的散步路线",
  "topic_id": "travel",
  "scenario": {
    "id": "canal-walk-route-choice",
    "label_zh": "选择运河散步路线",
    "goal_zh": "问清运河步道、老桥与公共通行边界，并选定往返路线"
  },
  "participants": [
    "Amir",
    "Liv"
  ],
  "context_zh": "两位朋友想从游客中心出发散步，请工作人员说明路线。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-03-s01",
      "speaker": "Amir",
      "text": "We have about an hour. Is there a pleasant walk from here?"
    },
    {
      "id": "p07-a-03-s02",
      "speaker": "Liv",
      "text": "Follow the path beside the canal. It's flat all the way to the old bridge."
    },
    {
      "id": "p07-a-03-s03",
      "speaker": "Amir",
      "text": "What's beyond the bridge? The map seems to stop there."
    },
    {
      "id": "p07-a-03-s04",
      "speaker": "Liv",
      "text": "There's a charming row of old cottages, but the public path ends just before their gardens."
    },
    {
      "id": "p07-a-03-s05",
      "speaker": "Amir",
      "text": "Then we'll walk to the bridge, look at the cottages from there, and come back."
    },
    {
      "id": "p07-a-03-s06",
      "speaker": "Liv",
      "text": "That should fit your time. Use this gate to reach the path."
    }
  ],
