{
  "id": "p07-a-05",
  "title_zh": "先拍摄园中昆虫再请专家辨认",
  "topic_id": "nature",
  "scenario": {
    "id": "garden-insect-photo-identification",
    "label_zh": "记录待辨认的花园昆虫",
    "goal_zh": "描述昆虫可见特征，决定暂记为未辨认昆虫并补充原位照片和地点"
  },
  "participants": [
    "Mae",
    "Dev"
  ],
  "context_zh": "志愿者在社区花园做生物调查记录，遇到无法确定种类的昆虫。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-05-s01",
      "speaker": "Mae",
      "text": "There's a tiny bug on that bush. Should I put it on the survey sheet?"
    },
    {
      "id": "p07-a-05-s02",
      "speaker": "Dev",
      "text": "Yes, but don't guess its name. This is a biological survey, so an uncertain record needs to be marked as uncertain."
    },
    {
      "id": "p07-a-05-s03",
      "speaker": "Mae",
      "text": "If I look closely, I can see two pale spots on its back."
    },
    {
      "id": "p07-a-05-s04",
      "speaker": "Dev",
      "text": "That may be a useful characteristic, but a photograph would help the specialist more."
    },
    {
      "id": "p07-a-05-s05",
      "speaker": "Mae",
      "text": "Should we classify it as a beetle for now?"
    },
    {
      "id": "p07-a-05-s06",
      "speaker": "Dev",
      "text": "Not until we're sure. Put it under unidentified insects and attach the photo."
    },
    {
      "id": "p07-a-05-s07",
      "speaker": "Mae",
      "text": "All right. I'll photograph it where it is and record the location."
    }
  ],
