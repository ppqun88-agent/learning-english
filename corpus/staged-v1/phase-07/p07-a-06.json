{
  "id": "p07-a-06",
  "title_zh": "分工准备蘑菇意面和生菜沙拉",
  "topic_id": "food",
  "scenario": {
    "id": "shared-dinner-preparation",
    "label_zh": "分工准备晚饭",
    "goal_zh": "商定晚餐分工、菜品和份量"
  },
  "participants": [
    "Ben",
    "Iris"
  ],
  "context_zh": "室友使用现有食材准备两人的晚餐，并商量桌面布置。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-06-s01",
      "speaker": "Ben",
      "text": "We've got mushrooms and a bunch of parsley. Shall we make pasta for the two of us?"
    },
    {
      "id": "p07-a-06-s02",
      "speaker": "Iris",
      "text": "Yes. Mushrooms and parsley are a good combination. I'll start the sauce if you chop the herbs."
    },
    {
      "id": "p07-a-06-s03",
      "speaker": "Ben",
      "text": "What about these salad leaves? I tried one, and it's quite bitter."
    },
    {
      "id": "p07-a-06-s04",
      "speaker": "Iris",
      "text": "Let's use a few with the mild lettuce, rather than making the whole salad from them."
    },
    {
      "id": "p07-a-06-s05",
      "speaker": "Ben",
      "text": "Good idea. I'll make enough salad for two and put the rest of the lettuce away."
    },
    {
      "id": "p07-a-06-s06",
      "speaker": "Iris",
      "text": "I'll set the table while the sauce cooks. Can we use that little candle in its glass holder?"
    },
    {
      "id": "p07-a-06-s07",
      "speaker": "Ben",
      "text": "Of course. I'll put it in the middle once I've finished chopping."
    }
  ],
