{
  "id": "p07-a-09",
  "title_zh": "把咖啡馆调查结论限定在实际样本内",
  "topic_id": "reasoning",
  "scenario": {
    "id": "survey-evidence",
    "label_zh": "讨论调查证据",
    "goal_zh": "核对样本、局限与结论的依据"
  },
  "participants": [
    "Leila",
    "Finn"
  ],
  "context_zh": "两名学生审查自己在一家咖啡馆收集的顾客问卷，避免把小样本解释成全城趋势。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-09-s01",
      "speaker": "Leila",
      "text": "Our draft says the whole city prefers reusable cups. Is the evidence really that convincing?"
    },
    {
      "id": "p07-a-09-s02",
      "speaker": "Finn",
      "text": "No. We only asked people in one café, so there's a clear risk of bias."
    },
    {
      "id": "p07-a-09-s03",
      "speaker": "Leila",
      "text": "But two other class groups got similar results. Isn't that enough?"
    },
    {
      "id": "p07-a-09-s04",
      "speaker": "Finn",
      "text": "It might be a coincidence. They used the same café on different days."
    },
    {
      "id": "p07-a-09-s05",
      "speaker": "Leila",
      "text": "Then we can't claim any certainty about the city's habits."
    },
    {
      "id": "p07-a-09-s06",
      "speaker": "Finn",
      "text": "Exactly. A comparative study across different neighbourhoods would tell us more."
    },
    {
      "id": "p07-a-09-s07",
      "speaker": "Leila",
      "text": "Should we call our report a comprehensive survey?"
    },
    {
      "id": "p07-a-09-s08",
      "speaker": "Finn",
      "text": "Definitely not. Describe this sample and cite the three sets of questionnaires separately."
    },
    {
      "id": "p07-a-09-s09",
      "speaker": "Leila",
      "text": "I'm convinced. I'll change the claim to 'Most people in our café sample preferred reusable cups.'"
    },
    {
      "id": "p07-a-09-s10",
      "speaker": "Finn",
      "text": "Good. I'll add the sample size and explain how the location limits the conclusion."
    }
  ],
