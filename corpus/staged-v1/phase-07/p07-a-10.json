{
  "id": "p07-a-10",
  "title_zh": "因乳房肿块预约诊所评估",
  "topic_id": "health",
  "scenario": {
    "id": "routine-clinic-booking",
    "label_zh": "描述问题并预约就诊",
    "goal_zh": "准确说明不适位置并确认预约时间"
  },
  "participants": [
    "Alina",
    "Jo"
  ],
  "context_zh": "虚构患者向诊所接待员描述需要就诊的原因；对话只安排评估，不判断病因。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-10-s01",
      "speaker": "Alina",
      "text": "I'd like an appointment at the clinic. I've noticed a lump in my left breast."
    },
    {
      "id": "p07-a-10-s02",
      "speaker": "Jo",
      "text": "When did you first notice it? I'll put that in the message for the clinician."
    },
    {
      "id": "p07-a-10-s03",
      "speaker": "Alina",
      "text": "Yesterday. I'm concerned because my mother had cancer, and I don't know what this means."
    },
    {
      "id": "p07-a-10-s04",
      "speaker": "Jo",
      "text": "I can arrange an assessment, but I can't tell you the cause over the phone. Would tomorrow at ten work for you?"
    },
    {
      "id": "p07-a-10-s05",
      "speaker": "Alina",
      "text": "Yes. Will the clinician have the message?"
    },
    {
      "id": "p07-a-10-s06",
      "speaker": "Jo",
      "text": "Yes, I've recorded what you told me. Your appointment is confirmed for ten tomorrow."
    },
    {
      "id": "p07-a-10-s07",
      "speaker": "Alina",
      "text": "Thank you. I'll be there."
    }
  ],
