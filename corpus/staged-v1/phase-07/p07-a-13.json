{
  "id": "p07-a-13",
  "title_zh": "排练战争短剧的撤离提示",
  "topic_id": "leisure",
  "scenario": {
    "id": "historical-play-scene-rehearsal",
    "label_zh": "核对历史短剧撤离场景的提示",
    "goal_zh": "澄清虚构战争场景、录音提示与道具处理，约定慢速排练撤离段落"
  },
  "participants": [
    "Dora",
    "Felix"
  ],
  "context_zh": "业余剧团排练一出虚构的内战题材短剧，用录音表现轰炸，不使用武器或实弹。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-13-s01",
      "speaker": "Dora",
      "text": "Before we start, does the whole cast understand where this scene takes place?"
    },
    {
      "id": "p07-a-13-s02",
      "speaker": "Felix",
      "text": "In a school during a civil war. My character is the commander trying to get everyone out."
    },
    {
      "id": "p07-a-13-s03",
      "speaker": "Dora",
      "text": "Right. The bombing is represented by the recording, not anything happening on stage."
    },
    {
      "id": "p07-a-13-s04",
      "speaker": "Felix",
      "text": "When do I give the command to leave? Before the noise or after it?"
    },
    {
      "id": "p07-a-13-s05",
      "speaker": "Dora",
      "text": "After the first sound. Everyone needs to hear your line clearly."
    },
    {
      "id": "p07-a-13-s06",
      "speaker": "Felix",
      "text": "And what do I do with the object I find on the floor?"
    },
    {
      "id": "p07-a-13-s07",
      "speaker": "Dora",
      "text": "It's a wooden prop shaped like a bullet, not a real one. Leave it where it is; the audience only needs to notice it."
    },
    {
      "id": "p07-a-13-s08",
      "speaker": "Felix",
      "text": "Understood. Let's run the sound cue and the exit once at walking pace."
    }
  ],
