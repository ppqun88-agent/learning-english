{
  "id": "p07-a-15",
  "title_zh": "约好提前到场为朋友的决赛加油",
  "topic_id": "leisure",
  "scenario": {
    "id": "championship-spectator-meeting",
    "label_zh": "安排锦标赛决赛观赛会合",
    "goal_zh": "约定提前在入口会合并分工携带门票，以共同为参赛朋友加油"
  },
  "participants": [
    "Milo",
    "Tess"
  ],
  "context_zh": "两位朋友准备观看熟人的地方锦标赛决赛，商量会合和入场安排。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-15-s01",
      "speaker": "Milo",
      "text": "Are you going to the championship final on Saturday? Sana's team made it through."
    },
    {
      "id": "p07-a-15-s02",
      "speaker": "Tess",
      "text": "Definitely. I bet she's nervous; it's her first final."
    },
    {
      "id": "p07-a-15-s03",
      "speaker": "Milo",
      "text": "She said she was. Seeing familiar faces might boost her confidence."
    },
    {
      "id": "p07-a-15-s04",
      "speaker": "Tess",
      "text": "Then let's sit together and cheer for her team. What time should we meet?"
    },
    {
      "id": "p07-a-15-s05",
      "speaker": "Milo",
      "text": "The doors open at two. There are bound to be queues, so how about a quarter to two by the main entrance?"
    },
    {
      "id": "p07-a-15-s06",
      "speaker": "Tess",
      "text": "Perfect. I'll bring the tickets, and we can go straight in when the doors open."
    }
  ],
