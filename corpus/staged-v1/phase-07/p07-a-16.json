{
  "id": "p07-a-16",
  "title_zh": "先向同伴试讲展示开场",
  "topic_id": "learning",
  "scenario": {
    "id": "student-presentation-support-plan",
    "label_zh": "约定先练习课堂展示的开场",
    "goal_zh": "说明公开发言顾虑，并同意借助笔记向同伴试讲开场"
  },
  "participants": [
    "Noor",
    "Jasper"
  ],
  "context_zh": "一名学生担心课堂展示时无法集中注意，同伴提出先做小范围练习。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-16-s01",
      "speaker": "Noor",
      "text": "I know the material, but speaking in front of the class feels really challenging."
    },
    {
      "id": "p07-a-16-s02",
      "speaker": "Jasper",
      "text": "Which part worries you most?"
    },
    {
      "id": "p07-a-16-s03",
      "speaker": "Noor",
      "text": "My concentration goes as soon as everyone looks at me. I don't know how I'll cope if I forget the first line."
    },
    {
      "id": "p07-a-16-s04",
      "speaker": "Jasper",
      "text": "Would it help to have the opening on a card? You could try it with just me first."
    },
    {
      "id": "p07-a-16-s05",
      "speaker": "Noor",
      "text": "Maybe. I feel capable of explaining it in a conversation, just not to a room full of people."
    },
    {
      "id": "p07-a-16-s06",
      "speaker": "Jasper",
      "text": "Then start as if you're explaining it to me. We only need to practise the opening today."
    },
    {
      "id": "p07-a-16-s07",
      "speaker": "Noor",
      "text": "All right. I'll use my notes and try the first minute now."
    }
  ],
