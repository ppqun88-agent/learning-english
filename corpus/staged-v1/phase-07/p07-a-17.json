{
  "id": "p07-a-17",
  "title_zh": "排除弹窗干扰并导出可读文件",
  "topic_id": "work",
  "scenario": {
    "id": "document-export-troubleshooting",
    "label_zh": "排查文档导出操作的困惑",
    "goal_zh": "暂时减少通知干扰，区分保存与导出，保留原件并确认导出的 PDF 可读"
  },
  "participants": [
    "Hana",
    "Rob"
  ],
  "context_zh": "同事帮助新员工使用虚构的内部文档工具导出文件，当前会话只暂停普通通知。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-17-s01",
      "speaker": "Hana",
      "text": "Can you help? I'm constantly closing pop-ups, and I still haven't made the PDF."
    },
    {
      "id": "p07-a-17-s02",
      "speaker": "Rob",
      "text": "The constant interruptions aren't helping. Shall we pause these ordinary reminders for ten minutes?"
    },
    {
      "id": "p07-a-17-s03",
      "speaker": "Hana",
      "text": "Yes, please. The export menu is confusing too. What's the difference between these two buttons?"
    },
    {
      "id": "p07-a-17-s04",
      "speaker": "Rob",
      "text": "Let me clarify that. 'Save' keeps the editable file; 'Export' lets you convert it to a PDF."
    },
    {
      "id": "p07-a-17-s05",
      "speaker": "Hana",
      "text": "That clears up the confusion. I'll keep the original and export a separate copy."
    },
    {
      "id": "p07-a-17-s06",
      "speaker": "Rob",
      "text": "Good. Now open the PDF and check the last page."
    },
    {
      "id": "p07-a-17-s07",
      "speaker": "Hana",
      "text": "It opens, and all the pages are here. Thanks. I'll turn the reminders back on now."
    }
  ],
