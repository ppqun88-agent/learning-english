{
  "id": "p07-a-19",
  "title_zh": "先请专业人员检查社区围墙",
  "topic_id": "community",
  "scenario": {
    "id": "community-wall-inspection-plan",
    "label_zh": "安排社区围墙专业检查",
    "goal_zh": "暂不决定围墙材料或施工方法，约定联系顾问检查并在报告后比较修复选项"
  },
  "participants": [
    "Gail",
    "Arun"
  ],
  "context_zh": "社区负责人发现花园围墙松动，与维护联络人商定检查和后续报价步骤。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-19-s01",
      "speaker": "Gail",
      "text": "A loose brick has fallen from the garden wall. I've kept people away from that side."
    },
    {
      "id": "p07-a-19-s02",
      "speaker": "Arun",
      "text": "Thanks. Do we know whether the rest of the wall is sound?"
    },
    {
      "id": "p07-a-19-s03",
      "speaker": "Gail",
      "text": "No. Someone suggested replacing it with concrete, but we haven't had it inspected."
    },
    {
      "id": "p07-a-19-s04",
      "speaker": "Arun",
      "text": "Then we shouldn't choose the construction method yet. Let's consult a building professional first."
    },
    {
      "id": "p07-a-19-s05",
      "speaker": "Gail",
      "text": "I can contact the consultant who inspected the hall last year."
    },
    {
      "id": "p07-a-19-s06",
      "speaker": "Arun",
      "text": "Ask whether the wall can be repaired and what we'd need to know before we construct anything new."
    },
    {
      "id": "p07-a-19-s07",
      "speaker": "Gail",
      "text": "I'll request an inspection and keep the area closed. We can compare the options after we have the report."
    },
    {
      "id": "p07-a-19-s08",
      "speaker": "Arun",
      "text": "Agreed. Don't ask anyone to start work before that."
    }
  ],
