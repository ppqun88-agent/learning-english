{
  "id": "p07-a-20",
  "title_zh": "选用较小场地并保留预算余量",
  "topic_id": "work",
  "scenario": {
    "id": "event-budget",
    "label_zh": "调整活动预算",
    "goal_zh": "比较场地方案并明确预算取舍"
  },
  "participants": [
    "Imani",
    "Seth"
  ],
  "context_zh": "活动筹备者比较两个虚构场地的报价，为四十人的工作坊选择场地。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-20-s01",
      "speaker": "Imani",
      "text": "The larger hall has a capacity of a hundred, but we're expecting forty people."
    },
    {
      "id": "p07-a-20-s02",
      "speaker": "Seth",
      "text": "The smaller room holds fifty and costs considerably less: three hundred pounds rather than six hundred."
    },
    {
      "id": "p07-a-20-s03",
      "speaker": "Imani",
      "text": "Let's calculate the whole cost. Are chairs and cleaning included in both prices?"
    },
    {
      "id": "p07-a-20-s04",
      "speaker": "Seth",
      "text": "Yes. I've checked the contract for each room. Both totals include them."
    },
    {
      "id": "p07-a-20-s05",
      "speaker": "Imani",
      "text": "A three-hundred-pound saving is considerable. Still, we should make a conservative estimate of what we'll collect in ticket sales."
    },
    {
      "id": "p07-a-20-s06",
      "speaker": "Seth",
      "text": "Agreed. If we budget for thirty paying guests, we won't depend on a full house."
    },
    {
      "id": "p07-a-20-s07",
      "speaker": "Imani",
      "text": "That makes cost our main consideration, provided everyone can fit comfortably."
    },
    {
      "id": "p07-a-20-s08",
      "speaker": "Seth",
      "text": "The smaller room's seated layout has space for fifty, so forty will fit."
    },
    {
      "id": "p07-a-20-s09",
      "speaker": "Imani",
      "text": "Then let's choose that room and keep the saving as a reserve. I'll ask them for the booking form."
    }
  ],
