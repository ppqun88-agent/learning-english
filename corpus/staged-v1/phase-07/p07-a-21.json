{
  "id": "p07-a-21",
  "title_zh": "缩小社区资助草稿的范围并分工补充细节",
  "topic_id": "work",
  "scenario": {
    "id": "community-grant-draft-review",
    "label_zh": "缩小社区活动资助草稿范围",
    "goal_zh": "将宽泛活动提案聚焦为邻里园艺交流，分工补充实际资源并安排委员会提交前核对"
  },
  "participants": [
    "Ruth",
    "Jonah"
  ],
  "context_zh": "社区组织的主席和志愿者审查尚未提交的活动资助草稿。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-21-s01",
      "speaker": "Ruth",
      "text": "As chairman of the committee, I'd like us to agree on a clearer plan before we submit this."
    },
    {
      "id": "p07-a-21-s02",
      "speaker": "Jonah",
      "text": "Is the current proposal too broad? It covers everything from gardening to evening classes."
    },
    {
      "id": "p07-a-21-s03",
      "speaker": "Ruth",
      "text": "Yes. What's the core purpose of the project?"
    },
    {
      "id": "p07-a-21-s04",
      "speaker": "Jonah",
      "text": "Helping new residents meet their neighbours. We could start with two shared gardening sessions."
    },
    {
      "id": "p07-a-21-s05",
      "speaker": "Ruth",
      "text": "Good. The first session could comprise a short introduction, paired planting, and tea afterwards."
    },
    {
      "id": "p07-a-21-s06",
      "speaker": "Jonah",
      "text": "What can the volunteers contribute besides their time?"
    },
    {
      "id": "p07-a-21-s07",
      "speaker": "Ruth",
      "text": "Some have offered spare tools. We should describe that contribution without putting an invented price on it."
    },
    {
      "id": "p07-a-21-s08",
      "speaker": "Jonah",
      "text": "I'll narrow the activities and list the tools that have actually been offered."
    },
    {
      "id": "p07-a-21-s09",
      "speaker": "Ruth",
      "text": "And I'll ask the other members to check the plan before we send anything."
    }
  ],
