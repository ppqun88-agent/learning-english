{
  "id": "p07-a-25",
  "title_zh": "为展览争议报道选取平衡的短片段",
  "topic_id": "work",
  "scenario": {
    "id": "exhibition-news-clip-edit",
    "label_zh": "修改展览收费争议报道的片段选择",
    "goal_zh": "补入画廊解释并保留居民异议，约定修订剪辑后核对引语再交电视台"
  },
  "participants": [
    "Keira",
    "Omar"
  ],
  "context_zh": "社区记者和编辑为虚构地方电视台准备一段展览报道，讨论应保留的不同观点。",
  "author": "author-phase07-a",
  "sentences": [
    {
      "id": "p07-a-25-s01",
      "speaker": "Keira",
      "text": "The local broadcaster wants a short piece about the new exhibition for tomorrow's broadcast."
    },
    {
      "id": "p07-a-25-s02",
      "speaker": "Omar",
      "text": "Are we explaining the art, or the controversy over the entrance charge?"
    },
    {
      "id": "p07-a-25-s03",
      "speaker": "Keira",
      "text": "Both, briefly. The charge is controversial because the gallery used to be free."
    },
    {
      "id": "p07-a-25-s04",
      "speaker": "Omar",
      "text": "My chief concern is that our current edit includes three complaints but no explanation from the gallery."
    },
    {
      "id": "p07-a-25-s05",
      "speaker": "Keira",
      "text": "We have the manager's interview. She says the charge helps cover the longer opening hours."
    },
    {
      "id": "p07-a-25-s06",
      "speaker": "Omar",
      "text": "Then use a clip of that answer alongside one resident's objection. Don't make either speaker sound as if they represent everyone."
    },
    {
      "id": "p07-a-25-s07",
      "speaker": "Keira",
      "text": "I'll revise the edit and keep the price and opening times on screen."
    },
    {
      "id": "p07-a-25-s08",
      "speaker": "Omar",
      "text": "Send me that version before it goes to the station. I'll check the quotes against the full interviews."
    }
  ],
