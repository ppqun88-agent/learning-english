{
  "id": "p07-b-02",
  "title_zh": "安排县议会报道的核查与编辑",
  "topic_id": "work",
  "scenario": {
    "id": "local-paper-council-coverage",
    "label_zh": "安排地方议会报道的核查与编辑",
    "goal_zh": "明确报道范围、核对资料的截止时间和编辑分工"
  },
  "participants": [
    "Ruth",
    "Amir"
  ],
  "context_zh": "虚构地方报的编辑露丝与记者阿米尔安排一期会议报道，文中不涉及真实新闻。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-02-s01",
      "speaker": "Ruth",
      "text": "What do you have for our next edition?"
    },
    {
      "id": "p07-b-02-s02",
      "speaker": "Amir",
      "text": "A report on yesterday's council meeting. They discussed bus services across the county."
    },
    {
      "id": "p07-b-02-s03",
      "speaker": "Ruth",
      "text": "Does our coverage include the villages, or only the main town?"
    },
    {
      "id": "p07-b-02-s04",
      "speaker": "Amir",
      "text": "Only the town so far. I haven't checked the proposed village routes."
    },
    {
      "id": "p07-b-02-s05",
      "speaker": "Ruth",
      "text": "Please check those before you edit the draft. People outside town will want to know what might change."
    },
    {
      "id": "p07-b-02-s06",
      "speaker": "Amir",
      "text": "What's the deadline for the revised version?"
    },
    {
      "id": "p07-b-02-s07",
      "speaker": "Ruth",
      "text": "Noon tomorrow. That's our editorial deadline, not the date the council will decide anything."
    },
    {
      "id": "p07-b-02-s08",
      "speaker": "Amir",
      "text": "Understood. I'll compare the draft with the route proposal and clearly label it as a proposal."
    },
    {
      "id": "p07-b-02-s09",
      "speaker": "Ruth",
      "text": "Good. Send me the revised text and the document link together."
    },
    {
      "id": "p07-b-02-s10",
      "speaker": "Amir",
      "text": "I will. I'll call the transport office this afternoon about anything the document doesn't explain."
    }
  ],
