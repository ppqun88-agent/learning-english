{
  "id": "p07-b-05",
  "title_zh": "明确西部短剧门响后的出场提示",
  "topic_id": "leisure",
  "scenario": {
    "id": "western-play-cue-rehearsal",
    "label_zh": "约定西部短剧的出场提示",
    "goal_zh": "澄清表演提示与停顿的目的并约定从门响处重排"
  },
  "participants": [
    "Bea",
    "Oscar"
  ],
  "context_zh": "社区剧团正在排练一出虚构西部短剧；贝娅负责舞台技术，奥斯卡扮演牛仔。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-05-s01",
      "speaker": "Bea",
      "text": "Why does the cowboy wait outside after the door opens? I thought that was your entrance."
    },
    {
      "id": "p07-b-05-s02",
      "speaker": "Oscar",
      "text": "I deliberately pause there. He's checking whether the room is empty."
    },
    {
      "id": "p07-b-05-s03",
      "speaker": "Bea",
      "text": "The crew thought you'd missed your cue, so they played the door sound twice."
    },
    {
      "id": "p07-b-05-s04",
      "speaker": "Oscar",
      "text": "Oh, that explains it. I want a dramatic pause, but not one that looks like a mistake."
    },
    {
      "id": "p07-b-05-s05",
      "speaker": "Bea",
      "text": "What duration do you have in mind? Two seconds, or closer to five?"
    },
    {
      "id": "p07-b-05-s06",
      "speaker": "Oscar",
      "text": "Two should be enough. Then I'll take one step through the doorway."
    },
    {
      "id": "p07-b-05-s07",
      "speaker": "Bea",
      "text": "Let's use the first door sound as the cue and keep the lights steady while you wait."
    },
    {
      "id": "p07-b-05-s08",
      "speaker": "Oscar",
      "text": "Agreed. Can we start again from the door sound so everyone can see the timing?"
    }
  ],
