{
  "id": "p07-b-06",
  "title_zh": "发现二手桌裂缝后决定不买",
  "topic_id": "services",
  "scenario": {
    "id": "secondhand-table-condition-choice",
    "label_zh": "查看二手桌状况后决定不购买",
    "goal_zh": "核对裂缝、桌腿和价格后决定不购买有损坏的桌子"
  },
  "participants": [
    "Mina",
    "Hugh"
  ],
  "context_zh": "顾客米娜正在二手家具店查看一张带雕刻桌腿的小桌子。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-06-s01",
      "speaker": "Mina",
      "text": "You're the dealer I spoke to about the small oak table, aren't you?"
    },
    {
      "id": "p07-b-06-s02",
      "speaker": "Hugh",
      "text": "Yes. This is it. It's a decent table for the price, though it isn't in perfect condition."
    },
    {
      "id": "p07-b-06-s03",
      "speaker": "Mina",
      "text": "I like the curved legs. Is that dark line part of the decoration?"
    },
    {
      "id": "p07-b-06-s04",
      "speaker": "Hugh",
      "text": "No, that's a crack. It goes along the side of the leg."
    },
    {
      "id": "p07-b-06-s05",
      "speaker": "Mina",
      "text": "Has anyone checked whether the leg is still strong enough?"
    },
    {
      "id": "p07-b-06-s06",
      "speaker": "Hugh",
      "text": "Not professionally. I can lower the price, but I can't promise the leg won't need repair."
    },
    {
      "id": "p07-b-06-s07",
      "speaker": "Mina",
      "text": "Then I'll leave it. I need a table I can use immediately, not another repair project."
    },
    {
      "id": "p07-b-06-s08",
      "speaker": "Hugh",
      "text": "Fair enough. I'll let you know if a similar one arrives without that damage."
    }
  ],
