{
  "id": "p07-b-08",
  "title_zh": "数据库崩溃后先保留原件并检查备份",
  "topic_id": "work",
  "scenario": {
    "id": "database-crash-backup-check",
    "label_zh": "数据库崩溃后约定先检查备份",
    "goal_zh": "保留原文件并分工检查磁盘与备份再决定恢复操作"
  },
  "participants": [
    "Tessa",
    "Robin"
  ],
  "context_zh": "办公室数据库导入失败后，两位同事商定排查顺序；对话不声称已经恢复数据。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-08-s01",
      "speaker": "Tessa",
      "text": "Did the database crash while you were importing the orders?"
    },
    {
      "id": "p07-b-08-s02",
      "speaker": "Robin",
      "text": "Yes. The program closed, and now it won't open the file."
    },
    {
      "id": "p07-b-08-s03",
      "speaker": "Tessa",
      "text": "Did the disk check detect any errors?"
    },
    {
      "id": "p07-b-08-s04",
      "speaker": "Robin",
      "text": "I haven't run it yet. Should I delete the damaged file and start again?"
    },
    {
      "id": "p07-b-08-s05",
      "speaker": "Tessa",
      "text": "Not yet. We don't know whether the file is damaged, and yesterday's backup may be missing today's orders."
    },
    {
      "id": "p07-b-08-s06",
      "speaker": "Robin",
      "text": "Then I'll leave the original alone and check which backup files we have."
    },
    {
      "id": "p07-b-08-s07",
      "speaker": "Tessa",
      "text": "Good. I'll ask IT to check the disk before we try opening another copy."
    },
    {
      "id": "p07-b-08-s08",
      "speaker": "Robin",
      "text": "Let's compare what we find before making any changes."
    }
  ],
