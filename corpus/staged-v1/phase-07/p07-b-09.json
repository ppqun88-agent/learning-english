{
  "id": "p07-b-09",
  "title_zh": "选择水下窗口等候海豹游近",
  "topic_id": "nature",
  "scenario": {
    "id": "aquarium-seal-viewing-choice",
    "label_zh": "选择海豹池的水下观察位置",
    "goal_zh": "解释展区观察条件并选择下层窗口等候海豹"
  },
  "participants": [
    "Asha",
    "Kit"
  ],
  "context_zh": "游客阿莎在水族馆向工作人员基特询问海豹观察位置。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-09-s01",
      "speaker": "Asha",
      "text": "That little seal is cute. Can we see it swimming from here?"
    },
    {
      "id": "p07-b-09-s02",
      "speaker": "Kit",
      "text": "Sometimes, but the underwater window gives you a better view of its dive."
    },
    {
      "id": "p07-b-09-s03",
      "speaker": "Asha",
      "text": "I'm curious about the depth of the pool. It looks shallow from this side."
    },
    {
      "id": "p07-b-09-s04",
      "speaker": "Kit",
      "text": "The sign says four metres at the deep end. The floor slopes downwards beyond those rocks."
    },
    {
      "id": "p07-b-09-s05",
      "speaker": "Asha",
      "text": "So the creature hasn't disappeared behind them. It's probably swimming below the window ledge."
    },
    {
      "id": "p07-b-09-s06",
      "speaker": "Kit",
      "text": "Possibly. We can't see all of the pool from one spot."
    },
    {
      "id": "p07-b-09-s07",
      "speaker": "Asha",
      "text": "Let's go to the lower window and wait quietly instead of tapping on the glass."
    },
    {
      "id": "p07-b-09-s08",
      "speaker": "Kit",
      "text": "It's just down these steps. There's also a ramp on your left."
    }
  ],
