{
  "id": "p07-b-10",
  "title_zh": "确定旱灾援助下一轮的物资分发安排",
  "topic_id": "community",
  "scenario": {
    "id": "drought-relief-delivery-plan",
    "label_zh": "安排旱灾援助物资的下一轮分发",
    "goal_zh": "核对农户求助与现有物资并确定分发次序及联系人"
  },
  "participants": [
    "Samira",
    "Owen"
  ],
  "context_zh": "虚构旱灾救助站的工作人员依据现场登记记录安排物资，不涉及真实灾情或政策。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-10-s01",
      "speaker": "Samira",
      "text": "The drought has left several farms without enough water. The calls this morning sound desperate."
    },
    {
      "id": "p07-b-10-s02",
      "speaker": "Owen",
      "text": "What do the farmers say they need most urgently?"
    },
    {
      "id": "p07-b-10-s03",
      "speaker": "Samira",
      "text": "Drinking water first. One family has lost its entire crop and desperately needs a delivery today."
    },
    {
      "id": "p07-b-10-s04",
      "speaker": "Owen",
      "text": "The destruction of the crops is terrible, but we can't solve the whole crisis with one van."
    },
    {
      "id": "p07-b-10-s05",
      "speaker": "Samira",
      "text": "Agreed. We have enough bottled water for today's registered households. How should we distribute it?"
    },
    {
      "id": "p07-b-10-s06",
      "speaker": "Owen",
      "text": "Let's start with the people who cannot reach the collection point. I'll phone them to confirm they're home."
    },
    {
      "id": "p07-b-10-s07",
      "speaker": "Samira",
      "text": "I'll prepare the boxes and update the distribution list so nobody gets missed or counted twice."
    },
    {
      "id": "p07-b-10-s08",
      "speaker": "Owen",
      "text": "Good. Once the driver confirms the route, we can give those households an arrival window."
    },
    {
      "id": "p07-b-10-s09",
      "speaker": "Samira",
      "text": "I'll also keep the other requests on the list for tomorrow. We shouldn't promise supplies we don't yet have."
    }
  ],
