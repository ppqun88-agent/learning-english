{
  "id": "p07-b-13",
  "title_zh": "缩小活动预约系统的首版交付范围",
  "topic_id": "work",
  "scenario": {
    "id": "project-delivery",
    "label_zh": "协调项目交付",
    "goal_zh": "澄清依赖、范围、风险与承诺"
  },
  "participants": [
    "Elise",
    "Tariq"
  ],
  "context_zh": "虚构项目团队面对新增需求，协调活动预约系统的首版交付。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-13-s01",
      "speaker": "Elise",
      "text": "Demand for the new booking system is higher than we expected. Can we add group bookings before Friday's delivery?"
    },
    {
      "id": "p07-b-13-s02",
      "speaker": "Tariq",
      "text": "That feature is dependent on a payment update we don't control. We can't promise it for Friday."
    },
    {
      "id": "p07-b-13-s03",
      "speaker": "Elise",
      "text": "Individual bookings are crucial for the event launch. Could we release those first?"
    },
    {
      "id": "p07-b-13-s04",
      "speaker": "Tariq",
      "text": "Yes. The most efficient approach is to test that smaller version thoroughly instead of adding an unfinished feature."
    },
    {
      "id": "p07-b-13-s05",
      "speaker": "Elise",
      "text": "Would one shared test sheet help the team work more efficiently? We keep repeating the same checks."
    },
    {
      "id": "p07-b-13-s06",
      "speaker": "Tariq",
      "text": "It would. I'll assign each test once and record any failures there."
    },
    {
      "id": "p07-b-13-s07",
      "speaker": "Elise",
      "text": "Then Friday's version will handle individual bookings only. I'll tell the organisers that group bookings have no confirmed date."
    },
    {
      "id": "p07-b-13-s08",
      "speaker": "Tariq",
      "text": "Agreed. I'll flag any test failure that threatens even that smaller delivery."
    }
  ],
