{
  "id": "p07-b-17",
  "title_zh": "把夸大的销售趋势说明改为实际下降幅度",
  "topic_id": "work",
  "scenario": {
    "id": "sales-chart-description-correction",
    "label_zh": "修正销售图表的趋势说明",
    "goal_zh": "核对点线和变化幅度，约定使用不过度夸张的图表说明"
  },
  "participants": [
    "Hana",
    "Giles"
  ],
  "context_zh": "两名同事核对虚构销量图：四个月销量依次为120、119、119和118件。",
  "author": "author-phase07-b",
  "sentences": [
    {
      "id": "p07-b-17-s01",
      "speaker": "Hana",
      "text": "Why does this chart look as if sales fell dramatically? They went from a hundred and twenty to a hundred and eighteen."
    },
    {
      "id": "p07-b-17-s02",
      "speaker": "Giles",
      "text": "The vertical axis starts at a hundred and seventeen. That makes the downward curve look much steeper."
    },
    {
      "id": "p07-b-17-s03",
      "speaker": "Hana",
      "text": "Did sales actually decrease in every month?"
    },
    {
      "id": "p07-b-17-s04",
      "speaker": "Giles",
      "text": "No. The middle two months were both a hundred and nineteen. That red dot marks the second of them."
    },
    {
      "id": "p07-b-17-s05",
      "speaker": "Hana",
      "text": "Then the title 'A steep decline every month' isn't accurate."
    },
    {
      "id": "p07-b-17-s06",
      "speaker": "Giles",
      "text": "Agreed. I'll replace it with 'Sales fell by two units over four months' and show the monthly figures."
    },
    {
      "id": "p07-b-17-s07",
      "speaker": "Hana",
      "text": "Could you also show the full scale from zero so readers can judge the size of the change?"
    },
    {
      "id": "p07-b-17-s08",
      "speaker": "Giles",
      "text": "Yes. I'll keep the original values and change only the scale and the wording."
    }
  ],
