{
  "id": "p07-c-01",
  "title_zh": "了解大学电子制作入门工作坊的要求与费用",
  "topic_id": "learning",
  "scenario": {
    "id": "electronics-workshop-access-inquiry",
    "label_zh": "了解大学电子制作入门工作坊的要求与费用",
    "goal_zh": "核对入门工作坊的资格、设备和费用，并确定索取课程说明的下一步"
  },
  "participants": [
    "Leila",
    "Owen"
  ],
  "context_zh": "莱拉向大学工程学院工作人员询问向公众开放的周末工作坊。",
  "author": "author-phase07-c",
  "sentences": [
    {
      "id": "p07-c-01-s01",
      "speaker": "Leila",
      "text": "I have an enquiry about the weekend electronics workshop. Is it open to people who are not students here?"
    },
    {
      "id": "p07-c-01-s02",
      "speaker": "Owen",
      "text": "Yes. The faculty runs it for the local community as well as our own students."
    },
    {
      "id": "p07-c-01-s03",
      "speaker": "Leila",
      "text": "My knowledge is fairly elementary. I can change a battery, but that is about it."
    },
    {
      "id": "p07-c-01-s04",
      "speaker": "Owen",
      "text": "That is enough to start. We equip each table with a simple kit, and a tutor demonstrates every step."
    },
    {
      "id": "p07-c-01-s05",
      "speaker": "Leila",
      "text": "Will the kit enable me to build something that actually works?"
    },
    {
      "id": "p07-c-01-s06",
      "speaker": "Owen",
      "text": "You will make a small light. If you encounter a problem, the tutor can help you find it."
    },
    {
      "id": "p07-c-01-s07",
      "speaker": "Leila",
      "text": "What is the fee, and do I need to buy any parts?"
    },
    {
      "id": "p07-c-01-s08",
      "speaker": "Owen",
      "text": "It is twenty pounds, with all parts included. Shall I email you the course outline?"
    },
    {
      "id": "p07-c-01-s09",
      "speaker": "Leila",
      "text": "Yes, please. I would like to read it before I register."
    },
    {
      "id": "p07-c-01-s10",
      "speaker": "Owen",
      "text": "I will send it today. There is no need to reserve a place yet."
    }
  ],
