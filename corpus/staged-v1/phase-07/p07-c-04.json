{
  "id": "p07-c-04",
  "title_zh": "为打破纪念碗道歉并约定先保留碎片",
  "topic_id": "relationships",
  "scenario": {
    "id": "broken-keepsake-apology",
    "label_zh": "为打破纪念碗道歉并约定先保留碎片",
    "goal_zh": "承认损坏纪念物的责任，听取朋友感受并约定不擅自处理碎片"
  },
  "participants": [
    "Thomas",
    "Mei"
  ],
  "context_zh": "托马斯打破了梅的祖母留下的碗，两人在厨房谈论这件事。",
  "author": "author-phase07-c",
  "sentences": [
    {
      "id": "p07-c-04-s01",
      "speaker": "Thomas",
      "text": "I broke your grandmother's bowl while I was clearing the table. It was my fault."
    },
    {
      "id": "p07-c-04-s02",
      "speaker": "Mei",
      "text": "I am furious. I told you that shelf was not safe for anything heavy."
    },
    {
      "id": "p07-c-04-s03",
      "speaker": "Thomas",
      "text": "I was in a hurry, but that is not an excuse. I should have listened."
    },
    {
      "id": "p07-c-04-s04",
      "speaker": "Mei",
      "text": "That bowl had a lot of emotional significance for me. A replacement would not be the same."
    },
    {
      "id": "p07-c-04-s05",
      "speaker": "Thomas",
      "text": "I understand. I will not buy another one and pretend that fixes it."
    },
    {
      "id": "p07-c-04-s06",
      "speaker": "Mei",
      "text": "Thank you. Sorting through her things has already been difficult emotionally."
    },
    {
      "id": "p07-c-04-s07",
      "speaker": "Thomas",
      "text": "I hope you can forgive me eventually. Would you like me to put the pieces somewhere safe?"
    },
    {
      "id": "p07-c-04-s08",
      "speaker": "Mei",
      "text": "Yes, in that box, please. Do not try to repair them yet."
    },
    {
      "id": "p07-c-04-s09",
      "speaker": "Thomas",
      "text": "I will leave any decision about the pieces to you."
    },
    {
      "id": "p07-c-04-s10",
      "speaker": "Mei",
      "text": "That helps. I still have faith in you, but I need a little time to stop being upset."
    }
  ],
