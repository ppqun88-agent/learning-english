{
  "id": "p07-c-11",
  "title_zh": "删去口述历史报名表中的非必要身份问题",
  "topic_id": "community",
  "scenario": {
    "id": "inclusive-history-workshop-signup",
    "label_zh": "删去口述历史报名表中的非必要身份问题",
    "goal_zh": "删去非必要的身份问题，并明确自愿分享、跳过问题及允许公开引用的边界"
  },
  "participants": [
    "Tessa",
    "Daniel"
  ],
  "context_zh": "社区口述历史活动的两名组织者审核报名表和参加说明。",
  "author": "author-phase07-c",
  "sentences": [
    {
      "id": "p07-c-11-s01",
      "speaker": "Tessa",
      "text": "This is a public history forum, so why does the registration form ask whether someone is gay?"
    },
    {
      "id": "p07-c-11-s02",
      "speaker": "Daniel",
      "text": "I copied an old form. It also asks about gender and ethnic background, but none of that is needed to book a seat."
    },
    {
      "id": "p07-c-11-s03",
      "speaker": "Tessa",
      "text": "Let us remove those questions. People should have the freedom to decide which parts of their lives they share."
    },
    {
      "id": "p07-c-11-s04",
      "speaker": "Daniel",
      "text": "Agreed. We should not exclude anyone who leaves the optional questions blank, either."
    },
    {
      "id": "p07-c-11-s05",
      "speaker": "Tessa",
      "text": "I want people to speak freely during the discussion, without assuming that everything will appear online."
    },
    {
      "id": "p07-c-11-s06",
      "speaker": "Daniel",
      "text": "Then we need a separate request for permission before using any personal story in the exhibition."
    },
    {
      "id": "p07-c-11-s07",
      "speaker": "Tessa",
      "text": "That seems like the ethical approach. We must not exploit someone's difficult experience just because it makes a powerful display."
    },
    {
      "id": "p07-c-11-s08",
      "speaker": "Daniel",
      "text": "I will add a clear choice: attend without sharing, share only in the room, or discuss permission for a public quotation later."
    },
    {
      "id": "p07-c-11-s09",
      "speaker": "Tessa",
      "text": "Good. No public quotation should be approved just by signing up."
    },
    {
      "id": "p07-c-11-s10",
      "speaker": "Daniel",
      "text": "I will remove the identity questions and bring the revised permission wording to our next meeting."
    }
  ],
