{
  "id": "p07-c-20",
  "title_zh": "了解延期规则后决定按期归还预约书",
  "topic_id": "services",
  "scenario": {
    "id": "library-loan-extension-choice",
    "label_zh": "了解延期规则后决定按期归还预约书",
    "goal_zh": "澄清一般延期和预约书例外限制，决定按期归还当前书并保留阅读进度"
  },
  "participants": [
    "Wendy",
    "Sam"
  ],
  "context_zh": "读者电话询问图书馆的虚构借阅规则。",
  "author": "author-phase07-c",
  "sentences": [
    {
      "id": "p07-c-20-s01",
      "speaker": "Wendy",
      "text": "I have not finished the entire book. Could I get an extension on the loan?"
    },
    {
      "id": "p07-c-20-s02",
      "speaker": "Sam",
      "text": "Usually, yes. But someone has reserved this copy, so we cannot extend it."
    },
    {
      "id": "p07-c-20-s03",
      "speaker": "Wendy",
      "text": "Could you make an exception for just two more days?"
    },
    {
      "id": "p07-c-20-s04",
      "speaker": "Sam",
      "text": "I am afraid not. For reserved books, the loan must not exceed the original period."
    },
    {
      "id": "p07-c-20-s05",
      "speaker": "Wendy",
      "text": "I see. The delay is entirely my responsibility; I started it rather late."
    },
    {
      "id": "p07-c-20-s06",
      "speaker": "Sam",
      "text": "You can place another request after you return it. Your reading notes might help you pick up where you left off."
    },
    {
      "id": "p07-c-20-s07",
      "speaker": "Wendy",
      "text": "So, essentially, I need to return this copy tomorrow and wait my turn again."
    },
    {
      "id": "p07-c-20-s08",
      "speaker": "Sam",
      "text": "That is right. I can show you how to make the new request when you bring it in."
    },
    {
      "id": "p07-c-20-s09",
      "speaker": "Wendy",
      "text": "Thank you. I will note my page number and return it tomorrow."
    },
    {
      "id": "p07-c-20-s10",
      "speaker": "Sam",
      "text": "You are welcome. We are open until six."
    }
  ],
