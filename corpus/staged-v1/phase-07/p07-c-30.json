{
  "id": "p07-c-30",
  "title_zh": "商定住宅区阅览室的六周试办安排",
  "topic_id": "community",
  "scenario": {
    "id": "estate-reading-room-pilot-plan",
    "label_zh": "商定住宅区阅览室的六周试办安排",
    "goal_zh": "选定住宅区获准使用的场所和可收纳家具，约定六周试办及反馈安排"
  },
  "participants": [
    "Moira",
    "Ken"
  ],
  "context_zh": "居民委员会讨论已获场地许可的周六阅览室试办方案。",
  "author": "author-phase07-c",
  "sentences": [
    {
      "id": "p07-c-30-s01",
      "speaker": "Moira",
      "text": "Could we establish a reading room on the estate without renting a shop elsewhere?"
    },
    {
      "id": "p07-c-30-s02",
      "speaker": "Ken",
      "text": "The old laundry building is available on Saturdays. It is the only shared facility we can use without paying rent."
    },
    {
      "id": "p07-c-30-s03",
      "speaker": "Moira",
      "text": "Has the council agreed to that use?"
    },
    {
      "id": "p07-c-30-s04",
      "speaker": "Ken",
      "text": "Yes, for a six-week trial. We would have to clear the room after each session."
    },
    {
      "id": "p07-c-30-s05",
      "speaker": "Moira",
      "text": "Then folding tables would make more sense than permanent desks."
    },
    {
      "id": "p07-c-30-s06",
      "speaker": "Ken",
      "text": "Agreed. Furthermore, the council's note says the existing storage cupboard is included, so we have somewhere to put them."
    },
    {
      "id": "p07-c-30-s07",
      "speaker": "Moira",
      "text": "Some residents wanted a gym. They may not embrace the reading-room idea immediately."
    },
    {
      "id": "p07-c-30-s08",
      "speaker": "Ken",
      "text": "That is why I favour a trial rather than a permanent change. We can ask for feedback after six Saturdays."
    },
    {
      "id": "p07-c-30-s09",
      "speaker": "Moira",
      "text": "Let us use the laundry building and borrow the folding tables from the hall."
    },
    {
      "id": "p07-c-30-s10",
      "speaker": "Ken",
      "text": "I will confirm the table loan and prepare a short notice explaining the trial and feedback meeting."
    }
  ],
