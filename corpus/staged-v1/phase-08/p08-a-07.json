{
  "id": "p08-a-07",
  "title_zh": "分享野餐点心并装好剩余部分",
  "topic_id": "food",
  "scenario": {
    "id": "picnic-pastry-sharing",
    "label_zh": "分配野餐点心",
    "goal_zh": "品尝点心并按食量分配，约定把剩余部分带走"
  },
  "participants": [
    "Rosa",
    "Eli"
  ],
  "context_zh": "朋友在公园摊开各自带来的野餐食物。",
  "author": "author-phase08-a",
  "sentences": [
    {
      "id": "p08-a-07-s01",
      "speaker": "Rosa",
      "text": "Those pastries look gorgeous. Did you make them?"
    },
    {
      "id": "p08-a-07-s02",
      "speaker": "Eli",
      "text": "Yes. I took them out when the tops were golden, so they should still be soft inside."
    },
    {
      "id": "p08-a-07-s03",
      "speaker": "Rosa",
      "text": "My goodness, you brought enough for a party!"
    },
    {
      "id": "p08-a-07-s04",
      "speaker": "Eli",
      "text": "I got carried away. Grab a plate before I open the honey; the lid is sticky."
    },
    {
      "id": "p08-a-07-s05",
      "speaker": "Rosa",
      "text": "Here you go. I'll have one now. That should take the edge off my hunger."
    },
    {
      "id": "p08-a-07-s06",
      "speaker": "Eli",
      "text": "Would you like a little honey on it?"
    },
    {
      "id": "p08-a-07-s07",
      "speaker": "Rosa",
      "text": "Just a little, thanks. Let's put the rest in your box rather than leave them out."
    },
    {
      "id": "p08-a-07-s08",
      "speaker": "Eli",
      "text": "Good idea. We can each take a few home."
    }
  ],
