{
  "id": "p08-a-08",
  "title_zh": "按初次使用者需要修改传单图文",
  "topic_id": "work",
  "scenario": {
    "id": "illustrated-leaflet-reader-revision",
    "label_zh": "修订操作传单的图文说明",
    "goal_zh": "按初次使用者需求补充逐步图示并纳入反馈，约定印刷前测试"
  },
  "participants": [
    "Sofia",
    "Marcus"
  ],
  "context_zh": "设计师和项目负责人检查共享工具柜的操作传单。",
  "author": "author-phase08-a",
  "sentences": [
    {
      "id": "p08-a-08-s01",
      "speaker": "Sofia",
      "text": "The graphic designer sent two versions. Which one is clearer to you?"
    },
    {
      "id": "p08-a-08-s02",
      "speaker": "Marcus",
      "text": "The one on the left. The graphics are simpler, but I still can't tell which button opens the drawer."
    },
    {
      "id": "p08-a-08-s03",
      "speaker": "Sofia",
      "text": "I'll ask her to illustrate the three steps separately."
    },
    {
      "id": "p08-a-08-s04",
      "speaker": "Marcus",
      "text": "Good. One large illustration of the whole cabinet doesn't show the sequence."
    },
    {
      "id": "p08-a-08-s05",
      "speaker": "Sofia",
      "text": "The intended audience is people using it for the first time, so we shouldn't assume they know the controls."
    },
    {
      "id": "p08-a-08-s06",
      "speaker": "Marcus",
      "text": "Can we incorporate the volunteers' comments as well? They keep being asked where to return things."
    },
    {
      "id": "p08-a-08-s07",
      "speaker": "Sofia",
      "text": "Yes. I'll add a return step and remove the paragraph about our history."
    },
    {
      "id": "p08-a-08-s08",
      "speaker": "Marcus",
      "text": "Let's try the new version with two first-time users before we print it."
    }
  ],
