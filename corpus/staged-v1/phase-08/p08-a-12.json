{
  "id": "p08-a-12",
  "title_zh": "约定检查柜门五金后再决定安装",
  "topic_id": "home",
  "scenario": {
    "id": "cabinet-hardware-installation-scope",
    "label_zh": "核对柜门五金安装范围",
    "goal_zh": "确认现场检查包含在安装费内，约好次日两点核对柜门尺寸与五金位置，条件合适才安装"
  },
  "participants": [
    "Idris",
    "Clare"
  ],
  "context_zh": "住户向木工说明柜门上的新五金件需要安装在哪里。",
  "author": "author-phase08-a",
  "sentences": [
    {
      "id": "p08-a-12-s01",
      "speaker": "Idris",
      "text": "I'd like the new handle here, but will it hit the wall when the door opens?"
    },
    {
      "id": "p08-a-12-s02",
      "speaker": "Clare",
      "text": "It might. There's only an inch between the door and the wall at that point."
    },
    {
      "id": "p08-a-12-s03",
      "speaker": "Idris",
      "text": "Could the hook go on the inner side instead? It's only for a light tea towel."
    },
    {
      "id": "p08-a-12-s04",
      "speaker": "Clare",
      "text": "Possibly, but I need to check the thickness of the door before I install anything."
    },
    {
      "id": "p08-a-12-s05",
      "speaker": "Idris",
      "text": "Is that check included in the installation fee?"
    },
    {
      "id": "p08-a-12-s06",
      "speaker": "Clare",
      "text": "Yes. I can come at two tomorrow, check the positions with you, and then fit the pieces if they work."
    },
    {
      "id": "p08-a-12-s07",
      "speaker": "Idris",
      "text": "Two is fine. Let's leave both pieces loose until you've had a look."
    }
  ],
