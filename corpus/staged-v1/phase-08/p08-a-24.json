{
  "id": "p08-a-24",
  "title_zh": "根据试演反馈简化魔术展示",
  "topic_id": "leisure",
  "scenario": {
    "id": "magic-prop-rehearsal-feedback",
    "label_zh": "调整魔术道具展示的节奏",
    "goal_zh": "核对道具功能并根据观众视角反馈，约定去掉过长解释后重新试演"
  },
  "participants": [
    "Luca",
    "Grace"
  ],
  "context_zh": "魔术爱好者请朋友试看一个儿童活动用的小节目。",
  "author": "author-phase08-a",
  "sentences": [
    {
      "id": "p08-a-24-s01",
      "speaker": "Luca",
      "text": "Did the illusion work, or could you tell where the ball went?"
    },
    {
      "id": "p08-a-24-s02",
      "speaker": "Grace",
      "text": "I guessed instantly because you kept looking at the same corner."
    },
    {
      "id": "p08-a-24-s03",
      "speaker": "Luca",
      "text": "The box is hollow, but the audience shouldn't see the opening from your seat."
    },
    {
      "id": "p08-a-24-s04",
      "speaker": "Grace",
      "text": "I couldn't see it. Your eyes gave it away."
    },
    {
      "id": "p08-a-24-s05",
      "speaker": "Luca",
      "text": "I was trying to impress everyone with a long story about an invisible bird."
    },
    {
      "id": "p08-a-24-s06",
      "speaker": "Grace",
      "text": "The story leaves room for imagination, but it went on after the trick was already over."
    },
    {
      "id": "p08-a-24-s07",
      "speaker": "Luca",
      "text": "So you weren't very impressed?"
    },
    {
      "id": "p08-a-24-s08",
      "speaker": "Grace",
      "text": "I liked the moment the ball vanished. Just let that happen without explaining every movement."
    },
    {
      "id": "p08-a-24-s09",
      "speaker": "Luca",
      "text": "All right. I'll shorten the story and try it again from the start."
    }
  ],
