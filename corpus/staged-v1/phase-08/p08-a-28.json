{
  "id": "p08-a-28",
  "title_zh": "试行轮流发言的工作坊规则",
  "topic_id": "work",
  "scenario": {
    "id": "workshop-participation-guideline",
    "label_zh": "修订工作坊的参与规则",
    "goal_zh": "把参与者反馈转化为轮流发言和允许澄清的规则，约定下一次试行后回顾效果"
  },
  "participants": [
    "Beth",
    "Imran"
  ],
  "context_zh": "两名培训组织者根据参与者反馈调整工作坊活动。",
  "author": "author-phase08-a",
  "sentences": [
    {
      "id": "p08-a-28-s01",
      "speaker": "Beth",
      "text": "People liked the group work, but some said they barely got a chance to interact."
    },
    {
      "id": "p08-a-28-s02",
      "speaker": "Imran",
      "text": "Let's integrate that feedback into the next session rather than just thanking them for it."
    },
    {
      "id": "p08-a-28-s03",
      "speaker": "Beth",
      "text": "What would you change? We can't force lively interaction by telling everyone to talk more."
    },
    {
      "id": "p08-a-28-s04",
      "speaker": "Imran",
      "text": "One guideline could be that everyone gets a turn before anyone takes a second one."
    },
    {
      "id": "p08-a-28-s05",
      "speaker": "Beth",
      "text": "Would that mean nobody can interrupt to ask a question?"
    },
    {
      "id": "p08-a-28-s06",
      "speaker": "Imran",
      "text": "Not quite. For instance, a quick request to explain an unfamiliar term should still be welcome."
    },
    {
      "id": "p08-a-28-s07",
      "speaker": "Beth",
      "text": "Then let's distinguish clarification from taking over the discussion."
    },
    {
      "id": "p08-a-28-s08",
      "speaker": "Imran",
      "text": "Agreed. We can implement the rule in the next workshop and ask whether it helped."
    },
    {
      "id": "p08-a-28-s09",
      "speaker": "Beth",
      "text": "I'll explain it at the start, and we'll compare the feedback afterwards."
    }
  ],
