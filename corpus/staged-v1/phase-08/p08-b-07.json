{
  "id": "p08-b-07",
  "title_zh": "试拍后保留包含河岸的横向构图",
  "topic_id": "leisure",
  "scenario": {
    "id": "landscape-photo-tripod-test",
    "label_zh": "试拍并选定风景照片构图",
    "goal_zh": "先试拍并比较横竖构图，选择包含河岸的横向画面并再次拍摄"
  },
  "participants": [
    "Leo",
    "Mina"
  ],
  "context_zh": "摄影学员莱奥与老师米娜在有护栏的观景台上练习风景摄影。",
  "author": "author-phase08-b",
  "sentences": [
    {
      "id": "p08-b-07-s01",
      "speaker": "Leo",
      "text": "The landscape is magnificent, but my photo makes the river look tiny."
    },
    {
      "id": "p08-b-07-s02",
      "speaker": "Mina",
      "text": "Which lens are you using?"
    },
    {
      "id": "p08-b-07-s03",
      "speaker": "Leo",
      "text": "The wide one. I wanted both mountains in the frame."
    },
    {
      "id": "p08-b-07-s04",
      "speaker": "Mina",
      "text": "Keep that lens for now. Try including less sky so the river has more space."
    },
    {
      "id": "p08-b-07-s05",
      "speaker": "Leo",
      "text": "The lighting keeps changing. Should I wait for the cloud to move?"
    },
    {
      "id": "p08-b-07-s06",
      "speaker": "Mina",
      "text": "Let's take a test first. You can mount the camera on the tripod without moving closer to the edge."
    },
    {
      "id": "p08-b-07-s07",
      "speaker": "Leo",
      "text": "Here's the test. I like the riverbank across the bottom; it leads into the picture."
    },
    {
      "id": "p08-b-07-s08",
      "speaker": "Mina",
      "text": "So do I. The portrait version cuts it off."
    },
    {
      "id": "p08-b-07-s09",
      "speaker": "Leo",
      "text": "I'll keep the horizontal composition. There, I've taken another with the same framing."
    }
  ],
