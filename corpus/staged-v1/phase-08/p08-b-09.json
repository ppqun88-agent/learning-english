{
  "id": "p08-b-09",
  "title_zh": "选定首次马拉松完赛的家庭纪念照",
  "topic_id": "relationships",
  "scenario": {
    "id": "first-marathon-photo-choice",
    "label_zh": "挑选首次马拉松完赛纪念照片",
    "goal_zh": "比较奖牌清晰的照片与家人拥抱的照片，选定拥抱照片并将简短配文加入打印预览"
  },
  "participants": [
    "Sophie",
    "Adam"
  ],
  "context_zh": "首次跑完马拉松的索菲与弟弟亚当为家庭相册挑选一张照片。",
  "author": "author-phase08-b",
  "sentences": [
    {
      "id": "p08-b-09-s01",
      "speaker": "Sophie",
      "text": "Can you help me choose a photo from the marathon? I only want to print one."
    },
    {
      "id": "p08-b-09-s02",
      "speaker": "Adam",
      "text": "This one shows the medal clearly, but the one with Mum has much more joy in it."
    },
    {
      "id": "p08-b-09-s03",
      "speaker": "Sophie",
      "text": "I look exhausted in that one."
    },
    {
      "id": "p08-b-09-s04",
      "speaker": "Adam",
      "text": "You'd just run all that way. The hug is what made the day memorable for me."
    },
    {
      "id": "p08-b-09-s05",
      "speaker": "Sophie",
      "text": "You're right. I may never run another, but I'll remember that moment for a lifetime."
    },
    {
      "id": "p08-b-09-s06",
      "speaker": "Adam",
      "text": "Then let's use the hug. What should I write underneath?"
    },
    {
      "id": "p08-b-09-s07",
      "speaker": "Sophie",
      "text": "Just 'My first finish, with Mum waiting.' No finishing time."
    },
    {
      "id": "p08-b-09-s08",
      "speaker": "Adam",
      "text": "Done. I've selected that photo and added your words to the print order preview."
    }
  ],
