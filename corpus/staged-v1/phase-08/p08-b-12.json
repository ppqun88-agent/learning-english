{
  "id": "p08-b-12",
  "title_zh": "确定工作坊单次试办的预算与筹备分工",
  "topic_id": "work",
  "scenario": {
    "id": "workshop-pilot-budget-scope-agreement",
    "label_zh": "按预算缩小工作坊试办范围",
    "goal_zh": "因经费和场地印刷成本限制选择单次小型试办，确定预算上限、人数及筹备分工"
  },
  "participants": [
    "Ezra",
    "Ines"
  ],
  "context_zh": "社区工作坊组织者埃兹拉与伊妮丝比较试办成本并确定筹备分工。",
  "author": "author-phase08-b",
  "sentences": [
    {
      "id": "p08-b-12-s01",
      "speaker": "Ezra",
      "text": "The long-term plan is a weekly workshop, but our funding is limited. Could we start with one Saturday?"
    },
    {
      "id": "p08-b-12-s02",
      "speaker": "Ines",
      "text": "Yes. The costs are largely for the room and printed materials, not equipment."
    },
    {
      "id": "p08-b-12-s03",
      "speaker": "Ezra",
      "text": "The large hall has become more expensive. Likewise, the full-colour booklet costs more than we expected."
    },
    {
      "id": "p08-b-12-s04",
      "speaker": "Ines",
      "text": "Then use the small room and a single-page handout. A modest first session would tell us whether people want another."
    },
    {
      "id": "p08-b-12-s05",
      "speaker": "Ezra",
      "text": "Moreover, the small room already has the tables we need. We wouldn't have to hire any."
    },
    {
      "id": "p08-b-12-s06",
      "speaker": "Ines",
      "text": "Let's set a total budget of one hundred pounds and limit the session to twelve people."
    },
    {
      "id": "p08-b-12-s07",
      "speaker": "Ezra",
      "text": "I'll reserve the room within that limit. Can you prepare the handout and check volunteer availability?"
    },
    {
      "id": "p08-b-12-s08",
      "speaker": "Ines",
      "text": "Yes. I'll confirm both by Friday, and we won't promise a weekly programme yet."
    }
  ],
