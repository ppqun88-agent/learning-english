{
  "id": "p08-b-22",
  "title_zh": "安排展示电机停机检查后再试运行",
  "topic_id": "services",
  "scenario": {
    "id": "display-motor-repair-inspection",
    "label_zh": "预约展示设备的停机检查",
    "goal_zh": "描述电机与模式切换异常，约定保持设备关闭并由维修人员检查后再监测测试"
  },
  "participants": [
    "Vic",
    "Luna"
  ],
  "context_zh": "虚构科学馆的展览管理员维克与设备维修师露娜讨论一台已经关闭的演示机器。",
  "author": "author-phase08-b",
  "sentences": [
    {
      "id": "p08-b-22-s01",
      "speaker": "Vic",
      "text": "Are you the mechanic who looks after the moving displays? Our model stopped halfway through a demonstration."
    },
    {
      "id": "p08-b-22-s02",
      "speaker": "Luna",
      "text": "Yes. Is it switched off now?"
    },
    {
      "id": "p08-b-22-s03",
      "speaker": "Vic",
      "text": "It is. The motor made a new clicking sound, and the machine wouldn't leave automatic mode."
    },
    {
      "id": "p08-b-22-s04",
      "speaker": "Luna",
      "text": "That could be a mechanical problem, but I need to inspect it before saying what's wrong."
    },
    {
      "id": "p08-b-22-s05",
      "speaker": "Vic",
      "text": "Could the switching mechanism be stuck?"
    },
    {
      "id": "p08-b-22-s06",
      "speaker": "Luna",
      "text": "Possibly. I'll check it with the power isolated. Please keep visitors away from the display until then."
    },
    {
      "id": "p08-b-22-s07",
      "speaker": "Vic",
      "text": "Of course. Once it's ready for a test, could you monitor it through a full cycle?"
    },
    {
      "id": "p08-b-22-s08",
      "speaker": "Luna",
      "text": "Yes. I'll inspect it tomorrow morning, and we'll only arrange a test after I've confirmed it's suitable."
    }
  ],
