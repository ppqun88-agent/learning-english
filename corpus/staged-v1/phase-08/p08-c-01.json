{
  "id": "p08-c-01",
  "title_zh": "询问博物馆兼职并索取岗位与养老金条款",
  "topic_id": "work",
  "scenario": {
    "id": "museum-part-time-role-inquiry",
    "label_zh": "核对博物馆兼职岗位及待遇资料",
    "goal_zh": "确认兼职岗位基本职责，约定先阅读岗位说明及养老金条款再决定申请"
  },
  "participants": [
    "Ellen",
    "Rafi"
  ],
  "context_zh": "退休后想重新工作的来访者向博物馆招聘人员询问职位。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-01-s01",
      "speaker": "Ellen",
      "text": "Your form asks for my occupation. Should I write 'retired teacher'?"
    },
    {
      "id": "p08-c-01-s02",
      "speaker": "Rafi",
      "text": "Yes, that's fine. Are you interested in the opening at our information desk?"
    },
    {
      "id": "p08-c-01-s03",
      "speaker": "Ellen",
      "text": "I am, provided it's a part-time job. I can work two days a week."
    },
    {
      "id": "p08-c-01-s04",
      "speaker": "Rafi",
      "text": "That's the schedule we're offering. The work involves welcoming visitors and answering questions."
    },
    {
      "id": "p08-c-01-s05",
      "speaker": "Ellen",
      "text": "The prospect of using my teaching experience again appeals to me. Does the role include a pension?"
    },
    {
      "id": "p08-c-01-s06",
      "speaker": "Rafi",
      "text": "I'll give you the benefits sheet rather than guess how the terms would apply to you."
    },
    {
      "id": "p08-c-01-s07",
      "speaker": "Ellen",
      "text": "Thank you. I'll read that and the job description before I apply."
    }
  ],
