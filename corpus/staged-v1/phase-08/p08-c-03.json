{
  "id": "p08-c-03",
  "title_zh": "修改游行地图以保留通道后再申请许可",
  "topic_id": "community",
  "scenario": {
    "id": "parade-route-permit-preparation",
    "label_zh": "按通行限制准备游行许可申请",
    "goal_zh": "发现摊位阻挡通道后同意修改场地图，再向市政部门申请许可"
  },
  "participants": [
    "Ivo",
    "Maya"
  ],
  "context_zh": "社区活动组织者向场地协调员核对虚构游行的申请材料。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-03-s01",
      "speaker": "Ivo",
      "text": "What do we need to obtain permission for the parade?"
    },
    {
      "id": "p08-c-03-s02",
      "speaker": "Maya",
      "text": "The council needs a route map before it can issue a permit."
    },
    {
      "id": "p08-c-03-s03",
      "speaker": "Ivo",
      "text": "This map shows the musicians here and the food stalls beside the gate."
    },
    {
      "id": "p08-c-03-s04",
      "speaker": "Maya",
      "text": "The stalls would occupy the whole entrance. That would leave no passage for people entering the square."
    },
    {
      "id": "p08-c-03-s05",
      "speaker": "Ivo",
      "text": "Could we put them along the far wall instead?"
    },
    {
      "id": "p08-c-03-s06",
      "speaker": "Maya",
      "text": "Yes, if the marked emergency route stays clear. Show both on the revised map."
    },
    {
      "id": "p08-c-03-s07",
      "speaker": "Ivo",
      "text": "I'll move the stalls on the plan and send the new map with the application."
    }
  ],
