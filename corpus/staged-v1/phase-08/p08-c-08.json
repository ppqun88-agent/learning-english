{
  "id": "p08-c-08",
  "title_zh": "在操作员监督下完成单页打印测试",
  "topic_id": "work",
  "scenario": {
    "id": "print-room-supervised-test-run",
    "label_zh": "按流程进行受监督的打印测试",
    "goal_zh": "核对控制面板与停机流程，在操作员监督下打印一页并检查输出"
  },
  "participants": [
    "Hana",
    "Owen"
  ],
  "context_zh": "新员工在印刷室接受设备操作员的首次指导。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-08-s01",
      "speaker": "Hana",
      "text": "May I operate this printer on my own today?"
    },
    {
      "id": "p08-c-08-s02",
      "speaker": "Owen",
      "text": "Not yet. I'm the trained operator, so I'll stay with you for this test."
    },
    {
      "id": "p08-c-08-s03",
      "speaker": "Hana",
      "text": "Is this the control panel for selecting the paper tray?"
    },
    {
      "id": "p08-c-08-s04",
      "speaker": "Owen",
      "text": "Yes. Choose tray two. Before we start, tell me the procedure if the paper jams."
    },
    {
      "id": "p08-c-08-s05",
      "speaker": "Hana",
      "text": "Stop the job and call you. I shouldn't open the covers while it's running."
    },
    {
      "id": "p08-c-08-s06",
      "speaker": "Owen",
      "text": "Correct. We can proceed with a single test page now."
    },
    {
      "id": "p08-c-08-s07",
      "speaker": "Hana",
      "text": "Here it is. The output looks sharp, but could you check the colour?"
    },
    {
      "id": "p08-c-08-s08",
      "speaker": "Owen",
      "text": "The colour is right. Leave the larger job paused until we check its settings together."
    }
  ],
