{
  "id": "p08-c-09",
  "title_zh": "将道路反对意见聚焦于儿童通行",
  "topic_id": "community",
  "scenario": {
    "id": "playground-road-objection-submission",
    "label_zh": "起草游乐场旁道路方案的具体反对意见",
    "goal_zh": "澄清反对新增道路而非所有改善工程，决定提交儿童通行风险与替代方案"
  },
  "participants": [
    "Nell",
    "Samir"
  ],
  "context_zh": "居民讨论如何就虚构的游乐场旁道路提案提交意见。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-09-s01",
      "speaker": "Nell",
      "text": "I saw you outside the meeting. Were you there as a protester?"
    },
    {
      "id": "p08-c-09-s02",
      "speaker": "Samir",
      "text": "Yes. I oppose the new access road beside the playground."
    },
    {
      "id": "p08-c-09-s03",
      "speaker": "Nell",
      "text": "Are you opposed to any changes to the park?"
    },
    {
      "id": "p08-c-09-s04",
      "speaker": "Samir",
      "text": "No. My prime concern is children crossing between the gate and the play area."
    },
    {
      "id": "p08-c-09-s05",
      "speaker": "Nell",
      "text": "Then let's make that clear. Otherwise, the council may think the opposition is to the whole improvement plan."
    },
    {
      "id": "p08-c-09-s06",
      "speaker": "Samir",
      "text": "I'll mark the crossing point on the map and suggest using the existing service entrance."
    },
    {
      "id": "p08-c-09-s07",
      "speaker": "Nell",
      "text": "Good. We can submit those specific concerns instead of just saying no."
    }
  ],
