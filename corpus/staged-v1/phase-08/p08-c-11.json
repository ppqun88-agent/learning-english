{
  "id": "p08-c-11",
  "title_zh": "改练变速跑位以突破对手预判",
  "topic_id": "leisure",
  "scenario": {
    "id": "football-attacking-practice-adjustment",
    "label_zh": "调整足球进攻训练的节奏与跑位",
    "goal_zh": "根据对手容易预判跑位的问题，同意先在半场练习变速和不同跑动路线"
  },
  "participants": [
    "Milo",
    "Tessa"
  ],
  "context_zh": "训练结束后，队员与教练讨论下一段练习。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-11-s01",
      "speaker": "Milo",
      "text": "My opponent seems to know where I'll run before I move."
    },
    {
      "id": "p08-c-11-s02",
      "speaker": "Tessa",
      "text": "Your runs have become predictable. You always head straight down the right side of the pitch."
    },
    {
      "id": "p08-c-11-s03",
      "speaker": "Milo",
      "text": "Should I just try to run faster?"
    },
    {
      "id": "p08-c-11-s04",
      "speaker": "Tessa",
      "text": "Not all the time. A change of pace can help, especially if you move inside first."
    },
    {
      "id": "p08-c-11-s05",
      "speaker": "Milo",
      "text": "I'd like to overcome that habit, but I need a chance to try without a full match going on."
    },
    {
      "id": "p08-c-11-s06",
      "speaker": "Tessa",
      "text": "Then we'll use half the field and practise two different runs. I'll defend at first."
    },
    {
      "id": "p08-c-11-s07",
      "speaker": "Milo",
      "text": "All right. I'll start slowly and change speed after the first pass."
    }
  ],
