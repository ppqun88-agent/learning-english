{
  "id": "p08-c-12",
  "title_zh": "暂缓扩展工作坊并先解决场地障碍",
  "topic_id": "work",
  "scenario": {
    "id": "workshop-pilot-expansion-check",
    "label_zh": "根据尚未结束的试办确定扩展条件",
    "goal_zh": "区分初步反馈与最终结果，决定先联系无障碍场地并在本阶段结束后复核扩展计划"
  },
  "participants": [
    "Amira",
    "Kit"
  ],
  "context_zh": "工作坊协调者讨论仍在进行的试办。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-12-s01",
      "speaker": "Amira",
      "text": "The first two sessions look promising. Can we announce more workshops?"
    },
    {
      "id": "p08-c-12-s02",
      "speaker": "Kit",
      "text": "Not yet. The trial is ongoing, and we haven't heard from the people who stopped attending."
    },
    {
      "id": "p08-c-12-s03",
      "speaker": "Amira",
      "text": "Overall, the feedback we do have is positive."
    },
    {
      "id": "p08-c-12-s04",
      "speaker": "Kit",
      "text": "True, but the stairs are still an obstacle for several people. More sessions in the same room won't solve that."
    },
    {
      "id": "p08-c-12-s05",
      "speaker": "Amira",
      "text": "I'm optimistic about the library room. They have step-free access."
    },
    {
      "id": "p08-c-12-s06",
      "speaker": "Kit",
      "text": "Let's ask about availability. The outcome of this trial should guide expansion, not just the first week's excitement."
    },
    {
      "id": "p08-c-12-s07",
      "speaker": "Amira",
      "text": "I'll contact the library and collect the missing feedback."
    },
    {
      "id": "p08-c-12-s08",
      "speaker": "Kit",
      "text": "Then we'll review the plan when this phase ends next Friday."
    }
  ],
