{
  "id": "p08-c-14",
  "title_zh": "选定与戏服搭配的平底鞋",
  "topic_id": "services",
  "scenario": {
    "id": "play-costume-shoe-choice",
    "label_zh": "为舞台戏服选择合脚的平底鞋",
    "goal_zh": "根据着装偏好与台阶走动需要，放弃尖头款并选定预算内的平底鞋"
  },
  "participants": [
    "Jules",
    "Rina"
  ],
  "context_zh": "演员在商店寻找可与现有戏服搭配的鞋。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-14-s01",
      "speaker": "Jules",
      "text": "This is the outfit I'll wear in the play. I need shoes that won't distract from it."
    },
    {
      "id": "p08-c-14-s02",
      "speaker": "Rina",
      "text": "Do you have a preference for a particular colour?"
    },
    {
      "id": "p08-c-14-s03",
      "speaker": "Jules",
      "text": "Black, and something plain. No shiny buckles."
    },
    {
      "id": "p08-c-14-s04",
      "speaker": "Rina",
      "text": "These pointed shoes suit the period, but try walking in them before you decide."
    },
    {
      "id": "p08-c-14-s05",
      "speaker": "Jules",
      "text": "My toes feel squeezed, and I have to climb steps on stage. Could I try the round-toed pair?"
    },
    {
      "id": "p08-c-14-s06",
      "speaker": "Rina",
      "text": "Of course. Those are flat and cost forty pounds."
    },
    {
      "id": "p08-c-14-s07",
      "speaker": "Jules",
      "text": "They feel much better, and they're within my budget. I'll purchase this pair."
    }
  ],
