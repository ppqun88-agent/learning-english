{
  "id": "p08-c-22",
  "title_zh": "在永久删除账户前先保存所需副本",
  "topic_id": "services",
  "scenario": {
    "id": "archive-account-deletion-check",
    "label_zh": "核对档案账户删除前的保留限制",
    "goal_zh": "了解账户删除的不可逆影响和受限文件规则，决定先下载可保存的个人副本而暂不删除"
  },
  "participants": [
    "Evan",
    "Helpdesk"
  ],
  "context_zh": "虚构档案网站的使用者向客服询问账户删除流程。",
  "author": "author-phase08-c",
  "sentences": [
    {
      "id": "p08-c-22-s01",
      "speaker": "Evan",
      "text": "I reset my password so I could close this account. Is deletion permanent?"
    },
    {
      "id": "p08-c-22-s02",
      "speaker": "Helpdesk",
      "text": "Yes. The notice says your saved reading lists will be removed permanently."
    },
    {
      "id": "p08-c-22-s03",
      "speaker": "Evan",
      "text": "Can I download everything first?"
    },
    {
      "id": "p08-c-22-s04",
      "speaker": "Helpdesk",
      "text": "You can export your lists. The archive rules prohibit downloading some restricted documents without prior permission."
    },
    {
      "id": "p08-c-22-s05",
      "speaker": "Evan",
      "text": "I only need my own notes and lists. I don't want copies of the restricted documents."
    },
    {
      "id": "p08-c-22-s06",
      "speaker": "Helpdesk",
      "text": "Use the export option for those, then check that the files open before you decide about deletion."
    },
    {
      "id": "p08-c-22-s07",
      "speaker": "Evan",
      "text": "I'll save and check them first. Please leave the account open for now."
    }
  ],
