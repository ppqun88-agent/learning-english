{
  "id": "p09-a-02",
  "title_zh": "商定课程调查的评分题与邀请方式",
  "topic_id": "reasoning",
  "scenario": {
    "id": "course-survey-rating-question-design",
    "label_zh": "课程满意度问题设计",
    "goal_zh": "区分课程评分与活动排序，决定采用单项评分题并随机邀请学员"
  },
  "participants": [
    "Nadia",
    "Evan"
  ],
  "context_zh": "两位课程组织者拟定课后问卷，尚未发送。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-02-s01",
      "speaker": "Nadia",
      "text": "How should we measure satisfaction with the course?"
    },
    {
      "id": "p09-a-02-s02",
      "speaker": "Evan",
      "text": "Would you like people to rank the activities from best to worst?"
    },
    {
      "id": "p09-a-02-s03",
      "speaker": "Nadia",
      "text": "That tells us which activity they prefer, not whether they liked the course overall."
    },
    {
      "id": "p09-a-02-s04",
      "speaker": "Evan",
      "text": "Then ask for one rating from one to five, followed by an optional comment."
    },
    {
      "id": "p09-a-02-s05",
      "speaker": "Nadia",
      "text": "Good. We should invite a random sample of students, not just the people who stayed to chat."
    },
    {
      "id": "p09-a-02-s06",
      "speaker": "Evan",
      "text": "Agreed. I'll use the full attendance list to draw the names, and we'll keep the question about the course as a whole."
    }
  ],
