{
  "id": "p09-a-04",
  "title_zh": "订单增长后商定分批交付提议",
  "topic_id": "work",
  "scenario": {
    "id": "rapid-order-growth-deadline-check",
    "label_zh": "快速增长订单的交期核对",
    "goal_zh": "依据包装能力确定可合理承诺的数量，并决定向客户提出分批交付"
  },
  "participants": [
    "Priya",
    "Dan"
  ],
  "context_zh": "两位小型印刷工作室同事在回复客户前核对产能。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-04-s01",
      "speaker": "Priya",
      "text": "The client wants a rapid response about the delivery date."
    },
    {
      "id": "p09-a-04-s02",
      "speaker": "Dan",
      "text": "Orders are coming in rapidly, but we still have only two people packing them."
    },
    {
      "id": "p09-a-04-s03",
      "speaker": "Priya",
      "text": "Is Friday a realistic date for all two hundred sets?"
    },
    {
      "id": "p09-a-04-s04",
      "speaker": "Dan",
      "text": "No. We can reasonably promise a hundred by Friday. The rest would need until Monday."
    },
    {
      "id": "p09-a-04-s05",
      "speaker": "Priya",
      "text": "I reckon they could use the first hundred at the opening and the rest next week."
    },
    {
      "id": "p09-a-04-s06",
      "speaker": "Dan",
      "text": "Maybe, but let's ask rather than assume. Offer those two dates and explain the quantities."
    },
    {
      "id": "p09-a-04-s07",
      "speaker": "Priya",
      "text": "Agreed. I'll send that proposal now and wait for their answer before confirming the job."
    }
  ],
