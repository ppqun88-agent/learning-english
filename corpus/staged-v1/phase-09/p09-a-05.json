{
  "id": "p09-a-05",
  "title_zh": "换位置试听后决定保留旧收音机",
  "topic_id": "services",
  "scenario": {
    "id": "radio-receiver-reception-check",
    "label_zh": "旧收音机信号试听",
    "goal_zh": "比较不同位置的接收效果，决定保留设备并仅在杂音再次出现时联系店员"
  },
  "participants": [
    "Marta",
    "Joel"
  ],
  "context_zh": "顾客带旧收音机到维修店，店员与她一起试听。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-05-s01",
      "speaker": "Marta",
      "text": "I bought this radio receiver here last year. Do you recall showing me how to tune it?"
    },
    {
      "id": "p09-a-05-s02",
      "speaker": "Joel",
      "text": "I do. What has changed?"
    },
    {
      "id": "p09-a-05-s03",
      "speaker": "Marta",
      "text": "The signal is relatively weak in my kitchen compared with the bedroom."
    },
    {
      "id": "p09-a-05-s04",
      "speaker": "Joel",
      "text": "Let's try it away from the metal shelf. There, can you hear the station now?"
    },
    {
      "id": "p09-a-05-s05",
      "speaker": "Marta",
      "text": "Yes, that's remarkably clear. The kitchen radio sits right beside a large metal cabinet."
    },
    {
      "id": "p09-a-05-s06",
      "speaker": "Joel",
      "text": "Try another position at home before paying for a repair. If the noise returns, bring it back."
    },
    {
      "id": "p09-a-05-s07",
      "speaker": "Marta",
      "text": "I will. I'll keep this one and contact you if moving it doesn't solve the problem at home."
    }
  ],
