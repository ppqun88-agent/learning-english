{
  "id": "p09-a-06",
  "title_zh": "为虚构商店案例选择短期营业方案",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-shop-revenue-reduction-plan",
    "label_zh": "虚构零售案例的收入变化",
    "goal_zh": "区分营业收入与利润，依据课堂数据选择短期缩短晚间营业的方案"
  },
  "participants": [
    "Aisha",
    "Ben"
  ],
  "context_zh": "商科课堂中的两名学生分析虚构零售商店，不是在提供经营或投资建议。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-06-s01",
      "speaker": "Aisha",
      "text": "In this scenario, a recession has reduced spending in the town. What does that mean for our shop?"
    },
    {
      "id": "p09-a-06-s02",
      "speaker": "Ben",
      "text": "Retail is the only sector shown here. The case does not give us figures for restaurants or factories."
    },
    {
      "id": "p09-a-06-s03",
      "speaker": "Aisha",
      "text": "The table shows a twenty percent reduction in revenue. Is that the same as a twenty percent fall in profit?"
    },
    {
      "id": "p09-a-06-s04",
      "speaker": "Ben",
      "text": "No. Revenue is money from sales before costs. We need the cost page to work out profit."
    },
    {
      "id": "p09-a-06-s05",
      "speaker": "Aisha",
      "text": "Here it is. The late opening hours cost more to run than they bring in."
    },
    {
      "id": "p09-a-06-s06",
      "speaker": "Ben",
      "text": "Then, for our short-term plan, shall we close at six instead of eight and review the figures after a month?"
    },
    {
      "id": "p09-a-06-s07",
      "speaker": "Aisha",
      "text": "Yes. We can explain that choice using the late-evening figures, rather than claiming every shop should do it."
    }
  ],
