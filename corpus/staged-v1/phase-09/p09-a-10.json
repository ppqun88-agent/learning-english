{
  "id": "p09-a-10",
  "title_zh": "核对参加条件并完成语言咖啡馆登记",
  "topic_id": "community",
  "scenario": {
    "id": "regional-language-cafe-registration",
    "label_zh": "区域语言咖啡馆活动登记",
    "goal_zh": "确认活动向当地居民开放且登记免费，为参加者登记下周二的语言咖啡馆名额"
  },
  "participants": [
    "Safa",
    "Helen"
  ],
  "context_zh": "虚构社区服务练习中，一名居民向区域中心询问普通语言交流活动。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-10-s01",
      "speaker": "Safa",
      "text": "Is the language cafe at this regional centre only for students?"
    },
    {
      "id": "p09-a-10-s02",
      "speaker": "Helen",
      "text": "No. Any local resident can join. You do not need to be studying at a college."
    },
    {
      "id": "p09-a-10-s03",
      "speaker": "Safa",
      "text": "I arrived as a refugee last year. Do you need documents about that?"
    },
    {
      "id": "p09-a-10-s04",
      "speaker": "Helen",
      "text": "Not for this activity. We just need a name for the list and your preferred session."
    },
    {
      "id": "p09-a-10-s05",
      "speaker": "Safa",
      "text": "Can I register for next Tuesday, under Safa?"
    },
    {
      "id": "p09-a-10-s06",
      "speaker": "Helen",
      "text": "Yes. Registration is free, and there is still a place."
    },
    {
      "id": "p09-a-10-s07",
      "speaker": "Safa",
      "text": "Tuesday, please. I'll come to the welcome desk at six."
    },
    {
      "id": "p09-a-10-s08",
      "speaker": "Helen",
      "text": "I've added Safa to Tuesday's list. Six at the welcome desk is correct."
    }
  ],
