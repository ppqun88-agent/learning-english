{
  "id": "p09-a-11",
  "title_zh": "承认公开玩笑的伤害并答应删评",
  "topic_id": "relationships",
  "scenario": {
    "id": "public-joke-apology-request",
    "label_zh": "公开玩笑后的道歉与请求",
    "goal_zh": "听取朋友对公开评论的感受，承认评论不妥并同意删掉它和不再拿这件事开玩笑"
  },
  "participants": [
    "Iris",
    "Sam"
  ],
  "context_zh": "朋友私下讨论一条让当事人难堪的社交媒体评论。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-11-s01",
      "speaker": "Iris",
      "text": "Your remark under my photo made me feel ridiculous in front of everyone."
    },
    {
      "id": "p09-a-11-s02",
      "speaker": "Sam",
      "text": "I meant it as a joke, but I can hear that it hurt you."
    },
    {
      "id": "p09-a-11-s03",
      "speaker": "Iris",
      "text": "You may regard it as harmless. I am sensitive about losing that job, and you know it."
    },
    {
      "id": "p09-a-11-s04",
      "speaker": "Sam",
      "text": "I regret posting it. I was not my usual self yesterday, but that is not an excuse."
    },
    {
      "id": "p09-a-11-s05",
      "speaker": "Iris",
      "text": "Please delete it. I do not want a big public apology that draws more attention to it."
    },
    {
      "id": "p09-a-11-s06",
      "speaker": "Sam",
      "text": "I will delete the comment and stop joking about the job. Is there anything else you need from me now?"
    },
    {
      "id": "p09-a-11-s07",
      "speaker": "Iris",
      "text": "Just some space. We can talk again later."
    },
    {
      "id": "p09-a-11-s08",
      "speaker": "Sam",
      "text": "Okay. I won't push you to make me feel better about it."
    }
  ],
