{
  "id": "p09-a-27",
  "title_zh": "确定太空展图像顺序与比例说明",
  "topic_id": "learning",
  "scenario": {
    "id": "space-exhibit-photo-sequence",
    "label_zh": "太空模型展图卡顺序与比例说明安排",
    "goal_zh": "依据给定图卡确定发射与入轨图像的顺序、选定清晰照片，并约定重排图卡及补充非等比例展示说明"
  },
  "participants": [
    "Hugo",
    "Zara"
  ],
  "context_zh": "学生用虚构教学图卡布置太空模型展示，核对的是图卡所示顺序。",
  "author": "author-phase09-a",
  "sentences": [
    {
      "id": "p09-a-27-s01",
      "speaker": "Hugo",
      "text": "Our sequence starts with the satellite already in orbit, then shows the launch. Is that deliberate?"
    },
    {
      "id": "p09-a-27-s02",
      "speaker": "Zara",
      "text": "No, I mixed up the cards. The rocket on the launch pad should come first."
    },
    {
      "id": "p09-a-27-s03",
      "speaker": "Hugo",
      "text": "Then the launch, followed by the card showing the satellite in orbit, as the numbered guide says."
    },
    {
      "id": "p09-a-27-s04",
      "speaker": "Zara",
      "text": "Yes. Which launch photo should we use?"
    },
    {
      "id": "p09-a-27-s05",
      "speaker": "Hugo",
      "text": "This shot is clearer. You can see the whole rocket rather than only a cloud of smoke."
    },
    {
      "id": "p09-a-27-s06",
      "speaker": "Zara",
      "text": "Good choice. We also need to say these drawings are not to scale. The model Earth and the satellite look almost the same size."
    },
    {
      "id": "p09-a-27-s07",
      "speaker": "Hugo",
      "text": "Agreed. I'll use this photo, put the cards in that order, and add the scale note below them."
    }
  ],
