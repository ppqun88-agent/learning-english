{
  "id": "p09-b-01",
  "title_zh": "约好为丧亲同事代领午餐",
  "topic_id": "relationships",
  "scenario": {
    "id": "bereaved-colleague-support-choice",
    "label_zh": "约好为丧亲同事代领午餐",
    "goal_zh": "听取丧亲同事对慰问方式的感受，并约定代领午餐而不转发私人消息"
  },
  "participants": [
    "Marta",
    "Elias"
  ],
  "context_zh": "虚构办公室场景：同事失去亲人后返回工作岗位，两人讨论怎样提供他真正需要的支持。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-01-s01",
      "speaker": "Marta",
      "text": "I'm terribly sorry about your brother, Elias. Would you rather I left you alone today?"
    },
    {
      "id": "p09-b-01-s02",
      "speaker": "Elias",
      "text": "No, stay. It's been a tough week since he died, but being on my own isn't helping."
    },
    {
      "id": "p09-b-01-s03",
      "speaker": "Marta",
      "text": "People have been asking me to pass on their sympathy. I haven't shared your message with anyone."
    },
    {
      "id": "p09-b-01-s04",
      "speaker": "Elias",
      "text": "Thank you. I know their concern is sincere. I just can't face answering twenty messages."
    },
    {
      "id": "p09-b-01-s05",
      "speaker": "Marta",
      "text": "Would it help if I collected your lunch? I know that won't take away your suffering."
    },
    {
      "id": "p09-b-01-s06",
      "speaker": "Elias",
      "text": "It would. You've been sympathetic without making me explain everything."
    },
    {
      "id": "p09-b-01-s07",
      "speaker": "Marta",
      "text": "Then I'll pick up the sandwich you ordered. And your message stays between us."
    },
    {
      "id": "p09-b-01-s08",
      "speaker": "Elias",
      "text": "Yes, please. That's all I need for now."
    }
  ],
