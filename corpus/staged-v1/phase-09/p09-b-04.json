{
  "id": "p09-b-04",
  "title_zh": "分工处理咖啡馆洒落的饮料",
  "topic_id": "work",
  "scenario": {
    "id": "cafe-spill-clearance-plan",
    "label_zh": "分工处理咖啡馆洒落的饮料",
    "goal_zh": "隔开洒落饮料的区域，并约定清理后等地面干燥再恢复通行"
  },
  "participants": [
    "Nico",
    "Leena"
  ],
  "context_zh": "咖啡馆两位工作人员处理一杯洒在桌面和地板上的饮料。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-04-s01",
      "speaker": "Nico",
      "text": "I saw a customer spill a drink by table four. I've put the barrier across the aisle."
    },
    {
      "id": "p09-b-04-s02",
      "speaker": "Leena",
      "text": "Good. Someone could slip on that. Is there any broken glass?"
    },
    {
      "id": "p09-b-04-s03",
      "speaker": "Nico",
      "text": "No, it was a paper cup. Could you slide the empty tray towards me so I can clear the table?"
    },
    {
      "id": "p09-b-04-s04",
      "speaker": "Leena",
      "text": "Here you are. The tabletop is sticky too."
    },
    {
      "id": "p09-b-04-s05",
      "speaker": "Nico",
      "text": "I'll wipe it. Can you sweep up the dry crumbs first, then mop the drink off the floor?"
    },
    {
      "id": "p09-b-04-s06",
      "speaker": "Leena",
      "text": "Yes. I'll keep the barrier there until the floor is dry."
    },
    {
      "id": "p09-b-04-s07",
      "speaker": "Nico",
      "text": "Thanks. I'll check it with you before we let customers through again."
    }
  ],
