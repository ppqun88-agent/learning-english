  "title_zh": "约好周四午间练习困难乐段",
  "topic_id": "leisure",
  "scenario": {
    "id": "rehearsal-slot-small-restart",
    "label_zh": "约好周四午间练习困难乐段",
    "goal_zh": "回应排练失误后的挫败感，并约定周四午间进行十五分钟的局部练习"
  },
  "participants": [
    "Dylan",
    "Inez"
  ],
  "context_zh": "业余乐队排练后，演奏者与队友商量短时间练习。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-08-s01",
      "speaker": "Dylan",
      "text": "I somehow lost my place in the last verse, even though I knew it yesterday."
    },
    {
      "id": "p09-b-08-s02",
      "speaker": "Inez",
      "text": "I noticed, but the opening sounded super. Don't throw away the whole performance because of one verse."
    },
    {
      "id": "p09-b-08-s03",
      "speaker": "Dylan",
      "text": "Could we go through that bit together sometime this week?"
    },
    {
      "id": "p09-b-08-s04",
      "speaker": "Inez",
      "text": "I can spare fifteen minutes on Thursday at lunch. Would that work?"
    },
    {
      "id": "p09-b-08-s05",
      "speaker": "Dylan",
      "text": "Yes. Let's start at twelve thirty and practise only the change into the last verse."
    },
    {
      "id": "p09-b-08-s06",
      "speaker": "Inez",
      "text": "Deal. Bring your marked copy, and we'll take it slowly."
    }
  ],
