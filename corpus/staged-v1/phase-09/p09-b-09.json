{
  "id": "p09-b-09",
  "title_zh": "选定传感器演示的离线试验范围",
  "topic_id": "work",
  "scenario": {
    "id": "sensor-demo-offline-trial",
    "label_zh": "选定传感器演示的离线试验范围",
    "goal_zh": "区分技术功能与演示需要，并约定先测试本地记录和指示灯而不联网"
  },
  "participants": [
    "Cleo",
    "Anders"
  ],
  "context_zh": "两位设计师商量虚构低压传感器演示的测试范围，不提供安全关键系统操作建议。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-09-s01",
      "speaker": "Cleo",
      "text": "This version is quite sophisticated. It can transmit readings to a phone as well as save them locally."
    },
    {
      "id": "p09-b-09-s02",
      "speaker": "Anders",
      "text": "Do we need every technological feature for Friday's demonstration?"
    },
    {
      "id": "p09-b-09-s03",
      "speaker": "Cleo",
      "text": "Probably not. We're still doing basic testing, and the wireless link isn't reliable yet."
    },
    {
      "id": "p09-b-09-s04",
      "speaker": "Anders",
      "text": "Let's keep the first trial offline. Can the sensor record a change and trigger the little indicator light without the phone?"
    },
    {
      "id": "p09-b-09-s05",
      "speaker": "Cleo",
      "text": "Yes. We can check the saved reading against the value on the display."
    },
    {
      "id": "p09-b-09-s06",
      "speaker": "Anders",
      "text": "That's a clear test. Let's use only those two functions and leave the wireless link off."
    },
    {
      "id": "p09-b-09-s07",
      "speaker": "Cleo",
      "text": "Agreed. I'll write down the results before we decide whether to add the phone connection."
    }
  ],
