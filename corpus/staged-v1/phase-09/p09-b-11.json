{
  "id": "p09-b-11",
  "title_zh": "约定按证据范围修改溪流保护告示",
  "topic_id": "nature",
  "scenario": {
    "id": "stream-habitat-notice-scope",
    "label_zh": "约定按证据范围修改溪流保护告示",
    "goal_zh": "区分已记录的踩踏破坏与尚未评估的生存风险，并约定告示要求游客留在步道上"
  },
  "participants": [
    "Petra",
    "Wes"
  ],
  "context_zh": "保护区志愿者与管理员依虚构观察记录修改告示。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-11-s01",
      "speaker": "Petra",
      "text": "I've written that visitors are a threat to the survival of every species in the stream. Is that too broad?"
    },
    {
      "id": "p09-b-11-s02",
      "speaker": "Wes",
      "text": "Yes. Our survey recorded plants damaged by trampling beside the stream. It didn't assess the survival of every animal and plant."
    },
    {
      "id": "p09-b-11-s03",
      "speaker": "Petra",
      "text": "Could we say that trampling can threaten plants along the bank?"
    },
    {
      "id": "p09-b-11-s04",
      "speaker": "Wes",
      "text": "Yes, and connect that directly to what we want people to do: stay on the path."
    },
    {
      "id": "p09-b-11-s05",
      "speaker": "Petra",
      "text": "I'll mention the trampling damage we recorded, ask visitors to stay on the path, and remove the claim about every species."
    },
    {
      "id": "p09-b-11-s06",
      "speaker": "Wes",
      "text": "Good. Put the survey date underneath, so the notice is clear about its evidence."
    }
  ],
