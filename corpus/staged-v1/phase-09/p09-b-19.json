{
  "id": "p09-b-19",
  "title_zh": "约好检查鱼缸旁漏水的水龙头",
  "topic_id": "services",
  "scenario": {
    "id": "aquarium-service-tap-inspection",
    "label_zh": "约好检查鱼缸旁漏水的水龙头",
    "goal_zh": "说明鱼缸旁供水龙头及临时接水安排，并约定维修人员到场检查而不自行拆修"
  },
  "participants": [
    "Amir",
    "Tessa"
  ],
  "context_zh": "水族店工作人员向维修服务说明龙头漏水；鱼缸本身的水温没有变化。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-19-s01",
      "speaker": "Amir",
      "text": "The tap above our service sink is dripping again. It's beside the display tank."
    },
    {
      "id": "p09-b-19-s02",
      "speaker": "Tessa",
      "text": "Has anything changed in the tank itself?"
    },
    {
      "id": "p09-b-19-s03",
      "speaker": "Amir",
      "text": "No. The temperature is stable, and the display system is running normally. The leak is just from that tap."
    },
    {
      "id": "p09-b-19-s04",
      "speaker": "Tessa",
      "text": "Can you describe what's underneath it?"
    },
    {
      "id": "p09-b-19-s05",
      "speaker": "Amir",
      "text": "There's a temporary container in the sink to catch the drips. We've closed that work area temporarily so nobody knocks it over."
    },
    {
      "id": "p09-b-19-s06",
      "speaker": "Tessa",
      "text": "I'll come at three to inspect the tap. Please leave the fitting intact so I can see where it's leaking."
    },
    {
      "id": "p09-b-19-s07",
      "speaker": "Amir",
      "text": "Three works. We'll leave the area closed and won't try to take the tap apart."
    }
  ],
