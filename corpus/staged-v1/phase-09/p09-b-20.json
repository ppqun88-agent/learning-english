{
  "id": "p09-b-20",
  "title_zh": "选定去观景台的平缓湖边路线",
  "topic_id": "travel",
  "scenario": {
    "id": "woodland-viewpoint-route-choice",
    "label_zh": "选定去观景台的平缓湖边路线",
    "goal_zh": "比较两条路线的坡度和长度，并选定较长但平缓的湖边路线"
  },
  "participants": [
    "Greta",
    "Owen"
  ],
  "context_zh": "游客向步道工作人员询问到湖边观景台的路线。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-20-s01",
      "speaker": "Greta",
      "text": "Does the short route to the viewpoint go up that slope?"
    },
    {
      "id": "p09-b-20-s02",
      "speaker": "Owen",
      "text": "Yes. It's quite steep near the top. The lakeside route is longer but mostly level."
    },
    {
      "id": "p09-b-20-s03",
      "speaker": "Greta",
      "text": "Do the trees surround the whole lake? I'd like to see the surrounding hills, not just the woods."
    },
    {
      "id": "p09-b-20-s04",
      "speaker": "Owen",
      "text": "There are trees on three sides. The viewpoint faces the open side, so both routes end with the same view."
    },
    {
      "id": "p09-b-20-s05",
      "speaker": "Greta",
      "text": "How much longer is the lakeside route?"
    },
    {
      "id": "p09-b-20-s06",
      "speaker": "Owen",
      "text": "About twenty minutes. There's one long stretch beside the water before it turns towards the viewpoint."
    },
    {
      "id": "p09-b-20-s07",
      "speaker": "Greta",
      "text": "Then we'll take that route. We have time, and I'd rather avoid the climb."
    },
    {
      "id": "p09-b-20-s08",
      "speaker": "Owen",
      "text": "Follow the blue signs from this gate. They'll keep you on the lakeside path."
    }
  ],
