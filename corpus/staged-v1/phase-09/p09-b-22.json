{
  "id": "p09-b-22",
  "title_zh": "约定用先写后轮流发言改善青年讨论课",
  "topic_id": "learning",
  "scenario": {
    "id": "teen-debate-participation-plan",
    "label_zh": "约定用先写后轮流发言改善青年讨论课",
    "goal_zh": "识别试教中少数人垄断发言的问题，并约定先独立写想法再轮流分享"
  },
  "participants": [
    "Zoe",
    "Hamish"
  ],
  "context_zh": "两位青年活动带领者根据一次试教商量讨论课的参与方式。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-22-s01",
      "speaker": "Zoe",
      "text": "The group are all in their teens, but one teen answered almost every question today."
    },
    {
      "id": "p09-b-22-s02",
      "speaker": "Hamish",
      "text": "I noticed a tendency for the quieter members to wait until someone else spoke."
    },
    {
      "id": "p09-b-22-s03",
      "speaker": "Zoe",
      "text": "How can we stimulate discussion without putting them on the spot?"
    },
    {
      "id": "p09-b-22-s04",
      "speaker": "Hamish",
      "text": "Let's tackle that by giving everyone two minutes to write an idea first. Then we can invite one idea from each person."
    },
    {
      "id": "p09-b-22-s05",
      "speaker": "Zoe",
      "text": "That might strengthen their confidence, especially if passing is allowed."
    },
    {
      "id": "p09-b-22-s06",
      "speaker": "Hamish",
      "text": "Yes. We'll make it clear that nobody has to speak, and the first volunteer doesn't get every turn."
    },
    {
      "id": "p09-b-22-s07",
      "speaker": "Zoe",
      "text": "Let's try that next session. I'll prepare the opening question and explain the order."
    },
    {
      "id": "p09-b-22-s08",
      "speaker": "Hamish",
      "text": "And I'll watch whether more people get a chance, rather than assuming it worked."
    }
  ],
