{
  "id": "p09-b-26",
  "title_zh": "放弃事故题材影片作为家庭放映",
  "topic_id": "leisure",
  "scenario": {
    "id": "sensitive-film-screening-choice",
    "label_zh": "放弃事故题材影片作为家庭放映",
    "goal_zh": "核对虚构影片的幸存者视角与悲剧内容，并决定改用轻松短片安排家庭放映"
  },
  "participants": [
    "Esther",
    "Malik"
  ],
  "context_zh": "朋友根据一份虚构电影目录选择家庭聚会影片，片名和情节均为教学创作。",
  "author": "author-phase09-b",
  "sentences": [
    {
      "id": "p09-b-26-s01",
      "speaker": "Esther",
      "text": "Would The Last Crossing work for family night? The cover calls it a tale of courage at sea."
    },
    {
      "id": "p09-b-26-s02",
      "speaker": "Malik",
      "text": "It's told by the only survivor of a shipwreck. The catalogue describes it as a tragedy, not a cheerful adventure."
    },
    {
      "id": "p09-b-26-s03",
      "speaker": "Esther",
      "text": "Does it actually show the accident?"
    },
    {
      "id": "p09-b-26-s04",
      "speaker": "Malik",
      "text": "Briefly, yes. Much of the film is about his terror during the storm and his grief afterwards."
    },
    {
      "id": "p09-b-26-s05",
      "speaker": "Esther",
      "text": "That could terrify the younger children. I don't think this is the right evening for a tragic story."
    },
    {
      "id": "p09-b-26-s06",
      "speaker": "Malik",
      "text": "Agreed. We could use the light-hearted short film we watched last week instead."
    },
    {
      "id": "p09-b-26-s07",
      "speaker": "Esther",
      "text": "Let's do that. We know it suits the group, and nobody has to sit through the shipwreck film."
    }
  ],
