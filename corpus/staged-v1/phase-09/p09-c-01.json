{
  "id": "p09-c-01",
  "title_zh": "选定温室的短环线",
  "topic_id": "nature",
  "scenario": {
    "id": "greenhouse-accessible-fern-loop",
    "label_zh": "选择温室蕨类短环线",
    "goal_zh": "核对蕨类展区位置与路线长度，选择从旁边的门进入短环线"
  },
  "participants": [
    "Inez",
    "Rafi"
  ],
  "context_zh": "游客在植物园服务台询问温室内的短路线。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-01-s01",
      "speaker": "Inez",
      "text": "I'd like to see the tropical plants, but I only have twenty minutes."
    },
    {
      "id": "p09-c-01-s02",
      "speaker": "Rafi",
      "text": "There's an abundance of ferns in the east greenhouse. You can see that section without walking through the whole building."
    },
    {
      "id": "p09-c-01-s03",
      "speaker": "Inez",
      "text": "I tend to wander when I visit gardens. Is there a marked route?"
    },
    {
      "id": "p09-c-01-s04",
      "speaker": "Rafi",
      "text": "Yes. The green arrows make a short loop. The entrance is adjacent to this desk, through the glass door."
    },
    {
      "id": "p09-c-01-s05",
      "speaker": "Inez",
      "text": "Does the loop bring me back here?"
    },
    {
      "id": "p09-c-01-s06",
      "speaker": "Rafi",
      "text": "It does, and it takes about fifteen minutes at an easy pace."
    },
    {
      "id": "p09-c-01-s07",
      "speaker": "Inez",
      "text": "Perfect. I'll take that loop and leave the other rooms for next time."
    }
  ],
