{
  "id": "p09-c-02",
  "title_zh": "核对海啸演练的地图路线",
  "topic_id": "community",
  "scenario": {
    "id": "coastal-school-drill-map-route",
    "label_zh": "按演练图核对海啸演练路线",
    "goal_zh": "依据学校提供的演练图，确认警报提示、禁入区域和前往高处集合点的路线"
  },
  "participants": [
    "Mara",
    "Jun"
  ],
  "context_zh": "两名教师核对虚构沿海学校桌面演练材料；不是现实灾害指引。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-02-s01",
      "speaker": "Mara",
      "text": "In this exercise, the tsunami alert appears while the class is in the sports hall. Which route does the school map show?"
    },
    {
      "id": "p09-c-02-s02",
      "speaker": "Jun",
      "text": "The blue route goes via the north gate to the upper car park. That's the marked assembly point."
    },
    {
      "id": "p09-c-02-s03",
      "speaker": "Mara",
      "text": "One pupil might suggest the tunnel because it looks shorter."
    },
    {
      "id": "p09-c-02-s04",
      "speaker": "Jun",
      "text": "The tunnel is inside the red zone on this exercise map. The instructions say not to enter it."
    },
    {
      "id": "p09-c-02-s05",
      "speaker": "Mara",
      "text": "Then I'll ask the class to trace the blue route, not choose a shortcut."
    },
    {
      "id": "p09-c-02-s06",
      "speaker": "Jun",
      "text": "Good. We'll show the alert first, then have them mark the north gate and the car park on their copies."
    },
    {
      "id": "p09-c-02-s07",
      "speaker": "Mara",
      "text": "Agreed. That checks whether they've understood this school's plan."
    }
  ],
