{
  "id": "p09-c-03",
  "title_zh": "降低开场伴奏音量并试唱后保留设置",
  "topic_id": "leisure",
  "scenario": {
    "id": "choir-quiet-opening-rehearsal",
    "label_zh": "试唱后调整开场曲伴奏和轻声提示",
    "goal_zh": "比较开场曲的慢速变奏，试唱后保留较低音量并约定用轻声提示开始"
  },
  "participants": [
    "Bea",
    "Leon"
  ],
  "context_zh": "合唱排练中，歌手与伴奏者调整开场。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-03-s01",
      "speaker": "Bea",
      "text": "Could we start with the slower variation of this tune? The first line feels rushed."
    },
    {
      "id": "p09-c-03-s02",
      "speaker": "Leon",
      "text": "Let's try it. I'll keep the melody the same but vary the rhythm in the left hand."
    },
    {
      "id": "p09-c-03-s03",
      "speaker": "Bea",
      "text": "Before we sing, can you lower the volume a little? I can't hear the people behind me."
    },
    {
      "id": "p09-c-03-s04",
      "speaker": "Leon",
      "text": "I've turned it down. Ready for the opening line?"
    },
    {
      "id": "p09-c-03-s05",
      "speaker": "Bea",
      "text": "That run was much easier to hear. Let's keep that setting."
    },
    {
      "id": "p09-c-03-s06",
      "speaker": "Leon",
      "text": "Shall I count us in loudly?"
    },
    {
      "id": "p09-c-03-s07",
      "speaker": "Bea",
      "text": "Please whisper the count. The audience shouldn't hear it."
    },
    {
      "id": "p09-c-03-s08",
      "speaker": "Leon",
      "text": "All right. A quiet count, then the slower opening."
    }
  ],
