{
  "id": "p09-c-09",
  "title_zh": "商定联合社团申请临时活动室",
  "topic_id": "community",
  "scenario": {
    "id": "club-shared-hall-request-alliance",
    "label_zh": "组成合作小组并决定共同提出场地请求",
    "goal_zh": "说明洪水后共同的场地困难，商定以合作小组名义提出共享活动室请求"
  },
  "participants": [
    "Dalia",
    "Mick"
  ],
  "context_zh": "虚构社区洪水后，两名社团负责人商议场地，不涉及真实灾情。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-09-s01",
      "speaker": "Dalia",
      "text": "In the aftermath of the flood, three clubs have lost their meeting rooms. Could we ask for the empty library room together?"
    },
    {
      "id": "p09-c-09-s02",
      "speaker": "Mick",
      "text": "Yes. The drama club would be a useful ally; they already know the building manager."
    },
    {
      "id": "p09-c-09-s03",
      "speaker": "Dalia",
      "text": "I'd like this to unite the clubs, not start an argument about who gets the best evening."
    },
    {
      "id": "p09-c-09-s04",
      "speaker": "Mick",
      "text": "Then the alliance needs one shared request and a timetable we can all accept."
    },
    {
      "id": "p09-c-09-s05",
      "speaker": "Dalia",
      "text": "We can show unity without pretending our needs are identical. Let's ask for a trial month with different evenings."
    },
    {
      "id": "p09-c-09-s06",
      "speaker": "Mick",
      "text": "Agreed. I'll draft that request for all three clubs to check before it goes to the manager."
    }
  ],
