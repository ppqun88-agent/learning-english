{
  "id": "p09-c-11",
  "title_zh": "调整展板边框并核对竖直位置",
  "topic_id": "work",
  "scenario": {
    "id": "exhibition-panel-frame-alignment",
    "label_zh": "调整展板边框并核对竖直位置",
    "goal_zh": "将铝制边框与标线对齐，检查调整后的竖直位置并确认保留"
  },
  "participants": [
    "Pia",
    "Dev"
  ],
  "context_zh": "展览布置人员在安装前试摆轻质展示板。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-11-s01",
      "speaker": "Pia",
      "text": "This aluminium frame is lighter than the old one, but it looks crooked."
    },
    {
      "id": "p09-c-11-s02",
      "speaker": "Dev",
      "text": "The printed border may be misleading us. Let's align the frame with the pencil marks on the backing board."
    },
    {
      "id": "p09-c-11-s03",
      "speaker": "Pia",
      "text": "I've moved it to the marks. Could you check the left edge with the level?"
    },
    {
      "id": "p09-c-11-s04",
      "speaker": "Dev",
      "text": "It's vertical now. The bubble is in the middle."
    },
    {
      "id": "p09-c-11-s05",
      "speaker": "Pia",
      "text": "How does the alignment look from the doorway?"
    },
    {
      "id": "p09-c-11-s06",
      "speaker": "Dev",
      "text": "Straight. Keep it there, and I'll mark the fixing points before we take it down."
    }
  ],
