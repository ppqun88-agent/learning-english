{
  "id": "p09-c-12",
  "title_zh": "核对工厂岗位的工资与人数信息",
  "topic_id": "work",
  "scenario": {
    "id": "factory-weekly-pay-inquiry",
    "label_zh": "核对招聘工资和员工人数图表",
    "goal_zh": "区分基本周薪和加班报酬，澄清员工人数图不是工资增长图并决定索取岗位说明"
  },
  "participants": [
    "Finn",
    "Rosa"
  ],
  "context_zh": "虚构工厂招聘咨询，求职者询问装配岗位的信息，不构成实际工作要约。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-12-s01",
      "speaker": "Finn",
      "text": "For the assembly job at your factory, is the weekly wage on this poster the basic pay, or does it include overtime?"
    },
    {
      "id": "p09-c-12-s02",
      "speaker": "Rosa",
      "text": "It's the basic pay for the stated hours. Overtime is listed separately in the job description."
    },
    {
      "id": "p09-c-12-s03",
      "speaker": "Finn",
      "text": "The line on this chart goes upward quite sharply. Does that show pay increasing?"
    },
    {
      "id": "p09-c-12-s04",
      "speaker": "Rosa",
      "text": "No. It shows the size of our workforce over five years, not anyone's pay."
    },
    {
      "id": "p09-c-12-s05",
      "speaker": "Finn",
      "text": "Thanks for explaining. Could I read about training and safety in the workplace before I apply?"
    },
    {
      "id": "p09-c-12-s06",
      "speaker": "Rosa",
      "text": "Of course. I'll send you the full job description, including the hours and pay details."
    },
    {
      "id": "p09-c-12-s07",
      "speaker": "Finn",
      "text": "Please do. I'll read that before deciding whether to apply."
    }
  ],
