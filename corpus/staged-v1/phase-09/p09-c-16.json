{
  "id": "p09-c-16",
  "title_zh": "核对肖像画说明中的买主财富与购藏记录",
  "topic_id": "leisure",
  "scenario": {
    "id": "museum-portrait-acquisition-label",
    "label_zh": "根据购藏记录核对富商所购肖像画的说明",
    "goal_zh": "区分有记录的购藏信息和未经证实的审美动机，约定保留来源并删除推测"
  },
  "participants": [
    "Lin",
    "George"
  ],
  "context_zh": "博物馆志愿者根据虚构馆藏卡讨论展品说明。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-16-s01",
      "speaker": "Lin",
      "text": "The label says this wealthy merchant bought the portrait to impress his rivals. Do we have a source for that?"
    },
    {
      "id": "p09-c-16-s02",
      "speaker": "George",
      "text": "No. The archive records his wealth and the date of the acquisition, but not his motive."
    },
    {
      "id": "p09-c-16-s03",
      "speaker": "Lin",
      "text": "Then we should remove that sentence. The purchase is documented, whereas the rivalry is only a story from a later guidebook."
    },
    {
      "id": "p09-c-16-s04",
      "speaker": "George",
      "text": "Could we say he bought it for its aesthetic value?"
    },
    {
      "id": "p09-c-16-s05",
      "speaker": "Lin",
      "text": "That's another guess about what he thought. We can describe the colours without claiming to know why he bought it."
    },
    {
      "id": "p09-c-16-s06",
      "speaker": "George",
      "text": "You're right. I'll keep the acquisition date, cite the archive card, and cut the sentence about his motive."
    }
  ],
