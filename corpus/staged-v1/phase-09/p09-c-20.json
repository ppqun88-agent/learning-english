{
  "id": "p09-c-20",
  "title_zh": "肯定打完全场的进步并选择传球练习",
  "topic_id": "leisure",
  "scenario": {
    "id": "team-season-progress-next-practice",
    "label_zh": "承认进步并针对薄弱点选择下一次训练",
    "goal_zh": "区分比赛输赢和个人进步，指出传球薄弱点并约定下次先练传球"
  },
  "participants": [
    "Ada",
    "Marcus"
  ],
  "context_zh": "教练与成年业余球员复盘一场比赛。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-20-s01",
      "speaker": "Ada",
      "text": "We didn't get a victory, so it feels as if the whole month was wasted."
    },
    {
      "id": "p09-c-20-s02",
      "speaker": "Marcus",
      "text": "You played the full match for the first time. That's an accomplishment, even though we lost."
    },
    {
      "id": "p09-c-20-s03",
      "speaker": "Ada",
      "text": "My passing is still a weakness. I gave the ball away three times."
    },
    {
      "id": "p09-c-20-s04",
      "speaker": "Marcus",
      "text": "Then it would be wise to practise short passes before we add more shooting drills."
    },
    {
      "id": "p09-c-20-s05",
      "speaker": "Ada",
      "text": "My old coach's favourite piece of wisdom was, 'Work on what the match shows you.' I suppose that's what you're saying."
    },
    {
      "id": "p09-c-20-s06",
      "speaker": "Marcus",
      "text": "Exactly. Shall we spend the first ten minutes on passing next time?"
    },
    {
      "id": "p09-c-20-s07",
      "speaker": "Ada",
      "text": "Yes. I can be pleased that I finished and still work on that."
    }
  ],
