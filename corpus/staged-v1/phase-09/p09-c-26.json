{
  "id": "p09-c-26",
  "title_zh": "核对出行补助用途并明确记录责任",
  "topic_id": "work",
  "scenario": {
    "id": "grant-travel-allocation-record",
    "label_zh": "核对补助用途及责任并分配记录工作",
    "goal_zh": "按给定资助条件保留出行预算，明确单次补助上限、记录分工和最终负责者"
  },
  "participants": [
    "Imani",
    "Oscar"
  ],
  "context_zh": "虚构项目预算交接练习，金额仅为情景材料。",
  "author": "author-phase09-c",
  "sentences": [
    {
      "id": "p09-c-26-s01",
      "speaker": "Imani",
      "text": "The grant gives us a travel allocation of two hundred pounds. Can we allocate any of it to refreshments?"
    },
    {
      "id": "p09-c-26-s02",
      "speaker": "Oscar",
      "text": "Not in accordance with this agreement. That money is reserved for participants' journeys."
    },
    {
      "id": "p09-c-26-s03",
      "speaker": "Imani",
      "text": "Understood. The travel allowance is ten pounds per person for each session, with receipts, isn't it?"
    },
    {
      "id": "p09-c-26-s04",
      "speaker": "Oscar",
      "text": "Yes. Those are the limits in the letter. If fewer people claim, we record the unused balance rather than spend it elsewhere."
    },
    {
      "id": "p09-c-26-s05",
      "speaker": "Imani",
      "text": "I'll adjust the worksheet accordingly and keep the refreshments on a separate line."
    },
    {
      "id": "p09-c-26-s06",
      "speaker": "Oscar",
      "text": "For accountability, each payment needs a receipt and the name of the person who checked it."
    },
    {
      "id": "p09-c-26-s07",
      "speaker": "Imani",
      "text": "I'll check the receipts. Who is accountable for the final report?"
    },
    {
      "id": "p09-c-26-s08",
      "speaker": "Oscar",
      "text": "I am. You keep the payment records, and I'll reconcile the total before submitting the report."
    },
    {
      "id": "p09-c-26-s09",
      "speaker": "Imani",
      "text": "Agreed. I'll bring you the records after each session."
    }
  ],
