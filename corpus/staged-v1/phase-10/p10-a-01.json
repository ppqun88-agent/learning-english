{
  "id": "p10-a-01",
  "title_zh": "商定摄影背景架的组装顺序",
  "topic_id": "work",
  "scenario": {
    "id": "photo-booth-frame-assembly-plan",
    "label_zh": "确定摄影背景架的组装方案",
    "goal_zh": "确认摄影背景架的材料和部件，约定先组架再挂背景布"
  },
  "participants": [
    "Mina",
    "Felix"
  ],
  "context_zh": "摄影活动开始前，两位工作人员查看待组装的背景架及布料。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-01-s01",
      "speaker": "Mina",
      "text": "Can you help me assemble the frame for the photo booth?"
    },
    {
      "id": "p10-a-01-s02",
      "speaker": "Felix",
      "text": "Sure. These poles are made of aluminum. Are they all the parts we need?"
    },
    {
      "id": "p10-a-01-s03",
      "speaker": "Mina",
      "text": "Yes, along with the feet in that box. The assembly instructions show where each pole goes."
    },
    {
      "id": "p10-a-01-s04",
      "speaker": "Felix",
      "text": "And this canvas is the backdrop, right?"
    },
    {
      "id": "p10-a-01-s05",
      "speaker": "Mina",
      "text": "Right. Let's put the frame together while it's still bare, then hang the fabric."
    },
    {
      "id": "p10-a-01-s06",
      "speaker": "Felix",
      "text": "Agreed. I'll unpack the feet, and we'll check the diagram before joining anything."
    }
  ],
