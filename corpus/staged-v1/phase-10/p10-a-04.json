{
  "id": "p10-a-04",
  "title_zh": "约定社团章程修订的投票安排",
  "topic_id": "community",
  "scenario": {
    "id": "club-charter-amendment-ballot-plan",
    "label_zh": "安排社团章程修改表决",
    "goal_zh": "明确现行委员任命规则与修改提案，并约定下次会议投票前发送完整修订文字"
  },
  "participants": [
    "Ada",
    "Jonas"
  ],
  "context_zh": "虚构摄影社团的秘书和主席讨论如何让会员决定任命规则。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-04-s01",
      "speaker": "Ada",
      "text": "Our charter says the chair can appoint the equipment committee without consulting members."
    },
    {
      "id": "p10-a-04-s02",
      "speaker": "Jonas",
      "text": "I know. The last selection felt arbitrary because nobody explained the criteria."
    },
    {
      "id": "p10-a-04-s03",
      "speaker": "Ada",
      "text": "I'd like to amend that section so members elect the committee instead."
    },
    {
      "id": "p10-a-04-s04",
      "speaker": "Jonas",
      "text": "Then we need the full wording of the amendment before anyone votes."
    },
    {
      "id": "p10-a-04-s05",
      "speaker": "Ada",
      "text": "I'll send it with next week's meeting notice. Can we hold a secret ballot at that meeting?"
    },
    {
      "id": "p10-a-04-s06",
      "speaker": "Jonas",
      "text": "Yes. Put the proposal on the agenda, but make clear that the current rule still applies until members approve a change."
    },
    {
      "id": "p10-a-04-s07",
      "speaker": "Ada",
      "text": "Understood. I'll describe it as a proposal, not an adopted rule."
    }
  ],
