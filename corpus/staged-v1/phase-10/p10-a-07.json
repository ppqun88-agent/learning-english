{
  "id": "p10-a-07",
  "title_zh": "选定奇幻故事封面的双角色画面",
  "topic_id": "leisure",
  "scenario": {
    "id": "fantasy-book-cover-character-choice",
    "label_zh": "选定奇幻故事封面角色",
    "goal_zh": "依据故事角色关系，选择天使与野兽友好相处的封面草图"
  },
  "participants": [
    "Lucia",
    "Pavel"
  ],
  "context_zh": "儿童奇幻故事作者与插画师挑选封面，不涉及宗教事实说明。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-07-s01",
      "speaker": "Lucia",
      "text": "The winged figure is an angel, and the enormous creature beside her is the beast from chapter one."
    },
    {
      "id": "p10-a-07-s02",
      "speaker": "Pavel",
      "text": "Readers may expect a fight. Isn't the creature actually her beloved companion?"
    },
    {
      "id": "p10-a-07-s03",
      "speaker": "Lucia",
      "text": "Exactly. In the story she rescues him, and they become friends."
    },
    {
      "id": "p10-a-07-s04",
      "speaker": "Pavel",
      "text": "Then the sketch where he's breathing fire at her gives a bizarre impression of their relationship."
    },
    {
      "id": "p10-a-07-s05",
      "speaker": "Lucia",
      "text": "Let's use the other one, where she's sitting beside him and he's asleep."
    },
    {
      "id": "p10-a-07-s06",
      "speaker": "Pavel",
      "text": "Agreed. I'll develop that quiet scene for the cover."
    }
  ],
