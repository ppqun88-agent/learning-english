{
  "id": "p10-a-09",
  "title_zh": "停用破损实验装置并约定交技术员处理",
  "topic_id": "learning",
  "scenario": {
    "id": "lab-apparatus-stop-and-store",
    "label_zh": "停止使用损坏实验装置并安排存放",
    "goal_zh": "说明昨日管道破裂情况，停止本次演示并约定将装置标注后交技术员检查"
  },
  "participants": [
    "Professor Hall",
    "Anika"
  ],
  "context_zh": "虚构教学实验室场景中，老师与助手准备演示时核对设备状态。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-09-s01",
      "speaker": "Professor Hall",
      "text": "Why is the apparatus still on the bench instead of in the equipment cabinet?"
    },
    {
      "id": "p10-a-09-s02",
      "speaker": "Anika",
      "text": "A tube burst during yesterday's test. I left everything disconnected for the technician."
    },
    {
      "id": "p10-a-09-s03",
      "speaker": "Professor Hall",
      "text": "Was the chamber damaged as well?"
    },
    {
      "id": "p10-a-09-s04",
      "speaker": "Anika",
      "text": "I don't know. I haven't opened it or tried another test."
    },
    {
      "id": "p10-a-09-s05",
      "speaker": "Professor Hall",
      "text": "Then all use must cease until the technician has checked it. We won't run today's demonstration."
    },
    {
      "id": "p10-a-09-s06",
      "speaker": "Anika",
      "text": "I'll label it as out of use and ask the technician where it should be stored."
    },
    {
      "id": "p10-a-09-s07",
      "speaker": "Professor Hall",
      "text": "Good. Leave it disconnected here until they take over."
    }
  ],
