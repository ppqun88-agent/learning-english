{
  "id": "p10-a-11",
  "title_zh": "点购半份三明治与薄荷茶",
  "topic_id": "food",
  "scenario": {
    "id": "cafe-small-meal-drink-choice",
    "label_zh": "点购小份午餐与饮料",
    "goal_zh": "说明食量较小，选择半份三明治及一杯不加糖的薄荷茶"
  },
  "participants": [
    "Nia",
    "Marco"
  ],
  "context_zh": "咖啡馆顾客根据胃口选择午餐份量及饮品。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-11-s01",
      "speaker": "Nia",
      "text": "The sandwiches look appealing, but I don't have much of an appetite today. Can I get a half portion?"
    },
    {
      "id": "p10-a-11-s02",
      "speaker": "Marco",
      "text": "Yes. Half a cheese sandwich comes with a small salad."
    },
    {
      "id": "p10-a-11-s03",
      "speaker": "Nia",
      "text": "I'll have that. What hot beverage would you suggest without milk?"
    },
    {
      "id": "p10-a-11-s04",
      "speaker": "Marco",
      "text": "Our mint blend is popular. It's a mixture of two kinds of mint, with no milk added."
    },
    {
      "id": "p10-a-11-s05",
      "speaker": "Nia",
      "text": "A cup of that, please, and no sugar."
    },
    {
      "id": "p10-a-11-s06",
      "speaker": "Marco",
      "text": "So that's half a cheese sandwich with salad and an unsweetened mint tea."
    },
    {
      "id": "p10-a-11-s07",
      "speaker": "Nia",
      "text": "That's right, thank you."
    }
  ],
