{
  "id": "p10-a-13",
  "title_zh": "找到历史会堂导览的集合长凳",
  "topic_id": "travel",
  "scenario": {
    "id": "heritage-hall-bench-meeting-point",
    "label_zh": "确认历史会堂导览的集合长凳",
    "goal_zh": "根据会堂内的建筑位置找到指定长凳，并确认在此等候导览"
  },
  "participants": [
    "Cora",
    "Evan"
  ],
  "context_zh": "历史会堂内，游客向接待员核对建筑导览的集合地点。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-13-s01",
      "speaker": "Cora",
      "text": "Where should I wait for the architectural tour of this hall?"
    },
    {
      "id": "p10-a-13-s02",
      "speaker": "Evan",
      "text": "On the long bench beneath the large wooden beam. Can you see it beyond the doorway?"
    },
    {
      "id": "p10-a-13-s03",
      "speaker": "Cora",
      "text": "I see two benches. Do you mean the one against the stone wall?"
    },
    {
      "id": "p10-a-13-s04",
      "speaker": "Evan",
      "text": "Yes, directly under that beam, not the one beside the window."
    },
    {
      "id": "p10-a-13-s05",
      "speaker": "Cora",
      "text": "I've found it. I'll wait here for the guide."
    },
    {
      "id": "p10-a-13-s06",
      "speaker": "Evan",
      "text": "That's the right place. The guide will come to that bench."
    }
  ],
