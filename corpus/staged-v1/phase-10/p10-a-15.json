{
  "id": "p10-a-15",
  "title_zh": "重写经济学作文中过强的断言",
  "topic_id": "learning",
  "scenario": {
    "id": "economics-essay-claim-revision",
    "label_zh": "修改经济学作文的绝对化断言",
    "goal_zh": "区分资本主义制度与单个企业案例，并将普遍化断言改为限定于案例的评价"
  },
  "participants": [
    "Miles",
    "Dr Chen"
  ],
  "context_zh": "虚构课堂作文反馈中，师生仅依据给定案例讨论论证范围。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-15-s01",
      "speaker": "Miles",
      "text": "My essay says capitalism always rewards the most useful businesses. Is that too strong?"
    },
    {
      "id": "p10-a-15-s02",
      "speaker": "Dr Chen",
      "text": "Yes. You can't characterize an entire economic system from one successful company."
    },
    {
      "id": "p10-a-15-s03",
      "speaker": "Miles",
      "text": "But the case study calls its setting a capitalist economy."
    },
    {
      "id": "p10-a-15-s04",
      "speaker": "Dr Chen",
      "text": "That describes the setting. It doesn't support your assertion about what always happens there."
    },
    {
      "id": "p10-a-15-s05",
      "speaker": "Miles",
      "text": "Could I assert that this particular company served its customers well?"
    },
    {
      "id": "p10-a-15-s06",
      "speaker": "Dr Chen",
      "text": "The customer interviews support that, although the survey is small. Keep that limit visible."
    },
    {
      "id": "p10-a-15-s07",
      "speaker": "Miles",
      "text": "I've changed it to: 'The company was arguably successful at meeting the needs of the customers interviewed.'"
    },
    {
      "id": "p10-a-15-s08",
      "speaker": "Dr Chen",
      "text": "That's a claim the case can support. Keep the next sentence about the small sample too."
    }
  ],
