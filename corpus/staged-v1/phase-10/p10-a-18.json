{
  "id": "p10-a-18",
  "title_zh": "战争影片讨论改用文字简介",
  "topic_id": "leisure",
  "scenario": {
    "id": "fictional-war-film-content-note",
    "label_zh": "约定以文字简介代替战争影片片段",
    "goal_zh": "核对虚构影片简介中的暴力内容，并决定不用影像片段而分发简短内容说明"
  },
  "participants": [
    "Priya",
    "Marcus"
  ],
  "context_zh": "影迷读书小组筹办者讨论一部完全虚构的战争影片是否适合周末活动。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-18-s01",
      "speaker": "Priya",
      "text": "The programme notes say the film opens with an assassination and then moves to a battlefield. Is that too much for Saturday's discussion?"
    },
    {
      "id": "p10-a-18-s02",
      "speaker": "Marcus",
      "text": "Possibly. The review also describes an atrocity against villagers, so it isn't only about soldiers fighting."
    },
    {
      "id": "p10-a-18-s03",
      "speaker": "Priya",
      "text": "It calls one central character a civilian casualty. Does the review describe what happened to her?"
    },
    {
      "id": "p10-a-18-s04",
      "speaker": "Marcus",
      "text": "Yes. It says she's injured during an attack, and it warns that the scene is brutal."
    },
    {
      "id": "p10-a-18-s05",
      "speaker": "Priya",
      "text": "Let's not show a clip. We can discuss the review's argument without asking everyone to watch that."
    },
    {
      "id": "p10-a-18-s06",
      "speaker": "Marcus",
      "text": "Agreed. I'll prepare a short written summary with a content note about violence, and people can choose whether to join that discussion."
    },
    {
      "id": "p10-a-18-s07",
      "speaker": "Priya",
      "text": "Good. Put the summary on the reading list in place of the clip."
    }
  ],
