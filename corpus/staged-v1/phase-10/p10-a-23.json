{
  "id": "p10-a-23",
  "title_zh": "断网时打开备份并约好本地改稿",
  "topic_id": "work",
  "scenario": {
    "id": "offline-backup-while-awaiting-service",
    "label_zh": "断网期间改用本地备份",
    "goal_zh": "确认重新打开浏览器未恢复连接，打开本地备份并约定网络恢复前不上传"
  },
  "participants": [
    "Pia",
    "Nathan"
  ],
  "context_zh": "办公室同事遇到宽带中断，改用已保存的本地文件继续工作。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-23-s01",
      "speaker": "Pia",
      "text": "The broadband is down again. I've reopened the browser, but the shared report still won't load."
    },
    {
      "id": "p10-a-23-s02",
      "speaker": "Nathan",
      "text": "There's a backup on this laptop from yesterday afternoon. We can work on that while we await the provider's update."
    },
    {
      "id": "p10-a-23-s03",
      "speaker": "Pia",
      "text": "Will that have the table we added after lunch?"
    },
    {
      "id": "p10-a-23-s04",
      "speaker": "Nathan",
      "text": "Let's check. I've opened the local copy, and the table is here on page three."
    },
    {
      "id": "p10-a-23-s05",
      "speaker": "Pia",
      "text": "Good. I'll make my edits in this copy and leave the upload until the connection returns."
    },
    {
      "id": "p10-a-23-s06",
      "speaker": "Nathan",
      "text": "Agreed. We'll compare versions before replacing anything online."
    }
  ],
