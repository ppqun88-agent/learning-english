{
  "id": "p10-a-30",
  "title_zh": "约好为散页传记申请装订评估",
  "topic_id": "services",
  "scenario": {
    "id": "archive-biography-binding-referral",
    "label_zh": "为档案馆传记申请装订评估",
    "goal_zh": "确认档案馆传记的目录身份及散页问题，并约定先申请装订评估而不自行粘补"
  },
  "participants": [
    "Esther",
    "Leo"
  ],
  "context_zh": "档案馆阅览室中，读者向工作人员报告一本传记的书页松脱。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-30-s01",
      "speaker": "Esther",
      "text": "The catalogue says this is the town founder's biography, but several pages are loose."
    },
    {
      "id": "p10-a-30-s02",
      "speaker": "Leo",
      "text": "Yes, it belongs to our archive. Please leave the pages in their current order."
    },
    {
      "id": "p10-a-30-s03",
      "speaker": "Esther",
      "text": "Could someone bind it again? I don't want the next reader to lose a page."
    },
    {
      "id": "p10-a-30-s04",
      "speaker": "Leo",
      "text": "I'll ask our conservator to assess it. We shouldn't glue anything ourselves."
    },
    {
      "id": "p10-a-30-s05",
      "speaker": "Esther",
      "text": "Here's the book, with the loose pages still between the covers."
    },
    {
      "id": "p10-a-30-s06",
      "speaker": "Leo",
      "text": "Thank you. I'll keep it off the reading shelf and send the assessment request today."
    }
  ],
