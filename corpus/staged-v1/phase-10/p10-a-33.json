{
  "id": "p10-a-33",
  "title_zh": "确认封路期间通往酒店的人行路线",
  "topic_id": "travel",
  "scenario": {
    "id": "hotel-road-closure-route",
    "label_zh": "确认封路期间通往酒店的步行路线",
    "goal_zh": "辨认赌场对面的酒店，并确认沿开放人行道到临时过街点的路线"
  },
  "participants": [
    "Nolan",
    "Grace"
  ],
  "context_zh": "虚构城市中，游客在道路施工与街头音乐声中向酒店接待员电话问路。",
  "author": "author-phase10-a",
  "sentences": [
    {
      "id": "p10-a-33-s01",
      "speaker": "Nolan",
      "text": "I'm outside the casino opposite your hotel. I missed your directions amid all this chaos, and that blast of music didn't help."
    },
    {
      "id": "p10-a-33-s02",
      "speaker": "Grace",
      "text": "No problem. The road closure is for vehicles. The pavement on your side is still open."
    },
    {
      "id": "p10-a-33-s03",
      "speaker": "Nolan",
      "text": "Can I cross straight in front of the hotel?"
    },
    {
      "id": "p10-a-33-s04",
      "speaker": "Grace",
      "text": "Not there. Walk along the open pavement to the marked temporary crossing, then come back on the hotel side."
    },
    {
      "id": "p10-a-33-s05",
      "speaker": "Nolan",
      "text": "I can see the crossing sign now. So I follow this pavement, cross at the sign, and walk back to your entrance."
    },
    {
      "id": "p10-a-33-s06",
      "speaker": "Grace",
      "text": "Exactly. Stay on the marked pedestrian route; you don't need to enter the work area."
    }
  ],
