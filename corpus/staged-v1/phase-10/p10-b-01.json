{
  "id": "p10-b-01",
  "title_zh": "约定就水坝提案提出联合问题",
  "topic_id": "nature",
  "scenario": {
    "id": "river-dam-consultation-plan",
    "label_zh": "约定就水坝提案提出联合问题",
    "goal_zh": "明确海岸居民团体对水坝影响的疑问，并约定征询两组意见后再联合提交咨询问题"
  },
  "participants": [
    "Mina",
    "Owen"
  ],
  "context_zh": "虚构环境讨论：两个海岸居民团体准备参加一项水坝提案的咨询会，不预判工程影响。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-01-s01",
      "speaker": "Owen",
      "text": "Our coastal residents group wants to join the coalition asking questions about the proposed dam."
    },
    {
      "id": "p10-b-01-s02",
      "speaker": "Mina",
      "text": "Good. We want to conserve the river habitat, but we still need to understand what the design would change."
    },
    {
      "id": "p10-b-01-s03",
      "speaker": "Owen",
      "text": "Some members want us to demand that the whole project be cancelled."
    },
    {
      "id": "p10-b-01-s04",
      "speaker": "Mina",
      "text": "We don't have the impact study yet. Could our collective response ask about fish movement and water levels instead?"
    },
    {
      "id": "p10-b-01-s05",
      "speaker": "Owen",
      "text": "Yes. I'll bring those two questions to our group tonight and explain that we aren't endorsing either outcome."
    },
    {
      "id": "p10-b-01-s06",
      "speaker": "Mina",
      "text": "I'll do the same. If both groups agree, we'll submit the questions together before the consultation meeting."
    }
  ],
