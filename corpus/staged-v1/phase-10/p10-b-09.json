{
  "id": "p10-b-09",
  "title_zh": "暂缓报道未经核实的腐败指控",
  "topic_id": "work",
  "scenario": {
    "id": "investigation-evidence-publication-hold",
    "label_zh": "暂缓报道未经核实的腐败指控",
    "goal_zh": "区分可核查线索与既定结论，并决定先核验原始文件再使用指控性措辞"
  },
  "participants": [
    "Editor",
    "Tessa"
  ],
  "context_zh": "虚构新闻编辑室：记者收到匿名材料，讨论是否足以支持腐败报道。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-09-s01",
      "speaker": "Tessa",
      "text": "This anonymous email calls the procurement officer corrupt. Should that be our headline?"
    },
    {
      "id": "p10-b-09-s02",
      "speaker": "Editor",
      "text": "No. Do we have credible evidence, or just the accusation?"
    },
    {
      "id": "p10-b-09-s03",
      "speaker": "Tessa",
      "text": "There is a payment spreadsheet, but we have not checked where it came from."
    },
    {
      "id": "p10-b-09-s04",
      "speaker": "Editor",
      "text": "Then calling it proof of corruption would damage our credibility. We need the original records and a response from the people concerned."
    },
    {
      "id": "p10-b-09-s05",
      "speaker": "Tessa",
      "text": "I want the investigation to help combat misuse of public money, not spread a rumour."
    },
    {
      "id": "p10-b-09-s06",
      "speaker": "Editor",
      "text": "Then start by checking the spreadsheet against the records. We'll hold the accusatory headline until we have evidence we can stand behind."
    },
    {
      "id": "p10-b-09-s07",
      "speaker": "Tessa",
      "text": "Agreed. I'll verify the documents before writing that claim."
    }
  ],
