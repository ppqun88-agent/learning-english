{
  "id": "p10-b-10",
  "title_zh": "调整国际象棋决赛直播的开场介绍",
  "topic_id": "leisure",
  "scenario": {
    "id": "chess-final-broadcast-opening",
    "label_zh": "调整国际象棋决赛直播的开场介绍",
    "goal_zh": "确认开播提示和解说分工，并决定不提前把关键一局说成决定胜负"
  },
  "participants": [
    "Producer",
    "Evan"
  ],
  "context_zh": "虚构俱乐部国际象棋决赛直播前，主持人与解说员核对开场。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-10-s01",
      "speaker": "Evan",
      "text": "As the commentator, should I call this the decisive game in my introduction?"
    },
    {
      "id": "p10-b-10-s02",
      "speaker": "Producer",
      "text": "Not yet. A draw would mean another game, so the title is still open."
    },
    {
      "id": "p10-b-10-s03",
      "speaker": "Evan",
      "text": "Then I'll introduce Mara as a strong contender and explain the possible outcomes."
    },
    {
      "id": "p10-b-10-s04",
      "speaker": "Producer",
      "text": "Good. Your commentary can begin after I welcome the audience. The first move is scheduled for two."
    },
    {
      "id": "p10-b-10-s05",
      "speaker": "Evan",
      "text": "The announcement says play will commence when the arbiter gives the signal. Shall I wait for that rather than assume the clock time?"
    },
    {
      "id": "p10-b-10-s06",
      "speaker": "Producer",
      "text": "Exactly. I'll welcome everyone, you explain the situation, and we wait for the arbiter before saying play has begun."
    }
  ],
