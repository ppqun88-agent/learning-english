{
  "id": "p10-b-11",
  "title_zh": "限定虚构听证会摘要的结论",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-hearing-summary-scope",
    "label_zh": "限定虚构听证会摘要的结论",
    "goal_zh": "区分官员声明与委员会决定，并约定摘要只保留材料中已有的听证内容"
  },
  "participants": [
    "Tutor",
    "Beth"
  ],
  "context_zh": "公民教育课堂使用虚构的国会听证会节录，学生修改摘要。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-11-s01",
      "speaker": "Beth",
      "text": "My summary says the congressional committee approved the new transport plan."
    },
    {
      "id": "p10-b-11-s02",
      "speaker": "Tutor",
      "text": "Which passage establishes approval?"
    },
    {
      "id": "p10-b-11-s03",
      "speaker": "Beth",
      "text": "The commissioner makes a declaration that her department supports it. I assumed the committee agreed."
    },
    {
      "id": "p10-b-11-s04",
      "speaker": "Tutor",
      "text": "That is her statement, not a committee vote. Does the extract include a vote?"
    },
    {
      "id": "p10-b-11-s05",
      "speaker": "Beth",
      "text": "No. I'll confine the summary to the commissioner's position and the questions that members asked."
    },
    {
      "id": "p10-b-11-s06",
      "speaker": "Tutor",
      "text": "Good. Keep the plan's status open rather than adding an outcome the extract doesn't provide."
    }
  ],
