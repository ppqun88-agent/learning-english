{
  "id": "p10-b-17",
  "title_zh": "约定先核对流程版本再合并志愿者手册",
  "topic_id": "work",
  "scenario": {
    "id": "volunteer-handbook-reconcile-versions",
    "label_zh": "约定先核对流程版本再合并志愿者手册",
    "goal_zh": "发现两份手册章节对应但内容不同，并分工核对现行流程后整理统一版本"
  },
  "participants": [
    "Idris",
    "Lena"
  ],
  "context_zh": "两位公益机构工作人员整理志愿者手册。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-17-s01",
      "speaker": "Lena",
      "text": "Can you compile the desk instructions into one volunteer handbook?"
    },
    {
      "id": "p10-b-17-s02",
      "speaker": "Idris",
      "text": "Yes, but these two files are not identical. Section three has a corresponding section in the older file with different opening steps."
    },
    {
      "id": "p10-b-17-s03",
      "speaker": "Lena",
      "text": "Do the section numbers still correspond to the same tasks?"
    },
    {
      "id": "p10-b-17-s04",
      "speaker": "Idris",
      "text": "They do. The titles match, but one says to use the paper register and the other says to use the tablet."
    },
    {
      "id": "p10-b-17-s05",
      "speaker": "Lena",
      "text": "We need consistency, not just a longer document. Please check with the desk lead before you consolidate the files."
    },
    {
      "id": "p10-b-17-s06",
      "speaker": "Idris",
      "text": "I'll mark the conflicting steps and ask which process is current. Could you check the contact names?"
    },
    {
      "id": "p10-b-17-s07",
      "speaker": "Lena",
      "text": "Yes. Let's merge the material only after both checks are complete."
    }
  ],
