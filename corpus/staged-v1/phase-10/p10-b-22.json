{
  "id": "p10-b-22",
  "title_zh": "约定停止贬低朋友的工作",
  "topic_id": "relationships",
  "scenario": {
    "id": "friends-comment-boundary-discussion",
    "label_zh": "约定停止贬低朋友的工作",
    "goal_zh": "说明贬低言语造成的感受，并在不扩大争执的情况下确认以后不再这样评论"
  },
  "participants": [
    "Seth",
    "Imani"
  ],
  "context_zh": "两位朋友私下谈论聚会时一人嘲笑另一人工作的事情。",
  "author": "author-phase10-b",
  "sentences": [
    {
      "id": "p10-b-22-s01",
      "speaker": "Imani",
      "text": "I wanted to confront you about what you said at dinner. Calling my work pointless was hurtful."
    },
    {
      "id": "p10-b-22-s02",
      "speaker": "Seth",
      "text": "I was joking. You don't have to condemn everything I say."
    },
    {
      "id": "p10-b-22-s03",
      "speaker": "Imani",
      "text": "I'm talking about that remark, not everything. It sounded as though you felt contempt for work that matters to me."
    },
    {
      "id": "p10-b-22-s04",
      "speaker": "Seth",
      "text": "I'm getting defensive. Let me start again. I didn't think about how it would sound."
    },
    {
      "id": "p10-b-22-s05",
      "speaker": "Imani",
      "text": "I don't want a confrontation every time we meet. I do want you to stop making my job the joke."
    },
    {
      "id": "p10-b-22-s06",
      "speaker": "Seth",
      "text": "You're right. I'm sorry for that comment. I won't make those jokes again."
    },
    {
      "id": "p10-b-22-s07",
      "speaker": "Imani",
      "text": "Thank you. That's the change I was asking for."
    }
  ],
