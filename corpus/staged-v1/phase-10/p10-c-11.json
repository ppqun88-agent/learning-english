{
  "id": "p10-c-11",
  "title_zh": "限定帮助网站更新的内部测试安排",
  "topic_id": "work",
  "scenario": {
    "id": "help-site-pilot-deployment-check",
    "label_zh": "限定帮助网站更新的测试范围",
    "goal_zh": "确认测试环境与演示内容，并约定先验证内部部署再考虑正式发布"
  },
  "participants": [
    "Priya",
    "Noel"
  ],
  "context_zh": "两名同事准备在隔离的测试环境中更新帮助网站。",
  "author": "author-phase10-c",
  "sentences": [
    {
      "id": "p10-c-11-s01",
      "speaker": "Priya",
      "text": "Can we deploy the new help page today?"
    },
    {
      "id": "p10-c-11-s02",
      "speaker": "Noel",
      "text": "To the test site, yes. This deployment must not touch the public site."
    },
    {
      "id": "p10-c-11-s03",
      "speaker": "Priya",
      "text": "I have the test domain open on a desktop. Where is the video file?"
    },
    {
      "id": "p10-c-11-s04",
      "speaker": "Noel",
      "text": "In the media directory. Can you embed it below the first set of instructions?"
    },
    {
      "id": "p10-c-11-s05",
      "speaker": "Priya",
      "text": "Yes. I will use the approved demo clip, not the recording with customer names."
    },
    {
      "id": "p10-c-11-s06",
      "speaker": "Noel",
      "text": "Good. After the test upload, check the video and all the links in a separate browser session."
    },
    {
      "id": "p10-c-11-s07",
      "speaker": "Priya",
      "text": "Understood. I will send you the test results before we make any decision about a public release."
    }
  ],
