{
  "id": "p10-c-29",
  "title_zh": "确定公众历史工作坊的参与式结构",
  "topic_id": "learning",
  "scenario": {
    "id": "public-history-workshop-structure",
    "label_zh": "设计鼓励参与的公众历史工作坊",
    "goal_zh": "明确工作坊讨论范围，并约定以口述故事、双人交流和开放提问鼓励参与"
  },
  "participants": [
    "June",
    "Dr Mensah"
  ],
  "context_zh": "成人教育负责人和受邀教育工作者筹备社区历史工作坊。",
  "author": "author-phase10-c",
  "sentences": [
    {
      "id": "p10-c-29-s01",
      "speaker": "June",
      "text": "As an educator, how would you make a local-history workshop feel less like a lecture?"
    },
    {
      "id": "p10-c-29-s02",
      "speaker": "Dr Mensah",
      "text": "Start with an engaging oral account, then ask people what they noticed before offering an interpretation."
    },
    {
      "id": "p10-c-29-s03",
      "speaker": "June",
      "text": "We want the session to enrich public discourse, not just test who knows the most dates."
    },
    {
      "id": "p10-c-29-s04",
      "speaker": "Dr Mensah",
      "text": "Then give people time to talk in pairs. Engagement is easier when every contribution does not have to be made to a whole room."
    },
    {
      "id": "p10-c-29-s05",
      "speaker": "June",
      "text": "Should the discussion encompass the entire town history?"
    },
    {
      "id": "p10-c-29-s06",
      "speaker": "Dr Mensah",
      "text": "Not in one evening. Let us focus on how one street changed, using two residents' accounts and a map."
    },
    {
      "id": "p10-c-29-s07",
      "speaker": "June",
      "text": "That gives us a clear structure: a short story, paired discussion, and open questions about that street."
    },
    {
      "id": "p10-c-29-s08",
      "speaker": "Dr Mensah",
      "text": "Yes. I will choose the accounts, and you can prepare the paired-discussion prompt."
    }
  ],
