{
  "id": "p11-a-01",
  "title_zh": "商定软件发布前的补充演练",
  "topic_id": "work",
  "scenario": {
    "id": "release-rehearsal-checkpoint",
    "label_zh": "商定软件发布前的补充演练",
    "goal_zh": "明确上次演练漏查的环节，并约定在测试环境演练新的检查步骤"
  },
  "participants": [
    "Mara",
    "Dev"
  ],
  "context_zh": "软件团队在发布前复核演练清单；本段只讨论测试安排，不执行真实发布。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-01-s01",
      "speaker": "Mara",
      "text": "With the release imminent, can we fit in one last rehearsal?"
    },
    {
      "id": "p11-a-01-s02",
      "speaker": "Dev",
      "text": "Yes, but let's execute the checklist in the test environment, not on the live service."
    },
    {
      "id": "p11-a-01-s03",
      "speaker": "Mara",
      "text": "The last rehearsal showed a gap in our execution: nobody checked the restored files."
    },
    {
      "id": "p11-a-01-s04",
      "speaker": "Dev",
      "text": "Then implementation of the new backup step needs an owner."
    },
    {
      "id": "p11-a-01-s05",
      "speaker": "Mara",
      "text": "I'll check the restored files. Can you watch the error log while I do that?"
    },
    {
      "id": "p11-a-01-s06",
      "speaker": "Dev",
      "text": "Of course. We'll rehearse those steps together before we decide whether we're ready."
    }
  ],
