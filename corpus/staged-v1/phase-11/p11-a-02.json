{
  "id": "p11-a-02",
  "title_zh": "约定暂停科学展台并请负责人检查",
  "topic_id": "learning",
  "scenario": {
    "id": "science-display-safety-pause",
    "label_zh": "约定暂停科学展台并请负责人检查",
    "goal_zh": "指出模型异常及展台安全边界，并约定暂停演示、请负责人检查"
  },
  "participants": [
    "Inez",
    "Colin"
  ],
  "context_zh": "虚构科学馆的工作人员检查一个氢能模型展台；展台不储存氢气，安全要求来自本场景给定的展台说明。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-02-s01",
      "speaker": "Inez",
      "text": "Is this the experimental display about hydrogen?"
    },
    {
      "id": "p11-a-02-s02",
      "speaker": "Colin",
      "text": "Yes. It uses a model, not real gas. The sign explains that hydrogen can form an explosive mixture with air."
    },
    {
      "id": "p11-a-02-s03",
      "speaker": "Inez",
      "text": "The model's cover has come loose. Could that be a hazard for visitors?"
    },
    {
      "id": "p11-a-02-s04",
      "speaker": "Colin",
      "text": "It could. The display instructions say to halt the demonstration if any cover is loose."
    },
    {
      "id": "p11-a-02-s05",
      "speaker": "Inez",
      "text": "Then let's leave it off and ask the supervisor to inspect it before anyone uses it."
    },
    {
      "id": "p11-a-02-s06",
      "speaker": "Colin",
      "text": "Agreed. I'll contact her now and keep visitors away from this table."
    }
  ],
