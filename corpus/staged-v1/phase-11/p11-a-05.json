{
  "id": "p11-a-05",
  "title_zh": "商定虚构博物馆预算中的采购延期",
  "topic_id": "work",
  "scenario": {
    "id": "fictional-museum-budget-gap",
    "label_zh": "商定虚构博物馆预算中的采购延期",
    "goal_zh": "区分总收入与可用余额，核对预算缺口并决定推迟展柜采购"
  },
  "participants": [
    "Priya",
    "Ben"
  ],
  "context_zh": "财务沟通练习：两名学员扮演虚构博物馆的项目人员，使用给定的预算数字，不提供现实财务建议。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-05-s01",
      "speaker": "Priya",
      "text": "The gross income for this fiscal year is eighty thousand. Why do we have only twelve thousand left?"
    },
    {
      "id": "p11-a-05-s02",
      "speaker": "Ben",
      "text": "Because gross income is before costs. Our expenditure so far is sixty-eight thousand."
    },
    {
      "id": "p11-a-05-s03",
      "speaker": "Priya",
      "text": "The new display cases would cost fifteen thousand, so we are three thousand short."
    },
    {
      "id": "p11-a-05-s04",
      "speaker": "Ben",
      "text": "And ordering them now would incur a storage charge, because the gallery is still closed."
    },
    {
      "id": "p11-a-05-s05",
      "speaker": "Priya",
      "text": "Let's postpone that purchase and keep using the existing cases."
    },
    {
      "id": "p11-a-05-s06",
      "speaker": "Ben",
      "text": "Agreed. I will revise the draft budget on that basis."
    }
  ],
