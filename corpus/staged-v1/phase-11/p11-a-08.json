{
  "id": "p11-a-08",
  "title_zh": "约定修正小说中派别与个人立场的概括",
  "topic_id": "leisure",
  "scenario": {
    "id": "novel-faction-motive-evidence",
    "label_zh": "约定修正小说中派别与个人立场的概括",
    "goal_zh": "区分小说派别的共同理念与一名人物的暴力立场，并商定修改读书会笔记"
  },
  "participants": [
    "Celia",
    "Jae"
  ],
  "context_zh": "两位读者讨论完全虚构的小说中名为 River Circle 的政治团体；不对应现实团体。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-08-s01",
      "speaker": "Celia",
      "text": "My notes describe everyone in the River Circle as an extremist."
    },
    {
      "id": "p11-a-08-s02",
      "speaker": "Jae",
      "text": "That is too broad. One faction argues for violence, but the rest reject it."
    },
    {
      "id": "p11-a-08-s03",
      "speaker": "Celia",
      "text": "Don't they share the same ideology about local self-rule?"
    },
    {
      "id": "p11-a-08-s04",
      "speaker": "Jae",
      "text": "They do, but that ideological agreement does not mean they agree on methods."
    },
    {
      "id": "p11-a-08-s05",
      "speaker": "Celia",
      "text": "Then I'll identify Varo as the character who supports attacks, rather than labeling the whole group."
    },
    {
      "id": "p11-a-08-s06",
      "speaker": "Jae",
      "text": "Good. Add that the other members challenge him in the meeting scene."
    }
  ],
