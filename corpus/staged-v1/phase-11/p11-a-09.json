{
  "id": "p11-a-09",
  "title_zh": "商定家庭水彩画的展示与搬运安排",
  "topic_id": "home",
  "scenario": {
    "id": "family-watercolour-display-plan",
    "label_zh": "商定家庭水彩画的展示与搬运安排",
    "goal_zh": "根据水彩画的脆弱状态选择避光展示位置，并约定请装裱师处理原作"
  },
  "participants": [
    "Elsa",
    "Tom"
  ],
  "context_zh": "家人查看祖母留下的一幅水彩画，决定如何在家中展示；对话讨论保存需求而不自行修复。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-09-s01",
      "speaker": "Elsa",
      "text": "I wanted to hang Grandma’s watercolour beside the sunny kitchen window."
    },
    {
      "id": "p11-a-09-s02",
      "speaker": "Tom",
      "text": "The colours could fade there. That light is quite harsh in the afternoon."
    },
    {
      "id": "p11-a-09-s03",
      "speaker": "Elsa",
      "text": "The paper looks fragile too. One corner is already torn."
    },
    {
      "id": "p11-a-09-s04",
      "speaker": "Tom",
      "text": "Then we should avoid unnecessary handling. Could we show a copy in the kitchen and keep the original in the shaded study?"
    },
    {
      "id": "p11-a-09-s05",
      "speaker": "Elsa",
      "text": "Yes. I'll ask a framer to assess the original before we move it into a new frame."
    },
    {
      "id": "p11-a-09-s06",
      "speaker": "Tom",
      "text": "Good. The copy can go by the window once we have it."
    }
  ],
