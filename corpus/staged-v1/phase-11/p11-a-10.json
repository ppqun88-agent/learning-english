{
  "id": "p11-a-10",
  "title_zh": "区分虚构案件报道中的指控与定罪",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-court-report-charge-boundary",
    "label_zh": "区分虚构案件报道中的指控与定罪",
    "goal_zh": "核对案例材料中的伤亡、武器及起诉信息，并商定避免预断有罪的报道表述"
  },
  "participants": [
    "Darius",
    "Mae"
  ],
  "context_zh": "虚构法律报道课堂：学员审阅一份教师编造的案件摘要，所有法律类别均只属于本练习设定。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-10-s01",
      "speaker": "Darius",
      "text": "Our case sheet describes a fatal shooting with a stolen firearm. Can my headline call the accused a killer?"
    },
    {
      "id": "p11-a-10-s02",
      "speaker": "Mae",
      "text": "No. It says the prosecutor has obtained an indictment, not a conviction."
    },
    {
      "id": "p11-a-10-s03",
      "speaker": "Darius",
      "text": "It also lists a felony charge. I thought that settled the question of guilt."
    },
    {
      "id": "p11-a-10-s04",
      "speaker": "Mae",
      "text": "In this exercise, a charge is an accusation. The trial has not taken place."
    },
    {
      "id": "p11-a-10-s05",
      "speaker": "Darius",
      "text": "Then I'll say the person has been charged in connection with the shooting and leave the verdict open."
    },
    {
      "id": "p11-a-10-s06",
      "speaker": "Mae",
      "text": "Yes. Keep the death in the report, but make the status of the case clear."
    }
  ],
