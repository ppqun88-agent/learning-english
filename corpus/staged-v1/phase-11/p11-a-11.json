{
  "id": "p11-a-11",
  "title_zh": "因大风改选码头装备检查",
  "topic_id": "travel",
  "scenario": {
    "id": "sailing-session-weather-choice",
    "label_zh": "因大风改选码头装备检查",
    "goal_zh": "依据船队暂停出航的安排取消本次水上练习，并选择在码头检查装备"
  },
  "participants": [
    "Imogen",
    "Kit"
  ],
  "context_zh": "学员与帆船教练在码头查看当天场地公布的风况和停航安排；不涉及现实天气预报。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-11-s01",
      "speaker": "Imogen",
      "text": "Are the conditions favourable for our first lesson?"
    },
    {
      "id": "p11-a-11-s02",
      "speaker": "Kit",
      "text": "Not on the water. The wind is fierce, and the whole training fleet is staying in the harbour."
    },
    {
      "id": "p11-a-11-s03",
      "speaker": "Imogen",
      "text": "Should I take my gear home, then?"
    },
    {
      "id": "p11-a-11-s04",
      "speaker": "Kit",
      "text": "You can, or we can use this hour to check it here on the dock. We will not go out today."
    },
    {
      "id": "p11-a-11-s05",
      "speaker": "Imogen",
      "text": "I'd rather stay and learn what everything is for."
    },
    {
      "id": "p11-a-11-s06",
      "speaker": "Kit",
      "text": "All right. We'll start with the equipment checklist, and I'll contact you about a new sailing date."
    }
  ],
