{
  "id": "p11-a-13",
  "title_zh": "商定攀岩颁奖介绍中的团队致谢",
  "topic_id": "leisure",
  "scenario": {
    "id": "climbing-award-team-credit",
    "label_zh": "商定攀岩颁奖介绍中的团队致谢",
    "goal_zh": "肯定攀岩成就与谦逊表现，并商定在介绍中具体提及队友贡献"
  },
  "participants": [
    "Nico",
    "Beth"
  ],
  "context_zh": "攀岩俱乐部成员为队友写简短颁奖介绍，讨论已经发生的比赛表现。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-13-s01",
      "speaker": "Nico",
      "text": "Finishing that route was an extraordinary feat. I want the introduction to capture that."
    },
    {
      "id": "p11-a-13-s02",
      "speaker": "Beth",
      "text": "Then mention the team too. Ava never tries to claim all the glory."
    },
    {
      "id": "p11-a-13-s03",
      "speaker": "Nico",
      "text": "She was very humble afterward. She spent most of the interview thanking her belayer."
    },
    {
      "id": "p11-a-13-s04",
      "speaker": "Beth",
      "text": "And she accepted the scoring correction with grace, even though it cost her a place."
    },
    {
      "id": "p11-a-13-s05",
      "speaker": "Nico",
      "text": "I'll keep the line about the climb and add a thank-you to the people who trained with her."
    },
    {
      "id": "p11-a-13-s06",
      "speaker": "Beth",
      "text": "Yes, and name her belayer, Sol. That will make the credit specific."
    }
  ],
