{
  "id": "p11-a-18",
  "title_zh": "为电影人访谈选定配图",
  "topic_id": "leisure",
  "scenario": {
    "id": "filmmaker-interview-photo-choice",
    "label_zh": "为电影人访谈选定配图",
    "goal_zh": "比较两张访谈照片的人物视线，核实窗边照片的脸部清晰度，并选定窗边照片"
  },
  "participants": [
    "Cameron",
    "Rina"
  ],
  "context_zh": "杂志编辑和摄影师查看电影人访谈的两张照片，访谈尚未刊出。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-18-s01",
      "speaker": "Cameron",
      "text": "Could you have a quick glance at the photos for the forthcoming interview?"
    },
    {
      "id": "p11-a-18-s02",
      "speaker": "Rina",
      "text": "The filmmaker is looking down in the first one. In the second, her gaze is directed toward the window."
    },
    {
      "id": "p11-a-18-s03",
      "speaker": "Cameron",
      "text": "I prefer the second expression, but is the face sharp enough for print?"
    },
    {
      "id": "p11-a-18-s04",
      "speaker": "Rina",
      "text": "Yes. I checked the full-size file. The window is blurred, not her face."
    },
    {
      "id": "p11-a-18-s05",
      "speaker": "Cameron",
      "text": "Then let's use the window portrait. It feels thoughtful without making her look distracted."
    },
    {
      "id": "p11-a-18-s06",
      "speaker": "Rina",
      "text": "Agreed. I'll prepare that file for the layout."
    }
  ],
