{
  "id": "p11-a-19",
  "title_zh": "约定收集扫描仪错误记录后检修",
  "topic_id": "services",
  "scenario": {
    "id": "scanner-fault-service-plan",
    "label_zh": "约定收集扫描仪错误记录后检修",
    "goal_zh": "说明扫描仪预览正常但无法保存的故障，并约定发送筛选后的日志供检修"
  },
  "participants": [
    "Ellis",
    "Farah"
  ],
  "context_zh": "办公室员工与设备服务人员通过电话排查扫描仪问题；尚未确定硬件或软件原因。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-19-s01",
      "speaker": "Ellis",
      "text": "The scanner's inability to save files is holding up our work. The preview still looks normal."
    },
    {
      "id": "p11-a-19-s02",
      "speaker": "Farah",
      "text": "So the preview is functional, but saving fails. Is any warning indicator showing?"
    },
    {
      "id": "p11-a-19-s03",
      "speaker": "Ellis",
      "text": "A red light flashes when I press Save. Is that a hardware fault?"
    },
    {
      "id": "p11-a-19-s04",
      "speaker": "Farah",
      "text": "I can't tell yet. Can you filter the error log by the scanner's device name and send me those entries?"
    },
    {
      "id": "p11-a-19-s05",
      "speaker": "Ellis",
      "text": "Yes. I can send the relevant entries without including the scanned documents."
    },
    {
      "id": "p11-a-19-s06",
      "speaker": "Farah",
      "text": "Thank you. I'll review them and arrange an inspection; please leave the scanner out of use until then."
    }
  ],
