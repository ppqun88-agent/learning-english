{
  "id": "p11-a-28",
  "title_zh": "商定葬礼后的安静聚会与自愿扫墓",
  "topic_id": "relationships",
  "scenario": {
    "id": "family-memorial-quiet-plan",
    "label_zh": "商定葬礼后的安静聚会与自愿扫墓",
    "goal_zh": "了解家人对葬礼后安排的需要，并约定安静聚会且不强求一起扫墓"
  },
  "participants": [
    "Alice",
    "Dan"
  ],
  "context_zh": "两位成年亲属为已去世的姨妈 Nora 商量葬礼当天的家庭安排。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-28-s01",
      "speaker": "Alice",
      "text": "After Aunt Nora’s funeral, would you like a large gathering at the house?"
    },
    {
      "id": "p11-a-28-s02",
      "speaker": "Dan",
      "text": "I would rather keep it quiet. Grief makes conversation exhausting for me at the moment."
    },
    {
      "id": "p11-a-28-s03",
      "speaker": "Alice",
      "text": "Then just the close family, with tea and somewhere you can sit alone if you want."
    },
    {
      "id": "p11-a-28-s04",
      "speaker": "Dan",
      "text": "Thank you. Are people going to visit her grave afterward?"
    },
    {
      "id": "p11-a-28-s05",
      "speaker": "Alice",
      "text": "Some want to, but nobody has to go. We can make that a separate choice."
    },
    {
      "id": "p11-a-28-s06",
      "speaker": "Dan",
      "text": "That helps. A quiet cup of tea with the family sounds right for me."
    }
  ],
