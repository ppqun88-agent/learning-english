{
  "id": "p11-a-34",
  "title_zh": "商定观日出后的出租车返程",
  "topic_id": "travel",
  "scenario": {
    "id": "sunrise-return-taxi-plan",
    "label_zh": "商定观日出后的出租车返程",
    "goal_zh": "确认观景结束后的交通需要，并决定步行到出租车站等车"
  },
  "participants": [
    "Paula",
    "Jin"
  ],
  "context_zh": "两位朋友在城市海滨看完日出，讨论如何返回住处；没有预订车辆。",
  "author": "author-phase11-a",
  "sentences": [
    {
      "id": "p11-a-34-s01",
      "speaker": "Paula",
      "text": "That was a glorious sunrise. The whole horizon turned pink."
    },
    {
      "id": "p11-a-34-s02",
      "speaker": "Jin",
      "text": "Worth getting up early for. My feet are cold now, though. Shall we head back?"
    },
    {
      "id": "p11-a-34-s03",
      "speaker": "Paula",
      "text": "Can we hail a taxi from this path?"
    },
    {
      "id": "p11-a-34-s04",
      "speaker": "Jin",
      "text": "I would rather use the taxi stand by the road. Cars cannot stop here."
    },
    {
      "id": "p11-a-34-s05",
      "speaker": "Paula",
      "text": "I hear a horn. Is that a taxi calling us?"
    },
    {
      "id": "p11-a-34-s06",
      "speaker": "Jin",
      "text": "I can't tell. We have not booked one, so let's not assume it is for us."
    },
    {
      "id": "p11-a-34-s07",
      "speaker": "Paula",
      "text": "Right. We will walk to the stand and wait there."
    }
  ],
