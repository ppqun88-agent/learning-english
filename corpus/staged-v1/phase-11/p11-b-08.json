{
  "id": "p11-b-08",
  "title_zh": "约定先核对图书修补活动审批，暂不公布日期",
  "topic_id": "community",
  "scenario": {
    "id": "library-project-contact-before-launch",
    "label_zh": "约定先核对图书修补活动审批，暂不公布日期",
    "goal_zh": "确认现有资料不足以公布图书修补活动开始日期，并分工询问审批与收集志愿者可用时段"
  },
  "participants": [
    "Ruth",
    "Ben"
  ],
  "context_zh": "两名图书馆志愿者想组织周末维修书籍活动，但尚未获准使用房间。",
  "author": "author-phase11-b",
  "sentences": [
    {
      "id": "p11-b-08-s01",
      "speaker": "Ruth",
      "text": "Can we initiate the approval process for the book-repair sessions this week?"
    },
    {
      "id": "p11-b-08-s02",
      "speaker": "Ben",
      "text": "Yes, but the library has an interim manager. We should find out who can authorize room use."
    },
    {
      "id": "p11-b-08-s03",
      "speaker": "Ruth",
      "text": "I'll inquire at the office tomorrow. Could we advertise a start date now?"
    },
    {
      "id": "p11-b-08-s04",
      "speaker": "Ben",
      "text": "We have insufficient information for that. We don't even know whether the room is available on Saturdays."
    },
    {
      "id": "p11-b-08-s05",
      "speaker": "Ruth",
      "text": "Fair point. In the meantime, could you collect the volunteers' available times?"
    },
    {
      "id": "p11-b-08-s06",
      "speaker": "Ben",
      "text": "Certainly. I'll collect those without promising a date."
    },
    {
      "id": "p11-b-08-s07",
      "speaker": "Ruth",
      "text": "Good. I'll ask about the approval steps and room availability, then we'll compare what we've learned."
    }
  ],
