{
  "id": "p11-b-18",
  "title_zh": "虚构委员会先补书面依据再表决例外",
  "topic_id": "society",
  "scenario": {
    "id": "fictional-committee-exception-record",
    "label_zh": "虚构委员会先补书面依据再表决例外",
    "goal_zh": "区分合理担忧与启用紧急条款的依据，并约定补齐资料后再表决"
  },
  "participants": [
    "Aisha",
    "Tom"
  ],
  "context_zh": "学生扮演虚构社区委员会成员，按课堂角色卡讨论场地分配规则；不描述真实法律或机构。",
  "author": "author-phase11-b",
  "sentences": [
    {
      "id": "p11-b-18-s01",
      "speaker": "Aisha",
      "text": "Our role card gives the committee a mandate to allocate rooms, not to rewrite the building rules."
    },
    {
      "id": "p11-b-18-s02",
      "speaker": "Tom",
      "text": "Could we invoke the emergency clause to give the youth group the hall tonight?"
    },
    {
      "id": "p11-b-18-s03",
      "speaker": "Aisha",
      "text": "What is the emergency?"
    },
    {
      "id": "p11-b-18-s04",
      "speaker": "Tom",
      "text": "Their usual room may be unavailable. That's a legitimate concern, but we haven't heard from the building manager."
    },
    {
      "id": "p11-b-18-s05",
      "speaker": "Aisha",
      "text": "Then we don't yet have a justification for an exception. We need the room status and the reason it can't be used."
    },
    {
      "id": "p11-b-18-s06",
      "speaker": "Tom",
      "text": "Agreed. Let's request that in writing before the vote."
    },
    {
      "id": "p11-b-18-s07",
      "speaker": "Aisha",
      "text": "Yes. We'll keep the exception pending until that information is available."
    }
  ],
