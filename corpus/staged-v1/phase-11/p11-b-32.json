{
  "id": "p11-b-32",
  "title_zh": "将虚构法案流程图标为等待表决",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-legislature-bill-stage-chart",
    "label_zh": "将虚构法案流程图标为等待表决",
    "goal_zh": "区分议员提案、委员会审议与立法机构通过法律，并修正流程图上的通过状态"
  },
  "participants": [
    "Sana",
    "Peter"
  ],
  "context_zh": "学生依据架空城邦的课堂案例制作立法流程图，流程仅用于虚构沟通练习。",
  "author": "author-phase11-b",
  "sentences": [
    {
      "id": "p11-b-32-s01",
      "speaker": "Sana",
      "text": "Our chart says the new park law is in force. Where did that come from?"
    },
    {
      "id": "p11-b-32-s02",
      "speaker": "Peter",
      "text": "The lawmaker presented the bill to the legislative committee, and the committee discussed it."
    },
    {
      "id": "p11-b-32-s03",
      "speaker": "Sana",
      "text": "But the case card says the legislature hasn't voted yet."
    },
    {
      "id": "p11-b-32-s04",
      "speaker": "Peter",
      "text": "You're right. The bill would replace the existing legislation on park access, but it hasn't done that yet."
    },
    {
      "id": "p11-b-32-s05",
      "speaker": "Sana",
      "text": "Then move the marker back to 'Awaiting a vote'. The discussion and the final decision are different stages."
    },
    {
      "id": "p11-b-32-s06",
      "speaker": "Peter",
      "text": "Done. I've moved it back and changed 'new law' to 'proposed bill'."
    },
    {
      "id": "p11-b-32-s07",
      "speaker": "Sana",
      "text": "That now matches the card."
    }
  ],
