{
  "id": "p11-c-02",
  "title_zh": "约好核实公司合并后的人员安排",
  "topic_id": "work",
  "scenario": {
    "id": "company-merger-staff-memo",
    "label_zh": "约好核实公司合并后的人员安排",
    "goal_zh": "区分已公布的公司合并与尚未确认的人员变化，并约定向人事团队询问"
  },
  "participants": [
    "Priya",
    "Evan"
  ],
  "context_zh": "虚构公司的两位同事阅读内部合并备忘录；并非真实企业消息。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-02-s01",
      "speaker": "Priya",
      "text": "Have you read the memo about the merger? It says the two companies will merge in January."
    },
    {
      "id": "p11-c-02-s02",
      "speaker": "Evan",
      "text": "Yes, but it doesn’t say whether our office will move. My predecessor left a folder about an earlier move, but that may not apply."
    },
    {
      "id": "p11-c-02-s03",
      "speaker": "Priya",
      "text": "Does the memo mention changes to personnel? People are asking whether their jobs will stay the same."
    },
    {
      "id": "p11-c-02-s04",
      "speaker": "Evan",
      "text": "It says those details haven’t been decided. We shouldn’t fill the gaps with guesses."
    },
    {
      "id": "p11-c-02-s05",
      "speaker": "Priya",
      "text": "I’ll ask the HR team when they expect to explain the staffing plans and the office location."
    },
    {
      "id": "p11-c-02-s06",
      "speaker": "Evan",
      "text": "Thanks. Let’s wait for that reply before we update our team."
    }
  ],
