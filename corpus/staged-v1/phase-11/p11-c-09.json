{
  "id": "p11-c-09",
  "title_zh": "约定分开记录部分答卷与完整答卷",
  "topic_id": "reasoning",
  "scenario": {
    "id": "survey-partial-response-method",
    "label_zh": "约定分开记录部分答卷与完整答卷",
    "goal_zh": "说明未完成答卷的统计边界，并约定在方法说明中写明纳入条件"
  },
  "participants": [
    "Iris",
    "Malik"
  ],
  "context_zh": "研究方法课的两位学员讨论虚构问卷练习的数据处理。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-09-s01",
      "speaker": "Iris",
      "text": "Twenty people only partially completed the survey. Should we discard those responses?"
    },
    {
      "id": "p11-c-09-s02",
      "speaker": "Malik",
      "text": "Not automatically. A partial response may still answer our first question, but it can’t tell us about the unanswered items."
    },
    {
      "id": "p11-c-09-s03",
      "speaker": "Iris",
      "text": "Then we shouldn’t overlook the different number of answers to each question."
    },
    {
      "id": "p11-c-09-s04",
      "speaker": "Malik",
      "text": "Right. One parameter of our analysis is whether the question was actually answered. We’ll report the count for every item."
    },
    {
      "id": "p11-c-09-s05",
      "speaker": "Iris",
      "text": "I’ll describe that rule in the methodology section and keep partial and complete responses separate in the summary."
    },
    {
      "id": "p11-c-09-s06",
      "speaker": "Malik",
      "text": "Good. That will make it clear which results use which answers."
    }
  ],
