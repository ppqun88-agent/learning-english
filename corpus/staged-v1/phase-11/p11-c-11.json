{
  "id": "p11-c-11",
  "title_zh": "选定不靠近鸟巢的池塘观察点",
  "topic_id": "nature",
  "scenario": {
    "id": "pond-migration-observation-boundary",
    "label_zh": "选定不靠近鸟巢的池塘观察点",
    "goal_zh": "确认观察范围，并约定从远处记录鸟类而不把未见雏鸟解释为捕食结果"
  },
  "participants": [
    "Sylvia",
    "Owen"
  ],
  "context_zh": "自然观察小组的成人新成员向带队志愿者询问池塘观察位置。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-11-s01",
      "speaker": "Sylvia",
      "text": "Is this pond a good place to watch the spring migration?"
    },
    {
      "id": "p11-c-11-s02",
      "speaker": "Owen",
      "text": "Yes, from the viewing screen. There’s also a nest in the reeds, so we stay on this side of the rope."
    },
    {
      "id": "p11-c-11-s03",
      "speaker": "Sylvia",
      "text": "I can see one adult bird, but none of its offspring. Could a predator have taken them?"
    },
    {
      "id": "p11-c-11-s04",
      "speaker": "Owen",
      "text": "We can’t tell from here. They may simply be out of sight; let’s record what we actually see."
    },
    {
      "id": "p11-c-11-s05",
      "speaker": "Sylvia",
      "text": "All right. I’ll note one adult by the reeds, not an empty nest."
    },
    {
      "id": "p11-c-11-s06",
      "speaker": "Owen",
      "text": "Good. We’ll use the screen and leave the birds undisturbed."
    }
  ],
