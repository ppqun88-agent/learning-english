{
  "id": "p11-c-17",
  "title_zh": "约定修正咖啡馆介绍中的免排队宣传",
  "topic_id": "work",
  "scenario": {
    "id": "cafe-guide-queue-claim-correction",
    "label_zh": "约定修正咖啡馆介绍中的免排队宣传",
    "goal_zh": "核对咖啡馆改善与高峰排队的区别，并约定删去绝不等待的表述"
  },
  "participants": [
    "Sana",
    "Drew"
  ],
  "context_zh": "社区生活指南的编辑与撰稿人讨论一间虚构咖啡馆的介绍稿。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-17-s01",
      "speaker": "Sana",
      "text": "Your piece says there’s never a wait, but this café is notorious for its Saturday queues."
    },
    {
      "id": "p11-c-17-s02",
      "speaker": "Drew",
      "text": "There have been some notable improvements, notably a second till and more seats."
    },
    {
      "id": "p11-c-17-s03",
      "speaker": "Sana",
      "text": "Those are useful changes. Do they mean nobody queues anymore?"
    },
    {
      "id": "p11-c-17-s04",
      "speaker": "Drew",
      "text": "No. I was there on Saturday and waited fifteen minutes. The sentence is misleading."
    },
    {
      "id": "p11-c-17-s05",
      "speaker": "Sana",
      "text": "Let’s keep the details about the extra till and seats, but take out the guarantee."
    },
    {
      "id": "p11-c-17-s06",
      "speaker": "Drew",
      "text": "Agreed. I’ll say the changes may help, while busy periods can still mean a wait."
    }
  ],
