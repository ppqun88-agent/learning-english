{
  "id": "p11-c-21",
  "title_zh": "约定分步准备课程口头展示",
  "topic_id": "learning",
  "scenario": {
    "id": "course-orientation-speaking-plan",
    "label_zh": "约定分步准备课程口头展示",
    "goal_zh": "澄清课程展示的参与要求，并约定先练习简短开场而不是一次准备全部内容"
  },
  "participants": [
    "Willa",
    "Dr Mason"
  ],
  "context_zh": "一位成人学员在课程迎新后向授课教师询问展示任务。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-21-s01",
      "speaker": "Willa",
      "text": "After orientation, I looked at the first module again. The final oral presentation seems overwhelming."
    },
    {
      "id": "p11-c-21-s02",
      "speaker": "Dr Mason",
      "text": "Which part worries you most: choosing a topic or speaking in front of the group?"
    },
    {
      "id": "p11-c-21-s03",
      "speaker": "Willa",
      "text": "Speaking. Could I be a passive observer for that session instead?"
    },
    {
      "id": "p11-c-21-s04",
      "speaker": "Dr Mason",
      "text": "You’ll need to present something, but it doesn’t have to be polished. We don’t want to overwhelm you with the whole task at once."
    },
    {
      "id": "p11-c-21-s05",
      "speaker": "Willa",
      "text": "Could I start by practicing a thirty-second introduction with a partner?"
    },
    {
      "id": "p11-c-21-s06",
      "speaker": "Dr Mason",
      "text": "Yes. Bring just that introduction to Thursday’s class. We can build the rest after you’ve tried it."
    },
    {
      "id": "p11-c-21-s07",
      "speaker": "Willa",
      "text": "That sounds manageable. I’ll prepare the opening, not the entire talk."
    }
  ],
