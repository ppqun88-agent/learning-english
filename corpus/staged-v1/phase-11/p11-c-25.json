{
  "id": "p11-c-25",
  "title_zh": "分工通知客户与培训人员改期",
  "topic_id": "work",
  "scenario": {
    "id": "team-launch-notification-split",
    "label_zh": "分工通知客户与培训人员改期",
    "goal_zh": "确认双方都希望避免无谓到场，并约定在中午前分别通知两类受影响人员"
  },
  "participants": [
    "Rowan",
    "Imani"
  ],
  "context_zh": "两个项目同事为一次已改到周五的产品培训协调通知工作。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-25-s01",
      "speaker": "Rowan",
      "text": "Our mutual aim is to stop people arriving for a session that isn’t happening tomorrow."
    },
    {
      "id": "p11-c-25-s02",
      "speaker": "Imani",
      "text": "Right. The new date is Friday, but two groups still need to know, namely the customers and the trainers."
    },
    {
      "id": "p11-c-25-s03",
      "speaker": "Rowan",
      "text": "I can notify the customers. Can you contact the trainers?"
    },
    {
      "id": "p11-c-25-s04",
      "speaker": "Imani",
      "text": "Yes. I’ll explain the change and ask each trainer to confirm they’ve seen it."
    },
    {
      "id": "p11-c-25-s05",
      "speaker": "Rowan",
      "text": "Let’s get both sets of messages out by noon, then compare who has replied."
    },
    {
      "id": "p11-c-25-s06",
      "speaker": "Imani",
      "text": "Agreed. I’ll send you my reply list after lunch."
    }
  ],
