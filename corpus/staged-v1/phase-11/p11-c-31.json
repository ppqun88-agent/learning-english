{
  "id": "p11-c-31",
  "title_zh": "决定推迟未成年人俱乐部的户外出游",
  "topic_id": "leisure",
  "scenario": {
    "id": "youth-outing-consent-weather",
    "label_zh": "决定推迟未成年人俱乐部的户外出游",
    "goal_zh": "确认仍缺家长同意且天气存在不确定性，并决定推迟出游、另行征求新日期"
  },
  "participants": [
    "Gemma",
    "Louis"
  ],
  "context_zh": "虚构青少年俱乐部的两位成人组织者讨论一次未满十八岁成员的出游，不涉及真实天气预报。",
  "author": "author-phase11-c",
  "sentences": [
    {
      "id": "p11-c-31-s01",
      "speaker": "Gemma",
      "text": "We’re still missing parental consent for three of the under-eighteen members on tomorrow’s outdoor outing."
    },
    {
      "id": "p11-c-31-s02",
      "speaker": "Louis",
      "text": "And the forecast in our planning sheet gives high odds of heavy rain. Could we switch to an indoor visit?"
    },
    {
      "id": "p11-c-31-s03",
      "speaker": "Gemma",
      "text": "That would be a different activity from the one the families were asked to approve."
    },
    {
      "id": "p11-c-31-s04",
      "speaker": "Louis",
      "text": "Then I’d opt to postpone rather than rush a new plan through tonight."
    },
    {
      "id": "p11-c-31-s05",
      "speaker": "Gemma",
      "text": "I agree. Let’s tell everyone tomorrow’s trip is off and ask which dates would work instead."
    },
    {
      "id": "p11-c-31-s06",
      "speaker": "Louis",
      "text": "Yes. Once we choose a new date, we’ll send the full plan and request consent again."
    }
  ],
