{
  "id": "p12-a-03",
  "title_zh": "限定初步问卷报告的结论",
  "topic_id": "reasoning",
  "scenario": {
    "id": "preliminary-survey-prevention-claim-scope",
    "label_zh": "限定初步健康问卷的样本与预防结论",
    "goal_zh": "核对问卷样本范围并约定删除未测量的预防效果结论"
  },
  "participants": [
    "Amir",
    "Tess"
  ],
  "context_zh": "两名学生讨论虚构健康调查练习的数据；不是现实医学研究或健康建议。",
  "author": "author-phase12-a",
  "sentences": [
    {
      "id": "p12-a-03-s01",
      "speaker": "Amir",
      "text": "These preliminary results show that most respondents reported poor sleep."
    },
    {
      "id": "p12-a-03-s02",
      "speaker": "Tess",
      "text": "But the respondents were predominantly staff on the night shift. We can't describe everyone at the company."
    },
    {
      "id": "p12-a-03-s03",
      "speaker": "Amir",
      "text": "Then I'll report the prevalence of poor sleep in this sample, not in the whole workforce."
    },
    {
      "id": "p12-a-03-s04",
      "speaker": "Tess",
      "text": "What about your sentence saying the new timetable helps with prevention?"
    },
    {
      "id": "p12-a-03-s05",
      "speaker": "Amir",
      "text": "We didn't measure that. I'll remove it and describe who answered the survey."
    },
    {
      "id": "p12-a-03-s06",
      "speaker": "Tess",
      "text": "Good. Let's keep the sample description beside the results."
    }
  ],
