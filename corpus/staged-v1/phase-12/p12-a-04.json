{
  "id": "p12-a-04",
  "title_zh": "为虚构省长采访拟定预算问题",
  "topic_id": "society",
  "scenario": {
    "id": "fictional-provincial-interview-budget-question",
    "label_zh": "为虚构省政府采访拟定具体预算问题",
    "goal_zh": "区分省级预算承诺与结果证据并拟定具体采访问题"
  },
  "participants": [
    "Mara",
    "Joel"
  ],
  "context_zh": "新闻写作课堂中的虚构省政府材料。Mara 与 Joel 准备模拟采访，所述人物、地区与政策均非当前新闻。",
  "author": "author-phase12-a",
  "sentences": [
    {
      "id": "p12-a-04-s01",
      "speaker": "Mara",
      "text": "The premier promises greater prosperity in this speech. Is that enough for our opening question?"
    },
    {
      "id": "p12-a-04-s02",
      "speaker": "Joel",
      "text": "It's too broad. What does the provincial budget actually fund?"
    },
    {
      "id": "p12-a-04-s03",
      "speaker": "Mara",
      "text": "The exercise says the province will pay for three bus routes, but it gives no results yet."
    },
    {
      "id": "p12-a-04-s04",
      "speaker": "Joel",
      "text": "Then ask which communities those routes serve and how success will be measured."
    },
    {
      "id": "p12-a-04-s05",
      "speaker": "Mara",
      "text": "So: 'Which communities will get the routes, and what would count as success?'"
    },
    {
      "id": "p12-a-04-s06",
      "speaker": "Joel",
      "text": "Yes. That tests the promise without treating it as an achieved result."
    }
  ],
