{
  "id": "p12-a-06",
  "title_zh": "区分虚构海报的宣传与事实",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-poster-rhetoric-evidence-label",
    "label_zh": "分析虚构历史海报的宣传修辞与证据边界",
    "goal_zh": "指出海报的宣传承诺并约定在说明牌上保留归属而不把承诺写成事实"
  },
  "participants": [
    "Imani",
    "Hugo"
  ],
  "context_zh": "历史课堂使用自编的虚构政治海报。Imani 与 Hugo 编写材料说明，不评价现实政治人物。",
  "author": "author-phase12-a",
  "sentences": [
    {
      "id": "p12-a-06-s01",
      "speaker": "Imani",
      "text": "This poster seems to proclaim the start of a perfect society."
    },
    {
      "id": "p12-a-06-s02",
      "speaker": "Hugo",
      "text": "That's revolutionary rhetoric, not a description of what actually happened."
    },
    {
      "id": "p12-a-06-s03",
      "speaker": "Imani",
      "text": "Should our label call it propaganda?"
    },
    {
      "id": "p12-a-06-s04",
      "speaker": "Hugo",
      "text": "Yes, if we explain its purpose: it tries to win support for the fictional movement."
    },
    {
      "id": "p12-a-06-s05",
      "speaker": "Imani",
      "text": "I'll write that the poster promises a perfect society, rather than saying the movement created one."
    },
    {
      "id": "p12-a-06-s06",
      "speaker": "Hugo",
      "text": "That keeps the claim attached to the poster. Use that version."
    }
  ],
