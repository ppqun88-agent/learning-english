{
  "id": "p12-a-18",
  "title_zh": "核对义卖收入的分配比例",
  "topic_id": "community",
  "scenario": {
    "id": "fundraiser-proceeds-allocation-ratio",
    "label_zh": "核对筹款收入分配比例并安排转交",
    "goal_zh": "算清两家受助机构的分配金额并约定核对账户后转交"
  },
  "participants": [
    "Paolo",
    "Mei"
  ],
  "context_zh": "社区义卖志愿者 Paolo 与 Mei 核对自编练习中的一千元净收入，不涉及真实捐款或账户信息。",
  "author": "author-phase12-a",
  "sentences": [
    {
      "id": "p12-a-18-s01",
      "speaker": "Paolo",
      "text": "The net proceeds from the book sale are one thousand dollars."
    },
    {
      "id": "p12-a-18-s02",
      "speaker": "Mei",
      "text": "We agreed on a ratio of three to one between the shelter and the library fund, didn't we?"
    },
    {
      "id": "p12-a-18-s03",
      "speaker": "Paolo",
      "text": "Yes. The shelter is the main recipient, so it gets seven hundred and fifty."
    },
    {
      "id": "p12-a-18-s04",
      "speaker": "Mei",
      "text": "And the remainder is two hundred and fifty for the library fund."
    },
    {
      "id": "p12-a-18-s05",
      "speaker": "Paolo",
      "text": "I'll confirm both organisations' payment details before arranging the transfers."
    },
    {
      "id": "p12-a-18-s06",
      "speaker": "Mei",
      "text": "Good. I'll add those two amounts to our summary, marked as not yet transferred."
    }
  ],
