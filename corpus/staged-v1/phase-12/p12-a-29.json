{
  "id": "p12-a-29",
  "title_zh": "区分虚构历史材料中的政体变化",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-history-rebellion-timeline",
    "label_zh": "区分虚构历史材料中的统治与政体变化",
    "goal_zh": "排清女王统治结束与共和国建立的先后并约定补入过渡阶段"
  },
  "participants": [
    "Kira",
    "Nathan"
  ],
  "context_zh": "历史写作课堂使用完全虚构的王国年表。Kira 与 Nathan 按三张给定事件卡整理时间线。",
  "author": "author-phase12-a",
  "sentences": [
    {
      "id": "p12-a-29-s01",
      "speaker": "Kira",
      "text": "This card says the rebellion ended the queen's reign. Does the republic start at the same point?"
    },
    {
      "id": "p12-a-29-s02",
      "speaker": "Nathan",
      "text": "Not according to the next card. A temporary regime took power first."
    },
    {
      "id": "p12-a-29-s03",
      "speaker": "Kira",
      "text": "And the third card places the declaration of the republic a year later."
    },
    {
      "id": "p12-a-29-s04",
      "speaker": "Nathan",
      "text": "Then our timeline skips an important stage."
    },
    {
      "id": "p12-a-29-s05",
      "speaker": "Kira",
      "text": "I'll add the temporary government between the two events."
    },
    {
      "id": "p12-a-29-s06",
      "speaker": "Nathan",
      "text": "Yes. We can show the sequence without implying that the change happened overnight."
    }
  ],
