{
  "id": "p12-b-06",
  "title_zh": "支持志愿团队并保留休息时间",
  "topic_id": "relationships",
  "scenario": {
    "id": "volunteer-shift-support-with-boundaries",
    "label_zh": "志愿轮班中的支持与边界",
    "goal_zh": "表达支持并约定保留周六休息而只参加周日活动"
  },
  "participants": [
    "Sam",
    "Jo"
  ],
  "context_zh": "成年人 Sam 与 Jo 在讨论周末为家具捐赠站搬运小件物品的志愿安排。",
  "author": "author-phase12-b",
  "sentences": [
    {
      "id": "p12-b-06-s01",
      "speaker": "Sam",
      "text": "I want to join both shifts as a show of solidarity, but I’ve had almost no time off this month."
    },
    {
      "id": "p12-b-06-s02",
      "speaker": "Jo",
      "text": "For your own sake, keep Saturday free. Coming on Sunday would still help."
    },
    {
      "id": "p12-b-06-s03",
      "speaker": "Sam",
      "text": "I thought you might see that as letting the team down."
    },
    {
      "id": "p12-b-06-s04",
      "speaker": "Jo",
      "text": "Not at all. Being supportive doesn’t mean making a sacrifice every weekend."
    },
    {
      "id": "p12-b-06-s05",
      "speaker": "Sam",
      "text": "Then I’ll volunteer on Sunday and leave Saturday for rest."
    },
    {
      "id": "p12-b-06-s06",
      "speaker": "Jo",
      "text": "That works. I’ll put you down for Sunday, not both days."
    }
  ],
