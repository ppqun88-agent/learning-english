{
  "id": "p12-b-07",
  "title_zh": "不只展示符合趋势的数据点",
  "topic_id": "reasoning",
  "scenario": {
    "id": "scattered-data-display-selection",
    "label_zh": "零散数据展示的选择偏差核对",
    "goal_zh": "检查零散结果的展示范围并约定补回被省略的数据"
  },
  "participants": [
    "Imani",
    "Felix"
  ],
  "context_zh": "研究课程同伴 Imani 与 Felix 检查一张虚构实验数据图。",
  "author": "author-phase12-b",
  "sentences": [
    {
      "id": "p12-b-07-s01",
      "speaker": "Imani",
      "text": "Why have you left these scattered results off the graph?"
    },
    {
      "id": "p12-b-07-s02",
      "speaker": "Felix",
      "text": "Those seemingly random points made the main trend harder to see. I wanted a clearer graph."
    },
    {
      "id": "p12-b-07-s03",
      "speaker": "Imani",
      "text": "But that is selective reporting. Those points came from the same experiment."
    },
    {
      "id": "p12-b-07-s04",
      "speaker": "Felix",
      "text": "I see why you’re sceptical of the neat curve now."
    },
    {
      "id": "p12-b-07-s05",
      "speaker": "Imani",
      "text": "Could we show all the points and explain why some differ?"
    },
    {
      "id": "p12-b-07-s06",
      "speaker": "Felix",
      "text": "Yes. I’ll restore them and remove the claim that every measurement follows the curve."
    }
  ],
