{
  "id": "p12-b-14",
  "title_zh": "核对双屏客服培训演示",
  "topic_id": "learning",
  "scenario": {
    "id": "training-demo-two-screen-simulation",
    "label_zh": "双屏模拟演示的设备与分工",
    "goal_zh": "核对演示规格并约定先用虚构对话测试双屏显示"
  },
  "participants": [
    "Ben",
    "Zoe"
  ],
  "context_zh": "培训设计师 Ben 与技术同事 Zoe 在虚构客服培训项目中准备离线演示，不涉及真实客户资料。",
  "author": "author-phase12-b",
  "sentences": [
    {
      "id": "p12-b-14-s01",
      "speaker": "Ben",
      "text": "Can this setup show two conversations simultaneously? I want trainees to compare the replies."
    },
    {
      "id": "p12-b-14-s02",
      "speaker": "Zoe",
      "text": "Yes, on these two demonstration screens. We can use prepared text instead of live customer messages."
    },
    {
      "id": "p12-b-14-s03",
      "speaker": "Ben",
      "text": "Can we simulate a delayed reply on the left while the right conversation continues?"
    },
    {
      "id": "p12-b-14-s04",
      "speaker": "Zoe",
      "text": "We can. I’ll advance the left sequence more slowly during the simulation."
    },
    {
      "id": "p12-b-14-s05",
      "speaker": "Ben",
      "text": "Do we need any specialized hardware?"
    },
    {
      "id": "p12-b-14-s06",
      "speaker": "Zoe",
      "text": "No. The equipment specification asks for two ordinary screens and a computer, all of which are here."
    },
    {
      "id": "p12-b-14-s07",
      "speaker": "Ben",
      "text": "Then let’s test both sequences with the fictional messages before the session."
    },
    {
      "id": "p12-b-14-s08",
      "speaker": "Zoe",
      "text": "Agreed. I’ll take the left sequence, and you can watch the right."
    }
  ],
