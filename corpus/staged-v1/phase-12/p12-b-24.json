{
  "id": "p12-b-24",
  "title_zh": "为虚构和解文件准备咨询问题",
  "topic_id": "learning",
  "scenario": {
    "id": "fictional-settlement-review-questions",
    "label_zh": "虚构和解草案的咨询问题整理",
    "goal_zh": "指出单段文字不足以判断全部要求并约定向律师询问完整条款"
  },
  "participants": [
    "Ruth",
    "Max"
  ],
  "context_zh": "完全虚构的法律英语角色练习：Ruth 与 Max 准备一位模拟客户给律师的问题，不提供现实法律建议。",
  "author": "author-phase12-b",
  "sentences": [
    {
      "id": "p12-b-24-s01",
      "speaker": "Ruth",
      "text": "Our fictional client wants to sue the supplier, but there’s a settlement draft in the exercise pack."
    },
    {
      "id": "p12-b-24-s02",
      "speaker": "Max",
      "text": "Are we supposed to tell the client to sign it?"
    },
    {
      "id": "p12-b-24-s03",
      "speaker": "Ruth",
      "text": "No. We’re preparing questions for the solicitor. This paragraph mentions payment, but the rest of the terms are missing."
    },
    {
      "id": "p12-b-24-s04",
      "speaker": "Max",
      "text": "So we shouldn’t judge the whole offer solely on that paragraph."
    },
    {
      "id": "p12-b-24-s05",
      "speaker": "Ruth",
      "text": "Exactly. Let’s ask what obligations the complete draft would place on each party."
    },
    {
      "id": "p12-b-24-s06",
      "speaker": "Max",
      "text": "I’ll add that question and a request for the full document."
    }
  ],
