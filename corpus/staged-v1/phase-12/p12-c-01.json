{
  "id": "p12-c-01",
  "title_zh": "排练持道具剑退场",
  "topic_id": "leisure",
  "scenario": {
    "id": "prop-sword-exit-rehearsal",
    "label_zh": "排练持道具剑退场",
    "goal_zh": "明确战士角色的退场动作并约定降低道具剑后走到门口"
  },
  "participants": [
    "Leon",
    "Ada"
  ],
  "context_zh": "业余剧团排练虚构历史剧。Leon 饰演战士，Ada 负责导演；手中是舞台道具剑。",
  "author": "author-phase12-c",
  "sentences": [
    {
      "id": "p12-c-01-s01",
      "speaker": "Leon",
      "text": "Should the warrior leave in anger, or is he trying to hide it?"
    },
    {
      "id": "p12-c-01-s02",
      "speaker": "Ada",
      "text": "Hide it until you reach the door. That will be more theatrical than shouting all the way across the stage."
    },
    {
      "id": "p12-c-01-s03",
      "speaker": "Leon",
      "text": "I was going to swing the sword as I turned."
    },
    {
      "id": "p12-c-01-s04",
      "speaker": "Ada",
      "text": "Please don't. Keep the prop low, walk to the door, and then look back."
    },
    {
      "id": "p12-c-01-s05",
      "speaker": "Leon",
      "text": "All right. The look can carry the anger; I don't need the big movement."
    },
    {
      "id": "p12-c-01-s06",
      "speaker": "Ada",
      "text": "Exactly. Let's try that exit once."
    }
  ],
