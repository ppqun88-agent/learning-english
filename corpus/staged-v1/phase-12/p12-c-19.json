{
  "id": "p12-c-19",
  "title_zh": "为编织样片选择线材",
  "topic_id": "leisure",
  "scenario": {
    "id": "weaving-sample-thread-choice",
    "label_zh": "为编织样片选择线材",
    "goal_zh": "比较两种样片的触感并选择棉线编织小样片"
  },
  "participants": [
    "Mina",
    "Faye"
  ],
  "context_zh": "手工课上，导师给学生看两块不同线材编成的样片。",
  "author": "author-phase12-c",
  "sentences": [
    {
      "id": "p12-c-19-s01",
      "speaker": "Mina",
      "text": "I like the colour of this sample, but its texture feels rather rough."
    },
    {
      "id": "p12-c-19-s02",
      "speaker": "Faye",
      "text": "Try the other one. That uses cotton thread instead of the stiff cord."
    },
    {
      "id": "p12-c-19-s03",
      "speaker": "Mina",
      "text": "That's much softer. Would it be easier for my first attempt?"
    },
    {
      "id": "p12-c-19-s04",
      "speaker": "Faye",
      "text": "I think so. You could weave a small square before deciding what to make with it."
    },
    {
      "id": "p12-c-19-s05",
      "speaker": "Mina",
      "text": "I'll use the cotton, then. A sample square is enough for today."
    }
  ],
