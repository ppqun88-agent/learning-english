{
  "id": "pilot01-bank",
  "title_zh": "核对银行账单",
  "context_zh": "客户发现不熟悉的扣费，客服核对而不作无根据保证。",
  "sentences": [
    {
      "id": "pilot01-bank-s01",
      "speaker": "Customer",
      "text": "There is a charge on my bank statement that I do not recognize."
    },
    {
      "id": "pilot01-bank-s02",
      "speaker": "Adviser",
      "text": "Let us check the amount and the name of the company."
    },
    {
      "id": "pilot01-bank-s03",
      "speaker": "Customer",
      "text": "It might be my annual subscription, but I thought I had cancelled it."
    },
    {
      "id": "pilot01-bank-s04",
      "speaker": "Adviser",
      "text": "Do you have a record of the cancellation?"
    },
    {
      "id": "pilot01-bank-s05",
      "speaker": "Customer",
      "text": "Yes, I have an email. Can I request a refund?"
    },
    {
      "id": "pilot01-bank-s06",
      "speaker": "Adviser",
      "text": "You can contact the company first. Keep a copy of its response in case you need to raise a dispute."
    }
  ],
