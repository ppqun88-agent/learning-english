{
  "id": "pilot01-booking",
  "title_zh": "修改旅馆预订",
  "context_zh": "预订变更，核对房型、时间和费用。",
  "sentences": [
    {
      "id": "pilot01-booking-s01",
      "speaker": "Guest",
      "text": "I have a reservation for Friday, but I need to change the date to Saturday."
    },
    {
      "id": "pilot01-booking-s02",
      "speaker": "Receptionist",
      "text": "Of course. Would you like a single room or a double room?"
    },
    {
      "id": "pilot01-booking-s03",
      "speaker": "Guest",
      "text": "A single room, please. Is breakfast included in the price?"
    },
    {
      "id": "pilot01-booking-s04",
      "speaker": "Receptionist",
      "text": "Yes. Your room will be ready after three. Please bring your passport."
    },
    {
      "id": "pilot01-booking-s05",
      "speaker": "Guest",
      "text": "My flight arrives at midnight. Can I still check in?"
    },
    {
      "id": "pilot01-booking-s06",
      "speaker": "Receptionist",
      "text": "Certainly. I will send you a confirmation by email."
    }
  ],
