{
  "id": "pilot01-budget",
  "title_zh": "团队缩减活动预算",
  "context_zh": "同事比较方案，在费用和实际效果之间取舍。",
  "sentences": [
    {
      "id": "pilot01-budget-s01",
      "speaker": "Ava",
      "text": "Our budget is limited. Which expense can we reduce?"
    },
    {
      "id": "pilot01-budget-s02",
      "speaker": "Ben",
      "text": "We could choose a smaller venue. The current estimate includes a large hall."
    },
    {
      "id": "pilot01-budget-s03",
      "speaker": "Ava",
      "text": "Would that affect the quality of the event?"
    },
    {
      "id": "pilot01-budget-s04",
      "speaker": "Ben",
      "text": "Not necessarily. Our priority is useful discussion, not a large audience."
    },
    {
      "id": "pilot01-budget-s05",
      "speaker": "Ava",
      "text": "Then let us compare the options before we make a decision."
    },
    {
      "id": "pilot01-budget-s06",
      "speaker": "Ben",
      "text": "Agreed. I will ask each venue for a detailed quote."
    }
  ],
