{
  "id": "pilot01-feedback",
  "title_zh": "给同事反馈",
  "context_zh": "同事礼貌指出报告的问题，并约定修改方式。",
  "sentences": [
    {
      "id": "pilot01-feedback-s01",
      "speaker": "Manager",
      "text": "Could we discuss the draft? The introduction is clear, but the final section needs work."
    },
    {
      "id": "pilot01-feedback-s02",
      "speaker": "Writer",
      "text": "What would you suggest?"
    },
    {
      "id": "pilot01-feedback-s03",
      "speaker": "Manager",
      "text": "Please explain the benefit to the reader and remove the repeated examples."
    },
    {
      "id": "pilot01-feedback-s04",
      "speaker": "Writer",
      "text": "That is helpful feedback. I was worried that the argument was too brief."
    },
    {
      "id": "pilot01-feedback-s05",
      "speaker": "Manager",
      "text": "It is strong enough. A concise version will be easier to follow."
    },
    {
      "id": "pilot01-feedback-s06",
      "speaker": "Writer",
      "text": "I will revise it today. Is tomorrow a reasonable deadline?"
    },
    {
      "id": "pilot01-feedback-s07",
      "speaker": "Manager",
      "text": "Yes. Thank you for being flexible."
    }
  ],
