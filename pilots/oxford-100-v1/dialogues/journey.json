{
  "id": "pilot01-journey",
  "title_zh": "错过火车后的替代路线",
  "context_zh": "旅客在车站寻找可行的替代行程。",
  "sentences": [
    {
      "id": "pilot01-journey-s01",
      "speaker": "Passenger",
      "text": "I missed my train. Is there another route to York?"
    },
    {
      "id": "pilot01-journey-s02",
      "speaker": "Clerk",
      "text": "You can take a bus, but the journey will take longer."
    },
    {
      "id": "pilot01-journey-s03",
      "speaker": "Passenger",
      "text": "Where is the bus stop, and how much is the fare?"
    },
    {
      "id": "pilot01-journey-s04",
      "speaker": "Clerk",
      "text": "It is opposite the station. You can pay the driver with a card."
    },
    {
      "id": "pilot01-journey-s05",
      "speaker": "Passenger",
      "text": "Is the service direct, or do I need to transfer?"
    },
    {
      "id": "pilot01-journey-s06",
      "speaker": "Clerk",
      "text": "It is direct. Allow extra time because there is a delay on the main road."
    }
  ],
