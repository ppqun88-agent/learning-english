{
  "id": "pilot01-lunch",
  "title_zh": "有饮食限制的午餐",
  "context_zh": "朋友一起点餐，确认食物成分。",
  "sentences": [
    {
      "id": "pilot01-lunch-s01",
      "speaker": "Maya",
      "text": "Shall we share a salad and some bread?"
    },
    {
      "id": "pilot01-lunch-s02",
      "speaker": "Leo",
      "text": "Yes, but I have an allergy to nuts. Could we ask about the ingredients?"
    },
    {
      "id": "pilot01-lunch-s03",
      "speaker": "Maya",
      "text": "Excuse me, does the dressing contain any nuts?"
    },
    {
      "id": "pilot01-lunch-s04",
      "speaker": "Server",
      "text": "Yes. We can serve the salad without it and bring olive oil instead."
    },
    {
      "id": "pilot01-lunch-s05",
      "speaker": "Leo",
      "text": "Thank you. Could you also check with the chef about cross-contact?"
    },
    {
      "id": "pilot01-lunch-s06",
      "speaker": "Server",
      "text": "Certainly. I will explain your concern before you order."
    }
  ],
