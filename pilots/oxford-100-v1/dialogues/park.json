{
  "id": "pilot01-park",
  "title_zh": "讨论社区公园方案",
  "context_zh": "居民比较设施用途并明确责任。",
  "sentences": [
    {
      "id": "pilot01-park-s01",
      "speaker": "Resident",
      "text": "The proposal would turn this empty site into a public garden."
    },
    {
      "id": "pilot01-park-s02",
      "speaker": "Planner",
      "text": "Yes. We want to create a space that the whole community can enjoy."
    },
    {
      "id": "pilot01-park-s03",
      "speaker": "Resident",
      "text": "How will you ensure that people with limited mobility can use it?"
    },
    {
      "id": "pilot01-park-s04",
      "speaker": "Planner",
      "text": "The entrance will be level, and the paths will be wide."
    },
    {
      "id": "pilot01-park-s05",
      "speaker": "Resident",
      "text": "Who will be responsible for maintenance?"
    },
    {
      "id": "pilot01-park-s06",
      "speaker": "Planner",
      "text": "The council. We will publish a schedule and invite residents to report any damage."
    }
  ],
