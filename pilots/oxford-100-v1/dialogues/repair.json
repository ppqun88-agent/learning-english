{
  "id": "pilot01-repair",
  "title_zh": "报修漏水",
  "context_zh": "租客向房东说明问题并约定维修。",
  "sentences": [
    {
      "id": "pilot01-repair-s01",
      "speaker": "Tenant",
      "text": "There is a leak under the kitchen sink. The floor is wet."
    },
    {
      "id": "pilot01-repair-s02",
      "speaker": "Landlord",
      "text": "Can you turn off the water? I will arrange a repair."
    },
    {
      "id": "pilot01-repair-s03",
      "speaker": "Tenant",
      "text": "Yes. Is it safe to use the socket beside the sink?"
    },
    {
      "id": "pilot01-repair-s04",
      "speaker": "Landlord",
      "text": "Please do not use it. Keep that area clear until someone checks it."
    },
    {
      "id": "pilot01-repair-s05",
      "speaker": "Tenant",
      "text": "I can give the plumber access tomorrow morning."
    },
    {
      "id": "pilot01-repair-s06",
      "speaker": "Landlord",
      "text": "Thank you. I will confirm the appointment this afternoon."
    }
  ],
