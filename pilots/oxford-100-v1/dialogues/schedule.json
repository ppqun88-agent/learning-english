{
  "id": "pilot01-schedule",
  "title_zh": "协调项目交付",
  "context_zh": "团队说明依赖关系，协商可实现的承诺。",
  "sentences": [
    {
      "id": "pilot01-schedule-s01",
      "speaker": "Lead",
      "text": "Can we deliver the update on Monday?"
    },
    {
      "id": "pilot01-schedule-s02",
      "speaker": "Engineer",
      "text": "There is a risk. We depend on a supplier for one component."
    },
    {
      "id": "pilot01-schedule-s03",
      "speaker": "Lead",
      "text": "Is there an alternative if it does not arrive?"
    },
    {
      "id": "pilot01-schedule-s04",
      "speaker": "Engineer",
      "text": "Yes, but we need permission to change the design. That is a separate requirement."
    },
    {
      "id": "pilot01-schedule-s05",
      "speaker": "Lead",
      "text": "Let us clarify the scope before we make a commitment."
    },
    {
      "id": "pilot01-schedule-s06",
      "speaker": "Engineer",
      "text": "Agreed. I will assess the impact and send you a realistic timeline."
    }
  ],
