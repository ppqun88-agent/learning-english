{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scene-taxonomy",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label_zh": {
            "type": "string",
            "minLength": 1
          },
          "scope_zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label_zh",
          "scope_zh"
        ],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "label_zh": {
            "type": "string",
            "minLength": 1
          },
          "goal_zh": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "topic_id",
          "label_zh",
          "goal_zh"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "topics",
    "scenarios"
  ],
  "additionalProperties": false
}
